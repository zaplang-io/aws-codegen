# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by application_signals_error_from_code.
enum Application_SignalsError:
    AccessDeniedException
    ConflictException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def application_signals_error_from_code(str code) -> Application_SignalsError:
    if code == "AccessDeniedException":
        return Application_SignalsError.AccessDeniedException
    if code == "ConflictException":
        return Application_SignalsError.ConflictException
    if code == "ResourceNotFoundException":
        return Application_SignalsError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return Application_SignalsError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return Application_SignalsError.ThrottlingException
    if code == "ValidationException":
        return Application_SignalsError.ValidationException
    return Application_SignalsError.Unknown(code=code)

