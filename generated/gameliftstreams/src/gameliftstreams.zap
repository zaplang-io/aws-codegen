# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by gameliftstreams_error_from_code.
enum GameLiftStreamsError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    StreamSessionAccessNotReadyException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def gameliftstreams_error_from_code(str code) -> GameLiftStreamsError:
    if code == "AccessDeniedException":
        return GameLiftStreamsError.AccessDeniedException
    if code == "ConflictException":
        return GameLiftStreamsError.ConflictException
    if code == "InternalServerException":
        return GameLiftStreamsError.InternalServerException
    if code == "ResourceNotFoundException":
        return GameLiftStreamsError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return GameLiftStreamsError.ServiceQuotaExceededException
    if code == "StreamSessionAccessNotReadyException":
        return GameLiftStreamsError.StreamSessionAccessNotReadyException
    if code == "ThrottlingException":
        return GameLiftStreamsError.ThrottlingException
    if code == "ValidationException":
        return GameLiftStreamsError.ValidationException
    return GameLiftStreamsError.Unknown(code=code)

