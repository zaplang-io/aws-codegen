    # Paginator for GetClustersForImage — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: cluster).
    def paginate_get_clusters_for_image(self, GetClustersForImageRequest input):
        auto host = endpoints.regional_host(inspector2_service(), self.region)
        while True:
            auto raw = self.get_clusters_for_image(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

    # Paginator for ListAccountPermissions — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: permissions).
    def paginate_list_account_permissions(self, ListAccountPermissionsRequest input):
        auto host = endpoints.regional_host(inspector2_service(), self.region)
        while True:
            auto raw = self.list_account_permissions(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

