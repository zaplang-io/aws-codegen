enum UsageType:
    EC2_INSTANCE_HOURS
    ECR_INITIAL_SCAN
    ECR_RESCAN
    LAMBDA_FUNCTION_HOURS
    LAMBDA_FUNCTION_CODE_HOURS
    CODE_REPOSITORY_SAST
    CODE_REPOSITORY_IAC
    CODE_REPOSITORY_SCA
    EC2_AGENTLESS_INSTANCE_HOURS
    AZURE_CONTAINER_IMAGE_INITIAL_SCAN
    AZURE_CONTAINER_IMAGE_RESCAN
    AZURE_VM_AGENT_BASED_INSTANCE_HOURS
    AZURE_SERVERLESS_FUNCTION_HOURS
    EC2_AMI_HOURS
    Unknown(str value)

@derive(Json)
@json(open)
enum VMScannerStatus:
    SUCCESS
    PENDING
    FAILED
    Unknown(str value)

@derive(Json)
@json(open)
enum ValidationExceptionReason:
    CANNOT_PARSE
    FIELD_VALIDATION_FAILED
    OTHER
    Unknown(str value)

@derive(Json)
@json(open)
enum VmInstanceSortBy:
    CRITICAL
    HIGH
    ALL
    NETWORK_FINDINGS
    Unknown(str value)

@derive(Json)
@json(open)
enum VmPlatform:
    WINDOWS
    LINUX
    UNKNOWN
    Unknown(str value)

