# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by inspector2_error_from_code.
enum Inspector2Error:
    AccessDeniedException
    BadRequestException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def inspector2_error_from_code(str code) -> Inspector2Error:
    if code == "AccessDeniedException":
        return Inspector2Error.AccessDeniedException
    if code == "BadRequestException":
        return Inspector2Error.BadRequestException
    if code == "ConflictException":
        return Inspector2Error.ConflictException
    if code == "InternalServerException":
        return Inspector2Error.InternalServerException
    if code == "ResourceNotFoundException":
        return Inspector2Error.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return Inspector2Error.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return Inspector2Error.ThrottlingException
    if code == "ValidationException":
        return Inspector2Error.ValidationException
    return Inspector2Error.Unknown(code=code)

