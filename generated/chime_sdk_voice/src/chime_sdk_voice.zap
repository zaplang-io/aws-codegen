# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by voice_chime_error_from_code.
enum Chime_SDK_VoiceError:
    AccessDeniedException
    BadRequestException
    ConflictException
    ForbiddenException
    GoneException
    NotFoundException
    ResourceLimitExceededException
    ServiceFailureException
    ServiceUnavailableException
    ThrottledClientException
    UnauthorizedClientException
    UnprocessableEntityException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def voice_chime_error_from_code(str code) -> Chime_SDK_VoiceError:
    if code == "AccessDeniedException":
        return Chime_SDK_VoiceError.AccessDeniedException
    if code == "BadRequestException":
        return Chime_SDK_VoiceError.BadRequestException
    if code == "ConflictException":
        return Chime_SDK_VoiceError.ConflictException
    if code == "ForbiddenException":
        return Chime_SDK_VoiceError.ForbiddenException
    if code == "GoneException":
        return Chime_SDK_VoiceError.GoneException
    if code == "NotFoundException":
        return Chime_SDK_VoiceError.NotFoundException
    if code == "ResourceLimitExceededException":
        return Chime_SDK_VoiceError.ResourceLimitExceededException
    if code == "ServiceFailureException":
        return Chime_SDK_VoiceError.ServiceFailureException
    if code == "ServiceUnavailableException":
        return Chime_SDK_VoiceError.ServiceUnavailableException
    if code == "ThrottledClientException":
        return Chime_SDK_VoiceError.ThrottledClientException
    if code == "UnauthorizedClientException":
        return Chime_SDK_VoiceError.UnauthorizedClientException
    if code == "UnprocessableEntityException":
        return Chime_SDK_VoiceError.UnprocessableEntityException
    return Chime_SDK_VoiceError.Unknown(code=code)

