    # Paginator for ListSipMediaApplications — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: SipMediaApplications).
    def paginate_list_sip_media_applications(self, ListSipMediaApplicationsRequest input):
        auto host = endpoints.regional_host(voice_chime_service(), self.region)
        while True:
            auto raw = self.list_sip_media_applications(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

    # Paginator for ListSipRules — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: SipRules).
    def paginate_list_sip_rules(self, ListSipRulesRequest input):
        auto host = endpoints.regional_host(voice_chime_service(), self.region)
        while True:
            auto raw = self.list_sip_rules(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

# Construct a Chime_SDK_VoiceClient bound to credentials + region.
def voice_chime_client(core.Credentials creds, str region) -> Chime_SDK_VoiceClient:
    return Chime_SDK_VoiceClient(creds=creds, region=region)
