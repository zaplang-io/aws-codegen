    # Paginator for ListCampaigns — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: campaignSummaryList).
    def paginate_list_campaigns(self, ListCampaignsRequest input):
        auto host = endpoints.regional_host(connect_campaigns_service(), self.region)
        while True:
            auto raw = self.list_campaigns(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

    # Paginator for ListConnectInstanceIntegrations — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: integrationSummaryList).
    def paginate_list_connect_instance_integrations(self, ListConnectInstanceIntegrationsRequest input):
        auto host = endpoints.regional_host(connect_campaigns_service(), self.region)
        while True:
            auto raw = self.list_connect_instance_integrations(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

# Construct a ConnectCampaignsV2Client bound to credentials + region.
def connect_campaigns_client(core.Credentials creds, str region) -> ConnectCampaignsV2Client:
    return ConnectCampaignsV2Client(creds=creds, region=region)
