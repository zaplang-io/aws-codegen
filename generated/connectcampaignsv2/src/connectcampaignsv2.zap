# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by connect_campaigns_error_from_code.
enum ConnectCampaignsV2Error:
    AccessDeniedException
    ConflictException
    InternalServerException
    InvalidCampaignStateException
    InvalidStateException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def connect_campaigns_error_from_code(str code) -> ConnectCampaignsV2Error:
    if code == "AccessDeniedException":
        return ConnectCampaignsV2Error.AccessDeniedException
    if code == "ConflictException":
        return ConnectCampaignsV2Error.ConflictException
    if code == "InternalServerException":
        return ConnectCampaignsV2Error.InternalServerException
    if code == "InvalidCampaignStateException":
        return ConnectCampaignsV2Error.InvalidCampaignStateException
    if code == "InvalidStateException":
        return ConnectCampaignsV2Error.InvalidStateException
    if code == "ResourceNotFoundException":
        return ConnectCampaignsV2Error.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return ConnectCampaignsV2Error.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return ConnectCampaignsV2Error.ThrottlingException
    if code == "ValidationException":
        return ConnectCampaignsV2Error.ValidationException
    return ConnectCampaignsV2Error.Unknown(code=code)

