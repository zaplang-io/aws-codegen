# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# smithy-rpc-v2-cbor body `__type` (cbor.cbor_error_type) code by cloudwatch_omni_error_from_code.
enum CloudWatchOmniError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a smithy-rpc-v2-cbor error code to a variant. The code is the body's
# `__type` (cbor.cbor_error_type / cbor.cbor_error.code); it is namespaced like
# awsJson (e.g. "com.amazonaws.<svc>#<Name>"), so strip to the bare shape name
# (the text after the last '#') before dispatching.
def cloudwatch_omni_error_from_code(str code) -> CloudWatchOmniError:
    if code == "AccessDeniedException":
        return CloudWatchOmniError.AccessDeniedException
    if code == "ConflictException":
        return CloudWatchOmniError.ConflictException
    if code == "InternalServerException":
        return CloudWatchOmniError.InternalServerException
    if code == "ResourceNotFoundException":
        return CloudWatchOmniError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return CloudWatchOmniError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return CloudWatchOmniError.ThrottlingException
    if code == "ValidationException":
        return CloudWatchOmniError.ValidationException
    return CloudWatchOmniError.Unknown(code=code)

