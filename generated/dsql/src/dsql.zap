# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def dsql_error_from_code(str code) -> DSQLError:
    if code == "AccessDeniedException":
        return DSQLError.AccessDeniedException
    if code == "ConflictException":
        return DSQLError.ConflictException
    if code == "InternalServerException":
        return DSQLError.InternalServerException
    if code == "ResourceNotFoundException":
        return DSQLError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return DSQLError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return DSQLError.ThrottlingException
    if code == "ValidationException":
        return DSQLError.ValidationException
    return DSQLError.Unknown(code=code)

