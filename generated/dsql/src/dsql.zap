    # Paginator for ListClusters — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: clusters).
    def paginate_list_clusters(self, ListClustersInput input):
        auto host = endpoints.regional_host(dsql_service(), self.region)
        while True:
            auto raw = self.list_clusters(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

    # Paginator for ListStreams — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: streams).
    def paginate_list_streams(self, ListStreamsInput input):
        auto host = endpoints.regional_host(dsql_service(), self.region)
        while True:
            auto raw = self.list_streams(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

# Construct a DSQLClient bound to credentials + region.
def dsql_client(core.Credentials creds, str region) -> DSQLClient:
    return DSQLClient(creds=creds, region=region)
