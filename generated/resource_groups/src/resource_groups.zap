    # Paginator for SearchResources — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: ResourceIdentifiers).
    def paginate_search_resources(self, SearchResourcesInput input):
        auto host = endpoints.regional_host(resource_groups_service(), self.region)
        while True:
            auto raw = self.search_resources(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

# Construct a Resource_GroupsClient bound to credentials + region.
def resource_groups_client(core.Credentials creds, str region) -> Resource_GroupsClient:
    return Resource_GroupsClient(creds=creds, region=region)
