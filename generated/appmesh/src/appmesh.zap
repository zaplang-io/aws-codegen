    # Paginator for ListGatewayRoutes — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: gatewayRoutes).
    def paginate_list_gateway_routes(self, ListGatewayRoutesInput input):
        auto host = endpoints.regional_host(appmesh_service(), self.region)
        while True:
            auto raw = self.list_gateway_routes(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

