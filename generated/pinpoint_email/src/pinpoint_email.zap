    # Paginator for GetDedicatedIps — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: DedicatedIps).
    def paginate_get_dedicated_ips(self, GetDedicatedIpsRequest input):
        auto host = endpoints.regional_host(email_service(), self.region)
        while True:
            auto raw = self.get_dedicated_ips(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

