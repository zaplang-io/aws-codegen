# Construct a ARC_Zonal_ShiftClient bound to credentials + region.
def arc_zonal_shift_client(core.Credentials creds, str region) -> ARC_Zonal_ShiftClient:
    return ARC_Zonal_ShiftClient(creds=creds, region=region)
