        auto doc = UpdateZonalShiftDocument(comment=input.comment, expiresIn=input.expiresIn)
        auto bp = restjson.rest_json_document(b, doc.to_json())
        return restjson.rest_json_request(self.creds, bp, arc_zonal_shift_service(), self.region, host)

    # Paginator for ListAutoshifts — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: items).
    def paginate_list_autoshifts(self, ListAutoshiftsRequest input):
        auto host = endpoints.regional_host(arc_zonal_shift_service(), self.region)
        while True:
            auto raw = self.list_autoshifts(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

