# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by ecs_error_from_code.
enum ECSError:
    AccessDeniedException
    AttributeLimitExceededException
    BlockedException
    ClientException
    ClusterContainsCapacityProviderException
    ClusterContainsContainerInstancesException
    ClusterContainsServicesException
    ClusterContainsTasksException
    ClusterNotFoundException
    ConflictException
    DaemonNotActiveException
    DaemonNotFoundException
    GatewayNotFoundException
    InvalidParameterException
    LimitExceededException
    MissingVersionException
    NamespaceNotFoundException
    NoUpdateAvailableException
    PlatformTaskDefinitionIncompatibilityException
    PlatformUnknownException
    ResourceInUseException
    ResourceNotFoundException
    ServerException
    ServiceDeploymentNotFoundException
    ServiceNotActiveException
    ServiceNotFoundException
    TargetNotConnectedException
    TargetNotFoundException
    TaskSetNotFoundException
    UnsupportedFeatureException
    UpdateInProgressException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def ecs_error_from_code(str code) -> ECSError:
    if code == "AccessDeniedException":
        return ECSError.AccessDeniedException
    if code == "AttributeLimitExceededException":
        return ECSError.AttributeLimitExceededException
    if code == "BlockedException":
        return ECSError.BlockedException
    if code == "ClientException":
        return ECSError.ClientException
    if code == "ClusterContainsCapacityProviderException":
        return ECSError.ClusterContainsCapacityProviderException
    if code == "ClusterContainsContainerInstancesException":
        return ECSError.ClusterContainsContainerInstancesException
    if code == "ClusterContainsServicesException":
        return ECSError.ClusterContainsServicesException
    if code == "ClusterContainsTasksException":
        return ECSError.ClusterContainsTasksException
    if code == "ClusterNotFoundException":
        return ECSError.ClusterNotFoundException
    if code == "ConflictException":
        return ECSError.ConflictException
    if code == "DaemonNotActiveException":
        return ECSError.DaemonNotActiveException
    if code == "DaemonNotFoundException":
        return ECSError.DaemonNotFoundException
    if code == "GatewayNotFoundException":
        return ECSError.GatewayNotFoundException
    if code == "InvalidParameterException":
        return ECSError.InvalidParameterException
    if code == "LimitExceededException":
        return ECSError.LimitExceededException
    if code == "MissingVersionException":
        return ECSError.MissingVersionException
    if code == "NamespaceNotFoundException":
        return ECSError.NamespaceNotFoundException
    if code == "NoUpdateAvailableException":
        return ECSError.NoUpdateAvailableException
    if code == "PlatformTaskDefinitionIncompatibilityException":
        return ECSError.PlatformTaskDefinitionIncompatibilityException
    if code == "PlatformUnknownException":
        return ECSError.PlatformUnknownException
    if code == "ResourceInUseException":
        return ECSError.ResourceInUseException
    if code == "ResourceNotFoundException":
        return ECSError.ResourceNotFoundException
    if code == "ServerException":
        return ECSError.ServerException
    if code == "ServiceDeploymentNotFoundException":
        return ECSError.ServiceDeploymentNotFoundException
    if code == "ServiceNotActiveException":
        return ECSError.ServiceNotActiveException
    if code == "ServiceNotFoundException":
        return ECSError.ServiceNotFoundException
    if code == "TargetNotConnectedException":
        return ECSError.TargetNotConnectedException
    if code == "TargetNotFoundException":
        return ECSError.TargetNotFoundException
    if code == "TaskSetNotFoundException":
        return ECSError.TaskSetNotFoundException
    if code == "UnsupportedFeatureException":
        return ECSError.UnsupportedFeatureException
    if code == "UpdateInProgressException":
        return ECSError.UpdateInProgressException
    return ECSError.Unknown(code=code)

