# --- errors ----------------------------------------------------------------

# Typed service errors (#361): the per-service enum + classifier + name
# dispatcher emitted on top of `aws_core.errors` (DECISIONS.md D-0006). One
# bare variant per modeled error shape, plus an open-enum `Unknown(str code)`
# catch-all, so a caller built against this model keeps working when the
# service adds an error. The raw wire code is
# the awsJson `__type` / X-Amzn-ErrorType shape name.
# `errors.error_code` normalizes it to the bare shape name before matching;
# the base carrier, the X-Amzn-ErrorType fallback and the raise/check bridge
# are inherited from `aws_core.errors` and not re-emitted here.
enum ECSErrorKind:
    AccessDeniedException
    AttributeLimitExceededException
    BlockedException
    ClientException
    ClusterContainsCapacityProviderException
    ClusterContainsContainerInstancesException
    ClusterContainsServicesException
    ClusterContainsTasksException
    ClusterNotFoundException
    ConflictException
    DaemonNotActiveException
    DaemonNotFoundException
    GatewayNotFoundException
    InvalidParameterException
    LimitExceededException
    MissingVersionException
    NamespaceNotFoundException
    NoUpdateAvailableException
    PlatformTaskDefinitionIncompatibilityException
    PlatformUnknownException
    ResourceInUseException
    ResourceNotFoundException
    ServerException
    ServiceDeploymentNotFoundException
    ServiceNotActiveException
    ServiceNotFoundException
    TargetNotConnectedException
    TargetNotFoundException
    TaskSetNotFoundException
    UnsupportedFeatureException
    UpdateInProgressException
    Unknown(str code)

# Classify an AWS error code into `ECSErrorKind`,
# normalizing first (`errors.error_code` strips any namespace/suffix) then
# matching by name; an unmodeled code becomes `Unknown(name)`, carrying it.
def ecs_error_kind(str code) -> ECSErrorKind:
    auto name = errors.error_code(code)
    if name == "AccessDeniedException":
        return ECSErrorKind.AccessDeniedException
    if name == "AttributeLimitExceededException":
        return ECSErrorKind.AttributeLimitExceededException
    if name == "BlockedException":
        return ECSErrorKind.BlockedException
    if name == "ClientException":
        return ECSErrorKind.ClientException
    if name == "ClusterContainsCapacityProviderException":
        return ECSErrorKind.ClusterContainsCapacityProviderException
    if name == "ClusterContainsContainerInstancesException":
        return ECSErrorKind.ClusterContainsContainerInstancesException
    if name == "ClusterContainsServicesException":
        return ECSErrorKind.ClusterContainsServicesException
    if name == "ClusterContainsTasksException":
        return ECSErrorKind.ClusterContainsTasksException
    if name == "ClusterNotFoundException":
        return ECSErrorKind.ClusterNotFoundException
    if name == "ConflictException":
        return ECSErrorKind.ConflictException
    if name == "DaemonNotActiveException":
        return ECSErrorKind.DaemonNotActiveException
    if name == "DaemonNotFoundException":
        return ECSErrorKind.DaemonNotFoundException
    if name == "GatewayNotFoundException":
        return ECSErrorKind.GatewayNotFoundException
    if name == "InvalidParameterException":
        return ECSErrorKind.InvalidParameterException
    if name == "LimitExceededException":
        return ECSErrorKind.LimitExceededException
    if name == "MissingVersionException":
        return ECSErrorKind.MissingVersionException
    if name == "NamespaceNotFoundException":
        return ECSErrorKind.NamespaceNotFoundException
    if name == "NoUpdateAvailableException":
        return ECSErrorKind.NoUpdateAvailableException
    if name == "PlatformTaskDefinitionIncompatibilityException":
        return ECSErrorKind.PlatformTaskDefinitionIncompatibilityException
    if name == "PlatformUnknownException":
        return ECSErrorKind.PlatformUnknownException
    if name == "ResourceInUseException":
        return ECSErrorKind.ResourceInUseException
    if name == "ResourceNotFoundException":
        return ECSErrorKind.ResourceNotFoundException
    if name == "ServerException":
        return ECSErrorKind.ServerException
    if name == "ServiceDeploymentNotFoundException":
        return ECSErrorKind.ServiceDeploymentNotFoundException
    if name == "ServiceNotActiveException":
        return ECSErrorKind.ServiceNotActiveException
    if name == "ServiceNotFoundException":
        return ECSErrorKind.ServiceNotFoundException
    if name == "TargetNotConnectedException":
        return ECSErrorKind.TargetNotConnectedException
    if name == "TargetNotFoundException":
        return ECSErrorKind.TargetNotFoundException
    if name == "TaskSetNotFoundException":
        return ECSErrorKind.TaskSetNotFoundException
    if name == "UnsupportedFeatureException":
        return ECSErrorKind.UnsupportedFeatureException
    if name == "UpdateInProgressException":
        return ECSErrorKind.UpdateInProgressException
    return ECSErrorKind.Unknown(name)

# The canonical name of a classified error. This `match` is exhaustive over
# every variant (the compiler enforces it, so a new variant forces it to be
# updated — the generator emits the enum and dispatcher together) and is
# module-local, so each pattern is a two-segment `Enum.Variant` — the portable
# form until the compiler resolves module-qualified variant patterns in a
# caller's own `match` (DECISIONS.md D-0006). `Unknown` carries its code.
def ecs_error_name(ECSErrorKind k) -> str:
    match k:
        case ECSErrorKind.AccessDeniedException:
            return "AccessDeniedException"
        case ECSErrorKind.AttributeLimitExceededException:
            return "AttributeLimitExceededException"
        case ECSErrorKind.BlockedException:
            return "BlockedException"
        case ECSErrorKind.ClientException:
            return "ClientException"
        case ECSErrorKind.ClusterContainsCapacityProviderException:
            return "ClusterContainsCapacityProviderException"
        case ECSErrorKind.ClusterContainsContainerInstancesException:
            return "ClusterContainsContainerInstancesException"
        case ECSErrorKind.ClusterContainsServicesException:
            return "ClusterContainsServicesException"
        case ECSErrorKind.ClusterContainsTasksException:
            return "ClusterContainsTasksException"
        case ECSErrorKind.ClusterNotFoundException:
            return "ClusterNotFoundException"
        case ECSErrorKind.ConflictException:
            return "ConflictException"
        case ECSErrorKind.DaemonNotActiveException:
            return "DaemonNotActiveException"
        case ECSErrorKind.DaemonNotFoundException:
            return "DaemonNotFoundException"
        case ECSErrorKind.GatewayNotFoundException:
            return "GatewayNotFoundException"
        case ECSErrorKind.InvalidParameterException:
            return "InvalidParameterException"
        case ECSErrorKind.LimitExceededException:
            return "LimitExceededException"
        case ECSErrorKind.MissingVersionException:
            return "MissingVersionException"
        case ECSErrorKind.NamespaceNotFoundException:
            return "NamespaceNotFoundException"
        case ECSErrorKind.NoUpdateAvailableException:
            return "NoUpdateAvailableException"
        case ECSErrorKind.PlatformTaskDefinitionIncompatibilityException:
            return "PlatformTaskDefinitionIncompatibilityException"
        case ECSErrorKind.PlatformUnknownException:
            return "PlatformUnknownException"
        case ECSErrorKind.ResourceInUseException:
            return "ResourceInUseException"
        case ECSErrorKind.ResourceNotFoundException:
            return "ResourceNotFoundException"
        case ECSErrorKind.ServerException:
            return "ServerException"
        case ECSErrorKind.ServiceDeploymentNotFoundException:
            return "ServiceDeploymentNotFoundException"
        case ECSErrorKind.ServiceNotActiveException:
            return "ServiceNotActiveException"
        case ECSErrorKind.ServiceNotFoundException:
            return "ServiceNotFoundException"
        case ECSErrorKind.TargetNotConnectedException:
            return "TargetNotConnectedException"
        case ECSErrorKind.TargetNotFoundException:
            return "TargetNotFoundException"
        case ECSErrorKind.TaskSetNotFoundException:
            return "TaskSetNotFoundException"
        case ECSErrorKind.UnsupportedFeatureException:
            return "UnsupportedFeatureException"
        case ECSErrorKind.UpdateInProgressException:
            return "UpdateInProgressException"
        case ECSErrorKind.Unknown(c):
            return "Unknown(" + c + ")"

# --- client ----------------------------------------------------------------

# JSON body helpers (compact, declaration-order objects): the collection
# serialization @derive(Json) does not emit yet (zaplang-io/zap#424). `_json_str`
# escapes+quotes via the prelude JSON writer; `_json_obj`/`_json_arr` comma-join
# pre-serialized members.
def ecs_json_str(str s) -> str:
    return json.dumps(JsonValue.Str(s))

def ecs_json_obj(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "{" + body + "}"

def ecs_json_arr(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "[" + body + "]"

# Explicit JSON serializers for input shapes with collection/nested members
# (the @derive(Json) collection follow-up, zaplang-io/zap#424).

# Serialize AwsVpcConfiguration to a compact JSON object (declaration order).
def aws_vpc_configuration_to_json(AwsVpcConfiguration v) -> str:
    list[str] parts = []
    list[str] e0 = []
    for x0 in v.subnets:
        e0.append(ecs_json_str(x0))
    parts.append("\"subnets\":" + ecs_json_arr(e0))
    if v.securityGroups.is_some():
        auto u1 = v.securityGroups.unwrap()
        list[str] e2 = []
        for x2 in u1:
            e2.append(ecs_json_str(x2))
        parts.append("\"securityGroups\":" + ecs_json_arr(e2))
    if v.assignPublicIp.is_some():
        auto u3 = v.assignPublicIp.unwrap()
        parts.append("\"assignPublicIp\":" + u3.to_json())
    return ecs_json_obj(parts)

