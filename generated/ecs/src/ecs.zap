    # Paginator for ListAccountSettings — yields each Response page, threading the
    # nextToken -> nextToken continuation token until the output token is absent (result key: settings).
    def paginate_list_account_settings(self, ListAccountSettingsRequest input):
        auto host = endpoints.regional_host(ecs_protocol().service, self.region)
        while True:
            auto body = input.to_json()
            auto raw = awsjson.awsjson_request_now(ecs_protocol(), self.creds, self.region, "ListAccountSettings", body)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

