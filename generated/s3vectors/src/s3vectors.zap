    # Paginator for ListIndexes — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: indexes).
    def paginate_list_indexes(self, ListIndexesInput input):
        auto host = endpoints.regional_host(s3vectors_service(), self.region)
        while True:
            auto raw = self.list_indexes(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

    # Paginator for ListVectorBuckets — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: vectorBuckets).
    def paginate_list_vector_buckets(self, ListVectorBucketsInput input):
