    # Paginator for GetOfferingStatus — yields each Response page, threading the
    # nextToken -> nextToken continuation token until the output token is absent (result key: current, nextPeriod).
    def paginate_get_offering_status(self, GetOfferingStatusRequest input):
        auto host = endpoints.regional_host(devicefarm_protocol().service, self.region)
        while True:
            auto body = input.to_json()
            auto raw = awsjson.awsjson_request_now(devicefarm_protocol(), self.creds, self.region, "GetOfferingStatus", body)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

