# every variant (the compiler enforces it, so a new variant forces it to be
# updated — the generator emits the enum and dispatcher together) and is
# module-local, so each pattern is a two-segment `Enum.Variant` — the portable
# form until the compiler resolves module-qualified variant patterns in a
# caller's own `match` (DECISIONS.md D-0006). `Unknown` carries its code.
def cloudsearch_error_name(CloudSearchErrorKind k) -> str:
    match k:
        case CloudSearchErrorKind.BaseException:
            return "BaseException"
        case CloudSearchErrorKind.DisabledOperationException:
            return "DisabledOperationException"
        case CloudSearchErrorKind.InternalException:
            return "InternalException"
        case CloudSearchErrorKind.InvalidTypeException:
            return "InvalidTypeException"
        case CloudSearchErrorKind.LimitExceededException:
            return "LimitExceededException"
        case CloudSearchErrorKind.ResourceAlreadyExistsException:
            return "ResourceAlreadyExistsException"
        case CloudSearchErrorKind.ResourceNotFoundException:
            return "ResourceNotFoundException"
        case CloudSearchErrorKind.ValidationException:
            return "ValidationException"
        case CloudSearchErrorKind.Unknown(c):
            return "Unknown(" + c + ")"

