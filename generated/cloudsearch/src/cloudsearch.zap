    auto name = errors.error_code(code)
    if name == "BaseException":
        return CloudSearchErrorKind.BaseException
    if name == "DisabledOperationException":
        return CloudSearchErrorKind.DisabledOperationException
    if name == "InternalException":
        return CloudSearchErrorKind.InternalException
    if name == "InvalidTypeException":
        return CloudSearchErrorKind.InvalidTypeException
    if name == "LimitExceededException":
        return CloudSearchErrorKind.LimitExceededException
    if name == "ResourceAlreadyExistsException":
        return CloudSearchErrorKind.ResourceAlreadyExistsException
    if name == "ResourceNotFoundException":
        return CloudSearchErrorKind.ResourceNotFoundException
    if name == "ValidationException":
        return CloudSearchErrorKind.ValidationException
    return CloudSearchErrorKind.Unknown(name)

