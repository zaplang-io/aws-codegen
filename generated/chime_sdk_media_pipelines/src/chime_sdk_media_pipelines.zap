    if code == "ResourceLimitExceededException":
        return Chime_SDK_Media_PipelinesError.ResourceLimitExceededException
    if code == "ServiceFailureException":
        return Chime_SDK_Media_PipelinesError.ServiceFailureException
    if code == "ServiceUnavailableException":
