# --- errors ----------------------------------------------------------------

# Typed service errors (#361): the per-service enum + classifier + name
# dispatcher emitted on top of `aws_core.errors` (DECISIONS.md D-0006). One
# bare variant per modeled error shape, plus an open-enum `Unknown(str code)`
# catch-all, so a caller built against this model keeps working when the
# service adds an error. The raw wire code is
# the awsJson `__type` / X-Amzn-ErrorType shape name.
# `errors.error_code` normalizes it to the bare shape name before matching;
# the base carrier, the X-Amzn-ErrorType fallback and the raise/check bridge
# are inherited from `aws_core.errors` and not re-emitted here.
enum Application_Discovery_ServiceErrorKind:
    AuthorizationErrorException
    ConflictErrorException
    HomeRegionNotSetException
    InvalidParameterException
    InvalidParameterValueException
    LimitExceededException
    OperationNotPermittedException
    ResourceInUseException
    ResourceNotFoundException
    ServerInternalErrorException
    Unknown(str code)

# Classify an AWS error code into `Application_Discovery_ServiceErrorKind`,
# normalizing first (`errors.error_code` strips any namespace/suffix) then
# matching by name; an unmodeled code becomes `Unknown(name)`, carrying it.
def discovery_error_kind(str code) -> Application_Discovery_ServiceErrorKind:
    auto name = errors.error_code(code)
    if name == "AuthorizationErrorException":
        return Application_Discovery_ServiceErrorKind.AuthorizationErrorException
    if name == "ConflictErrorException":
        return Application_Discovery_ServiceErrorKind.ConflictErrorException
    if name == "HomeRegionNotSetException":
        return Application_Discovery_ServiceErrorKind.HomeRegionNotSetException
    if name == "InvalidParameterException":
        return Application_Discovery_ServiceErrorKind.InvalidParameterException
    if name == "InvalidParameterValueException":
        return Application_Discovery_ServiceErrorKind.InvalidParameterValueException
    if name == "LimitExceededException":
        return Application_Discovery_ServiceErrorKind.LimitExceededException
    if name == "OperationNotPermittedException":
        return Application_Discovery_ServiceErrorKind.OperationNotPermittedException
    if name == "ResourceInUseException":
        return Application_Discovery_ServiceErrorKind.ResourceInUseException
    if name == "ResourceNotFoundException":
        return Application_Discovery_ServiceErrorKind.ResourceNotFoundException
    if name == "ServerInternalErrorException":
        return Application_Discovery_ServiceErrorKind.ServerInternalErrorException
    return Application_Discovery_ServiceErrorKind.Unknown(name)

# The canonical name of a classified error. This `match` is exhaustive over
# every variant (the compiler enforces it, so a new variant forces it to be
# updated — the generator emits the enum and dispatcher together) and is
# module-local, so each pattern is a two-segment `Enum.Variant` — the portable
# form until the compiler resolves module-qualified variant patterns in a
# caller's own `match` (DECISIONS.md D-0006). `Unknown` carries its code.
def discovery_error_name(Application_Discovery_ServiceErrorKind k) -> str:
    match k:
        case Application_Discovery_ServiceErrorKind.AuthorizationErrorException:
            return "AuthorizationErrorException"
        case Application_Discovery_ServiceErrorKind.ConflictErrorException:
            return "ConflictErrorException"
        case Application_Discovery_ServiceErrorKind.HomeRegionNotSetException:
            return "HomeRegionNotSetException"
        case Application_Discovery_ServiceErrorKind.InvalidParameterException:
            return "InvalidParameterException"
        case Application_Discovery_ServiceErrorKind.InvalidParameterValueException:
            return "InvalidParameterValueException"
        case Application_Discovery_ServiceErrorKind.LimitExceededException:
            return "LimitExceededException"
        case Application_Discovery_ServiceErrorKind.OperationNotPermittedException:
            return "OperationNotPermittedException"
        case Application_Discovery_ServiceErrorKind.ResourceInUseException:
            return "ResourceInUseException"
        case Application_Discovery_ServiceErrorKind.ResourceNotFoundException:
            return "ResourceNotFoundException"
        case Application_Discovery_ServiceErrorKind.ServerInternalErrorException:
            return "ServerInternalErrorException"
        case Application_Discovery_ServiceErrorKind.Unknown(c):
            return "Unknown(" + c + ")"

