# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by discovery_error_from_code.
enum Application_Discovery_ServiceError:
    AuthorizationErrorException
    ConflictErrorException
    HomeRegionNotSetException
    InvalidParameterException
    InvalidParameterValueException
    LimitExceededException
    OperationNotPermittedException
    ResourceInUseException
    ResourceNotFoundException
    ServerInternalErrorException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def discovery_error_from_code(str code) -> Application_Discovery_ServiceError:
    if code == "AuthorizationErrorException":
        return Application_Discovery_ServiceError.AuthorizationErrorException
    if code == "ConflictErrorException":
        return Application_Discovery_ServiceError.ConflictErrorException
    if code == "HomeRegionNotSetException":
        return Application_Discovery_ServiceError.HomeRegionNotSetException
    if code == "InvalidParameterException":
        return Application_Discovery_ServiceError.InvalidParameterException
    if code == "InvalidParameterValueException":
        return Application_Discovery_ServiceError.InvalidParameterValueException
    if code == "LimitExceededException":
        return Application_Discovery_ServiceError.LimitExceededException
    if code == "OperationNotPermittedException":
        return Application_Discovery_ServiceError.OperationNotPermittedException
    if code == "ResourceInUseException":
        return Application_Discovery_ServiceError.ResourceInUseException
    if code == "ResourceNotFoundException":
        return Application_Discovery_ServiceError.ResourceNotFoundException
    if code == "ServerInternalErrorException":
        return Application_Discovery_ServiceError.ServerInternalErrorException
    return Application_Discovery_ServiceError.Unknown(code=code)

