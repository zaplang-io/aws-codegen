    # Paginator for ListPartners — yields each Response page, threading the
    # NextToken -> NextToken continuation token until the output token is absent (result key: PartnerSummaryList).
    def paginate_list_partners(self, ListPartnersRequest input):
        auto host = endpoints.regional_host(partnercentral_account_protocol().service, self.region)
        while True:
            auto body = input.to_json()
            auto raw = awsjson.awsjson_request_now(partnercentral_account_protocol(), self.creds, self.region, "ListPartners", body)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

# Construct a PartnerCentral_AccountClient bound to credentials + region.
def partnercentral_account_client(core.Credentials creds, str region) -> PartnerCentral_AccountClient:
    return PartnerCentral_AccountClient(creds=creds, region=region)
