# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by admin_wickr_error_from_code.
enum WickrError:
    BadRequestError
    ForbiddenError
    InternalServerError
    RateLimitError
    ResourceNotFoundError
    UnauthorizedError
    ValidationError
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def admin_wickr_error_from_code(str code) -> WickrError:
    if code == "BadRequestError":
        return WickrError.BadRequestError
    if code == "ForbiddenError":
        return WickrError.ForbiddenError
    if code == "InternalServerError":
        return WickrError.InternalServerError
    if code == "RateLimitError":
        return WickrError.RateLimitError
    if code == "ResourceNotFoundError":
        return WickrError.ResourceNotFoundError
    if code == "UnauthorizedError":
        return WickrError.UnauthorizedError
    if code == "ValidationError":
        return WickrError.ValidationError
    return WickrError.Unknown(code=code)

# --- client ----------------------------------------------------------------

