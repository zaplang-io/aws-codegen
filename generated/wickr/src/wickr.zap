# Render a bool bound to a URI/query/header slot as its wire text.
def admin_wickr_bind_bool(bool b) -> str:
    if b:
        return "true"
    return "false"

# A bound Wickr client: credentials + region, threaded into every operation.
struct WickrClient:
    core.Credentials creds
