    # Paginator for ListBlockedGuestUsers — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: blocklist).
    def paginate_list_blocked_guest_users(self, ListBlockedGuestUsersRequest input):
        auto host = endpoints.regional_host(admin_wickr_service(), self.region)
        while True:
            auto raw = self.list_blocked_guest_users(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

