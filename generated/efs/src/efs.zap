    # Paginator for DescribeAccessPoints — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: AccessPoints).
    def paginate_describe_access_points(self, DescribeAccessPointsRequest input):
        auto host = endpoints.regional_host(elasticfilesystem_service(), self.region)
        while True:
            auto raw = self.describe_access_points(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

