        return EFSError.SecurityGroupNotFound
    if code == "SubnetNotFound":
        return EFSError.SubnetNotFound
    if code == "ThrottlingException":
        return EFSError.ThrottlingException
    if code == "ThroughputLimitExceeded":
        return EFSError.ThroughputLimitExceeded
    if code == "TooManyRequests":
        return EFSError.TooManyRequests
    if code == "UnsupportedAvailabilityZone":
        return EFSError.UnsupportedAvailabilityZone
    if code == "ValidationException":
        return EFSError.ValidationException
    return EFSError.Unknown(code=code)

# --- client ----------------------------------------------------------------

# Per-operation JSON document bodies (the unbound "document" members of an
# operation's input, serialized with @derive(Json)).

@derive(Json)
struct DescribeAccountPreferencesDocument:
    # document members of DescribeAccountPreferences
    Optional[str] NextToken
    Optional[int64] MaxResults

@derive(Json)
struct PutAccountPreferencesDocument:
    # document members of PutAccountPreferences
    ResourceIdType ResourceIdType

@derive(Json)
struct PutBackupPolicyDocument:
    # document members of PutBackupPolicy
    BackupPolicy BackupPolicy

@derive(Json)
struct PutFileSystemPolicyDocument:
    # document members of PutFileSystemPolicy
    str Policy
    Optional[bool] BypassPolicyLockoutSafetyCheck

@derive(Json)
struct UpdateFileSystemDocument:
    # document members of UpdateFileSystem
    Optional[ThroughputMode] ThroughputMode
    Optional[float64] ProvisionedThroughputInMibps

@derive(Json)
struct UpdateFileSystemProtectionDocument:
    # document members of UpdateFileSystemProtection
    Optional[ReplicationOverwriteProtection] ReplicationOverwriteProtection

# JSON body helpers (compact, declaration-order objects): the collection
# serialization @derive(Json) does not emit yet (zaplang-io/zap#424). `_json_str`
# escapes+quotes via the prelude JSON writer; `_json_obj`/`_json_arr` comma-join
# pre-serialized members.
def elasticfilesystem_json_str(str s) -> str:
    return json.dumps(JsonValue.Str(s))

def elasticfilesystem_json_obj(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "{" + body + "}"

def elasticfilesystem_json_arr(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "[" + body + "]"

# Explicit JSON serializers for document bodies with collection/nested
# members (the @derive(Json) collection follow-up, zaplang-io/zap#424).

# Serialize PosixUser to a compact JSON object (declaration order).
def posix_user_to_json(PosixUser v) -> str:
    list[str] parts = []
    parts.append("\"Uid\":" + str(v.Uid))
    parts.append("\"Gid\":" + str(v.Gid))
    if v.SecondaryGids.is_some():
        auto u0 = v.SecondaryGids.unwrap()
        list[str] e1 = []
        for x1 in u0:
            e1.append(str(x1))
        parts.append("\"SecondaryGids\":" + elasticfilesystem_json_arr(e1))
    return elasticfilesystem_json_obj(parts)

