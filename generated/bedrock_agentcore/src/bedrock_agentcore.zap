    return "[" + body + "]"

# A timestamp as an ISO-8601 JSON string (`@json(timestamp="iso8601")`).
def bedrock_agentcore_json_ts_iso(DateTime dt) -> str:
    return "\"" + datetime.strftime(dt, "%Y-%m-%dT%H:%M:%SZ") + "\""

