# Construct a Bedrock_AgentCoreClient bound to credentials + region.
def bedrock_agentcore_client(core.Credentials creds, str region) -> Bedrock_AgentCoreClient:
    return Bedrock_AgentCoreClient(creds=creds, region=region)
