    # Paginator for ListABTests — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: abTests).
    def paginate_list_ab_tests(self, ListABTestsRequest input):
        auto host = endpoints.regional_host(bedrock_agentcore_service(), self.region)
        while True:
            auto raw = self.list_ab_tests(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

