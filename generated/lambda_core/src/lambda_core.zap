    # Paginator for ListNetworkConnectorVersions — yields each Response page, threading the
    # NextMarker -> Marker continuation token until it is absent (result key: NetworkConnectorVersions).
    def paginate_list_network_connector_versions(self, ListNetworkConnectorVersionsRequest input):
        auto host = endpoints.regional_host(lambda__service(), self.region)
        while True:
            auto raw = self.list_network_connector_versions(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextMarker")
            if not np.has_more:
                break
            input.Marker = Optional.Some(np.token)

