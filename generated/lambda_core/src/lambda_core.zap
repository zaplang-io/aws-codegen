# --- errors ----------------------------------------------------------------

# Typed service errors (#361): the per-service enum + classifier + name
# dispatcher emitted on top of `aws_core.errors` (DECISIONS.md D-0006). One
# bare variant per modeled error shape, plus an open-enum `Unknown(str code)`
# catch-all, so a caller built against this model keeps working when the
# service adds an error. The raw wire code is
# the restJson1 X-Amzn-ErrorType header or body `__type`.
# `errors.error_code` normalizes it to the bare shape name before matching;
# the base carrier, the X-Amzn-ErrorType fallback and the raise/check bridge
# are inherited from `aws_core.errors` and not re-emitted here.
enum Lambda_CoreErrorKind:
    InvalidParameterValueException
    NetworkConnectorLimitExceededException
    ResourceConflictException
    ResourceNotFoundException
    ServiceException
    ServiceQuotaExceededException
    TooManyRequestsException
    Unknown(str code)

# Classify an AWS error code into `Lambda_CoreErrorKind`,
# normalizing first (`errors.error_code` strips any namespace/suffix) then
# matching by name; an unmodeled code becomes `Unknown(name)`, carrying it.
def lambda__error_kind(str code) -> Lambda_CoreErrorKind:
    auto name = errors.error_code(code)
    if name == "InvalidParameterValueException":
        return Lambda_CoreErrorKind.InvalidParameterValueException
    if name == "NetworkConnectorLimitExceededException":
        return Lambda_CoreErrorKind.NetworkConnectorLimitExceededException
    if name == "ResourceConflictException":
        return Lambda_CoreErrorKind.ResourceConflictException
    if name == "ResourceNotFoundException":
        return Lambda_CoreErrorKind.ResourceNotFoundException
    if name == "ServiceException":
        return Lambda_CoreErrorKind.ServiceException
    if name == "ServiceQuotaExceededException":
        return Lambda_CoreErrorKind.ServiceQuotaExceededException
    if name == "TooManyRequestsException":
        return Lambda_CoreErrorKind.TooManyRequestsException
    return Lambda_CoreErrorKind.Unknown(name)

# The canonical name of a classified error. This `match` is exhaustive over
# every variant (the compiler enforces it, so a new variant forces it to be
# updated — the generator emits the enum and dispatcher together) and is
# module-local, so each pattern is a two-segment `Enum.Variant` — the portable
# form until the compiler resolves module-qualified variant patterns in a
# caller's own `match` (DECISIONS.md D-0006). `Unknown` carries its code.
def lambda__error_name(Lambda_CoreErrorKind k) -> str:
    match k:
        case Lambda_CoreErrorKind.InvalidParameterValueException:
            return "InvalidParameterValueException"
        case Lambda_CoreErrorKind.NetworkConnectorLimitExceededException:
            return "NetworkConnectorLimitExceededException"
        case Lambda_CoreErrorKind.ResourceConflictException:
            return "ResourceConflictException"
        case Lambda_CoreErrorKind.ResourceNotFoundException:
            return "ResourceNotFoundException"
        case Lambda_CoreErrorKind.ServiceException:
            return "ServiceException"
        case Lambda_CoreErrorKind.ServiceQuotaExceededException:
            return "ServiceQuotaExceededException"
        case Lambda_CoreErrorKind.TooManyRequestsException:
            return "TooManyRequestsException"
        case Lambda_CoreErrorKind.Unknown(c):
            return "Unknown(" + c + ")"

