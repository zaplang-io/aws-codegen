    # Paginator for ListDashboards — yields each Response page, threading the
    # nextToken -> nextToken continuation token until the output token is absent (result key: dashboards).
    def paginate_list_dashboards(self, ListDashboardsRequest input):
        auto host = endpoints.regional_host(bcm_dashboards_protocol().service, self.region)
        while True:
            auto body = input.to_json()
            auto raw = awsjson.awsjson_request_now(bcm_dashboards_protocol(), self.creds, self.region, "ListDashboards", body)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

    # Paginator for ListScheduledReports — yields each Response page, threading the
    # nextToken -> nextToken continuation token until the output token is absent (result key: scheduledReports).
    def paginate_list_scheduled_reports(self, ListScheduledReportsRequest input):
        auto host = endpoints.regional_host(bcm_dashboards_protocol().service, self.region)
        while True:
            auto body = input.to_json()
            auto raw = awsjson.awsjson_request_now(bcm_dashboards_protocol(), self.creds, self.region, "ListScheduledReports", body)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

# Construct a BCM_DashboardsClient bound to credentials + region.
def bcm_dashboards_client(core.Credentials creds, str region) -> BCM_DashboardsClient:
    return BCM_DashboardsClient(creds=creds, region=region)
