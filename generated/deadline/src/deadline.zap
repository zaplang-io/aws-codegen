# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by deadline_error_from_code.
enum deadlineError:
    AccessDeniedException
    ConflictException
    InternalServerErrorException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def deadline_error_from_code(str code) -> deadlineError:
    if code == "AccessDeniedException":
        return deadlineError.AccessDeniedException
    if code == "ConflictException":
        return deadlineError.ConflictException
    if code == "InternalServerErrorException":
        return deadlineError.InternalServerErrorException
    if code == "ResourceNotFoundException":
        return deadlineError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return deadlineError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return deadlineError.ThrottlingException
    if code == "ValidationException":
        return deadlineError.ValidationException
    return deadlineError.Unknown(code=code)

