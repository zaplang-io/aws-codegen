    list[str] parts = []
    list[str] e0 = []
    for x0 in v.selections:
        e0.append(x0.to_json())
    parts.append("\"selections\":" + deadline_json_arr(e0))
    if v.count.is_some():
        auto u1 = v.count.unwrap()
        parts.append("\"count\":" + u1.to_json())
    return deadline_json_obj(parts)

