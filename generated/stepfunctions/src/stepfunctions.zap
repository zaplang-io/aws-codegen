    # Paginator for GetExecutionHistory — yields each Response page, threading the
    # nextToken -> nextToken continuation token until the output token is absent (result key: events).
    def paginate_get_execution_history(self, GetExecutionHistoryInput input):
        auto host = endpoints.regional_host(states_protocol().service, self.region)
        while True:
            auto body = input.to_json()
            auto raw = awsjson.awsjson_request_now(states_protocol(), self.creds, self.region, "GetExecutionHistory", body)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

