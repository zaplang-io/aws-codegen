# --- errors ----------------------------------------------------------------

# Typed service errors (#361): the per-service enum + classifier + name
# dispatcher emitted on top of `aws_core.errors` (DECISIONS.md D-0006). One
# bare variant per modeled error shape, plus an open-enum `Unknown(str code)`
# catch-all, so a caller built against this model keeps working when the
# service adds an error. The raw wire code is
# the awsJson `__type` / X-Amzn-ErrorType shape name.
# `errors.error_code` normalizes it to the bare shape name before matching;
# the base carrier, the X-Amzn-ErrorType fallback and the raise/check bridge
# are inherited from `aws_core.errors` and not re-emitted here.
enum AthenaErrorKind:
    InternalServerException
    InvalidRequestException
    MetadataException
    ResourceNotFoundException
    SessionAlreadyExistsException
    TooManyRequestsException
    Unknown(str code)

# Classify an AWS error code into `AthenaErrorKind`,
# normalizing first (`errors.error_code` strips any namespace/suffix) then
# matching by name; an unmodeled code becomes `Unknown(name)`, carrying it.
def athena_error_kind(str code) -> AthenaErrorKind:
    auto name = errors.error_code(code)
    if name == "InternalServerException":
        return AthenaErrorKind.InternalServerException
    if name == "InvalidRequestException":
        return AthenaErrorKind.InvalidRequestException
    if name == "MetadataException":
        return AthenaErrorKind.MetadataException
    if name == "ResourceNotFoundException":
        return AthenaErrorKind.ResourceNotFoundException
    if name == "SessionAlreadyExistsException":
        return AthenaErrorKind.SessionAlreadyExistsException
    if name == "TooManyRequestsException":
        return AthenaErrorKind.TooManyRequestsException
    return AthenaErrorKind.Unknown(name)

# The canonical name of a classified error. This `match` is exhaustive over
# every variant (the compiler enforces it, so a new variant forces it to be
# updated — the generator emits the enum and dispatcher together) and is
# module-local, so each pattern is a two-segment `Enum.Variant` — the portable
# form until the compiler resolves module-qualified variant patterns in a
# caller's own `match` (DECISIONS.md D-0006). `Unknown` carries its code.
def athena_error_name(AthenaErrorKind k) -> str:
    match k:
        case AthenaErrorKind.InternalServerException:
            return "InternalServerException"
        case AthenaErrorKind.InvalidRequestException:
            return "InvalidRequestException"
        case AthenaErrorKind.MetadataException:
            return "MetadataException"
        case AthenaErrorKind.ResourceNotFoundException:
            return "ResourceNotFoundException"
        case AthenaErrorKind.SessionAlreadyExistsException:
            return "SessionAlreadyExistsException"
        case AthenaErrorKind.TooManyRequestsException:
            return "TooManyRequestsException"
        case AthenaErrorKind.Unknown(c):
            return "Unknown(" + c + ")"

# --- client ----------------------------------------------------------------

# JSON body helpers (compact, declaration-order objects): the collection
# serialization @derive(Json) does not emit yet (zaplang-io/zap#424). `_json_str`
# escapes+quotes via the prelude JSON writer; `_json_obj`/`_json_arr` comma-join
# pre-serialized members.
def athena_json_str(str s) -> str:
    return json.dumps(JsonValue.Str(s))

def athena_json_obj(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "{" + body + "}"

def athena_json_arr(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
