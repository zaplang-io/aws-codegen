    # Paginator for GetQueryResults — yields each Response page, threading the
    # NextToken -> NextToken continuation token until the output token is absent (result key: ResultSet.Rows).
    def paginate_get_query_results(self, GetQueryResultsInput input):
        auto host = endpoints.regional_host(athena_protocol().service, self.region)
        while True:
            auto body = input.to_json()
            auto raw = awsjson.awsjson_request_now(athena_protocol(), self.creds, self.region, "GetQueryResults", body)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

