# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by athena_error_from_code.
enum AthenaError:
    InternalServerException
    InvalidRequestException
    MetadataException
    ResourceNotFoundException
    SessionAlreadyExistsException
    TooManyRequestsException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def athena_error_from_code(str code) -> AthenaError:
    if code == "InternalServerException":
        return AthenaError.InternalServerException
    if code == "InvalidRequestException":
        return AthenaError.InvalidRequestException
    if code == "MetadataException":
        return AthenaError.MetadataException
    if code == "ResourceNotFoundException":
        return AthenaError.ResourceNotFoundException
    if code == "SessionAlreadyExistsException":
        return AthenaError.SessionAlreadyExistsException
    if code == "TooManyRequestsException":
        return AthenaError.TooManyRequestsException
    return AthenaError.Unknown(code=code)

