        return MediaStoreError.CorsPolicyNotFoundException
    if code == "InternalServerError":
        return MediaStoreError.InternalServerError
    if code == "LimitExceededException":
        return MediaStoreError.LimitExceededException
    if code == "PolicyNotFoundException":
        return MediaStoreError.PolicyNotFoundException
    return MediaStoreError.Unknown(code=code)

