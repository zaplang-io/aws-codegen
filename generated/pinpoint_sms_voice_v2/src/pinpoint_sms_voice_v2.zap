# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by sms_voice_error_from_code.
enum Pinpoint_SMS_Voice_V2Error:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def sms_voice_error_from_code(str code) -> Pinpoint_SMS_Voice_V2Error:
    if code == "AccessDeniedException":
        return Pinpoint_SMS_Voice_V2Error.AccessDeniedException
    if code == "ConflictException":
        return Pinpoint_SMS_Voice_V2Error.ConflictException
    if code == "InternalServerException":
        return Pinpoint_SMS_Voice_V2Error.InternalServerException
    if code == "ResourceNotFoundException":
        return Pinpoint_SMS_Voice_V2Error.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return Pinpoint_SMS_Voice_V2Error.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return Pinpoint_SMS_Voice_V2Error.ThrottlingException
    if code == "ValidationException":
        return Pinpoint_SMS_Voice_V2Error.ValidationException
    return Pinpoint_SMS_Voice_V2Error.Unknown(code=code)

