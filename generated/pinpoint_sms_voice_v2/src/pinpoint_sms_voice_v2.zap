    # Paginator for DescribeAccountAttributes — yields each Response page, threading the
    # NextToken -> NextToken continuation token until the output token is absent (result key: AccountAttributes).
    def paginate_describe_account_attributes(self, DescribeAccountAttributesRequest input):
