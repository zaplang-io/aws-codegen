    # Paginator for ListDataProtectionSettings — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: dataProtectionSettings).
    def paginate_list_data_protection_settings(self, ListDataProtectionSettingsRequest input):
        auto host = endpoints.regional_host(workspaces_web_service(), self.region)
        while True:
            auto raw = self.list_data_protection_settings(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

