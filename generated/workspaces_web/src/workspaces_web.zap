# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by workspaces_web_error_from_code.
enum WorkSpaces_WebError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    TooManyTagsException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def workspaces_web_error_from_code(str code) -> WorkSpaces_WebError:
    if code == "AccessDeniedException":
        return WorkSpaces_WebError.AccessDeniedException
    if code == "ConflictException":
        return WorkSpaces_WebError.ConflictException
    if code == "InternalServerException":
        return WorkSpaces_WebError.InternalServerException
    if code == "ResourceNotFoundException":
        return WorkSpaces_WebError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return WorkSpaces_WebError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return WorkSpaces_WebError.ThrottlingException
    if code == "TooManyTagsException":
        return WorkSpaces_WebError.TooManyTagsException
    if code == "ValidationException":
        return WorkSpaces_WebError.ValidationException
    return WorkSpaces_WebError.Unknown(code=code)

