    # Paginator for ListChecks — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: checkSummaries).
    def paginate_list_checks(self, ListChecksRequest input):
        auto host = endpoints.regional_host(trustedadvisor_service(), self.region)
        while True:
            auto raw = self.list_checks(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

