# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by billingconductor_error_from_code.
enum billingconductorError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceLimitExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def billingconductor_error_from_code(str code) -> billingconductorError:
    if code == "AccessDeniedException":
        return billingconductorError.AccessDeniedException
    if code == "ConflictException":
        return billingconductorError.ConflictException
    if code == "InternalServerException":
        return billingconductorError.InternalServerException
    if code == "ResourceNotFoundException":
        return billingconductorError.ResourceNotFoundException
    if code == "ServiceLimitExceededException":
        return billingconductorError.ServiceLimitExceededException
    if code == "ThrottlingException":
        return billingconductorError.ThrottlingException
    if code == "ValidationException":
        return billingconductorError.ValidationException
    return billingconductorError.Unknown(code=code)

