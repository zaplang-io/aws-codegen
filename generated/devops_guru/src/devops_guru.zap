# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by devops_guru_error_from_code.
enum DevOps_GuruError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def devops_guru_error_from_code(str code) -> DevOps_GuruError:
    if code == "AccessDeniedException":
        return DevOps_GuruError.AccessDeniedException
    if code == "ConflictException":
        return DevOps_GuruError.ConflictException
    if code == "InternalServerException":
        return DevOps_GuruError.InternalServerException
    if code == "ResourceNotFoundException":
        return DevOps_GuruError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return DevOps_GuruError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return DevOps_GuruError.ThrottlingException
    if code == "ValidationException":
        return DevOps_GuruError.ValidationException
    return DevOps_GuruError.Unknown(code=code)

