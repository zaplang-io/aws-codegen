    # Paginator for ListChannelGroups — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: Items).
    def paginate_list_channel_groups(self, ListChannelGroupsRequest input):
        auto host = endpoints.regional_host(mediapackagev2_service(), self.region)
        while True:
            auto raw = self.list_channel_groups(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

