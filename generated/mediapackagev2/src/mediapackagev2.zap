# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by mediapackagev2_error_from_code.
enum MediaPackageV2Error:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def mediapackagev2_error_from_code(str code) -> MediaPackageV2Error:
    if code == "AccessDeniedException":
        return MediaPackageV2Error.AccessDeniedException
    if code == "ConflictException":
        return MediaPackageV2Error.ConflictException
    if code == "InternalServerException":
        return MediaPackageV2Error.InternalServerException
    if code == "ResourceNotFoundException":
        return MediaPackageV2Error.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return MediaPackageV2Error.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return MediaPackageV2Error.ThrottlingException
    if code == "ValidationException":
        return MediaPackageV2Error.ValidationException
    return MediaPackageV2Error.Unknown(code=code)

