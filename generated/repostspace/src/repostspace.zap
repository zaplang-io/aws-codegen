    # UpdateSpace  PUT /spaces/{spaceId}
    # errors: AccessDeniedException, ConflictException, InternalServerException, ResourceNotFoundException, ThrottlingException, ValidationException
    def update_space(self, UpdateSpaceInput input) -> str:
        auto host = endpoints.regional_host(repostspace_service(), self.region)
        dict[str, str] labels = {}
        labels["spaceId"] = input.spaceId
        auto b = binding.HttpBinding(method="PUT", path_template="/spaces/{spaceId}", labels=labels, greedy_labels={}, query={}, multi_query={}, headers={}, prefix_header_prefix="", prefix_headers={}, payload_kind=binding.PayloadKind.Empty, body="", content_type="")
        list[str] parts = []
        if input.description.is_some():
            auto u0 = input.description.unwrap()
            parts.append("\"description\":" + repostspace_json_str(u0))
        if input.tier.is_some():
            auto u1 = input.tier.unwrap()
            parts.append("\"tier\":" + u1.to_json())
        if input.roleArn.is_some():
            auto u2 = input.roleArn.unwrap()
            parts.append("\"roleArn\":" + repostspace_json_str(u2))
        if input.supportedEmailDomains.is_some():
            auto u3 = input.supportedEmailDomains.unwrap()
            parts.append("\"supportedEmailDomains\":" + supported_email_domains_parameters_to_json(u3))
        auto bp = restjson.rest_json_document(b, repostspace_json_obj(parts))
        return restjson.rest_json_request(self.creds, bp, repostspace_service(), self.region, host)

    # Paginator for ListChannels — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: channels).
    def paginate_list_channels(self, ListChannelsInput input):
        auto host = endpoints.regional_host(repostspace_service(), self.region)
        while True:
            auto raw = self.list_channels(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

    # Paginator for ListSpaces — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: spaces).
    def paginate_list_spaces(self, ListSpacesInput input):
        auto host = endpoints.regional_host(repostspace_service(), self.region)
        while True:
            auto raw = self.list_spaces(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

# Construct a repostspaceClient bound to credentials + region.
def repostspace_client(core.Credentials creds, str region) -> repostspaceClient:
    return repostspaceClient(creds=creds, region=region)
