    # Paginator for ListLinkedWhatsAppBusinessAccounts — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: linkedAccounts).
    def paginate_list_linked_whats_app_business_accounts(self, ListLinkedWhatsAppBusinessAccountsInput input):
        auto host = endpoints.regional_host(social_messaging_service(), self.region)
        while True:
            auto raw = self.list_linked_whats_app_business_accounts(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

