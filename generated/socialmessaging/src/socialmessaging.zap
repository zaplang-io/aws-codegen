# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by social_messaging_error_from_code.
enum SocialMessagingError:
    AccessDeniedByMetaException
    AccessDeniedException
    ConflictException
    DependencyException
    InternalServiceException
    InvalidParametersException
    LimitExceededException
    ResourceNotFoundException
    ThrottledRequestException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def social_messaging_error_from_code(str code) -> SocialMessagingError:
    if code == "AccessDeniedByMetaException":
        return SocialMessagingError.AccessDeniedByMetaException
    if code == "AccessDeniedException":
        return SocialMessagingError.AccessDeniedException
    if code == "ConflictException":
        return SocialMessagingError.ConflictException
    if code == "DependencyException":
        return SocialMessagingError.DependencyException
    if code == "InternalServiceException":
        return SocialMessagingError.InternalServiceException
    if code == "InvalidParametersException":
        return SocialMessagingError.InvalidParametersException
    if code == "LimitExceededException":
        return SocialMessagingError.LimitExceededException
    if code == "ResourceNotFoundException":
        return SocialMessagingError.ResourceNotFoundException
    if code == "ThrottledRequestException":
        return SocialMessagingError.ThrottledRequestException
    if code == "ValidationException":
        return SocialMessagingError.ValidationException
    return SocialMessagingError.Unknown(code=code)

