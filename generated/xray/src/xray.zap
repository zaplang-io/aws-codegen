# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by xray_error_from_code.
enum XRayError:
    InvalidPolicyRevisionIdException
    InvalidRequestException
    LockoutPreventionException
    MalformedPolicyDocumentException
    PolicyCountLimitExceededException
    PolicySizeLimitExceededException
    ResourceNotFoundException
    RuleLimitExceededException
    ThrottledException
    TooManyTagsException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def xray_error_from_code(str code) -> XRayError:
    if code == "InvalidPolicyRevisionIdException":
        return XRayError.InvalidPolicyRevisionIdException
    if code == "InvalidRequestException":
        return XRayError.InvalidRequestException
    if code == "LockoutPreventionException":
        return XRayError.LockoutPreventionException
    if code == "MalformedPolicyDocumentException":
        return XRayError.MalformedPolicyDocumentException
    if code == "PolicyCountLimitExceededException":
        return XRayError.PolicyCountLimitExceededException
    if code == "PolicySizeLimitExceededException":
        return XRayError.PolicySizeLimitExceededException
    if code == "ResourceNotFoundException":
        return XRayError.ResourceNotFoundException
    if code == "RuleLimitExceededException":
        return XRayError.RuleLimitExceededException
    if code == "ThrottledException":
        return XRayError.ThrottledException
    if code == "TooManyTagsException":
        return XRayError.TooManyTagsException
    return XRayError.Unknown(code=code)

