# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by braket_error_from_code.
enum BraketError:
    AccessDeniedException
    ConflictException
    DeviceOfflineException
    DeviceRetiredException
    InternalServiceException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def braket_error_from_code(str code) -> BraketError:
    if code == "AccessDeniedException":
        return BraketError.AccessDeniedException
    if code == "ConflictException":
        return BraketError.ConflictException
    if code == "DeviceOfflineException":
        return BraketError.DeviceOfflineException
    if code == "DeviceRetiredException":
        return BraketError.DeviceRetiredException
    if code == "InternalServiceException":
        return BraketError.InternalServiceException
    if code == "ResourceNotFoundException":
        return BraketError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return BraketError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return BraketError.ThrottlingException
    if code == "ValidationException":
        return BraketError.ValidationException
    return BraketError.Unknown(code=code)

