struct UserJourneySummary:
    str userJourneyId
    str name
    Optional[DateTime] createdAt
    Optional[DateTime] updatedAt

# no @derive(Json): member(s) fieldList: list[ValidationExceptionField] not yet serializable by derive
# (list/map collections — zaplang-io/zap#346 follow-up).
struct ValidationException:
    str message
    Optional[ValidationExceptionReason] reason
    Optional[list[ValidationExceptionField]] fieldList

@derive(Json)
struct ValidationExceptionField:
    str name
    str message

# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by resiliencehub_error_from_code.
enum resiliencehubv2Error:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def resiliencehub_error_from_code(str code) -> resiliencehubv2Error:
    if code == "AccessDeniedException":
        return resiliencehubv2Error.AccessDeniedException
    if code == "ConflictException":
        return resiliencehubv2Error.ConflictException
    if code == "InternalServerException":
        return resiliencehubv2Error.InternalServerException
    if code == "ResourceNotFoundException":
        return resiliencehubv2Error.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return resiliencehubv2Error.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return resiliencehubv2Error.ThrottlingException
    if code == "ValidationException":
        return resiliencehubv2Error.ValidationException
    return resiliencehubv2Error.Unknown(code=code)

