    # Paginator for ListAssertions — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: assertions).
    def paginate_list_assertions(self, ListAssertionsRequest input):
        auto host = endpoints.regional_host(resiliencehub_service(), self.region)
        while True:
            auto raw = self.list_assertions(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
