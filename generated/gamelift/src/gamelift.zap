# --- errors ----------------------------------------------------------------

# Typed service errors (#361): the per-service enum + classifier + name
# dispatcher emitted on top of `aws_core.errors` (DECISIONS.md D-0006). One
# bare variant per modeled error shape, plus an open-enum `Unknown(str code)`
# catch-all, so a caller built against this model keeps working when the
# service adds an error. The raw wire code is
# the smithy-rpc-v2-cbor body `__type`.
# `errors.error_code` normalizes it to the bare shape name before matching;
# the base carrier, the X-Amzn-ErrorType fallback and the raise/check bridge
# are inherited from `aws_core.errors` and not re-emitted here.
enum GameLiftErrorKind:
    ConflictException
    FleetCapacityExceededException
    GameSessionFullException
    IdempotentParameterMismatchException
    InternalServiceException
    InvalidFleetStatusException
    InvalidGameSessionStatusException
    InvalidRequestException
    LimitExceededException
    NotFoundException
    NotReadyException
    OutOfCapacityException
    TaggingFailedException
    TerminalRoutingStrategyException
    UnauthorizedException
    UnsupportedRegionException
    Unknown(str code)

# Classify an AWS error code into `GameLiftErrorKind`,
# normalizing first (`errors.error_code` strips any namespace/suffix) then
# matching by name; an unmodeled code becomes `Unknown(name)`, carrying it.
def gamelift_error_kind(str code) -> GameLiftErrorKind:
    auto name = errors.error_code(code)
    if name == "ConflictException":
        return GameLiftErrorKind.ConflictException
    if name == "FleetCapacityExceededException":
        return GameLiftErrorKind.FleetCapacityExceededException
    if name == "GameSessionFullException":
        return GameLiftErrorKind.GameSessionFullException
    if name == "IdempotentParameterMismatchException":
        return GameLiftErrorKind.IdempotentParameterMismatchException
    if name == "InternalServiceException":
        return GameLiftErrorKind.InternalServiceException
    if name == "InvalidFleetStatusException":
        return GameLiftErrorKind.InvalidFleetStatusException
    if name == "InvalidGameSessionStatusException":
        return GameLiftErrorKind.InvalidGameSessionStatusException
    if name == "InvalidRequestException":
        return GameLiftErrorKind.InvalidRequestException
    if name == "LimitExceededException":
        return GameLiftErrorKind.LimitExceededException
    if name == "NotFoundException":
        return GameLiftErrorKind.NotFoundException
    if name == "NotReadyException":
        return GameLiftErrorKind.NotReadyException
    if name == "OutOfCapacityException":
        return GameLiftErrorKind.OutOfCapacityException
    if name == "TaggingFailedException":
        return GameLiftErrorKind.TaggingFailedException
    if name == "TerminalRoutingStrategyException":
        return GameLiftErrorKind.TerminalRoutingStrategyException
    if name == "UnauthorizedException":
        return GameLiftErrorKind.UnauthorizedException
    if name == "UnsupportedRegionException":
        return GameLiftErrorKind.UnsupportedRegionException
    return GameLiftErrorKind.Unknown(name)

# The canonical name of a classified error. This `match` is exhaustive over
# every variant (the compiler enforces it, so a new variant forces it to be
# updated — the generator emits the enum and dispatcher together) and is
# module-local, so each pattern is a two-segment `Enum.Variant` — the portable
# form until the compiler resolves module-qualified variant patterns in a
# caller's own `match` (DECISIONS.md D-0006). `Unknown` carries its code.
def gamelift_error_name(GameLiftErrorKind k) -> str:
    match k:
        case GameLiftErrorKind.ConflictException:
            return "ConflictException"
        case GameLiftErrorKind.FleetCapacityExceededException:
            return "FleetCapacityExceededException"
        case GameLiftErrorKind.GameSessionFullException:
            return "GameSessionFullException"
        case GameLiftErrorKind.IdempotentParameterMismatchException:
            return "IdempotentParameterMismatchException"
        case GameLiftErrorKind.InternalServiceException:
            return "InternalServiceException"
        case GameLiftErrorKind.InvalidFleetStatusException:
            return "InvalidFleetStatusException"
        case GameLiftErrorKind.InvalidGameSessionStatusException:
            return "InvalidGameSessionStatusException"
        case GameLiftErrorKind.InvalidRequestException:
            return "InvalidRequestException"
        case GameLiftErrorKind.LimitExceededException:
            return "LimitExceededException"
        case GameLiftErrorKind.NotFoundException:
            return "NotFoundException"
        case GameLiftErrorKind.NotReadyException:
            return "NotReadyException"
        case GameLiftErrorKind.OutOfCapacityException:
            return "OutOfCapacityException"
        case GameLiftErrorKind.TaggingFailedException:
            return "TaggingFailedException"
        case GameLiftErrorKind.TerminalRoutingStrategyException:
            return "TerminalRoutingStrategyException"
        case GameLiftErrorKind.UnauthorizedException:
            return "UnauthorizedException"
        case GameLiftErrorKind.UnsupportedRegionException:
            return "UnsupportedRegionException"
        case GameLiftErrorKind.Unknown(c):
            return "Unknown(" + c + ")"

