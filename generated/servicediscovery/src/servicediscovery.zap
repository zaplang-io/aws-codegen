# --- errors ----------------------------------------------------------------

# Typed service errors (#361): the per-service enum + classifier + name
# dispatcher emitted on top of `aws_core.errors` (DECISIONS.md D-0006). One
# bare variant per modeled error shape, plus an open-enum `Unknown(str code)`
# catch-all, so a caller built against this model keeps working when the
# service adds an error. The raw wire code is
# the awsJson `__type` / X-Amzn-ErrorType shape name.
# `errors.error_code` normalizes it to the bare shape name before matching;
# the base carrier, the X-Amzn-ErrorType fallback and the raise/check bridge
# are inherited from `aws_core.errors` and not re-emitted here.
enum ServiceDiscoveryErrorKind:
    CustomHealthNotFound
    DuplicateRequest
    InstanceNotFound
    InvalidInput
    NamespaceAlreadyExists
    NamespaceNotFound
    OperationNotFound
    RequestLimitExceeded
    ResourceInUse
    ResourceLimitExceeded
    ResourceNotFoundException
    ServiceAlreadyExists
    ServiceAttributesLimitExceededException
    ServiceNotFound
    TooManyTagsException
    Unknown(str code)

# Classify an AWS error code into `ServiceDiscoveryErrorKind`,
# normalizing first (`errors.error_code` strips any namespace/suffix) then
# matching by name; an unmodeled code becomes `Unknown(name)`, carrying it.
def servicediscovery_error_kind(str code) -> ServiceDiscoveryErrorKind:
    auto name = errors.error_code(code)
    if name == "CustomHealthNotFound":
        return ServiceDiscoveryErrorKind.CustomHealthNotFound
    if name == "DuplicateRequest":
        return ServiceDiscoveryErrorKind.DuplicateRequest
    if name == "InstanceNotFound":
        return ServiceDiscoveryErrorKind.InstanceNotFound
    if name == "InvalidInput":
        return ServiceDiscoveryErrorKind.InvalidInput
    if name == "NamespaceAlreadyExists":
        return ServiceDiscoveryErrorKind.NamespaceAlreadyExists
    if name == "NamespaceNotFound":
        return ServiceDiscoveryErrorKind.NamespaceNotFound
    if name == "OperationNotFound":
        return ServiceDiscoveryErrorKind.OperationNotFound
    if name == "RequestLimitExceeded":
        return ServiceDiscoveryErrorKind.RequestLimitExceeded
    if name == "ResourceInUse":
        return ServiceDiscoveryErrorKind.ResourceInUse
    if name == "ResourceLimitExceeded":
        return ServiceDiscoveryErrorKind.ResourceLimitExceeded
    if name == "ResourceNotFoundException":
        return ServiceDiscoveryErrorKind.ResourceNotFoundException
    if name == "ServiceAlreadyExists":
        return ServiceDiscoveryErrorKind.ServiceAlreadyExists
    if name == "ServiceAttributesLimitExceededException":
        return ServiceDiscoveryErrorKind.ServiceAttributesLimitExceededException
    if name == "ServiceNotFound":
        return ServiceDiscoveryErrorKind.ServiceNotFound
    if name == "TooManyTagsException":
        return ServiceDiscoveryErrorKind.TooManyTagsException
    return ServiceDiscoveryErrorKind.Unknown(name)

# The canonical name of a classified error. This `match` is exhaustive over
# every variant (the compiler enforces it, so a new variant forces it to be
# updated — the generator emits the enum and dispatcher together) and is
# module-local, so each pattern is a two-segment `Enum.Variant` — the portable
# form until the compiler resolves module-qualified variant patterns in a
# caller's own `match` (DECISIONS.md D-0006). `Unknown` carries its code.
def servicediscovery_error_name(ServiceDiscoveryErrorKind k) -> str:
    match k:
        case ServiceDiscoveryErrorKind.CustomHealthNotFound:
            return "CustomHealthNotFound"
        case ServiceDiscoveryErrorKind.DuplicateRequest:
            return "DuplicateRequest"
        case ServiceDiscoveryErrorKind.InstanceNotFound:
            return "InstanceNotFound"
        case ServiceDiscoveryErrorKind.InvalidInput:
            return "InvalidInput"
        case ServiceDiscoveryErrorKind.NamespaceAlreadyExists:
            return "NamespaceAlreadyExists"
        case ServiceDiscoveryErrorKind.NamespaceNotFound:
            return "NamespaceNotFound"
        case ServiceDiscoveryErrorKind.OperationNotFound:
            return "OperationNotFound"
        case ServiceDiscoveryErrorKind.RequestLimitExceeded:
            return "RequestLimitExceeded"
        case ServiceDiscoveryErrorKind.ResourceInUse:
            return "ResourceInUse"
        case ServiceDiscoveryErrorKind.ResourceLimitExceeded:
            return "ResourceLimitExceeded"
        case ServiceDiscoveryErrorKind.ResourceNotFoundException:
            return "ResourceNotFoundException"
        case ServiceDiscoveryErrorKind.ServiceAlreadyExists:
            return "ServiceAlreadyExists"
        case ServiceDiscoveryErrorKind.ServiceAttributesLimitExceededException:
            return "ServiceAttributesLimitExceededException"
        case ServiceDiscoveryErrorKind.ServiceNotFound:
            return "ServiceNotFound"
        case ServiceDiscoveryErrorKind.TooManyTagsException:
            return "TooManyTagsException"
        case ServiceDiscoveryErrorKind.Unknown(c):
            return "Unknown(" + c + ")"

# --- client ----------------------------------------------------------------

# JSON body helpers (compact, declaration-order objects): the collection
# serialization @derive(Json) does not emit yet (zaplang-io/zap#424). `_json_str`
# escapes+quotes via the prelude JSON writer; `_json_obj`/`_json_arr` comma-join
# pre-serialized members.
def servicediscovery_json_str(str s) -> str:
    return json.dumps(JsonValue.Str(s))

def servicediscovery_json_obj(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "{" + body + "}"

def servicediscovery_json_arr(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "[" + body + "]"

