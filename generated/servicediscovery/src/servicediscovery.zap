# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by servicediscovery_error_from_code.
enum ServiceDiscoveryError:
    CustomHealthNotFound
    DuplicateRequest
    InstanceNotFound
    InvalidInput
    NamespaceAlreadyExists
    NamespaceNotFound
    OperationNotFound
    RequestLimitExceeded
    ResourceInUse
    ResourceLimitExceeded
    ResourceNotFoundException
    ServiceAlreadyExists
    ServiceAttributesLimitExceededException
    ServiceNotFound
    TooManyTagsException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def servicediscovery_error_from_code(str code) -> ServiceDiscoveryError:
    if code == "CustomHealthNotFound":
        return ServiceDiscoveryError.CustomHealthNotFound
    if code == "DuplicateRequest":
        return ServiceDiscoveryError.DuplicateRequest
    if code == "InstanceNotFound":
        return ServiceDiscoveryError.InstanceNotFound
    if code == "InvalidInput":
        return ServiceDiscoveryError.InvalidInput
    if code == "NamespaceAlreadyExists":
        return ServiceDiscoveryError.NamespaceAlreadyExists
    if code == "NamespaceNotFound":
        return ServiceDiscoveryError.NamespaceNotFound
    if code == "OperationNotFound":
        return ServiceDiscoveryError.OperationNotFound
    if code == "RequestLimitExceeded":
        return ServiceDiscoveryError.RequestLimitExceeded
    if code == "ResourceInUse":
        return ServiceDiscoveryError.ResourceInUse
    if code == "ResourceLimitExceeded":
        return ServiceDiscoveryError.ResourceLimitExceeded
    if code == "ResourceNotFoundException":
        return ServiceDiscoveryError.ResourceNotFoundException
    if code == "ServiceAlreadyExists":
        return ServiceDiscoveryError.ServiceAlreadyExists
    if code == "ServiceAttributesLimitExceededException":
        return ServiceDiscoveryError.ServiceAttributesLimitExceededException
    if code == "ServiceNotFound":
        return ServiceDiscoveryError.ServiceNotFound
    if code == "TooManyTagsException":
        return ServiceDiscoveryError.TooManyTagsException
    return ServiceDiscoveryError.Unknown(code=code)

