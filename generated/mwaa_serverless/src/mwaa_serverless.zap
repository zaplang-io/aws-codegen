    # Paginator for ListTaskInstances — yields each Response page, threading the
    # NextToken -> NextToken continuation token until the output token is absent (result key: TaskInstances).
    def paginate_list_task_instances(self, ListTaskInstancesRequest input):
        auto host = endpoints.regional_host(airflow_serverless_protocol().service, self.region)
        while True:
            auto body = input.to_json()
            auto raw = awsjson.awsjson_request_now(airflow_serverless_protocol(), self.creds, self.region, "ListTaskInstances", body)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

