# Construct a WorkSpaces_Thin_ClientClient bound to credentials + region.
def thinclient_client(core.Credentials creds, str region) -> WorkSpaces_Thin_ClientClient:
    return WorkSpaces_Thin_ClientClient(creds=creds, region=region)
