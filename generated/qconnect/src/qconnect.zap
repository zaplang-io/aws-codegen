# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by wisdom_error_from_code.
enum QConnectError:
    AccessDeniedException
    ConflictException
    DependencyFailedException
    PreconditionFailedException
    RequestTimeoutException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    TooManyTagsException
    UnauthorizedException
    UnprocessableContentException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def wisdom_error_from_code(str code) -> QConnectError:
    if code == "AccessDeniedException":
        return QConnectError.AccessDeniedException
    if code == "ConflictException":
        return QConnectError.ConflictException
    if code == "DependencyFailedException":
        return QConnectError.DependencyFailedException
    if code == "PreconditionFailedException":
        return QConnectError.PreconditionFailedException
    if code == "RequestTimeoutException":
        return QConnectError.RequestTimeoutException
    if code == "ResourceNotFoundException":
        return QConnectError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return QConnectError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return QConnectError.ThrottlingException
    if code == "TooManyTagsException":
        return QConnectError.TooManyTagsException
    if code == "UnauthorizedException":
        return QConnectError.UnauthorizedException
    if code == "UnprocessableContentException":
        return QConnectError.UnprocessableContentException
    if code == "ValidationException":
        return QConnectError.ValidationException
    return QConnectError.Unknown(code=code)

