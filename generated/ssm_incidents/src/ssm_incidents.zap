# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by ssm_incidents_error_from_code.
enum SSM_IncidentsError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def ssm_incidents_error_from_code(str code) -> SSM_IncidentsError:
    if code == "AccessDeniedException":
        return SSM_IncidentsError.AccessDeniedException
    if code == "ConflictException":
        return SSM_IncidentsError.ConflictException
    if code == "InternalServerException":
        return SSM_IncidentsError.InternalServerException
    if code == "ResourceNotFoundException":
        return SSM_IncidentsError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return SSM_IncidentsError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return SSM_IncidentsError.ThrottlingException
    if code == "ValidationException":
        return SSM_IncidentsError.ValidationException
    return SSM_IncidentsError.Unknown(code=code)

