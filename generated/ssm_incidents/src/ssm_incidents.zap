            auto raw = self.list_replication_sets(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

    # Paginator for ListResponsePlans — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: responsePlanSummaries).
    def paginate_list_response_plans(self, ListResponsePlansInput input):
        auto host = endpoints.regional_host(ssm_incidents_service(), self.region)
        while True:
            auto raw = self.list_response_plans(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

    # Paginator for ListTimelineEvents — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: eventSummaries).
    def paginate_list_timeline_events(self, ListTimelineEventsInput input):
        auto host = endpoints.regional_host(ssm_incidents_service(), self.region)
        while True:
            auto raw = self.list_timeline_events(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

# Construct a SSM_IncidentsClient bound to credentials + region.
def ssm_incidents_client(core.Credentials creds, str region) -> SSM_IncidentsClient:
    return SSM_IncidentsClient(creds=creds, region=region)
