    # Paginator for GetResourcePolicies — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: resourcePolicies).
    def paginate_get_resource_policies(self, GetResourcePoliciesInput input):
        auto host = endpoints.regional_host(ssm_incidents_service(), self.region)
        while True:
            auto raw = self.get_resource_policies(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

