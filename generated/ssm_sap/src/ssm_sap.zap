# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by ssm_sap_error_from_code.
enum Ssm_SapError:
    ConflictException
    InternalServerException
    ResourceNotFoundException
    UnauthorizedException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def ssm_sap_error_from_code(str code) -> Ssm_SapError:
    if code == "ConflictException":
        return Ssm_SapError.ConflictException
    if code == "InternalServerException":
        return Ssm_SapError.InternalServerException
    if code == "ResourceNotFoundException":
        return Ssm_SapError.ResourceNotFoundException
    if code == "UnauthorizedException":
        return Ssm_SapError.UnauthorizedException
    if code == "ValidationException":
        return Ssm_SapError.ValidationException
    return Ssm_SapError.Unknown(code=code)

