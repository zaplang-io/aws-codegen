#   ListOperations (document member `Filters: list[Filter]` is not serializable by derive)
#   RegisterApplication (document member `Instances: list[str]` is not serializable by derive)
#   StartConfigurationChecks (document member `ConfigurationCheckIds: list[ConfigurationCheckType]` is not serializable by derive)
#   TagResource (document member `tags: dict[str, str]` is not serializable by derive)
#   UntagResource (httpQuery `tagKeys` has unsupported type list[str])
#   UpdateApplicationSettings (document member `CredentialsToAddOrUpdate: list[ApplicationCredential]` is not serializable by derive)

# Paginated operations (paginators-1.json) not surfaced — their operation is
# skipped above, or the continuation token is not a simple string field:
#   ListApplications (operation not generated)
#   ListConfigurationCheckOperations (operation not generated)
#   ListOperationEvents (operation not generated)
#   ListOperations (operation not generated)

# Per-operation JSON document bodies (the unbound "document" members of an
# operation's input, serialized with @derive(Json)).

@derive(Json)
struct DeleteResourcePermissionDocument:
    # document members of DeleteResourcePermission
    Optional[str] ActionType
    Optional[str] SourceResourceArn
    str ResourceArn

@derive(Json)
struct DeregisterApplicationDocument:
    # document members of DeregisterApplication
    str ApplicationId

@derive(Json)
struct GetApplicationDocument:
    # document members of GetApplication
    Optional[str] ApplicationId
    Optional[str] ApplicationArn
    Optional[str] AppRegistryArn

@derive(Json)
struct GetComponentDocument:
    # document members of GetComponent
    str ApplicationId
    str ComponentId

@derive(Json)
struct GetConfigurationCheckOperationDocument:
    # document members of GetConfigurationCheckOperation
    str OperationId

@derive(Json)
struct GetDatabaseDocument:
    # document members of GetDatabase
    Optional[str] ApplicationId
    Optional[str] ComponentId
    Optional[str] DatabaseId
    Optional[str] DatabaseArn

@derive(Json)
struct GetOperationDocument:
    # document members of GetOperation
    str OperationId

@derive(Json)
struct GetResourcePermissionDocument:
    # document members of GetResourcePermission
    Optional[str] ActionType
    str ResourceArn

@derive(Json)
struct ListComponentsDocument:
    # document members of ListComponents
    Optional[str] ApplicationId
    Optional[str] NextToken
    Optional[int64] MaxResults

@derive(Json)
struct ListConfigurationCheckDefinitionsDocument:
    # document members of ListConfigurationCheckDefinitions
    Optional[int64] MaxResults
    Optional[str] NextToken

@derive(Json)
struct ListDatabasesDocument:
    # document members of ListDatabases
    Optional[str] ApplicationId
    Optional[str] ComponentId
    Optional[str] NextToken
    Optional[int64] MaxResults

@derive(Json)
struct ListSubCheckResultsDocument:
    # document members of ListSubCheckResults
    str OperationId
    Optional[int64] MaxResults
    Optional[str] NextToken

@derive(Json)
struct ListSubCheckRuleResultsDocument:
    # document members of ListSubCheckRuleResults
    str SubCheckResultId
    Optional[int64] MaxResults
    Optional[str] NextToken

@derive(Json)
struct PutResourcePermissionDocument:
    # document members of PutResourcePermission
    str ActionType
    str SourceResourceArn
    str ResourceArn

@derive(Json)
struct StartApplicationDocument:
    # document members of StartApplication
    str ApplicationId

@derive(Json)
struct StartApplicationRefreshDocument:
    # document members of StartApplicationRefresh
    str ApplicationId

@derive(Json)
struct StopApplicationDocument:
    # document members of StopApplication
    str ApplicationId
    Optional[str] StopConnectedEntity
    Optional[bool] IncludeEc2InstanceShutdown

