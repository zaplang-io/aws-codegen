# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by neptune_graph_error_from_code.
enum Neptune_GraphError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    UnprocessableException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def neptune_graph_error_from_code(str code) -> Neptune_GraphError:
    if code == "AccessDeniedException":
        return Neptune_GraphError.AccessDeniedException
    if code == "ConflictException":
        return Neptune_GraphError.ConflictException
    if code == "InternalServerException":
        return Neptune_GraphError.InternalServerException
    if code == "ResourceNotFoundException":
        return Neptune_GraphError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return Neptune_GraphError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return Neptune_GraphError.ThrottlingException
    if code == "UnprocessableException":
        return Neptune_GraphError.UnprocessableException
    if code == "ValidationException":
        return Neptune_GraphError.ValidationException
    return Neptune_GraphError.Unknown(code=code)

