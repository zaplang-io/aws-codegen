    # Paginator for ListExportTasks — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: tasks).
    def paginate_list_export_tasks(self, ListExportTasksInput input):
        auto host = endpoints.regional_host(neptune_graph_service(), self.region)
        while True:
            auto raw = self.list_export_tasks(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

    # Paginator for ListGraphSnapshots — yields each Response page, threading the
