    # Paginator for ListBackendJobs — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: Jobs).
    def paginate_list_backend_jobs(self, ListBackendJobsRequest input):
        auto host = endpoints.regional_host(amplifybackend_service(), self.region)
        while True:
            auto raw = self.list_backend_jobs(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

# Construct a AmplifyBackendClient bound to credentials + region.
def amplifybackend_client(core.Credentials creds, str region) -> AmplifyBackendClient:
    return AmplifyBackendClient(creds=creds, region=region)
