# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by amplifybackend_error_from_code.
enum AmplifyBackendError:
    BadRequestException
    GatewayTimeoutException
    NotFoundException
    TooManyRequestsException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def amplifybackend_error_from_code(str code) -> AmplifyBackendError:
    if code == "BadRequestException":
        return AmplifyBackendError.BadRequestException
    if code == "GatewayTimeoutException":
        return AmplifyBackendError.GatewayTimeoutException
    if code == "NotFoundException":
        return AmplifyBackendError.NotFoundException
    if code == "TooManyRequestsException":
        return AmplifyBackendError.TooManyRequestsException
    return AmplifyBackendError.Unknown(code=code)

