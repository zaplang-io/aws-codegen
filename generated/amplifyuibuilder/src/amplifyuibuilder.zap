# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by amplifyuibuilder_error_from_code.
enum AmplifyUIBuilderError:
    InternalServerException
    InvalidParameterException
    ResourceConflictException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    UnauthorizedException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def amplifyuibuilder_error_from_code(str code) -> AmplifyUIBuilderError:
    if code == "InternalServerException":
        return AmplifyUIBuilderError.InternalServerException
    if code == "InvalidParameterException":
        return AmplifyUIBuilderError.InvalidParameterException
    if code == "ResourceConflictException":
        return AmplifyUIBuilderError.ResourceConflictException
    if code == "ResourceNotFoundException":
        return AmplifyUIBuilderError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return AmplifyUIBuilderError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return AmplifyUIBuilderError.ThrottlingException
    if code == "UnauthorizedException":
        return AmplifyUIBuilderError.UnauthorizedException
    return AmplifyUIBuilderError.Unknown(code=code)

