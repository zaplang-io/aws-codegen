    Optional[list[VpcLink]] Items
    Optional[str] NextToken

# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by apigateway_error_from_code.
enum ApiGatewayV2Error:
    AccessDeniedException
    BadRequestException
    ConflictException
    NotFoundException
    TooManyRequestsException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def apigateway_error_from_code(str code) -> ApiGatewayV2Error:
    if code == "AccessDeniedException":
        return ApiGatewayV2Error.AccessDeniedException
    if code == "BadRequestException":
        return ApiGatewayV2Error.BadRequestException
    if code == "ConflictException":
        return ApiGatewayV2Error.ConflictException
    if code == "NotFoundException":
        return ApiGatewayV2Error.NotFoundException
    if code == "TooManyRequestsException":
        return ApiGatewayV2Error.TooManyRequestsException
    return ApiGatewayV2Error.Unknown(code=code)

