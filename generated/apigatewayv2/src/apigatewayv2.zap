    # Paginator for GetApis — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: Items).
    def paginate_get_apis(self, GetApisRequest input):
        auto host = endpoints.regional_host(apigateway_service(), self.region)
        while True:
            auto raw = self.get_apis(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

