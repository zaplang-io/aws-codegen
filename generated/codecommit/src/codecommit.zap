    # Paginator for DescribePullRequestEvents — yields each Response page, threading the
    # nextToken -> nextToken continuation token until the output token is absent (result key: pullRequestEvents).
    def paginate_describe_pull_request_events(self, DescribePullRequestEventsInput input):
        auto host = endpoints.regional_host(codecommit_protocol().service, self.region)
        while True:
            auto body = input.to_json()
            auto raw = awsjson.awsjson_request_now(codecommit_protocol(), self.creds, self.region, "DescribePullRequestEvents", body)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

