# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by storagegateway_error_from_code.
enum Storage_GatewayError:
    InternalServerError
    InvalidGatewayRequestException
    ServiceUnavailableError
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def storagegateway_error_from_code(str code) -> Storage_GatewayError:
    if code == "InternalServerError":
        return Storage_GatewayError.InternalServerError
    if code == "InvalidGatewayRequestException":
        return Storage_GatewayError.InvalidGatewayRequestException
    if code == "ServiceUnavailableError":
        return Storage_GatewayError.ServiceUnavailableError
    return Storage_GatewayError.Unknown(code=code)

