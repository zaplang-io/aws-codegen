# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by servicecatalog_error_from_code.
enum Service_CatalogError:
    DuplicateResourceException
    InvalidParametersException
    InvalidStateException
    LimitExceededException
    OperationNotSupportedException
    ResourceInUseException
    ResourceNotFoundException
    TagOptionNotMigratedException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def servicecatalog_error_from_code(str code) -> Service_CatalogError:
    if code == "DuplicateResourceException":
        return Service_CatalogError.DuplicateResourceException
    if code == "InvalidParametersException":
        return Service_CatalogError.InvalidParametersException
    if code == "InvalidStateException":
        return Service_CatalogError.InvalidStateException
    if code == "LimitExceededException":
        return Service_CatalogError.LimitExceededException
    if code == "OperationNotSupportedException":
        return Service_CatalogError.OperationNotSupportedException
    if code == "ResourceInUseException":
        return Service_CatalogError.ResourceInUseException
    if code == "ResourceNotFoundException":
        return Service_CatalogError.ResourceNotFoundException
    if code == "TagOptionNotMigratedException":
        return Service_CatalogError.TagOptionNotMigratedException
    return Service_CatalogError.Unknown(code=code)

