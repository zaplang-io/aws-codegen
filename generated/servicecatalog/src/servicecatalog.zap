# --- errors ----------------------------------------------------------------

# Typed service errors (#361): the per-service enum + classifier + name
# dispatcher emitted on top of `aws_core.errors` (DECISIONS.md D-0006). One
# bare variant per modeled error shape, plus an open-enum `Unknown(str code)`
# catch-all, so a caller built against this model keeps working when the
# service adds an error. The raw wire code is
# the awsJson `__type` / X-Amzn-ErrorType shape name.
# `errors.error_code` normalizes it to the bare shape name before matching;
# the base carrier, the X-Amzn-ErrorType fallback and the raise/check bridge
# are inherited from `aws_core.errors` and not re-emitted here.
enum Service_CatalogErrorKind:
    DuplicateResourceException
    InvalidParametersException
    InvalidStateException
    LimitExceededException
    OperationNotSupportedException
    ResourceInUseException
    ResourceNotFoundException
    TagOptionNotMigratedException
    Unknown(str code)

# Classify an AWS error code into `Service_CatalogErrorKind`,
# normalizing first (`errors.error_code` strips any namespace/suffix) then
# matching by name; an unmodeled code becomes `Unknown(name)`, carrying it.
def servicecatalog_error_kind(str code) -> Service_CatalogErrorKind:
    auto name = errors.error_code(code)
    if name == "DuplicateResourceException":
        return Service_CatalogErrorKind.DuplicateResourceException
    if name == "InvalidParametersException":
        return Service_CatalogErrorKind.InvalidParametersException
    if name == "InvalidStateException":
        return Service_CatalogErrorKind.InvalidStateException
    if name == "LimitExceededException":
        return Service_CatalogErrorKind.LimitExceededException
    if name == "OperationNotSupportedException":
        return Service_CatalogErrorKind.OperationNotSupportedException
    if name == "ResourceInUseException":
        return Service_CatalogErrorKind.ResourceInUseException
    if name == "ResourceNotFoundException":
        return Service_CatalogErrorKind.ResourceNotFoundException
    if name == "TagOptionNotMigratedException":
        return Service_CatalogErrorKind.TagOptionNotMigratedException
    return Service_CatalogErrorKind.Unknown(name)

# The canonical name of a classified error. This `match` is exhaustive over
# every variant (the compiler enforces it, so a new variant forces it to be
# updated — the generator emits the enum and dispatcher together) and is
# module-local, so each pattern is a two-segment `Enum.Variant` — the portable
# form until the compiler resolves module-qualified variant patterns in a
# caller's own `match` (DECISIONS.md D-0006). `Unknown` carries its code.
def servicecatalog_error_name(Service_CatalogErrorKind k) -> str:
    match k:
        case Service_CatalogErrorKind.DuplicateResourceException:
            return "DuplicateResourceException"
        case Service_CatalogErrorKind.InvalidParametersException:
            return "InvalidParametersException"
        case Service_CatalogErrorKind.InvalidStateException:
            return "InvalidStateException"
        case Service_CatalogErrorKind.LimitExceededException:
            return "LimitExceededException"
        case Service_CatalogErrorKind.OperationNotSupportedException:
            return "OperationNotSupportedException"
        case Service_CatalogErrorKind.ResourceInUseException:
            return "ResourceInUseException"
        case Service_CatalogErrorKind.ResourceNotFoundException:
            return "ResourceNotFoundException"
        case Service_CatalogErrorKind.TagOptionNotMigratedException:
            return "TagOptionNotMigratedException"
        case Service_CatalogErrorKind.Unknown(c):
            return "Unknown(" + c + ")"

