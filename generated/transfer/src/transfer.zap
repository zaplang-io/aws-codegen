# no @derive(Json): member(s) OnUpload: list[WorkflowDetail], OnPartialUpload: list[WorkflowDetail] not yet serializable by derive
# (list/map collections — zaplang-io/zap#346 follow-up).
struct WorkflowDetails:
    Optional[list[WorkflowDetail]] OnUpload
    Optional[list[WorkflowDetail]] OnPartialUpload

# no @derive(Json): member(s) TagStepDetails: TagStepDetails not yet serializable by derive
# (list/map collections — zaplang-io/zap#346 follow-up).
struct WorkflowStep:
    Optional[WorkflowStepType] Type
    Optional[CopyStepDetails] CopyStepDetails
    Optional[CustomStepDetails] CustomStepDetails
    Optional[DeleteStepDetails] DeleteStepDetails
    Optional[TagStepDetails] TagStepDetails
    Optional[DecryptStepDetails] DecryptStepDetails

# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by transfer_error_from_code.
enum TransferError:
    AccessDeniedException
    ConflictException
    InternalServiceError
    InvalidNextTokenException
    InvalidRequestException
    ResourceExistsException
    ResourceNotFoundException
    ServiceUnavailableException
    ThrottlingException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def transfer_error_from_code(str code) -> TransferError:
    if code == "AccessDeniedException":
        return TransferError.AccessDeniedException
    if code == "ConflictException":
        return TransferError.ConflictException
    if code == "InternalServiceError":
        return TransferError.InternalServiceError
    if code == "InvalidNextTokenException":
        return TransferError.InvalidNextTokenException
    if code == "InvalidRequestException":
        return TransferError.InvalidRequestException
    if code == "ResourceExistsException":
        return TransferError.ResourceExistsException
    if code == "ResourceNotFoundException":
        return TransferError.ResourceNotFoundException
    if code == "ServiceUnavailableException":
        return TransferError.ServiceUnavailableException
    if code == "ThrottlingException":
        return TransferError.ThrottlingException
    return TransferError.Unknown(code=code)

