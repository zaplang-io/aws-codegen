# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by macie2_error_from_code.
enum Macie2Error:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    UnprocessableEntityException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def macie2_error_from_code(str code) -> Macie2Error:
    if code == "AccessDeniedException":
        return Macie2Error.AccessDeniedException
    if code == "ConflictException":
        return Macie2Error.ConflictException
    if code == "InternalServerException":
        return Macie2Error.InternalServerException
    if code == "ResourceNotFoundException":
        return Macie2Error.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return Macie2Error.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return Macie2Error.ThrottlingException
    if code == "UnprocessableEntityException":
        return Macie2Error.UnprocessableEntityException
    if code == "ValidationException":
        return Macie2Error.ValidationException
    return Macie2Error.Unknown(code=code)

