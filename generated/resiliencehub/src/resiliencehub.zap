# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by resiliencehub_error_from_code.
enum resiliencehubError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def resiliencehub_error_from_code(str code) -> resiliencehubError:
    if code == "AccessDeniedException":
        return resiliencehubError.AccessDeniedException
    if code == "ConflictException":
        return resiliencehubError.ConflictException
    if code == "InternalServerException":
        return resiliencehubError.InternalServerException
    if code == "ResourceNotFoundException":
        return resiliencehubError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return resiliencehubError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return resiliencehubError.ThrottlingException
    if code == "ValidationException":
        return resiliencehubError.ValidationException
    return resiliencehubError.Unknown(code=code)

