# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by groundstation_error_from_code.
enum GroundStationError:
    DependencyException
    InvalidParameterException
    ResourceInUseException
    ResourceLimitExceededException
    ResourceNotFoundException
    ServiceQuotaExceededException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def groundstation_error_from_code(str code) -> GroundStationError:
    if code == "DependencyException":
        return GroundStationError.DependencyException
    if code == "InvalidParameterException":
        return GroundStationError.InvalidParameterException
    if code == "ResourceInUseException":
        return GroundStationError.ResourceInUseException
    if code == "ResourceLimitExceededException":
        return GroundStationError.ResourceLimitExceededException
    if code == "ResourceNotFoundException":
        return GroundStationError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return GroundStationError.ServiceQuotaExceededException
    return GroundStationError.Unknown(code=code)

# --- client ----------------------------------------------------------------

# Operations skipped in v0 (a member type is not yet bindable/serializable —
# a non-string/enum/int URI/query/header, a collection or non-derivable
# document member, or an unsupported httpPayload):
#   CreateConfig (document member `tags: dict[str, str]` is not serializable by derive)
#   CreateDataflowEndpointGroup (document member `endpointDetails: list[EndpointDetails]` is not serializable by derive)
#   CreateDataflowEndpointGroupV2 (document member `endpoints: list[CreateEndpointDetails]` is not serializable by derive)
#   CreateEphemeris (document member `ephemeris: EphemerisData` is not serializable by derive)
#   CreateMissionProfile (document member `dataflowEdges: list[list[str]]` is not serializable by derive)
#   ListContacts (document member `statusList: list[ContactStatus]` is not serializable by derive)
#   ListEphemerides (document member `statusList: list[EphemerisStatus]` is not serializable by derive)
