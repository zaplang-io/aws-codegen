    # Paginator for ListAntennas — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: antennaList).
    def paginate_list_antennas(self, ListAntennasRequest input):
        auto host = endpoints.regional_host(groundstation_service(), self.region)
        while True:
            auto raw = self.list_antennas(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

