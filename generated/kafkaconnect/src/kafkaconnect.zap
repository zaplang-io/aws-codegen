    InternalServerErrorException
    NotFoundException
    ServiceUnavailableException
    TooManyRequestsException
    UnauthorizedException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def kafkaconnect_error_from_code(str code) -> KafkaConnectError:
    if code == "BadRequestException":
        return KafkaConnectError.BadRequestException
    if code == "ConflictException":
        return KafkaConnectError.ConflictException
    if code == "ForbiddenException":
        return KafkaConnectError.ForbiddenException
    if code == "InternalServerErrorException":
        return KafkaConnectError.InternalServerErrorException
    if code == "NotFoundException":
        return KafkaConnectError.NotFoundException
    if code == "ServiceUnavailableException":
        return KafkaConnectError.ServiceUnavailableException
    if code == "TooManyRequestsException":
        return KafkaConnectError.TooManyRequestsException
    if code == "UnauthorizedException":
        return KafkaConnectError.UnauthorizedException
    return KafkaConnectError.Unknown(code=code)

# --- client ----------------------------------------------------------------

# JSON body helpers (compact, declaration-order objects): the collection
# serialization @derive(Json) does not emit yet (zaplang-io/zap#424). `_json_str`
# escapes+quotes via the prelude JSON writer; `_json_obj`/`_json_arr` comma-join
# pre-serialized members.
def kafkaconnect_json_str(str s) -> str:
    return json.dumps(JsonValue.Str(s))

def kafkaconnect_json_obj(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "{" + body + "}"

def kafkaconnect_json_arr(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "[" + body + "]"

# Explicit JSON serializers for document bodies with collection/nested
# members (the @derive(Json) collection follow-up, zaplang-io/zap#424).

# Serialize ApacheKafkaCluster to a compact JSON object (declaration order).
def apache_kafka_cluster_to_json(ApacheKafkaCluster v) -> str:
    list[str] parts = []
    parts.append("\"bootstrapServers\":" + kafkaconnect_json_str(v.bootstrapServers))
    parts.append("\"vpc\":" + vpc_to_json(v.vpc))
    return kafkaconnect_json_obj(parts)

# Serialize KafkaCluster to a compact JSON object (declaration order).
def kafka_cluster_to_json(KafkaCluster v) -> str:
    list[str] parts = []
    parts.append("\"apacheKafkaCluster\":" + apache_kafka_cluster_to_json(v.apacheKafkaCluster))
    return kafkaconnect_json_obj(parts)

# Serialize Vpc to a compact JSON object (declaration order).
def vpc_to_json(Vpc v) -> str:
    list[str] parts = []
    if v.securityGroups.is_some():
        auto u0 = v.securityGroups.unwrap()
        list[str] e1 = []
        for x1 in u0:
            e1.append(kafkaconnect_json_str(x1))
        parts.append("\"securityGroups\":" + kafkaconnect_json_arr(e1))
    list[str] e2 = []
    for x2 in v.subnets:
        e2.append(kafkaconnect_json_str(x2))
    parts.append("\"subnets\":" + kafkaconnect_json_arr(e2))
    return kafkaconnect_json_obj(parts)

# Render a bool bound to a URI/query/header slot as its wire text.
def kafkaconnect_bind_bool(bool b) -> str:
    if b:
        return "true"
    return "false"

