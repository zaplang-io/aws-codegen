    Optional[str] ServiceArn

# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by apprunner_error_from_code.
enum AppRunnerError:
    InternalServiceErrorException
    InvalidRequestException
    InvalidStateException
    ResourceNotFoundException
    ServiceQuotaExceededException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def apprunner_error_from_code(str code) -> AppRunnerError:
    if code == "InternalServiceErrorException":
        return AppRunnerError.InternalServiceErrorException
    if code == "InvalidRequestException":
        return AppRunnerError.InvalidRequestException
    if code == "InvalidStateException":
        return AppRunnerError.InvalidStateException
    if code == "ResourceNotFoundException":
        return AppRunnerError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return AppRunnerError.ServiceQuotaExceededException
    return AppRunnerError.Unknown(code=code)

