    # Paginator for ListAssociatedRoute53HealthChecks — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: HealthCheckIds).
    def paginate_list_associated_route53_health_checks(self, ListAssociatedRoute53HealthChecksRequest input):
        auto host = endpoints.regional_host(route53_recovery_control_config_service(), self.region)
        while True:
            auto raw = self.list_associated_route53_health_checks(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

