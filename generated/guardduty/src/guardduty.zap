# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by guardduty_error_from_code.
enum GuardDutyError:
    AccessDeniedException
    BadRequestException
    ConflictException
    InternalServerErrorException
    ResourceNotFoundException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def guardduty_error_from_code(str code) -> GuardDutyError:
    if code == "AccessDeniedException":
        return GuardDutyError.AccessDeniedException
    if code == "BadRequestException":
        return GuardDutyError.BadRequestException
    if code == "ConflictException":
        return GuardDutyError.ConflictException
    if code == "InternalServerErrorException":
        return GuardDutyError.InternalServerErrorException
    if code == "ResourceNotFoundException":
        return GuardDutyError.ResourceNotFoundException
    return GuardDutyError.Unknown(code=code)

