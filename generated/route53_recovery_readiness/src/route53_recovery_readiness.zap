# Construct a Route53_Recovery_ReadinessClient bound to credentials + region.
def route53_recovery_readiness_client(core.Credentials creds, str region) -> Route53_Recovery_ReadinessClient:
    return Route53_Recovery_ReadinessClient(creds=creds, region=region)
