    # Paginator for GetCellReadinessSummary — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: ReadinessChecks).
    def paginate_get_cell_readiness_summary(self, GetCellReadinessSummaryRequest input):
        auto host = endpoints.regional_host(route53_recovery_readiness_service(), self.region)
        while True:
            auto raw = self.get_cell_readiness_summary(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

