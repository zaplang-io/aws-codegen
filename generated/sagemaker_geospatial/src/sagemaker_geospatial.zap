# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by sagemaker_geospatial_error_from_code.
enum SageMaker_GeospatialError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def sagemaker_geospatial_error_from_code(str code) -> SageMaker_GeospatialError:
    if code == "AccessDeniedException":
        return SageMaker_GeospatialError.AccessDeniedException
    if code == "ConflictException":
        return SageMaker_GeospatialError.ConflictException
    if code == "InternalServerException":
        return SageMaker_GeospatialError.InternalServerException
    if code == "ResourceNotFoundException":
        return SageMaker_GeospatialError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return SageMaker_GeospatialError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return SageMaker_GeospatialError.ThrottlingException
    if code == "ValidationException":
        return SageMaker_GeospatialError.ValidationException
    return SageMaker_GeospatialError.Unknown(code=code)

