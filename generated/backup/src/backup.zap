    # Paginator for ListBackupAccessPoints — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: BackupAccessPoints).
    def paginate_list_backup_access_points(self, ListBackupAccessPointsRequest input):
        auto host = endpoints.regional_host(backup_service(), self.region)
        while True:
            auto raw = self.list_backup_access_points(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
