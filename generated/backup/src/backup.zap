# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by backup_error_from_code.
enum BackupError:
    AlreadyExistsException
    ConflictException
    DependencyFailureException
    InvalidParameterValueException
    InvalidRequestException
    InvalidResourceStateException
    LimitExceededException
    MissingParameterValueException
    ResourceNotFoundException
    ServiceUnavailableException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def backup_error_from_code(str code) -> BackupError:
    if code == "AlreadyExistsException":
        return BackupError.AlreadyExistsException
    if code == "ConflictException":
        return BackupError.ConflictException
    if code == "DependencyFailureException":
        return BackupError.DependencyFailureException
    if code == "InvalidParameterValueException":
        return BackupError.InvalidParameterValueException
    if code == "InvalidRequestException":
        return BackupError.InvalidRequestException
    if code == "InvalidResourceStateException":
        return BackupError.InvalidResourceStateException
    if code == "LimitExceededException":
        return BackupError.LimitExceededException
    if code == "MissingParameterValueException":
        return BackupError.MissingParameterValueException
    if code == "ResourceNotFoundException":
        return BackupError.ResourceNotFoundException
    if code == "ServiceUnavailableException":
        return BackupError.ServiceUnavailableException
    return BackupError.Unknown(code=code)

