    # Paginator for ListApiKeys — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: apiKeys).
    def paginate_list_api_keys(self, ListApiKeysRequest input):
        auto host = endpoints.regional_host(appsync_service(), self.region)
        while True:
            auto raw = self.list_api_keys(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

