# --- errors ----------------------------------------------------------------

# Typed service errors (#361): the per-service enum + classifier + name
# dispatcher emitted on top of `aws_core.errors` (DECISIONS.md D-0006). One
# bare variant per modeled error shape, plus an open-enum `Unknown(str code)`
# catch-all, so a caller built against this model keeps working when the
# service adds an error. The raw wire code is
# the restJson1 X-Amzn-ErrorType header or body `__type`.
# `errors.error_code` normalizes it to the bare shape name before matching;
# the base carrier, the X-Amzn-ErrorType fallback and the raise/check bridge
# are inherited from `aws_core.errors` and not re-emitted here.
enum AppSyncErrorKind:
    AccessDeniedException
    ApiKeyLimitExceededException
    ApiKeyValidityOutOfBoundsException
    ApiLimitExceededException
    BadRequestException
    ConcurrentModificationException
    ConflictException
    GraphQLSchemaException
    InternalFailureException
    LimitExceededException
    NotFoundException
    ServiceQuotaExceededException
    UnauthorizedException
    Unknown(str code)

# Classify an AWS error code into `AppSyncErrorKind`,
# normalizing first (`errors.error_code` strips any namespace/suffix) then
# matching by name; an unmodeled code becomes `Unknown(name)`, carrying it.
def appsync_error_kind(str code) -> AppSyncErrorKind:
    auto name = errors.error_code(code)
    if name == "AccessDeniedException":
        return AppSyncErrorKind.AccessDeniedException
    if name == "ApiKeyLimitExceededException":
        return AppSyncErrorKind.ApiKeyLimitExceededException
    if name == "ApiKeyValidityOutOfBoundsException":
        return AppSyncErrorKind.ApiKeyValidityOutOfBoundsException
    if name == "ApiLimitExceededException":
        return AppSyncErrorKind.ApiLimitExceededException
    if name == "BadRequestException":
        return AppSyncErrorKind.BadRequestException
    if name == "ConcurrentModificationException":
        return AppSyncErrorKind.ConcurrentModificationException
    if name == "ConflictException":
        return AppSyncErrorKind.ConflictException
    if name == "GraphQLSchemaException":
        return AppSyncErrorKind.GraphQLSchemaException
    if name == "InternalFailureException":
        return AppSyncErrorKind.InternalFailureException
    if name == "LimitExceededException":
        return AppSyncErrorKind.LimitExceededException
    if name == "NotFoundException":
        return AppSyncErrorKind.NotFoundException
    if name == "ServiceQuotaExceededException":
        return AppSyncErrorKind.ServiceQuotaExceededException
    if name == "UnauthorizedException":
        return AppSyncErrorKind.UnauthorizedException
    return AppSyncErrorKind.Unknown(name)

# The canonical name of a classified error. This `match` is exhaustive over
# every variant (the compiler enforces it, so a new variant forces it to be
# updated — the generator emits the enum and dispatcher together) and is
# module-local, so each pattern is a two-segment `Enum.Variant` — the portable
# form until the compiler resolves module-qualified variant patterns in a
# caller's own `match` (DECISIONS.md D-0006). `Unknown` carries its code.
def appsync_error_name(AppSyncErrorKind k) -> str:
    match k:
        case AppSyncErrorKind.AccessDeniedException:
            return "AccessDeniedException"
        case AppSyncErrorKind.ApiKeyLimitExceededException:
            return "ApiKeyLimitExceededException"
        case AppSyncErrorKind.ApiKeyValidityOutOfBoundsException:
            return "ApiKeyValidityOutOfBoundsException"
        case AppSyncErrorKind.ApiLimitExceededException:
            return "ApiLimitExceededException"
        case AppSyncErrorKind.BadRequestException:
            return "BadRequestException"
        case AppSyncErrorKind.ConcurrentModificationException:
            return "ConcurrentModificationException"
        case AppSyncErrorKind.ConflictException:
            return "ConflictException"
        case AppSyncErrorKind.GraphQLSchemaException:
            return "GraphQLSchemaException"
        case AppSyncErrorKind.InternalFailureException:
            return "InternalFailureException"
        case AppSyncErrorKind.LimitExceededException:
            return "LimitExceededException"
        case AppSyncErrorKind.NotFoundException:
            return "NotFoundException"
        case AppSyncErrorKind.ServiceQuotaExceededException:
            return "ServiceQuotaExceededException"
        case AppSyncErrorKind.UnauthorizedException:
            return "UnauthorizedException"
        case AppSyncErrorKind.Unknown(c):
            return "Unknown(" + c + ")"

