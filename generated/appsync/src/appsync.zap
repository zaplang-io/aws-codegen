        parts.append("\"functions\":" + appsync_json_arr(e1))
    return appsync_json_obj(parts)

# Render a bool bound to a URI/query/header slot as its wire text.
def appsync_bind_bool(bool b) -> str:
    if b:
        return "true"
    return "false"

