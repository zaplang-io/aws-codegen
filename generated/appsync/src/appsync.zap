# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by appsync_error_from_code.
enum AppSyncError:
    AccessDeniedException
    ApiKeyLimitExceededException
    ApiKeyValidityOutOfBoundsException
    ApiLimitExceededException
    BadRequestException
    ConcurrentModificationException
    ConflictException
    GraphQLSchemaException
    InternalFailureException
    LimitExceededException
    NotFoundException
    ServiceQuotaExceededException
    UnauthorizedException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def appsync_error_from_code(str code) -> AppSyncError:
    if code == "AccessDeniedException":
        return AppSyncError.AccessDeniedException
    if code == "ApiKeyLimitExceededException":
        return AppSyncError.ApiKeyLimitExceededException
    if code == "ApiKeyValidityOutOfBoundsException":
        return AppSyncError.ApiKeyValidityOutOfBoundsException
    if code == "ApiLimitExceededException":
        return AppSyncError.ApiLimitExceededException
    if code == "BadRequestException":
        return AppSyncError.BadRequestException
    if code == "ConcurrentModificationException":
        return AppSyncError.ConcurrentModificationException
    if code == "ConflictException":
        return AppSyncError.ConflictException
    if code == "GraphQLSchemaException":
        return AppSyncError.GraphQLSchemaException
    if code == "InternalFailureException":
        return AppSyncError.InternalFailureException
    if code == "LimitExceededException":
        return AppSyncError.LimitExceededException
    if code == "NotFoundException":
        return AppSyncError.NotFoundException
    if code == "ServiceQuotaExceededException":
        return AppSyncError.ServiceQuotaExceededException
    if code == "UnauthorizedException":
        return AppSyncError.UnauthorizedException
    return AppSyncError.Unknown(code=code)

