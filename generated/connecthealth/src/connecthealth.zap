    # Paginator for ListDomains — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: domains).
    def paginate_list_domains(self, ListDomainsInput input):
        auto host = endpoints.regional_host(health_agent_service(), self.region)
        while True:
            auto raw = self.list_domains(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

    # Paginator for ListSubscriptions — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: subscriptions).
    def paginate_list_subscriptions(self, ListSubscriptionsInput input):
        auto host = endpoints.regional_host(health_agent_service(), self.region)
        while True:
            auto raw = self.list_subscriptions(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

# Construct a ConnectHealthClient bound to credentials + region.
def health_agent_client(core.Credentials creds, str region) -> ConnectHealthClient:
    return ConnectHealthClient(creds=creds, region=region)
