        dict[str, str] query = {}
        if input.status.is_some():
            query["status"] = input.status.unwrap_or("")
        if input.maxResults.is_some():
            query["maxResults"] = str(input.maxResults.unwrap_or(0))
        if input.nextToken.is_some():
            query["nextToken"] = input.nextToken.unwrap_or("")
        auto b = binding.HttpBinding(method="GET", path_template="/domain", labels={}, greedy_labels={}, query=query, headers={}, prefix_header_prefix="", prefix_headers={}, payload_kind=binding.PayloadKind.Empty, body="", content_type="")
        return restjson.rest_json_request(self.creds, b, health_agent_service(), self.region, host)

    # ListSubscriptions  GET /domains/{domainId}/subscriptions
    # errors: AccessDeniedException, InternalServerException, ResourceNotFoundException, ValidationException
    def list_subscriptions(self, ListSubscriptionsInput input) -> str:
        auto host = endpoints.regional_host(health_agent_service(), self.region)
        dict[str, str] labels = {}
        labels["domainId"] = input.domainId
        dict[str, str] query = {}
        if input.maxResults.is_some():
            query["maxResults"] = str(input.maxResults.unwrap_or(0))
        if input.nextToken.is_some():
            query["nextToken"] = input.nextToken.unwrap_or("")
        auto b = binding.HttpBinding(method="GET", path_template="/domains/{domainId}/subscriptions", labels=labels, greedy_labels={}, query=query, headers={}, prefix_header_prefix="", prefix_headers={}, payload_kind=binding.PayloadKind.Empty, body="", content_type="")
        return restjson.rest_json_request(self.creds, b, health_agent_service(), self.region, host)

    # ListTagsForResource  GET /tags/{resourceArn}
    def list_tags_for_resource(self, ListTagsForResourceInput input) -> str:
        auto host = endpoints.regional_host(health_agent_service(), self.region)
        dict[str, str] labels = {}
        labels["resourceArn"] = input.resourceArn
        auto b = binding.HttpBinding(method="GET", path_template="/tags/{resourceArn}", labels=labels, greedy_labels={}, query={}, headers={}, prefix_header_prefix="", prefix_headers={}, payload_kind=binding.PayloadKind.Empty, body="", content_type="")
        return restjson.rest_json_request(self.creds, b, health_agent_service(), self.region, host)

    # Paginator for ListDomains — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: domains).
    def paginate_list_domains(self, ListDomainsInput input):
        auto host = endpoints.regional_host(health_agent_service(), self.region)
        while True:
            auto raw = self.list_domains(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

    # Paginator for ListSubscriptions — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: subscriptions).
    def paginate_list_subscriptions(self, ListSubscriptionsInput input):
        auto host = endpoints.regional_host(health_agent_service(), self.region)
        while True:
            auto raw = self.list_subscriptions(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

# Construct a ConnectHealthClient bound to credentials + region.
def health_agent_client(core.Credentials creds, str region) -> ConnectHealthClient:
    return ConnectHealthClient(creds=creds, region=region)
