# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by health_agent_error_from_code.
enum ConnectHealthError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def health_agent_error_from_code(str code) -> ConnectHealthError:
    if code == "AccessDeniedException":
        return ConnectHealthError.AccessDeniedException
    if code == "ConflictException":
        return ConnectHealthError.ConflictException
    if code == "InternalServerException":
        return ConnectHealthError.InternalServerException
    if code == "ResourceNotFoundException":
        return ConnectHealthError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return ConnectHealthError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return ConnectHealthError.ThrottlingException
    if code == "ValidationException":
        return ConnectHealthError.ValidationException
    return ConnectHealthError.Unknown(code=code)

