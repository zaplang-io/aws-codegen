# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by clouddirectory_error_from_code.
enum CloudDirectoryError:
    AccessDeniedException
    BatchWriteException
    CannotListParentOfRootException
    DirectoryAlreadyExistsException
    DirectoryDeletedException
    DirectoryNotDisabledException
    DirectoryNotEnabledException
    FacetAlreadyExistsException
    FacetInUseException
    FacetNotFoundException
    FacetValidationException
    IncompatibleSchemaException
    IndexedAttributeMissingException
    InternalServiceException
    InvalidArnException
    InvalidAttachmentException
    InvalidFacetUpdateException
    InvalidNextTokenException
    InvalidRuleException
    InvalidSchemaDocException
    InvalidTaggingRequestException
    LimitExceededException
    LinkNameAlreadyInUseException
    NotIndexException
    NotNodeException
    NotPolicyException
    ObjectAlreadyDetachedException
    ObjectNotDetachedException
    ResourceNotFoundException
    RetryableConflictException
    SchemaAlreadyExistsException
    SchemaAlreadyPublishedException
    StillContainsLinksException
    UnsupportedIndexTypeException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def clouddirectory_error_from_code(str code) -> CloudDirectoryError:
    if code == "AccessDeniedException":
        return CloudDirectoryError.AccessDeniedException
    if code == "BatchWriteException":
        return CloudDirectoryError.BatchWriteException
    if code == "CannotListParentOfRootException":
        return CloudDirectoryError.CannotListParentOfRootException
    if code == "DirectoryAlreadyExistsException":
        return CloudDirectoryError.DirectoryAlreadyExistsException
    if code == "DirectoryDeletedException":
        return CloudDirectoryError.DirectoryDeletedException
    if code == "DirectoryNotDisabledException":
        return CloudDirectoryError.DirectoryNotDisabledException
    if code == "DirectoryNotEnabledException":
        return CloudDirectoryError.DirectoryNotEnabledException
    if code == "FacetAlreadyExistsException":
        return CloudDirectoryError.FacetAlreadyExistsException
    if code == "FacetInUseException":
        return CloudDirectoryError.FacetInUseException
    if code == "FacetNotFoundException":
        return CloudDirectoryError.FacetNotFoundException
    if code == "FacetValidationException":
        return CloudDirectoryError.FacetValidationException
    if code == "IncompatibleSchemaException":
        return CloudDirectoryError.IncompatibleSchemaException
    if code == "IndexedAttributeMissingException":
        return CloudDirectoryError.IndexedAttributeMissingException
    if code == "InternalServiceException":
        return CloudDirectoryError.InternalServiceException
    if code == "InvalidArnException":
        return CloudDirectoryError.InvalidArnException
    if code == "InvalidAttachmentException":
        return CloudDirectoryError.InvalidAttachmentException
    if code == "InvalidFacetUpdateException":
        return CloudDirectoryError.InvalidFacetUpdateException
    if code == "InvalidNextTokenException":
        return CloudDirectoryError.InvalidNextTokenException
    if code == "InvalidRuleException":
        return CloudDirectoryError.InvalidRuleException
    if code == "InvalidSchemaDocException":
        return CloudDirectoryError.InvalidSchemaDocException
    if code == "InvalidTaggingRequestException":
        return CloudDirectoryError.InvalidTaggingRequestException
    if code == "LimitExceededException":
        return CloudDirectoryError.LimitExceededException
    if code == "LinkNameAlreadyInUseException":
        return CloudDirectoryError.LinkNameAlreadyInUseException
    if code == "NotIndexException":
        return CloudDirectoryError.NotIndexException
    if code == "NotNodeException":
        return CloudDirectoryError.NotNodeException
    if code == "NotPolicyException":
        return CloudDirectoryError.NotPolicyException
    if code == "ObjectAlreadyDetachedException":
        return CloudDirectoryError.ObjectAlreadyDetachedException
    if code == "ObjectNotDetachedException":
        return CloudDirectoryError.ObjectNotDetachedException
    if code == "ResourceNotFoundException":
        return CloudDirectoryError.ResourceNotFoundException
    if code == "RetryableConflictException":
        return CloudDirectoryError.RetryableConflictException
    if code == "SchemaAlreadyExistsException":
        return CloudDirectoryError.SchemaAlreadyExistsException
    if code == "SchemaAlreadyPublishedException":
        return CloudDirectoryError.SchemaAlreadyPublishedException
    if code == "StillContainsLinksException":
        return CloudDirectoryError.StillContainsLinksException
    if code == "UnsupportedIndexTypeException":
        return CloudDirectoryError.UnsupportedIndexTypeException
    if code == "ValidationException":
        return CloudDirectoryError.ValidationException
    return CloudDirectoryError.Unknown(code=code)

