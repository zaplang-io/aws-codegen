            p = query.query_scalar(p, "TemplateContent", input.TemplateContent.unwrap())
        if input.SuccessRedirectionURL.is_some():
            auto t1 = input.SuccessRedirectionURL.unwrap()
            p = query.query_scalar(p, "SuccessRedirectionURL", t1)
        if input.FailureRedirectionURL.is_some():
            auto t2 = input.FailureRedirectionURL.unwrap()
            p = query.query_scalar(p, "FailureRedirectionURL", t2)
        return query.query_request(self.creds, email_service(), self.region, p)

    # VerifyDomainDkim
    def verify_domain_dkim(self, VerifyDomainDkimRequest input) -> str:
        auto p = query.query_params("VerifyDomainDkim", "2010-12-01")
        p = query.query_scalar(p, "Domain", input.Domain)
        return query.query_request(self.creds, email_service(), self.region, p)

    # VerifyDomainIdentity
    def verify_domain_identity(self, VerifyDomainIdentityRequest input) -> str:
        auto p = query.query_params("VerifyDomainIdentity", "2010-12-01")
        p = query.query_scalar(p, "Domain", input.Domain)
        return query.query_request(self.creds, email_service(), self.region, p)

    # VerifyEmailAddress
    def verify_email_address(self, VerifyEmailAddressRequest input) -> str:
        auto p = query.query_params("VerifyEmailAddress", "2010-12-01")
        p = query.query_scalar(p, "EmailAddress", input.EmailAddress)
        return query.query_request(self.creds, email_service(), self.region, p)

    # VerifyEmailIdentity
    def verify_email_identity(self, VerifyEmailIdentityRequest input) -> str:
        auto p = query.query_params("VerifyEmailIdentity", "2010-12-01")
        p = query.query_scalar(p, "EmailAddress", input.EmailAddress)
        return query.query_request(self.creds, email_service(), self.region, p)

# Construct a SESClient bound to credentials + region.
def email_client(core.Credentials creds, str region) -> SESClient:
    return SESClient(creds=creds, region=region)
