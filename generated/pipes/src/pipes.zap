# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by pipes_error_from_code.
enum PipesError:
    ConflictException
    InternalException
    NotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def pipes_error_from_code(str code) -> PipesError:
    if code == "ConflictException":
        return PipesError.ConflictException
    if code == "InternalException":
        return PipesError.InternalException
    if code == "NotFoundException":
        return PipesError.NotFoundException
    if code == "ServiceQuotaExceededException":
        return PipesError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return PipesError.ThrottlingException
    if code == "ValidationException":
        return PipesError.ValidationException
    return PipesError.Unknown(code=code)

# --- client ----------------------------------------------------------------

# Operations skipped in v0 (a member type is not yet bindable/serializable —
# a non-string/enum/int URI/query/header, a collection or non-derivable
# document member, or an unsupported httpPayload):
#   CreatePipe (document member `SourceParameters: PipeSourceParameters` is not serializable by derive)
#   TagResource (document member `tags: dict[str, str]` is not serializable by derive)
#   UntagResource (httpQuery `tagKeys` has unsupported type list[str])
#   UpdatePipe (document member `SourceParameters: UpdatePipeSourceParameters` is not serializable by derive)

# A bound Pipes client: credentials + region, threaded into every operation.
struct PipesClient:
    core.Credentials creds
    str region

    # DeletePipe  DELETE /v1/pipes/{Name}
    # errors: ConflictException, InternalException, NotFoundException, ThrottlingException, ValidationException
    def delete_pipe(self, DeletePipeRequest input) -> str:
        auto host = endpoints.regional_host(pipes_service(), self.region)
        dict[str, str] labels = {}
        labels["Name"] = input.Name
        auto b = binding.HttpBinding(method="DELETE", path_template="/v1/pipes/{Name}", labels=labels, greedy_labels={}, query={}, headers={}, prefix_header_prefix="", prefix_headers={}, payload_kind=binding.PayloadKind.Empty, body="", content_type="")
        return restjson.rest_json_request(self.creds, b, pipes_service(), self.region, host)

    # DescribePipe  GET /v1/pipes/{Name}
    # errors: InternalException, NotFoundException, ThrottlingException, ValidationException
    def describe_pipe(self, DescribePipeRequest input) -> str:
        auto host = endpoints.regional_host(pipes_service(), self.region)
        dict[str, str] labels = {}
        labels["Name"] = input.Name
        auto b = binding.HttpBinding(method="GET", path_template="/v1/pipes/{Name}", labels=labels, greedy_labels={}, query={}, headers={}, prefix_header_prefix="", prefix_headers={}, payload_kind=binding.PayloadKind.Empty, body="", content_type="")
        return restjson.rest_json_request(self.creds, b, pipes_service(), self.region, host)

    # ListPipes  GET /v1/pipes
    # errors: InternalException, ThrottlingException, ValidationException
    def list_pipes(self, ListPipesRequest input) -> str:
        auto host = endpoints.regional_host(pipes_service(), self.region)
        dict[str, str] query = {}
        if input.NamePrefix.is_some():
            query["NamePrefix"] = input.NamePrefix.unwrap_or("")
        if input.DesiredState.is_some():
            query["DesiredState"] = input.DesiredState.unwrap_or("")
        if input.CurrentState.is_some():
            query["CurrentState"] = input.CurrentState.unwrap_or("")
        if input.SourcePrefix.is_some():
            query["SourcePrefix"] = input.SourcePrefix.unwrap_or("")
        if input.TargetPrefix.is_some():
            query["TargetPrefix"] = input.TargetPrefix.unwrap_or("")
        if input.NextToken.is_some():
            query["NextToken"] = input.NextToken.unwrap_or("")
        if input.Limit.is_some():
            query["Limit"] = str(input.Limit.unwrap_or(0))
        auto b = binding.HttpBinding(method="GET", path_template="/v1/pipes", labels={}, greedy_labels={}, query=query, headers={}, prefix_header_prefix="", prefix_headers={}, payload_kind=binding.PayloadKind.Empty, body="", content_type="")
        return restjson.rest_json_request(self.creds, b, pipes_service(), self.region, host)

    # ListTagsForResource  GET /tags/{resourceArn}
    # errors: InternalException, NotFoundException, ValidationException
    def list_tags_for_resource(self, ListTagsForResourceRequest input) -> str:
        auto host = endpoints.regional_host(pipes_service(), self.region)
        dict[str, str] labels = {}
        labels["resourceArn"] = input.resourceArn
        auto b = binding.HttpBinding(method="GET", path_template="/tags/{resourceArn}", labels=labels, greedy_labels={}, query={}, headers={}, prefix_header_prefix="", prefix_headers={}, payload_kind=binding.PayloadKind.Empty, body="", content_type="")
        return restjson.rest_json_request(self.creds, b, pipes_service(), self.region, host)

    # StartPipe  POST /v1/pipes/{Name}/start
    # errors: ConflictException, InternalException, NotFoundException, ThrottlingException, ValidationException
    def start_pipe(self, StartPipeRequest input) -> str:
        auto host = endpoints.regional_host(pipes_service(), self.region)
        dict[str, str] labels = {}
        labels["Name"] = input.Name
        auto b = binding.HttpBinding(method="POST", path_template="/v1/pipes/{Name}/start", labels=labels, greedy_labels={}, query={}, headers={}, prefix_header_prefix="", prefix_headers={}, payload_kind=binding.PayloadKind.Empty, body="", content_type="")
        return restjson.rest_json_request(self.creds, b, pipes_service(), self.region, host)

    # StopPipe  POST /v1/pipes/{Name}/stop
    # errors: ConflictException, InternalException, NotFoundException, ThrottlingException, ValidationException
    def stop_pipe(self, StopPipeRequest input) -> str:
        auto host = endpoints.regional_host(pipes_service(), self.region)
        dict[str, str] labels = {}
        labels["Name"] = input.Name
        auto b = binding.HttpBinding(method="POST", path_template="/v1/pipes/{Name}/stop", labels=labels, greedy_labels={}, query={}, headers={}, prefix_header_prefix="", prefix_headers={}, payload_kind=binding.PayloadKind.Empty, body="", content_type="")
        return restjson.rest_json_request(self.creds, b, pipes_service(), self.region, host)

    # Paginator for ListPipes — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: Pipes).
    def paginate_list_pipes(self, ListPipesRequest input):
        auto host = endpoints.regional_host(pipes_service(), self.region)
        while True:
            auto raw = self.list_pipes(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

# Construct a PipesClient bound to credentials + region.
def pipes_client(core.Credentials creds, str region) -> PipesClient:
    return PipesClient(creds=creds, region=region)
