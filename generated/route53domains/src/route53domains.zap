# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by route53domains_error_from_code.
enum Route_53_DomainsError:
    DnssecLimitExceeded
    DomainLimitExceeded
    DuplicateRequest
    InvalidInput
    OperationLimitExceeded
    TLDInMaintenance
    TLDRulesViolation
    UnsupportedTLD
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def route53domains_error_from_code(str code) -> Route_53_DomainsError:
    if code == "DnssecLimitExceeded":
        return Route_53_DomainsError.DnssecLimitExceeded
    if code == "DomainLimitExceeded":
        return Route_53_DomainsError.DomainLimitExceeded
    if code == "DuplicateRequest":
        return Route_53_DomainsError.DuplicateRequest
    if code == "InvalidInput":
        return Route_53_DomainsError.InvalidInput
    if code == "OperationLimitExceeded":
        return Route_53_DomainsError.OperationLimitExceeded
    if code == "TLDInMaintenance":
        return Route_53_DomainsError.TLDInMaintenance
    if code == "TLDRulesViolation":
        return Route_53_DomainsError.TLDRulesViolation
    if code == "UnsupportedTLD":
        return Route_53_DomainsError.UnsupportedTLD
