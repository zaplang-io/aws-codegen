# --- errors ----------------------------------------------------------------

# Typed service errors (#361): the per-service enum + classifier + name
# dispatcher emitted on top of `aws_core.errors` (DECISIONS.md D-0006). One
# bare variant per modeled error shape, plus an open-enum `Unknown(str code)`
# catch-all, so a caller built against this model keeps working when the
# service adds an error. The raw wire code is
# the smithy-rpc-v2-cbor body `__type`.
# `errors.error_code` normalizes it to the bare shape name before matching;
# the base carrier, the X-Amzn-ErrorType fallback and the raise/check bridge
# are inherited from `aws_core.errors` and not re-emitted here.
enum Route_53_DomainsErrorKind:
    DnssecLimitExceeded
    DomainLimitExceeded
    DuplicateRequest
    InvalidInput
    OperationLimitExceeded
    TLDInMaintenance
    TLDRulesViolation
    UnsupportedTLD
    Unknown(str code)

# Classify an AWS error code into `Route_53_DomainsErrorKind`,
# normalizing first (`errors.error_code` strips any namespace/suffix) then
# matching by name; an unmodeled code becomes `Unknown(name)`, carrying it.
def route53domains_error_kind(str code) -> Route_53_DomainsErrorKind:
    auto name = errors.error_code(code)
    if name == "DnssecLimitExceeded":
        return Route_53_DomainsErrorKind.DnssecLimitExceeded
    if name == "DomainLimitExceeded":
        return Route_53_DomainsErrorKind.DomainLimitExceeded
    if name == "DuplicateRequest":
        return Route_53_DomainsErrorKind.DuplicateRequest
    if name == "InvalidInput":
        return Route_53_DomainsErrorKind.InvalidInput
    if name == "OperationLimitExceeded":
        return Route_53_DomainsErrorKind.OperationLimitExceeded
    if name == "TLDInMaintenance":
        return Route_53_DomainsErrorKind.TLDInMaintenance
    if name == "TLDRulesViolation":
        return Route_53_DomainsErrorKind.TLDRulesViolation
    if name == "UnsupportedTLD":
        return Route_53_DomainsErrorKind.UnsupportedTLD
    return Route_53_DomainsErrorKind.Unknown(name)

# The canonical name of a classified error. This `match` is exhaustive over
# every variant (the compiler enforces it, so a new variant forces it to be
# updated — the generator emits the enum and dispatcher together) and is
# module-local, so each pattern is a two-segment `Enum.Variant` — the portable
# form until the compiler resolves module-qualified variant patterns in a
# caller's own `match` (DECISIONS.md D-0006). `Unknown` carries its code.
def route53domains_error_name(Route_53_DomainsErrorKind k) -> str:
    match k:
        case Route_53_DomainsErrorKind.DnssecLimitExceeded:
            return "DnssecLimitExceeded"
        case Route_53_DomainsErrorKind.DomainLimitExceeded:
            return "DomainLimitExceeded"
        case Route_53_DomainsErrorKind.DuplicateRequest:
            return "DuplicateRequest"
        case Route_53_DomainsErrorKind.InvalidInput:
            return "InvalidInput"
        case Route_53_DomainsErrorKind.OperationLimitExceeded:
            return "OperationLimitExceeded"
        case Route_53_DomainsErrorKind.TLDInMaintenance:
            return "TLDInMaintenance"
        case Route_53_DomainsErrorKind.TLDRulesViolation:
            return "TLDRulesViolation"
        case Route_53_DomainsErrorKind.UnsupportedTLD:
            return "UnsupportedTLD"
        case Route_53_DomainsErrorKind.Unknown(c):
            return "Unknown(" + c + ")"

