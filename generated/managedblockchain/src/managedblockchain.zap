    # Paginator for ListAccessors — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: Accessors).
    def paginate_list_accessors(self, ListAccessorsInput input):
        auto host = endpoints.regional_host(managedblockchain_service(), self.region)
        while True:
            auto raw = self.list_accessors(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

# Construct a ManagedBlockchainClient bound to credentials + region.
def managedblockchain_client(core.Credentials creds, str region) -> ManagedBlockchainClient:
    return ManagedBlockchainClient(creds=creds, region=region)
