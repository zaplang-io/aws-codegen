        parts.append("\"BS\":" + dynamodb_json_arr(e8))
    if v.M.is_some():
        auto u9 = v.M.unwrap()
        list[str] m10 = []
        for k10 in sorted(u9.keys()):
            m10.append(dynamodb_json_str(k10) + ":" + attribute_value_to_json(u9[k10]))
        parts.append("\"M\":" + dynamodb_json_obj(m10))
    if v.L.is_some():
        auto u11 = v.L.unwrap()
        list[str] e12 = []
        for x12 in u11:
