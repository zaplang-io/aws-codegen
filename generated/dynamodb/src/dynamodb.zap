        parts.append("\"B\":" + dynamodb_json_str(base64.encode(u2)))
    if v.SS.is_some():
        auto u3 = v.SS.unwrap()
        list[str] e4 = []
        for x4 in u3:
            e4.append(dynamodb_json_str(x4))
        parts.append("\"SS\":" + dynamodb_json_arr(e4))
    if v.NS.is_some():
        auto u5 = v.NS.unwrap()
        list[str] e6 = []
        for x6 in u5:
            e6.append(dynamodb_json_str(x6))
        parts.append("\"NS\":" + dynamodb_json_arr(e6))
    if v.BS.is_some():
        auto u7 = v.BS.unwrap()
        list[str] e8 = []
        for x8 in u7:
