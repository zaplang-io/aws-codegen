# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by mgn_error_from_code.
enum mgnError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    UninitializedAccountException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def mgn_error_from_code(str code) -> mgnError:
    if code == "AccessDeniedException":
        return mgnError.AccessDeniedException
    if code == "ConflictException":
        return mgnError.ConflictException
    if code == "InternalServerException":
        return mgnError.InternalServerException
    if code == "ResourceNotFoundException":
        return mgnError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return mgnError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return mgnError.ThrottlingException
    if code == "UninitializedAccountException":
        return mgnError.UninitializedAccountException
    if code == "ValidationException":
        return mgnError.ValidationException
    return mgnError.Unknown(code=code)

