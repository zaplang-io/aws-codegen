# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by entityresolution_error_from_code.
enum EntityResolutionError:
    AccessDeniedException
    ConflictException
    ExceedsLimitException
    InternalServerException
    ResourceNotFoundException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def entityresolution_error_from_code(str code) -> EntityResolutionError:
    if code == "AccessDeniedException":
        return EntityResolutionError.AccessDeniedException
    if code == "ConflictException":
        return EntityResolutionError.ConflictException
    if code == "ExceedsLimitException":
        return EntityResolutionError.ExceedsLimitException
    if code == "InternalServerException":
        return EntityResolutionError.InternalServerException
    if code == "ResourceNotFoundException":
        return EntityResolutionError.ResourceNotFoundException
    if code == "ThrottlingException":
        return EntityResolutionError.ThrottlingException
    if code == "ValidationException":
        return EntityResolutionError.ValidationException
    return EntityResolutionError.Unknown(code=code)

