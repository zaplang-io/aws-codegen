# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by pinpoint_error_from_code.
enum PinpointError:
    BadRequestException
    ConflictException
    ForbiddenException
    InternalServerErrorException
    MethodNotAllowedException
    NotFoundException
    PayloadTooLargeException
    TooManyRequestsException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def pinpoint_error_from_code(str code) -> PinpointError:
    if code == "BadRequestException":
        return PinpointError.BadRequestException
    if code == "ConflictException":
        return PinpointError.ConflictException
    if code == "ForbiddenException":
        return PinpointError.ForbiddenException
    if code == "InternalServerErrorException":
        return PinpointError.InternalServerErrorException
    if code == "MethodNotAllowedException":
        return PinpointError.MethodNotAllowedException
    if code == "NotFoundException":
        return PinpointError.NotFoundException
    if code == "PayloadTooLargeException":
        return PinpointError.PayloadTooLargeException
    if code == "TooManyRequestsException":
        return PinpointError.TooManyRequestsException
    return PinpointError.Unknown(code=code)

