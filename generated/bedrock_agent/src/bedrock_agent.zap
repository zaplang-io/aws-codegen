    # Paginator for ListAgentActionGroups — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: actionGroupSummaries).
    def paginate_list_agent_action_groups(self, ListAgentActionGroupsRequest input):
        auto host = endpoints.regional_host(bedrock_agent_service(), self.region)
        while True:
            auto raw = self.list_agent_action_groups(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

