    # nextToken -> nextToken continuation token until it is absent (result key: knowledgeBaseSummaries).
    def paginate_list_knowledge_bases(self, ListKnowledgeBasesRequest input):
        auto host = endpoints.regional_host(bedrock_agent_service(), self.region)
        while True:
            auto raw = self.list_knowledge_bases(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

