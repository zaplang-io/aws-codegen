# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by bedrock_agent_error_from_code.
enum Bedrock_AgentError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def bedrock_agent_error_from_code(str code) -> Bedrock_AgentError:
    if code == "AccessDeniedException":
        return Bedrock_AgentError.AccessDeniedException
    if code == "ConflictException":
        return Bedrock_AgentError.ConflictException
    if code == "InternalServerException":
        return Bedrock_AgentError.InternalServerException
    if code == "ResourceNotFoundException":
        return Bedrock_AgentError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return Bedrock_AgentError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return Bedrock_AgentError.ThrottlingException
    if code == "ValidationException":
        return Bedrock_AgentError.ValidationException
    return Bedrock_AgentError.Unknown(code=code)

