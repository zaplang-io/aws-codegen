# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by geo_routes_error_from_code.
enum Geo_RoutesError:
    AccessDeniedException
    InternalServerException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def geo_routes_error_from_code(str code) -> Geo_RoutesError:
    if code == "AccessDeniedException":
        return Geo_RoutesError.AccessDeniedException
    if code == "InternalServerException":
        return Geo_RoutesError.InternalServerException
    if code == "ThrottlingException":
        return Geo_RoutesError.ThrottlingException
    if code == "ValidationException":
        return Geo_RoutesError.ValidationException
    return Geo_RoutesError.Unknown(code=code)

