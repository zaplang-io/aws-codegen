    # Paginator for ListDNSViews — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: dnsViews).
    def paginate_list_dns_views(self, ListDNSViewsInput input):
        auto host = endpoints.regional_host(route53globalresolver_service(), self.region)
        while True:
            auto raw = self.list_dns_views(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

