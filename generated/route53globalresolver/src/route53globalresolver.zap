# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by route53globalresolver_error_from_code.
enum Route53GlobalResolverError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def route53globalresolver_error_from_code(str code) -> Route53GlobalResolverError:
    if code == "AccessDeniedException":
        return Route53GlobalResolverError.AccessDeniedException
    if code == "ConflictException":
        return Route53GlobalResolverError.ConflictException
    if code == "InternalServerException":
        return Route53GlobalResolverError.InternalServerException
    if code == "ResourceNotFoundException":
        return Route53GlobalResolverError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return Route53GlobalResolverError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return Route53GlobalResolverError.ThrottlingException
    if code == "ValidationException":
        return Route53GlobalResolverError.ValidationException
    return Route53GlobalResolverError.Unknown(code=code)

