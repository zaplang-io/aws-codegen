# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by cleanrooms_ml_error_from_code.
enum CleanRoomsMLError:
    AccessDeniedException
    ConflictException
    InternalServiceException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def cleanrooms_ml_error_from_code(str code) -> CleanRoomsMLError:
    if code == "AccessDeniedException":
        return CleanRoomsMLError.AccessDeniedException
    if code == "ConflictException":
        return CleanRoomsMLError.ConflictException
    if code == "InternalServiceException":
        return CleanRoomsMLError.InternalServiceException
    if code == "ResourceNotFoundException":
        return CleanRoomsMLError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return CleanRoomsMLError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return CleanRoomsMLError.ThrottlingException
    if code == "ValidationException":
        return CleanRoomsMLError.ValidationException
    return CleanRoomsMLError.Unknown(code=code)

