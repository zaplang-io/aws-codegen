    # Paginator for DescribeTable — yields each Response page, threading the
    # NextToken -> NextToken continuation token until the output token is absent (result key: ColumnList).
    def paginate_describe_table(self, DescribeTableRequest input):
        auto host = endpoints.regional_host(redshift_data_protocol().service, self.region)
        while True:
            auto body = input.to_json()
            auto raw = awsjson.awsjson_request_now(redshift_data_protocol(), self.creds, self.region, "DescribeTable", body)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

