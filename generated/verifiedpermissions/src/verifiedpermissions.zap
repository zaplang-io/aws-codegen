# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by verifiedpermissions_error_from_code.
enum VerifiedPermissionsError:
    AccessDeniedException
    ConflictException
    InternalServerException
    InvalidStateException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    TooManyTagsException
    ValidationException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def verifiedpermissions_error_from_code(str code) -> VerifiedPermissionsError:
    if code == "AccessDeniedException":
        return VerifiedPermissionsError.AccessDeniedException
    if code == "ConflictException":
        return VerifiedPermissionsError.ConflictException
    if code == "InternalServerException":
        return VerifiedPermissionsError.InternalServerException
    if code == "InvalidStateException":
        return VerifiedPermissionsError.InvalidStateException
    if code == "ResourceNotFoundException":
        return VerifiedPermissionsError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return VerifiedPermissionsError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return VerifiedPermissionsError.ThrottlingException
    if code == "TooManyTagsException":
        return VerifiedPermissionsError.TooManyTagsException
    if code == "ValidationException":
        return VerifiedPermissionsError.ValidationException
    return VerifiedPermissionsError.Unknown(code=code)

