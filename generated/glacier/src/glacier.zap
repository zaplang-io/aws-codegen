    # Paginator for ListVaults — yields each Response page, threading the
    # Marker -> marker continuation token until it is absent (result key: VaultList).
    def paginate_list_vaults(self, ListVaultsInput input):
        auto host = endpoints.regional_host(glacier_service(), self.region)
        while True:
            auto raw = self.list_vaults(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "Marker")
            if not np.has_more:
                break
            input.marker = Optional.Some(np.token)

# Construct a GlacierClient bound to credentials + region.
def glacier_client(core.Credentials creds, str region) -> GlacierClient:
    return GlacierClient(creds=creds, region=region)
