# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by glacier_error_from_code.
enum GlacierError:
    InsufficientCapacityException
    InvalidParameterValueException
    LimitExceededException
    MissingParameterValueException
    NoLongerSupportedException
    PolicyEnforcedException
    RequestTimeoutException
    ResourceNotFoundException
    ServiceUnavailableException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def glacier_error_from_code(str code) -> GlacierError:
    if code == "InsufficientCapacityException":
        return GlacierError.InsufficientCapacityException
    if code == "InvalidParameterValueException":
        return GlacierError.InvalidParameterValueException
    if code == "LimitExceededException":
        return GlacierError.LimitExceededException
    if code == "MissingParameterValueException":
        return GlacierError.MissingParameterValueException
    if code == "NoLongerSupportedException":
        return GlacierError.NoLongerSupportedException
    if code == "PolicyEnforcedException":
        return GlacierError.PolicyEnforcedException
    if code == "RequestTimeoutException":
        return GlacierError.RequestTimeoutException
    if code == "ResourceNotFoundException":
        return GlacierError.ResourceNotFoundException
    if code == "ServiceUnavailableException":
        return GlacierError.ServiceUnavailableException
    return GlacierError.Unknown(code=code)

# --- client ----------------------------------------------------------------

# Operations skipped in v0 (a member type is not yet bindable/serializable —
# a non-string/enum/int URI/query/header, a collection or non-derivable
# document member, or an unsupported httpPayload):
#   InitiateJob (httpPayload member `jobParameters` is a non-derivable structure)
#   SetVaultNotifications (httpPayload member `vaultNotificationConfig` is a non-derivable structure)

# JSON body helpers (compact, declaration-order objects): the collection
# serialization @derive(Json) does not emit yet (zaplang-io/zap#424). `_json_str`
# escapes+quotes via the prelude JSON writer; `_json_obj`/`_json_arr` comma-join
# pre-serialized members.
def glacier_json_str(str s) -> str:
    return json.dumps(JsonValue.Str(s))

def glacier_json_obj(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "{" + body + "}"

def glacier_json_arr(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "[" + body + "]"

# Explicit JSON serializers for document bodies with collection/nested
# members (the @derive(Json) collection follow-up, zaplang-io/zap#424).

# Serialize DataRetrievalPolicy to a compact JSON object (declaration order).
def data_retrieval_policy_to_json(DataRetrievalPolicy v) -> str:
    list[str] parts = []
    if v.Rules.is_some():
        auto u0 = v.Rules.unwrap()
        list[str] e1 = []
        for x1 in u0:
            e1.append(x1.to_json())
        parts.append("\"Rules\":" + glacier_json_arr(e1))
    return glacier_json_obj(parts)

# A bound Glacier client: credentials + region, threaded into every operation.
struct GlacierClient:
    core.Credentials creds
    str region

    # AbortMultipartUpload  DELETE /{accountId}/vaults/{vaultName}/multipart-uploads/{uploadId}
    # errors: InvalidParameterValueException, MissingParameterValueException, NoLongerSupportedException, ResourceNotFoundException, ServiceUnavailableException
    def abort_multipart_upload(self, AbortMultipartUploadInput input) -> str:
        auto host = endpoints.regional_host(glacier_service(), self.region)
        dict[str, str] labels = {}
        labels["accountId"] = input.accountId
