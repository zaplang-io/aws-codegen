# A bound Lex_Model_Building_Service client: credentials + region, threaded into every operation.
struct Lex_Model_Building_ServiceClient:
    core.Credentials creds
    str region

    # CreateBotVersion  POST /bots/{name}/versions
    # errors: BadRequestException, ConflictException, InternalFailureException, LimitExceededException, NotFoundException, PreconditionFailedException
    def create_bot_version(self, CreateBotVersionRequest input) -> str:
        auto host = endpoints.regional_host(models_lex_service(), self.region)
