    # Paginator for DescribeReservedElasticsearchInstanceOfferings — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: ReservedElasticsearchInstanceOfferings).
    def paginate_describe_reserved_elasticsearch_instance_offerings(self, DescribeReservedElasticsearchInstanceOfferingsRequest input):
        auto host = endpoints.regional_host(es_service(), self.region)
        while True:
            auto raw = self.describe_reserved_elasticsearch_instance_offerings(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

