# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by es_error_from_code.
enum Elasticsearch_ServiceError:
    AccessDeniedException
    BaseException
    ConflictException
    DisabledOperationException
    InternalException
    InvalidPaginationTokenException
    InvalidTypeException
    LimitExceededException
    ResourceAlreadyExistsException
    ResourceNotFoundException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def es_error_from_code(str code) -> Elasticsearch_ServiceError:
    if code == "AccessDeniedException":
        return Elasticsearch_ServiceError.AccessDeniedException
    if code == "BaseException":
        return Elasticsearch_ServiceError.BaseException
    if code == "ConflictException":
        return Elasticsearch_ServiceError.ConflictException
    if code == "DisabledOperationException":
        return Elasticsearch_ServiceError.DisabledOperationException
    if code == "InternalException":
        return Elasticsearch_ServiceError.InternalException
    if code == "InvalidPaginationTokenException":
        return Elasticsearch_ServiceError.InvalidPaginationTokenException
    if code == "InvalidTypeException":
        return Elasticsearch_ServiceError.InvalidTypeException
    if code == "LimitExceededException":
        return Elasticsearch_ServiceError.LimitExceededException
    if code == "ResourceAlreadyExistsException":
        return Elasticsearch_ServiceError.ResourceAlreadyExistsException
    if code == "ResourceNotFoundException":
        return Elasticsearch_ServiceError.ResourceNotFoundException
    if code == "ValidationException":
        return Elasticsearch_ServiceError.ValidationException
    return Elasticsearch_ServiceError.Unknown(code=code)

