        parts.append("\"Name\":" + u0.to_json())
    if v.Value.is_some():
        auto u1 = v.Value.unwrap()
        list[str] e2 = []
        for x2 in u1:
            e2.append(es_json_str(x2))
        parts.append("\"Value\":" + es_json_arr(e2))
    return es_json_obj(parts)

