    # Paginator for ListAgentContexts — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: items).
    def paginate_list_agent_contexts(self, ListAgentContextsRequest input):
        auto host = endpoints.regional_host(wellarchitected_service(), self.region)
        while True:
            auto raw = self.list_agent_contexts(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

