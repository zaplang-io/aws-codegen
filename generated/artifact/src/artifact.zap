    if code == "ServiceQuotaExceededException":
        return ArtifactError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return ArtifactError.ThrottlingException
    if code == "ValidationException":
        return ArtifactError.ValidationException
    return ArtifactError.Unknown(code=code)

