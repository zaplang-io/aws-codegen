        auto host = endpoints.regional_host(codeguru_security_service(), self.region)
        while True:
            auto raw = self.get_findings(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

    # Paginator for ListScans — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: summaries).
    def paginate_list_scans(self, ListScansRequest input):
        auto host = endpoints.regional_host(codeguru_security_service(), self.region)
        while True:
            auto raw = self.list_scans(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

# Construct a CodeGuru_SecurityClient bound to credentials + region.
def codeguru_security_client(core.Credentials creds, str region) -> CodeGuru_SecurityClient:
    return CodeGuru_SecurityClient(creds=creds, region=region)
