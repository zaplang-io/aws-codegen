# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# smithy-rpc-v2-cbor body `__type` (cbor.cbor_error_type) code by compute_optimizer_error_from_code.
enum Compute_OptimizerError:
    AccessDeniedException
    InternalServerException
    InvalidParameterValueException
    LimitExceededException
    MissingAuthenticationToken
    OptInRequiredException
    ResourceNotFoundException
    ServiceUnavailableException
    ThrottlingException
    Unknown(str code)

# Map a smithy-rpc-v2-cbor error code to a variant. The code is the body's
# `__type` (cbor.cbor_error_type / cbor.cbor_error.code); it is namespaced like
# awsJson (e.g. "com.amazonaws.<svc>#<Name>"), so strip to the bare shape name
# (the text after the last '#') before dispatching.
def compute_optimizer_error_from_code(str code) -> Compute_OptimizerError:
    if code == "AccessDeniedException":
        return Compute_OptimizerError.AccessDeniedException
    if code == "InternalServerException":
        return Compute_OptimizerError.InternalServerException
    if code == "InvalidParameterValueException":
        return Compute_OptimizerError.InvalidParameterValueException
    if code == "LimitExceededException":
        return Compute_OptimizerError.LimitExceededException
    if code == "MissingAuthenticationToken":
        return Compute_OptimizerError.MissingAuthenticationToken
    if code == "OptInRequiredException":
        return Compute_OptimizerError.OptInRequiredException
    if code == "ResourceNotFoundException":
        return Compute_OptimizerError.ResourceNotFoundException
    if code == "ServiceUnavailableException":
        return Compute_OptimizerError.ServiceUnavailableException
    if code == "ThrottlingException":
        return Compute_OptimizerError.ThrottlingException
    return Compute_OptimizerError.Unknown(code=code)

