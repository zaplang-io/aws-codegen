# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by discovery_marketplace_error_from_code.
enum Marketplace_DiscoveryError:
    AccessDeniedException
    InternalServerException
    ResourceNotFoundException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def discovery_marketplace_error_from_code(str code) -> Marketplace_DiscoveryError:
    if code == "AccessDeniedException":
        return Marketplace_DiscoveryError.AccessDeniedException
    if code == "InternalServerException":
        return Marketplace_DiscoveryError.InternalServerException
    if code == "ResourceNotFoundException":
        return Marketplace_DiscoveryError.ResourceNotFoundException
    if code == "ThrottlingException":
        return Marketplace_DiscoveryError.ThrottlingException
    if code == "ValidationException":
        return Marketplace_DiscoveryError.ValidationException
    return Marketplace_DiscoveryError.Unknown(code=code)

