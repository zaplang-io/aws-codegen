    # Marker -> Marker continuation token until it is absent (result key: Principals).
    def paginate_describe_resource_permissions(self, DescribeResourcePermissionsRequest input):
        auto host = endpoints.regional_host(workdocs_service(), self.region)
        while True:
            auto raw = self.describe_resource_permissions(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "Marker")
            if not np.has_more:
                break
            input.Marker = Optional.Some(np.token)

