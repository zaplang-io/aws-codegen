# (zaplang-io/zap#424).
struct UpdateSiteRackPhysicalPropertiesOutput:
    Optional[Site] Site

@derive(Json)
struct ValidationException:
    Optional[str] Message

# no @derive(Json): member(s) SubnetIds: list[str] not derivable (list/map collections);
# serialized (when used in a request) by an explicit `<shape>_to_json`
# (zaplang-io/zap#424).
struct VpcInformation:
    Optional[str] VpcId
    Optional[list[str]] SubnetIds
    Optional[str] VpcEndpointId

# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by outposts_error_from_code.
enum OutpostsError:
    AccessDeniedException
    ConflictException
    InternalServerException
    NotFoundException
    ServiceQuotaExceededException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def outposts_error_from_code(str code) -> OutpostsError:
    if code == "AccessDeniedException":
        return OutpostsError.AccessDeniedException
    if code == "ConflictException":
        return OutpostsError.ConflictException
    if code == "InternalServerException":
        return OutpostsError.InternalServerException
    if code == "NotFoundException":
        return OutpostsError.NotFoundException
    if code == "ServiceQuotaExceededException":
        return OutpostsError.ServiceQuotaExceededException
    if code == "ValidationException":
        return OutpostsError.ValidationException
    return OutpostsError.Unknown(code=code)

# --- client ----------------------------------------------------------------

# Operations skipped in v0 (a member type is not yet bindable/serializable —
# a non-string/enum/int URI/query/header, a collection or non-derivable
# document member, or an unsupported httpPayload):
#   ListAssetInstances (httpQuery `AwsServiceFilter` has unsupported type list[AWSServiceName])
#   ListAssets (httpQuery `StatusFilter` has unsupported type list[AssetState])
#   ListCapacityTasks (httpQuery `CapacityTaskStatusFilter` has unsupported type list[CapacityTaskStatus])
#   ListCatalogItems (httpQuery `ItemClassFilter` has unsupported type list[CatalogItemClass])

# Paginated operations (paginators-1.json) not surfaced — their operation is
# skipped above, or the continuation token is not a simple string field:
#   ListAssetInstances (operation not generated)
#   ListAssets (operation not generated)
#   ListCapacityTasks (operation not generated)
#   ListCatalogItems (operation not generated)

# Per-operation JSON document bodies (the unbound "document" members of an
# operation's input, serialized with @derive(Json)).

@derive(Json)
struct CreateRenewalDocument:
    # document members of CreateRenewal
    PaymentOption PaymentOption
    PaymentTerm PaymentTerm
    str OutpostIdentifier
    Optional[str] ClientToken

@derive(Json)
struct StartConnectionDocument:
    # document members of StartConnection
    Optional[str] DeviceSerialNumber
    str AssetId
    str ClientPublicKey
    int64 NetworkInterfaceDeviceIndex

@derive(Json)
struct StartOutpostDecommissionDocument:
    # document members of StartOutpostDecommission
    Optional[bool] ValidateOnly

@derive(Json)
struct UpdateOutpostDocument:
    # document members of UpdateOutpost
    Optional[str] Name
    Optional[str] Description
    Optional[SupportedHardwareType] SupportedHardwareType

@derive(Json)
struct UpdateSiteDocument:
    # document members of UpdateSite
    Optional[str] Name
    Optional[str] Description
    Optional[str] Notes

@derive(Json)
struct UpdateSiteAddressDocument:
    # document members of UpdateSiteAddress
    AddressType AddressType
    Address Address

@derive(Json)
struct UpdateSiteRackPhysicalPropertiesDocument:
    # document members of UpdateSiteRackPhysicalProperties
    Optional[PowerDrawKva] PowerDrawKva
    Optional[PowerPhase] PowerPhase
    Optional[PowerConnector] PowerConnector
    Optional[PowerFeedDrop] PowerFeedDrop
    Optional[UplinkGbps] UplinkGbps
    Optional[UplinkCount] UplinkCount
    Optional[FiberOpticCableType] FiberOpticCableType
    Optional[OpticalStandard] OpticalStandard
    Optional[MaximumSupportedWeightLbs] MaximumSupportedWeightLbs

# JSON body helpers (compact, declaration-order objects): the collection
# serialization @derive(Json) does not emit yet (zaplang-io/zap#424). `_json_str`
# escapes+quotes via the prelude JSON writer; `_json_obj`/`_json_arr` comma-join
# pre-serialized members.
def outposts_json_str(str s) -> str:
    return json.dumps(JsonValue.Str(s))

def outposts_json_obj(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "{" + body + "}"

def outposts_json_arr(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "[" + body + "]"

# Explicit JSON serializers for document bodies with collection/nested
# members (the @derive(Json) collection follow-up, zaplang-io/zap#424).

# Serialize InstancesToExclude to a compact JSON object (declaration order).
def instances_to_exclude_to_json(InstancesToExclude v) -> str:
    list[str] parts = []
    if v.Instances.is_some():
        auto u0 = v.Instances.unwrap()
        list[str] e1 = []
        for x1 in u0:
            e1.append(outposts_json_str(x1))
        parts.append("\"Instances\":" + outposts_json_arr(e1))
    if v.AccountIds.is_some():
        auto u2 = v.AccountIds.unwrap()
        list[str] e3 = []
        for x3 in u2:
            e3.append(outposts_json_str(x3))
        parts.append("\"AccountIds\":" + outposts_json_arr(e3))
    if v.Services.is_some():
        auto u4 = v.Services.unwrap()
        list[str] e5 = []
        for x5 in u4:
            e5.append(x5.to_json())
        parts.append("\"Services\":" + outposts_json_arr(e5))
    return outposts_json_obj(parts)

# Serialize VpcInformation to a compact JSON object (declaration order).
def vpc_information_to_json(VpcInformation v) -> str:
    list[str] parts = []
    if v.VpcId.is_some():
        auto u0 = v.VpcId.unwrap()
        parts.append("\"VpcId\":" + outposts_json_str(u0))
    if v.SubnetIds.is_some():
