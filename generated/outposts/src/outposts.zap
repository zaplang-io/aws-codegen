            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

    # Paginator for ListOrders — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: Orders).
    def paginate_list_orders(self, ListOrdersInput input):
        auto host = endpoints.regional_host(outposts_service(), self.region)
        while True:
            auto raw = self.list_orders(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

    # Paginator for ListOutposts — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: Outposts).
    def paginate_list_outposts(self, ListOutpostsInput input):
