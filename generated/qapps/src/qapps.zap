    # UpdateQAppSessionMetadata  POST /runtime.updateQAppSessionMetadata
    # errors: AccessDeniedException, InternalServerException, ResourceNotFoundException, ServiceQuotaExceededException, ThrottlingException, UnauthorizedException, ValidationException
    def update_q_app_session_metadata(self, UpdateQAppSessionMetadataInput input) -> str:
        auto host = endpoints.regional_host(data_qapps_service(), self.region)
        dict[str, str] headers = {}
        headers["instance-id"] = input.instanceId
        auto b = binding.HttpBinding(method="POST", path_template="/runtime.updateQAppSessionMetadata", labels={}, greedy_labels={}, query={}, headers=headers, prefix_header_prefix="", prefix_headers={}, payload_kind=binding.PayloadKind.Empty, body="", content_type="")
        auto doc = UpdateQAppSessionMetadataDocument(sessionId=input.sessionId, sessionName=input.sessionName, sharingConfiguration=input.sharingConfiguration)
        auto bp = restjson.rest_json_document(b, doc.to_json())
        return restjson.rest_json_request(self.creds, bp, data_qapps_service(), self.region, host)

    # Paginator for ListLibraryItems — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: libraryItems).
    def paginate_list_library_items(self, ListLibraryItemsInput input):
        auto host = endpoints.regional_host(data_qapps_service(), self.region)
        while True:
            auto raw = self.list_library_items(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

    # Paginator for ListQApps — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: apps).
    def paginate_list_q_apps(self, ListQAppsInput input):
        auto host = endpoints.regional_host(data_qapps_service(), self.region)
        while True:
            auto raw = self.list_q_apps(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

# Construct a QAppsClient bound to credentials + region.
def data_qapps_client(core.Credentials creds, str region) -> QAppsClient:
    return QAppsClient(creds=creds, region=region)
