    parts.append("\"cards\":" + data_qapps_json_arr(e0))
    if v.initialPrompt.is_some():
        auto u1 = v.initialPrompt.unwrap()
        parts.append("\"initialPrompt\":" + data_qapps_json_str(u1))
    return data_qapps_json_obj(parts)

