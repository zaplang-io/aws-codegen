# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by frauddetector_error_from_code.
enum FraudDetectorError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ResourceUnavailableException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def frauddetector_error_from_code(str code) -> FraudDetectorError:
    if code == "AccessDeniedException":
        return FraudDetectorError.AccessDeniedException
    if code == "ConflictException":
        return FraudDetectorError.ConflictException
    if code == "InternalServerException":
        return FraudDetectorError.InternalServerException
    if code == "ResourceNotFoundException":
        return FraudDetectorError.ResourceNotFoundException
    if code == "ResourceUnavailableException":
        return FraudDetectorError.ResourceUnavailableException
    if code == "ThrottlingException":
        return FraudDetectorError.ThrottlingException
    if code == "ValidationException":
        return FraudDetectorError.ValidationException
    return FraudDetectorError.Unknown(code=code)

# --- client ----------------------------------------------------------------

# Operations skipped in v0 (input shape has collection members not yet
# serializable by @derive(Json); pending zaplang-io/zap#346 follow-up):
#   BatchCreateVariable (input BatchCreateVariableRequest)
