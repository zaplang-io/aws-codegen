# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by firehose_error_from_code.
enum FirehoseError:
    ConcurrentModificationException
    InvalidArgumentException
    InvalidKMSResourceException
    InvalidSourceException
    LimitExceededException
    ResourceInUseException
    ResourceNotFoundException
    ServiceUnavailableException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def firehose_error_from_code(str code) -> FirehoseError:
    if code == "ConcurrentModificationException":
        return FirehoseError.ConcurrentModificationException
    if code == "InvalidArgumentException":
        return FirehoseError.InvalidArgumentException
    if code == "InvalidKMSResourceException":
        return FirehoseError.InvalidKMSResourceException
    if code == "InvalidSourceException":
        return FirehoseError.InvalidSourceException
    if code == "LimitExceededException":
        return FirehoseError.LimitExceededException
    if code == "ResourceInUseException":
        return FirehoseError.ResourceInUseException
    if code == "ResourceNotFoundException":
        return FirehoseError.ResourceNotFoundException
    if code == "ServiceUnavailableException":
        return FirehoseError.ServiceUnavailableException
    return FirehoseError.Unknown(code=code)

# --- client ----------------------------------------------------------------

# Operations skipped in v0 (input shape has collection members not yet
# serializable by @derive(Json); pending zaplang-io/zap#346 follow-up):
#   CreateDeliveryStream (input CreateDeliveryStreamInput)
#   PutRecordBatch (input PutRecordBatchInput)
#   TagDeliveryStream (input TagDeliveryStreamInput)
#   UntagDeliveryStream (input UntagDeliveryStreamInput)
#   UpdateDestination (input UpdateDestinationInput)

# A bound Firehose client: credentials + region, threaded into every operation.
struct FirehoseClient:
    core.Credentials creds
    str region

    # DeleteDeliveryStream
    # errors: ResourceInUseException, ResourceNotFoundException
    def delete_delivery_stream(self, DeleteDeliveryStreamInput input) -> str:
        auto body = input.to_json()
        return awsjson.awsjson_request_now(firehose_protocol(), self.creds, self.region, "DeleteDeliveryStream", body)

    # DescribeDeliveryStream
    # errors: ResourceNotFoundException
    def describe_delivery_stream(self, DescribeDeliveryStreamInput input) -> str:
        auto body = input.to_json()
        return awsjson.awsjson_request_now(firehose_protocol(), self.creds, self.region, "DescribeDeliveryStream", body)

    # ListDeliveryStreams
    def list_delivery_streams(self, ListDeliveryStreamsInput input) -> str:
