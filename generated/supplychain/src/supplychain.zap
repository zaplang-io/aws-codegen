    # Paginator for ListDataIntegrationEvents — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: events).
    def paginate_list_data_integration_events(self, ListDataIntegrationEventsRequest input):
        auto host = endpoints.regional_host(scn_service(), self.region)
        while True:
            auto raw = self.list_data_integration_events(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

