    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def scn_error_from_code(str code) -> SupplyChainError:
    if code == "AccessDeniedException":
        return SupplyChainError.AccessDeniedException
    if code == "ConflictException":
        return SupplyChainError.ConflictException
    if code == "InternalServerException":
        return SupplyChainError.InternalServerException
    if code == "ResourceNotFoundException":
        return SupplyChainError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return SupplyChainError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return SupplyChainError.ThrottlingException
    if code == "ValidationException":
        return SupplyChainError.ValidationException
    return SupplyChainError.Unknown(code=code)

