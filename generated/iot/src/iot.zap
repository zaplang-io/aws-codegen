# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by iot_error_from_code.
enum IoTError:
    CertificateConflictException
    CertificateStateException
    CertificateValidationException
    ConflictException
    ConflictingResourceUpdateException
    DeleteConflictException
    IndexNotReadyException
    InternalException
    InternalFailureException
    InternalServerException
    InvalidAggregationException
    InvalidQueryException
    InvalidRequestException
    InvalidResponseException
    InvalidStateTransitionException
    LimitExceededException
    MalformedPolicyException
    NotConfiguredException
    RegistrationCodeValidationException
    ResourceAlreadyExistsException
    ResourceNotFoundException
    ResourceRegistrationFailureException
    ServiceQuotaExceededException
    ServiceUnavailableException
    SqlParseException
    TaskAlreadyExistsException
    ThrottlingException
    TransferAlreadyCompletedException
    TransferConflictException
    UnauthorizedException
    ValidationException
    VersionConflictException
    VersionsLimitExceededException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def iot_error_from_code(str code) -> IoTError:
    if code == "CertificateConflictException":
        return IoTError.CertificateConflictException
    if code == "CertificateStateException":
        return IoTError.CertificateStateException
    if code == "CertificateValidationException":
        return IoTError.CertificateValidationException
    if code == "ConflictException":
        return IoTError.ConflictException
    if code == "ConflictingResourceUpdateException":
        return IoTError.ConflictingResourceUpdateException
    if code == "DeleteConflictException":
        return IoTError.DeleteConflictException
    if code == "IndexNotReadyException":
        return IoTError.IndexNotReadyException
    if code == "InternalException":
        return IoTError.InternalException
    if code == "InternalFailureException":
        return IoTError.InternalFailureException
    if code == "InternalServerException":
        return IoTError.InternalServerException
    if code == "InvalidAggregationException":
        return IoTError.InvalidAggregationException
    if code == "InvalidQueryException":
        return IoTError.InvalidQueryException
    if code == "InvalidRequestException":
        return IoTError.InvalidRequestException
    if code == "InvalidResponseException":
        return IoTError.InvalidResponseException
    if code == "InvalidStateTransitionException":
        return IoTError.InvalidStateTransitionException
    if code == "LimitExceededException":
        return IoTError.LimitExceededException
    if code == "MalformedPolicyException":
        return IoTError.MalformedPolicyException
    if code == "NotConfiguredException":
        return IoTError.NotConfiguredException
    if code == "RegistrationCodeValidationException":
        return IoTError.RegistrationCodeValidationException
    if code == "ResourceAlreadyExistsException":
        return IoTError.ResourceAlreadyExistsException
    if code == "ResourceNotFoundException":
        return IoTError.ResourceNotFoundException
    if code == "ResourceRegistrationFailureException":
        return IoTError.ResourceRegistrationFailureException
    if code == "ServiceQuotaExceededException":
        return IoTError.ServiceQuotaExceededException
    if code == "ServiceUnavailableException":
        return IoTError.ServiceUnavailableException
    if code == "SqlParseException":
        return IoTError.SqlParseException
    if code == "TaskAlreadyExistsException":
        return IoTError.TaskAlreadyExistsException
    if code == "ThrottlingException":
        return IoTError.ThrottlingException
    if code == "TransferAlreadyCompletedException":
        return IoTError.TransferAlreadyCompletedException
    if code == "TransferConflictException":
        return IoTError.TransferConflictException
    if code == "UnauthorizedException":
        return IoTError.UnauthorizedException
    if code == "ValidationException":
        return IoTError.ValidationException
    if code == "VersionConflictException":
        return IoTError.VersionConflictException
    if code == "VersionsLimitExceededException":
        return IoTError.VersionsLimitExceededException
    return IoTError.Unknown(code=code)

