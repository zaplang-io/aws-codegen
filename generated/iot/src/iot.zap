    # nextToken -> nextToken continuation token until it is absent (result key: summaries).
    def paginate_get_behavior_model_training_summaries(self, GetBehaviorModelTrainingSummariesRequest input):
        auto host = endpoints.regional_host(iot_service(), self.region)
        while True:
            auto raw = self.get_behavior_model_training_summaries(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

