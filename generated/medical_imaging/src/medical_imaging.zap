    AccessDeniedException
    BadRequestException
    ConflictException
    InternalServerException
    NotAcceptableException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Classify an AWS error code into `Medical_ImagingErrorKind`,
# normalizing first (`errors.error_code` strips any namespace/suffix) then
# matching by name; an unmodeled code becomes `Unknown(name)`, carrying it.
def medical_imaging_error_kind(str code) -> Medical_ImagingErrorKind:
    auto name = errors.error_code(code)
    if name == "AccessDeniedException":
        return Medical_ImagingErrorKind.AccessDeniedException
    if name == "BadRequestException":
        return Medical_ImagingErrorKind.BadRequestException
    if name == "ConflictException":
        return Medical_ImagingErrorKind.ConflictException
    if name == "InternalServerException":
        return Medical_ImagingErrorKind.InternalServerException
    if name == "NotAcceptableException":
        return Medical_ImagingErrorKind.NotAcceptableException
    if name == "ResourceNotFoundException":
        return Medical_ImagingErrorKind.ResourceNotFoundException
    if name == "ServiceQuotaExceededException":
        return Medical_ImagingErrorKind.ServiceQuotaExceededException
    if name == "ThrottlingException":
        return Medical_ImagingErrorKind.ThrottlingException
    if name == "ValidationException":
        return Medical_ImagingErrorKind.ValidationException
    return Medical_ImagingErrorKind.Unknown(name)

# The canonical name of a classified error. This `match` is exhaustive over
# every variant (the compiler enforces it, so a new variant forces it to be
# updated — the generator emits the enum and dispatcher together) and is
# module-local, so each pattern is a two-segment `Enum.Variant` — the portable
# form until the compiler resolves module-qualified variant patterns in a
# caller's own `match` (DECISIONS.md D-0006). `Unknown` carries its code.
def medical_imaging_error_name(Medical_ImagingErrorKind k) -> str:
    match k:
        case Medical_ImagingErrorKind.AccessDeniedException:
            return "AccessDeniedException"
        case Medical_ImagingErrorKind.BadRequestException:
            return "BadRequestException"
        case Medical_ImagingErrorKind.ConflictException:
            return "ConflictException"
        case Medical_ImagingErrorKind.InternalServerException:
            return "InternalServerException"
        case Medical_ImagingErrorKind.NotAcceptableException:
            return "NotAcceptableException"
        case Medical_ImagingErrorKind.ResourceNotFoundException:
            return "ResourceNotFoundException"
        case Medical_ImagingErrorKind.ServiceQuotaExceededException:
            return "ServiceQuotaExceededException"
        case Medical_ImagingErrorKind.ThrottlingException:
            return "ThrottlingException"
        case Medical_ImagingErrorKind.ValidationException:
            return "ValidationException"
        case Medical_ImagingErrorKind.Unknown(c):
            return "Unknown(" + c + ")"

