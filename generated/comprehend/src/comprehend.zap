# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by comprehend_error_from_code.
enum ComprehendError:
    BatchSizeLimitExceededException
    ConcurrentModificationException
    InternalServerException
    InvalidFilterException
    InvalidRequestException
    JobNotFoundException
    KmsKeyValidationException
    ResourceInUseException
    ResourceLimitExceededException
    ResourceNotFoundException
    ResourceUnavailableException
    TextSizeLimitExceededException
    TooManyRequestsException
    TooManyTagKeysException
    TooManyTagsException
    UnsupportedLanguageException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def comprehend_error_from_code(str code) -> ComprehendError:
    if code == "BatchSizeLimitExceededException":
        return ComprehendError.BatchSizeLimitExceededException
    if code == "ConcurrentModificationException":
        return ComprehendError.ConcurrentModificationException
    if code == "InternalServerException":
        return ComprehendError.InternalServerException
    if code == "InvalidFilterException":
        return ComprehendError.InvalidFilterException
    if code == "InvalidRequestException":
        return ComprehendError.InvalidRequestException
    if code == "JobNotFoundException":
        return ComprehendError.JobNotFoundException
    if code == "KmsKeyValidationException":
        return ComprehendError.KmsKeyValidationException
    if code == "ResourceInUseException":
        return ComprehendError.ResourceInUseException
    if code == "ResourceLimitExceededException":
        return ComprehendError.ResourceLimitExceededException
    if code == "ResourceNotFoundException":
        return ComprehendError.ResourceNotFoundException
    if code == "ResourceUnavailableException":
        return ComprehendError.ResourceUnavailableException
    if code == "TextSizeLimitExceededException":
        return ComprehendError.TextSizeLimitExceededException
    if code == "TooManyRequestsException":
        return ComprehendError.TooManyRequestsException
    if code == "TooManyTagKeysException":
        return ComprehendError.TooManyTagKeysException
    if code == "TooManyTagsException":
        return ComprehendError.TooManyTagsException
    if code == "UnsupportedLanguageException":
        return ComprehendError.UnsupportedLanguageException
    return ComprehendError.Unknown(code=code)

