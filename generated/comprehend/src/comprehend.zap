# --- errors ----------------------------------------------------------------

# Typed service errors (#361): the per-service enum + classifier + name
# dispatcher emitted on top of `aws_core.errors` (DECISIONS.md D-0006). One
# bare variant per modeled error shape, plus an open-enum `Unknown(str code)`
# catch-all, so a caller built against this model keeps working when the
# service adds an error. The raw wire code is
# the smithy-rpc-v2-cbor body `__type`.
# `errors.error_code` normalizes it to the bare shape name before matching;
# the base carrier, the X-Amzn-ErrorType fallback and the raise/check bridge
# are inherited from `aws_core.errors` and not re-emitted here.
enum ComprehendErrorKind:
    BatchSizeLimitExceededException
    ConcurrentModificationException
    InternalServerException
    InvalidFilterException
    InvalidRequestException
    JobNotFoundException
    KmsKeyValidationException
    ResourceInUseException
    ResourceLimitExceededException
    ResourceNotFoundException
    ResourceUnavailableException
    TextSizeLimitExceededException
    TooManyRequestsException
    TooManyTagKeysException
    TooManyTagsException
    UnsupportedLanguageException
    Unknown(str code)

# Classify an AWS error code into `ComprehendErrorKind`,
# normalizing first (`errors.error_code` strips any namespace/suffix) then
# matching by name; an unmodeled code becomes `Unknown(name)`, carrying it.
def comprehend_error_kind(str code) -> ComprehendErrorKind:
    auto name = errors.error_code(code)
    if name == "BatchSizeLimitExceededException":
        return ComprehendErrorKind.BatchSizeLimitExceededException
    if name == "ConcurrentModificationException":
        return ComprehendErrorKind.ConcurrentModificationException
    if name == "InternalServerException":
        return ComprehendErrorKind.InternalServerException
    if name == "InvalidFilterException":
        return ComprehendErrorKind.InvalidFilterException
    if name == "InvalidRequestException":
        return ComprehendErrorKind.InvalidRequestException
    if name == "JobNotFoundException":
        return ComprehendErrorKind.JobNotFoundException
    if name == "KmsKeyValidationException":
        return ComprehendErrorKind.KmsKeyValidationException
    if name == "ResourceInUseException":
        return ComprehendErrorKind.ResourceInUseException
    if name == "ResourceLimitExceededException":
        return ComprehendErrorKind.ResourceLimitExceededException
    if name == "ResourceNotFoundException":
        return ComprehendErrorKind.ResourceNotFoundException
    if name == "ResourceUnavailableException":
        return ComprehendErrorKind.ResourceUnavailableException
    if name == "TextSizeLimitExceededException":
        return ComprehendErrorKind.TextSizeLimitExceededException
    if name == "TooManyRequestsException":
        return ComprehendErrorKind.TooManyRequestsException
    if name == "TooManyTagKeysException":
        return ComprehendErrorKind.TooManyTagKeysException
    if name == "TooManyTagsException":
        return ComprehendErrorKind.TooManyTagsException
    if name == "UnsupportedLanguageException":
        return ComprehendErrorKind.UnsupportedLanguageException
    return ComprehendErrorKind.Unknown(name)

# The canonical name of a classified error. This `match` is exhaustive over
# every variant (the compiler enforces it, so a new variant forces it to be
# updated — the generator emits the enum and dispatcher together) and is
# module-local, so each pattern is a two-segment `Enum.Variant` — the portable
# form until the compiler resolves module-qualified variant patterns in a
# caller's own `match` (DECISIONS.md D-0006). `Unknown` carries its code.
def comprehend_error_name(ComprehendErrorKind k) -> str:
    match k:
        case ComprehendErrorKind.BatchSizeLimitExceededException:
            return "BatchSizeLimitExceededException"
        case ComprehendErrorKind.ConcurrentModificationException:
            return "ConcurrentModificationException"
        case ComprehendErrorKind.InternalServerException:
            return "InternalServerException"
        case ComprehendErrorKind.InvalidFilterException:
            return "InvalidFilterException"
        case ComprehendErrorKind.InvalidRequestException:
            return "InvalidRequestException"
        case ComprehendErrorKind.JobNotFoundException:
            return "JobNotFoundException"
        case ComprehendErrorKind.KmsKeyValidationException:
            return "KmsKeyValidationException"
        case ComprehendErrorKind.ResourceInUseException:
            return "ResourceInUseException"
        case ComprehendErrorKind.ResourceLimitExceededException:
            return "ResourceLimitExceededException"
        case ComprehendErrorKind.ResourceNotFoundException:
            return "ResourceNotFoundException"
        case ComprehendErrorKind.ResourceUnavailableException:
            return "ResourceUnavailableException"
        case ComprehendErrorKind.TextSizeLimitExceededException:
            return "TextSizeLimitExceededException"
        case ComprehendErrorKind.TooManyRequestsException:
            return "TooManyRequestsException"
        case ComprehendErrorKind.TooManyTagKeysException:
            return "TooManyTagKeysException"
        case ComprehendErrorKind.TooManyTagsException:
            return "TooManyTagsException"
        case ComprehendErrorKind.UnsupportedLanguageException:
            return "UnsupportedLanguageException"
        case ComprehendErrorKind.Unknown(c):
            return "Unknown(" + c + ")"

