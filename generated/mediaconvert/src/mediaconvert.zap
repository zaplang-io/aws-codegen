# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by mediaconvert_error_from_code.
enum MediaConvertError:
    BadRequestException
    ConflictException
    ForbiddenException
    InternalServerErrorException
    NotFoundException
    ServiceQuotaExceededException
    TooManyRequestsException
    UnprocessableEntityException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def mediaconvert_error_from_code(str code) -> MediaConvertError:
    if code == "BadRequestException":
        return MediaConvertError.BadRequestException
    if code == "ConflictException":
        return MediaConvertError.ConflictException
    if code == "ForbiddenException":
        return MediaConvertError.ForbiddenException
    if code == "InternalServerErrorException":
        return MediaConvertError.InternalServerErrorException
    if code == "NotFoundException":
        return MediaConvertError.NotFoundException
    if code == "ServiceQuotaExceededException":
        return MediaConvertError.ServiceQuotaExceededException
    if code == "TooManyRequestsException":
        return MediaConvertError.TooManyRequestsException
    if code == "UnprocessableEntityException":
        return MediaConvertError.UnprocessableEntityException
    return MediaConvertError.Unknown(code=code)

# --- client ----------------------------------------------------------------

# Per-operation JSON document bodies (the unbound "document" members of an
# operation's input, serialized with @derive(Json)).

@derive(Json)
struct AssociateCertificateDocument:
    # document members of AssociateCertificate
    str Arn

