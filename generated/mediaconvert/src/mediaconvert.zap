    # Paginator for DescribeEndpoints — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: Endpoints).
    def paginate_describe_endpoints(self, DescribeEndpointsRequest input):
        auto host = endpoints.regional_host(mediaconvert_service(), self.region)
        while True:
            auto raw = self.describe_endpoints(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

