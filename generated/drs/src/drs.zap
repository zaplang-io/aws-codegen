# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by drs_error_from_code.
enum drsError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    UninitializedAccountException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def drs_error_from_code(str code) -> drsError:
    if code == "AccessDeniedException":
        return drsError.AccessDeniedException
    if code == "ConflictException":
        return drsError.ConflictException
    if code == "InternalServerException":
        return drsError.InternalServerException
    if code == "ResourceNotFoundException":
        return drsError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return drsError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return drsError.ThrottlingException
    if code == "UninitializedAccountException":
        return drsError.UninitializedAccountException
    if code == "ValidationException":
        return drsError.ValidationException
    return drsError.Unknown(code=code)

