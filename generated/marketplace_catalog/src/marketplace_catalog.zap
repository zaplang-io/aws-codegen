    # Paginator for DescribeAssessment — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: ControlAssessments).
    def paginate_describe_assessment(self, DescribeAssessmentRequest input):
        auto host = endpoints.regional_host(catalog_marketplace_service(), self.region)
        while True:
            auto raw = self.describe_assessment(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

    # Paginator for ListAssessments — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: AssessmentSummaryList).
    def paginate_list_assessments(self, ListAssessmentsRequest input):
        auto host = endpoints.regional_host(catalog_marketplace_service(), self.region)
        while True:
            auto raw = self.list_assessments(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

# Construct a Marketplace_CatalogClient bound to credentials + region.
def catalog_marketplace_client(core.Credentials creds, str region) -> Marketplace_CatalogClient:
    return Marketplace_CatalogClient(creds=creds, region=region)
