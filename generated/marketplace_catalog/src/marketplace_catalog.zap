# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by catalog_marketplace_error_from_code.
enum Marketplace_CatalogError:
    AccessDeniedException
    InternalServiceException
    ResourceInUseException
    ResourceNotFoundException
    ResourceNotSupportedException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def catalog_marketplace_error_from_code(str code) -> Marketplace_CatalogError:
    if code == "AccessDeniedException":
        return Marketplace_CatalogError.AccessDeniedException
    if code == "InternalServiceException":
        return Marketplace_CatalogError.InternalServiceException
    if code == "ResourceInUseException":
        return Marketplace_CatalogError.ResourceInUseException
    if code == "ResourceNotFoundException":
        return Marketplace_CatalogError.ResourceNotFoundException
    if code == "ResourceNotSupportedException":
        return Marketplace_CatalogError.ResourceNotSupportedException
    if code == "ServiceQuotaExceededException":
        return Marketplace_CatalogError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return Marketplace_CatalogError.ThrottlingException
    if code == "ValidationException":
        return Marketplace_CatalogError.ValidationException
    return Marketplace_CatalogError.Unknown(code=code)

