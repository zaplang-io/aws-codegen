    if v.Min.is_some():
        p = query.query_scalar(p, query.query_key(prefix, "Min"), str(v.Min.unwrap()))
    if v.Max.is_some():
        p = query.query_scalar(p, query.query_key(prefix, "Max"), str(v.Max.unwrap()))
    return p

