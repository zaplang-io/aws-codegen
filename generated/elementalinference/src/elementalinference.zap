    # Paginator for ListDictionaries — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: dictionaries).
    def paginate_list_dictionaries(self, ListDictionariesRequest input):
        auto host = endpoints.regional_host(elemental_inference_service(), self.region)
        while True:
            auto raw = self.list_dictionaries(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

    # Paginator for ListFeeds — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: feeds).
    def paginate_list_feeds(self, ListFeedsRequest input):
        auto host = endpoints.regional_host(elemental_inference_service(), self.region)
