# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def elemental_inference_error_from_code(str code) -> ElementalInferenceError:
    if code == "AccessDeniedException":
        return ElementalInferenceError.AccessDeniedException
    if code == "ConflictException":
        return ElementalInferenceError.ConflictException
    if code == "GatewayTimedOutException":
        return ElementalInferenceError.GatewayTimedOutException
    if code == "InternalServerErrorException":
        return ElementalInferenceError.InternalServerErrorException
    if code == "ResourceNotFoundException":
        return ElementalInferenceError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return ElementalInferenceError.ServiceQuotaExceededException
    if code == "ServiceUnavailableException":
        return ElementalInferenceError.ServiceUnavailableException
    if code == "TooManyRequestException":
        return ElementalInferenceError.TooManyRequestException
    if code == "ValidationException":
        return ElementalInferenceError.ValidationException
    return ElementalInferenceError.Unknown(code=code)

