# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by kendra_error_from_code.
enum kendraError:
    AccessDeniedException
    ConflictException
    FeaturedResultsConflictException
    InternalServerException
    InvalidRequestException
    ResourceAlreadyExistException
    ResourceInUseException
    ResourceNotFoundException
    ResourceUnavailableException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def kendra_error_from_code(str code) -> kendraError:
    if code == "AccessDeniedException":
        return kendraError.AccessDeniedException
    if code == "ConflictException":
        return kendraError.ConflictException
    if code == "FeaturedResultsConflictException":
        return kendraError.FeaturedResultsConflictException
    if code == "InternalServerException":
        return kendraError.InternalServerException
    if code == "InvalidRequestException":
        return kendraError.InvalidRequestException
    if code == "ResourceAlreadyExistException":
        return kendraError.ResourceAlreadyExistException
    if code == "ResourceInUseException":
        return kendraError.ResourceInUseException
    if code == "ResourceNotFoundException":
        return kendraError.ResourceNotFoundException
    if code == "ResourceUnavailableException":
        return kendraError.ResourceUnavailableException
    if code == "ServiceQuotaExceededException":
        return kendraError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return kendraError.ThrottlingException
    if code == "ValidationException":
        return kendraError.ValidationException
    return kendraError.Unknown(code=code)

