    # Paginator for ListMonitors — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: monitors).
    def paginate_list_monitors(self, ListMonitorsInput input):
        auto host = endpoints.regional_host(networkmonitor_service(), self.region)
        while True:
            auto raw = self.list_monitors(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

# Construct a NetworkMonitorClient bound to credentials + region.
def networkmonitor_client(core.Credentials creds, str region) -> NetworkMonitorClient:
    return NetworkMonitorClient(creds=creds, region=region)
