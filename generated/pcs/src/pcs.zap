# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by pcs_error_from_code.
enum PCSError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def pcs_error_from_code(str code) -> PCSError:
    if code == "AccessDeniedException":
        return PCSError.AccessDeniedException
    if code == "ConflictException":
        return PCSError.ConflictException
    if code == "InternalServerException":
        return PCSError.InternalServerException
    if code == "ResourceNotFoundException":
        return PCSError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return PCSError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return PCSError.ThrottlingException
    if code == "ValidationException":
        return PCSError.ValidationException
    return PCSError.Unknown(code=code)

