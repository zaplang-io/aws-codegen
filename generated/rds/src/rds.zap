    # AuthorizeDBSecurityGroupIngress
    # errors: AuthorizationAlreadyExistsFault, AuthorizationQuotaExceededFault, DBSecurityGroupNotFoundFault, InvalidDBSecurityGroupStateFault
    def authorize_db_security_group_ingress(self, AuthorizeDBSecurityGroupIngressMessage input) -> str:
        auto p = query.query_params("AuthorizeDBSecurityGroupIngress", "2014-10-31")
        p = query.query_scalar(p, "DBSecurityGroupName", input.DBSecurityGroupName)
        if input.CIDRIP.is_some():
            p = query.query_scalar(p, "CIDRIP", input.CIDRIP.unwrap())
        if input.EC2SecurityGroupName.is_some():
            auto t0 = input.EC2SecurityGroupName.unwrap()
            p = query.query_scalar(p, "EC2SecurityGroupName", t0)
        if input.EC2SecurityGroupId.is_some():
            auto t1 = input.EC2SecurityGroupId.unwrap()
            p = query.query_scalar(p, "EC2SecurityGroupId", t1)
        if input.EC2SecurityGroupOwnerId.is_some():
            auto t2 = input.EC2SecurityGroupOwnerId.unwrap()
            p = query.query_scalar(p, "EC2SecurityGroupOwnerId", t2)
        return query.query_request(self.creds, rds_service(), self.region, p)

    # BacktrackDBCluster
    # errors: DBClusterNotFoundFault, InvalidDBClusterStateFault
    def backtrack_db_cluster(self, BacktrackDBClusterMessage input) -> str:
        auto p = query.query_params("BacktrackDBCluster", "2014-10-31")
        p = query.query_scalar(p, "DBClusterIdentifier", input.DBClusterIdentifier)
        auto t0 = query.query_timestamp_iso8601(input.BacktrackTo)
