# A bound RDS client: credentials + region, threaded into every operation.
struct RDSClient:
    core.Credentials creds
    str region

    # AddRoleToDBCluster
    # errors: DBClusterNotFoundFault, DBClusterRoleAlreadyExistsFault, DBClusterRoleQuotaExceededFault, InvalidDBClusterStateFault
    def add_role_to_db_cluster(self, AddRoleToDBClusterMessage input) -> str:
        auto p = query.query_params("AddRoleToDBCluster", "2014-10-31")
        p = query.query_scalar(p, "DBClusterIdentifier", input.DBClusterIdentifier)
        p = query.query_scalar(p, "RoleArn", input.RoleArn)
        if input.FeatureName.is_some():
            p = query.query_scalar(p, "FeatureName", input.FeatureName.unwrap())
        return query.query_request(self.creds, rds_service(), self.region, p)

    # AddRoleToDBInstance
    # errors: DBInstanceNotFoundFault, DBInstanceRoleAlreadyExistsFault, DBInstanceRoleQuotaExceededFault, InvalidDBInstanceStateFault
