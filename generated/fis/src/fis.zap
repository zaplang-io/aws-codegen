            auto raw = self.list_target_account_configurations(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

    # Paginator for ListTargetResourceTypes — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: targetResourceTypes).
    def paginate_list_target_resource_types(self, ListTargetResourceTypesRequest input):
        auto host = endpoints.regional_host(fis_service(), self.region)
        while True:
            auto raw = self.list_target_resource_types(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

# Construct a fisClient bound to credentials + region.
def fis_client(core.Credentials creds, str region) -> fisClient:
    return fisClient(creds=creds, region=region)
