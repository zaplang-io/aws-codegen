    # Paginator for ListActions — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: actions).
    def paginate_list_actions(self, ListActionsRequest input):
        auto host = endpoints.regional_host(fis_service(), self.region)
        while True:
            auto raw = self.list_actions(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

