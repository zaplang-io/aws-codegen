# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by odb_error_from_code.
enum odbError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def odb_error_from_code(str code) -> odbError:
    if code == "AccessDeniedException":
        return odbError.AccessDeniedException
    if code == "ConflictException":
        return odbError.ConflictException
    if code == "InternalServerException":
        return odbError.InternalServerException
    if code == "ResourceNotFoundException":
        return odbError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return odbError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return odbError.ThrottlingException
    if code == "ValidationException":
        return odbError.ValidationException
    return odbError.Unknown(code=code)

