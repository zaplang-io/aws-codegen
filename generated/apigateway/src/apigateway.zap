# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by apigateway_error_from_code.
enum API_GatewayError:
    BadRequestException
    ConflictException
    LimitExceededException
    NotFoundException
    ServiceUnavailableException
    TooManyRequestsException
    UnauthorizedException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def apigateway_error_from_code(str code) -> API_GatewayError:
    if code == "BadRequestException":
        return API_GatewayError.BadRequestException
    if code == "ConflictException":
        return API_GatewayError.ConflictException
    if code == "LimitExceededException":
        return API_GatewayError.LimitExceededException
    if code == "NotFoundException":
        return API_GatewayError.NotFoundException
    if code == "ServiceUnavailableException":
        return API_GatewayError.ServiceUnavailableException
    if code == "TooManyRequestsException":
        return API_GatewayError.TooManyRequestsException
    if code == "UnauthorizedException":
        return API_GatewayError.UnauthorizedException
    return API_GatewayError.Unknown(code=code)

