# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by grafana_error_from_code.
enum grafanaError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def grafana_error_from_code(str code) -> grafanaError:
    if code == "AccessDeniedException":
        return grafanaError.AccessDeniedException
    if code == "ConflictException":
        return grafanaError.ConflictException
    if code == "InternalServerException":
        return grafanaError.InternalServerException
    if code == "ResourceNotFoundException":
        return grafanaError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return grafanaError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return grafanaError.ThrottlingException
    if code == "ValidationException":
        return grafanaError.ValidationException
    return grafanaError.Unknown(code=code)

