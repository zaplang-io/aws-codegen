    # Paginator for ListPermissions — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: permissions).
    def paginate_list_permissions(self, ListPermissionsRequest input):
        auto host = endpoints.regional_host(grafana_service(), self.region)
        while True:
            auto raw = self.list_permissions(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

