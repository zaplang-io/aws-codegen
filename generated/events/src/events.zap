# --- errors ----------------------------------------------------------------

# Typed service errors (#361): the per-service enum + classifier + name
# dispatcher emitted on top of `aws_core.errors` (DECISIONS.md D-0006). One
# bare variant per modeled error shape, plus an open-enum `Unknown(str code)`
# catch-all, so a caller built against this model keeps working when the
# service adds an error. The raw wire code is
# the awsJson `__type` / X-Amzn-ErrorType shape name.
# `errors.error_code` normalizes it to the bare shape name before matching;
# the base carrier, the X-Amzn-ErrorType fallback and the raise/check bridge
# are inherited from `aws_core.errors` and not re-emitted here.
enum EventBridgeErrorKind:
    AccessDeniedException
    ConcurrentModificationException
    IllegalStatusException
    InternalException
    InvalidEventPatternException
    InvalidStateException
    LimitExceededException
    ManagedRuleException
    OperationDisabledException
    PolicyLengthExceededException
    ResourceAlreadyExistsException
    ResourceNotFoundException
    ThrottlingException
    Unknown(str code)

# Classify an AWS error code into `EventBridgeErrorKind`,
# normalizing first (`errors.error_code` strips any namespace/suffix) then
# matching by name; an unmodeled code becomes `Unknown(name)`, carrying it.
def events_error_kind(str code) -> EventBridgeErrorKind:
    auto name = errors.error_code(code)
    if name == "AccessDeniedException":
        return EventBridgeErrorKind.AccessDeniedException
    if name == "ConcurrentModificationException":
        return EventBridgeErrorKind.ConcurrentModificationException
    if name == "IllegalStatusException":
        return EventBridgeErrorKind.IllegalStatusException
    if name == "InternalException":
        return EventBridgeErrorKind.InternalException
    if name == "InvalidEventPatternException":
        return EventBridgeErrorKind.InvalidEventPatternException
    if name == "InvalidStateException":
        return EventBridgeErrorKind.InvalidStateException
    if name == "LimitExceededException":
        return EventBridgeErrorKind.LimitExceededException
    if name == "ManagedRuleException":
        return EventBridgeErrorKind.ManagedRuleException
    if name == "OperationDisabledException":
        return EventBridgeErrorKind.OperationDisabledException
    if name == "PolicyLengthExceededException":
        return EventBridgeErrorKind.PolicyLengthExceededException
    if name == "ResourceAlreadyExistsException":
        return EventBridgeErrorKind.ResourceAlreadyExistsException
    if name == "ResourceNotFoundException":
        return EventBridgeErrorKind.ResourceNotFoundException
    if name == "ThrottlingException":
        return EventBridgeErrorKind.ThrottlingException
    return EventBridgeErrorKind.Unknown(name)

# The canonical name of a classified error. This `match` is exhaustive over
# every variant (the compiler enforces it, so a new variant forces it to be
# updated — the generator emits the enum and dispatcher together) and is
# module-local, so each pattern is a two-segment `Enum.Variant` — the portable
# form until the compiler resolves module-qualified variant patterns in a
# caller's own `match` (DECISIONS.md D-0006). `Unknown` carries its code.
def events_error_name(EventBridgeErrorKind k) -> str:
    match k:
        case EventBridgeErrorKind.AccessDeniedException:
            return "AccessDeniedException"
        case EventBridgeErrorKind.ConcurrentModificationException:
            return "ConcurrentModificationException"
        case EventBridgeErrorKind.IllegalStatusException:
            return "IllegalStatusException"
        case EventBridgeErrorKind.InternalException:
            return "InternalException"
        case EventBridgeErrorKind.InvalidEventPatternException:
            return "InvalidEventPatternException"
        case EventBridgeErrorKind.InvalidStateException:
            return "InvalidStateException"
        case EventBridgeErrorKind.LimitExceededException:
            return "LimitExceededException"
        case EventBridgeErrorKind.ManagedRuleException:
            return "ManagedRuleException"
        case EventBridgeErrorKind.OperationDisabledException:
            return "OperationDisabledException"
        case EventBridgeErrorKind.PolicyLengthExceededException:
            return "PolicyLengthExceededException"
        case EventBridgeErrorKind.ResourceAlreadyExistsException:
            return "ResourceAlreadyExistsException"
        case EventBridgeErrorKind.ResourceNotFoundException:
            return "ResourceNotFoundException"
        case EventBridgeErrorKind.ThrottlingException:
            return "ThrottlingException"
        case EventBridgeErrorKind.Unknown(c):
            return "Unknown(" + c + ")"

# --- client ----------------------------------------------------------------

# JSON body helpers (compact, declaration-order objects): the collection
# serialization @derive(Json) does not emit yet (zaplang-io/zap#424). `_json_str`
# escapes+quotes via the prelude JSON writer; `_json_obj`/`_json_arr` comma-join
# pre-serialized members.
def events_json_str(str s) -> str:
    return json.dumps(JsonValue.Str(s))

def events_json_obj(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "{" + body + "}"

def events_json_arr(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "[" + body + "]"

# Explicit JSON serializers for input shapes with collection/nested members
# (the @derive(Json) collection follow-up, zaplang-io/zap#424).

# Serialize AwsVpcConfiguration to a compact JSON object (declaration order).
def aws_vpc_configuration_to_json(AwsVpcConfiguration v) -> str:
    list[str] parts = []
    list[str] e0 = []
    for x0 in v.Subnets:
        e0.append(events_json_str(x0))
    parts.append("\"Subnets\":" + events_json_arr(e0))
    if v.SecurityGroups.is_some():
        auto u1 = v.SecurityGroups.unwrap()
        list[str] e2 = []
        for x2 in u1:
            e2.append(events_json_str(x2))
        parts.append("\"SecurityGroups\":" + events_json_arr(e2))
    if v.AssignPublicIp.is_some():
