# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by events_error_from_code.
enum EventBridgeError:
    AccessDeniedException
    ConcurrentModificationException
    IllegalStatusException
    InternalException
    InvalidEventPatternException
    InvalidStateException
    LimitExceededException
    ManagedRuleException
    OperationDisabledException
    PolicyLengthExceededException
    ResourceAlreadyExistsException
    ResourceNotFoundException
    ThrottlingException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def events_error_from_code(str code) -> EventBridgeError:
    if code == "AccessDeniedException":
        return EventBridgeError.AccessDeniedException
    if code == "ConcurrentModificationException":
        return EventBridgeError.ConcurrentModificationException
    if code == "IllegalStatusException":
        return EventBridgeError.IllegalStatusException
    if code == "InternalException":
        return EventBridgeError.InternalException
    if code == "InvalidEventPatternException":
        return EventBridgeError.InvalidEventPatternException
    if code == "InvalidStateException":
        return EventBridgeError.InvalidStateException
    if code == "LimitExceededException":
        return EventBridgeError.LimitExceededException
    if code == "ManagedRuleException":
        return EventBridgeError.ManagedRuleException
    if code == "OperationDisabledException":
        return EventBridgeError.OperationDisabledException
    if code == "PolicyLengthExceededException":
        return EventBridgeError.PolicyLengthExceededException
    if code == "ResourceAlreadyExistsException":
        return EventBridgeError.ResourceAlreadyExistsException
    if code == "ResourceNotFoundException":
        return EventBridgeError.ResourceNotFoundException
    if code == "ThrottlingException":
        return EventBridgeError.ThrottlingException
    return EventBridgeError.Unknown(code=code)

