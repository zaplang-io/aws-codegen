    # Paginator for ListRuleNamesByTarget — yields each Response page, threading the
    # NextToken -> NextToken continuation token until the output token is absent (result key: RuleNames).
    def paginate_list_rule_names_by_target(self, ListRuleNamesByTargetRequest input):
        auto host = endpoints.regional_host(events_protocol().service, self.region)
        while True:
            auto body = input.to_json()
            auto raw = awsjson.awsjson_request_now(events_protocol(), self.creds, self.region, "ListRuleNamesByTarget", body)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

