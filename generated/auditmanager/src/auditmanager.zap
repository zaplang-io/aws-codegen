# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by auditmanager_error_from_code.
enum AuditManagerError:
    AccessDeniedException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def auditmanager_error_from_code(str code) -> AuditManagerError:
    if code == "AccessDeniedException":
        return AuditManagerError.AccessDeniedException
    if code == "InternalServerException":
        return AuditManagerError.InternalServerException
    if code == "ResourceNotFoundException":
        return AuditManagerError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return AuditManagerError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return AuditManagerError.ThrottlingException
    if code == "ValidationException":
        return AuditManagerError.ValidationException
    return AuditManagerError.Unknown(code=code)

