# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by models_v2_lex_error_from_code.
enum Lex_Models_V2Error:
    ConflictException
    InternalServerException
    PreconditionFailedException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def models_v2_lex_error_from_code(str code) -> Lex_Models_V2Error:
    if code == "ConflictException":
        return Lex_Models_V2Error.ConflictException
    if code == "InternalServerException":
        return Lex_Models_V2Error.InternalServerException
    if code == "PreconditionFailedException":
        return Lex_Models_V2Error.PreconditionFailedException
    if code == "ResourceNotFoundException":
        return Lex_Models_V2Error.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return Lex_Models_V2Error.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return Lex_Models_V2Error.ThrottlingException
    if code == "ValidationException":
        return Lex_Models_V2Error.ValidationException
    return Lex_Models_V2Error.Unknown(code=code)

