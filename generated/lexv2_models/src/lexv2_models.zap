    # Paginator for DescribeBotAnalyzerRecommendation — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: botAnalyzerRecommendationList).
    def paginate_describe_bot_analyzer_recommendation(self, DescribeBotAnalyzerRecommendationRequest input):
        auto host = endpoints.regional_host(models_v2_lex_service(), self.region)
        while True:
            auto raw = self.describe_bot_analyzer_recommendation(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

    # Paginator for ListBotAnalyzerHistory — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: botAnalyzerHistoryList).
    def paginate_list_bot_analyzer_history(self, ListBotAnalyzerHistoryRequest input):
        auto host = endpoints.regional_host(models_v2_lex_service(), self.region)
        while True:
            auto raw = self.list_bot_analyzer_history(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

# Construct a Lex_Models_V2Client bound to credentials + region.
def models_v2_lex_client(core.Credentials creds, str region) -> Lex_Models_V2Client:
    return Lex_Models_V2Client(creds=creds, region=region)
