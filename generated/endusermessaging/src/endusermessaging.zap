    # Paginator for ListBrandProfileAttributes — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: brandProfileAttributes).
    def paginate_list_brand_profile_attributes(self, ListBrandProfileAttributesInput input):
        auto host = endpoints.regional_host(end_user_messaging_service(), self.region)
        while True:
            auto raw = self.list_brand_profile_attributes(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

