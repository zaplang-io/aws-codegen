# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by end_user_messaging_error_from_code.
enum EndUserMessagingError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def end_user_messaging_error_from_code(str code) -> EndUserMessagingError:
    if code == "AccessDeniedException":
        return EndUserMessagingError.AccessDeniedException
    if code == "ConflictException":
        return EndUserMessagingError.ConflictException
    if code == "InternalServerException":
        return EndUserMessagingError.InternalServerException
    if code == "ResourceNotFoundException":
        return EndUserMessagingError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return EndUserMessagingError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return EndUserMessagingError.ThrottlingException
    if code == "ValidationException":
        return EndUserMessagingError.ValidationException
    return EndUserMessagingError.Unknown(code=code)

