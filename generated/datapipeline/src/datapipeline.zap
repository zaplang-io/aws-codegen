    match k:
        case Data_PipelineErrorKind.InternalServiceError:
            return "InternalServiceError"
        case Data_PipelineErrorKind.InvalidRequestException:
            return "InvalidRequestException"
        case Data_PipelineErrorKind.PipelineDeletedException:
            return "PipelineDeletedException"
        case Data_PipelineErrorKind.PipelineNotFoundException:
            return "PipelineNotFoundException"
        case Data_PipelineErrorKind.TaskNotFoundException:
