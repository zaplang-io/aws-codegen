# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by ivs_error_from_code.
enum ivsError:
    AccessDeniedException
    ChannelNotBroadcasting
    ConflictException
    InternalServerException
    PendingVerification
    ResourceNotFoundException
    ServiceQuotaExceededException
    ServiceUnavailable
    StreamUnavailable
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def ivs_error_from_code(str code) -> ivsError:
    if code == "AccessDeniedException":
        return ivsError.AccessDeniedException
    if code == "ChannelNotBroadcasting":
        return ivsError.ChannelNotBroadcasting
    if code == "ConflictException":
        return ivsError.ConflictException
    if code == "InternalServerException":
        return ivsError.InternalServerException
    if code == "PendingVerification":
        return ivsError.PendingVerification
    if code == "ResourceNotFoundException":
        return ivsError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return ivsError.ServiceQuotaExceededException
    if code == "ServiceUnavailable":
        return ivsError.ServiceUnavailable
    if code == "StreamUnavailable":
        return ivsError.StreamUnavailable
    if code == "ThrottlingException":
        return ivsError.ThrottlingException
    if code == "ValidationException":
        return ivsError.ValidationException
    return ivsError.Unknown(code=code)

