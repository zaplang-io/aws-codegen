    # Paginator for ListAdConfigurations — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: adConfigurations).
    def paginate_list_ad_configurations(self, ListAdConfigurationsRequest input):
        auto host = endpoints.regional_host(ivs_service(), self.region)
        while True:
            auto raw = self.list_ad_configurations(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

