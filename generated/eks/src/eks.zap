# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by eks_error_from_code.
enum EKSError:
    AccessDeniedException
    BadRequestException
    ClientException
    InvalidParameterException
    InvalidRequestException
    InvalidStateException
    NotFoundException
    ResourceInUseException
    ResourceLimitExceededException
    ResourceNotFoundException
    ResourcePropagationDelayException
    ServerException
    ServiceUnavailableException
    ThrottlingException
    UnsupportedAvailabilityZoneException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def eks_error_from_code(str code) -> EKSError:
    if code == "AccessDeniedException":
        return EKSError.AccessDeniedException
    if code == "BadRequestException":
        return EKSError.BadRequestException
    if code == "ClientException":
        return EKSError.ClientException
    if code == "InvalidParameterException":
        return EKSError.InvalidParameterException
    if code == "InvalidRequestException":
        return EKSError.InvalidRequestException
    if code == "InvalidStateException":
        return EKSError.InvalidStateException
    if code == "NotFoundException":
        return EKSError.NotFoundException
    if code == "ResourceInUseException":
        return EKSError.ResourceInUseException
    if code == "ResourceLimitExceededException":
        return EKSError.ResourceLimitExceededException
    if code == "ResourceNotFoundException":
        return EKSError.ResourceNotFoundException
    if code == "ResourcePropagationDelayException":
        return EKSError.ResourcePropagationDelayException
    if code == "ServerException":
        return EKSError.ServerException
    if code == "ServiceUnavailableException":
        return EKSError.ServiceUnavailableException
    if code == "ThrottlingException":
        return EKSError.ThrottlingException
    if code == "UnsupportedAvailabilityZoneException":
        return EKSError.UnsupportedAvailabilityZoneException
    return EKSError.Unknown(code=code)

