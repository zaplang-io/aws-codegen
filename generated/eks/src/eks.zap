        auto host = endpoints.regional_host(eks_service(), self.region)
        while True:
            auto raw = self.list_associated_access_policies(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
