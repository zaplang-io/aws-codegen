# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by ivschat_error_from_code.
enum ivschatError:
    AccessDeniedException
    ConflictException
    InternalServerException
    PendingVerification
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def ivschat_error_from_code(str code) -> ivschatError:
    if code == "AccessDeniedException":
        return ivschatError.AccessDeniedException
    if code == "ConflictException":
        return ivschatError.ConflictException
    if code == "InternalServerException":
        return ivschatError.InternalServerException
    if code == "PendingVerification":
        return ivschatError.PendingVerification
    if code == "ResourceNotFoundException":
        return ivschatError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return ivschatError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return ivschatError.ThrottlingException
    if code == "ValidationException":
        return ivschatError.ValidationException
    return ivschatError.Unknown(code=code)

