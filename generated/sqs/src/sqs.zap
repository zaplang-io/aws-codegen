        return awsjson.awsjson_request_now(sqs_protocol(), self.creds, self.region, "TagQueue", body)

    # UntagQueue
    # errors: InvalidAddress, InvalidSecurity, QueueDoesNotExist, RequestThrottled, UnsupportedOperation
    def untag_queue(self, UntagQueueRequest input) -> str:
        auto body = untag_queue_request_to_json(input)
        return awsjson.awsjson_request_now(sqs_protocol(), self.creds, self.region, "UntagQueue", body)

    # Paginator for ListDeadLetterSourceQueues — yields each Response page, threading the
    # NextToken -> NextToken continuation token until the output token is absent (result key: queueUrls).
    def paginate_list_dead_letter_source_queues(self, ListDeadLetterSourceQueuesRequest input):
        auto host = endpoints.regional_host(sqs_protocol().service, self.region)
        while True:
            auto body = input.to_json()
            auto raw = awsjson.awsjson_request_now(sqs_protocol(), self.creds, self.region, "ListDeadLetterSourceQueues", body)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

    # Paginator for ListQueues — yields each Response page, threading the
    # NextToken -> NextToken continuation token until the output token is absent (result key: QueueUrls).
    def paginate_list_queues(self, ListQueuesRequest input):
        auto host = endpoints.regional_host(sqs_protocol().service, self.region)
        while True:
            auto body = input.to_json()
            auto raw = awsjson.awsjson_request_now(sqs_protocol(), self.creds, self.region, "ListQueues", body)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

# Construct a SQSClient bound to credentials + region.
def sqs_client(core.Credentials creds, str region) -> SQSClient:
    return SQSClient(creds=creds, region=region)
