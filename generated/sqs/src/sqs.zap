    match k:
        case SQSErrorKind.BatchEntryIdsNotDistinct:
            return "BatchEntryIdsNotDistinct"
        case SQSErrorKind.BatchRequestTooLong:
            return "BatchRequestTooLong"
        case SQSErrorKind.EmptyBatchRequest:
