    # Paginator for ListApplicationAssociations — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: ApplicationAssociations).
    def paginate_list_application_associations(self, ListApplicationAssociationsRequest input):
        auto host = endpoints.regional_host(app_integrations_service(), self.region)
        while True:
            auto raw = self.list_application_associations(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

