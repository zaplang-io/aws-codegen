    # Paginator for ListJobRunAttempts — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: jobRunAttempts).
    def paginate_list_job_run_attempts(self, ListJobRunAttemptsRequest input):
        auto host = endpoints.regional_host(emr_serverless_service(), self.region)
        while True:
            auto raw = self.list_job_run_attempts(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

# Construct a EMR_ServerlessClient bound to credentials + region.
def emr_serverless_client(core.Credentials creds, str region) -> EMR_ServerlessClient:
    return EMR_ServerlessClient(creds=creds, region=region)
