# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by emr_serverless_error_from_code.
enum EMR_ServerlessError:
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def emr_serverless_error_from_code(str code) -> EMR_ServerlessError:
    if code == "ConflictException":
        return EMR_ServerlessError.ConflictException
    if code == "InternalServerException":
        return EMR_ServerlessError.InternalServerException
    if code == "ResourceNotFoundException":
        return EMR_ServerlessError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return EMR_ServerlessError.ServiceQuotaExceededException
    if code == "ValidationException":
        return EMR_ServerlessError.ValidationException
    return EMR_ServerlessError.Unknown(code=code)

