# --- errors ----------------------------------------------------------------

# Typed service errors (#361): the per-service enum + classifier + name
# dispatcher emitted on top of `aws_core.errors` (DECISIONS.md D-0006). One
# bare variant per modeled error shape, plus an open-enum `Unknown(str code)`
# catch-all, so a caller built against this model keeps working when the
# service adds an error. The raw wire code is
# the restJson1 X-Amzn-ErrorType header or body `__type`.
# `errors.error_code` normalizes it to the bare shape name before matching;
# the base carrier, the X-Amzn-ErrorType fallback and the raise/check bridge
# are inherited from `aws_core.errors` and not re-emitted here.
enum EMR_ServerlessErrorKind:
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ValidationException
    Unknown(str code)

# Classify an AWS error code into `EMR_ServerlessErrorKind`,
# normalizing first (`errors.error_code` strips any namespace/suffix) then
# matching by name; an unmodeled code becomes `Unknown(name)`, carrying it.
def emr_serverless_error_kind(str code) -> EMR_ServerlessErrorKind:
    auto name = errors.error_code(code)
    if name == "ConflictException":
        return EMR_ServerlessErrorKind.ConflictException
    if name == "InternalServerException":
        return EMR_ServerlessErrorKind.InternalServerException
    if name == "ResourceNotFoundException":
        return EMR_ServerlessErrorKind.ResourceNotFoundException
    if name == "ServiceQuotaExceededException":
        return EMR_ServerlessErrorKind.ServiceQuotaExceededException
    if name == "ValidationException":
        return EMR_ServerlessErrorKind.ValidationException
    return EMR_ServerlessErrorKind.Unknown(name)

# The canonical name of a classified error. This `match` is exhaustive over
# every variant (the compiler enforces it, so a new variant forces it to be
# updated — the generator emits the enum and dispatcher together) and is
# module-local, so each pattern is a two-segment `Enum.Variant` — the portable
# form until the compiler resolves module-qualified variant patterns in a
# caller's own `match` (DECISIONS.md D-0006). `Unknown` carries its code.
def emr_serverless_error_name(EMR_ServerlessErrorKind k) -> str:
    match k:
        case EMR_ServerlessErrorKind.ConflictException:
            return "ConflictException"
        case EMR_ServerlessErrorKind.InternalServerException:
            return "InternalServerException"
        case EMR_ServerlessErrorKind.ResourceNotFoundException:
            return "ResourceNotFoundException"
        case EMR_ServerlessErrorKind.ServiceQuotaExceededException:
            return "ServiceQuotaExceededException"
        case EMR_ServerlessErrorKind.ValidationException:
            return "ValidationException"
        case EMR_ServerlessErrorKind.Unknown(c):
            return "Unknown(" + c + ")"

# --- client ----------------------------------------------------------------

# Operations skipped in v0 (a member type is not yet bindable/serializable —
# a non-string/enum/int URI/query/header, a collection or non-derivable
# document member, or an unsupported httpPayload):
#   ListApplications (httpQuery `states` has unsupported type list[ApplicationState])
#   ListJobRuns (httpQuery `states` has unsupported type list[JobRunState])
#   ListSessions (httpQuery `states` has unsupported type list[SessionState])

# Paginated operations (paginators-1.json) not surfaced — their operation is
# skipped above, or the continuation token is not a simple string field:
#   ListApplications (operation not generated)
#   ListJobRuns (operation not generated)
#   ListSessions (operation not generated)

# JSON body helpers (compact, declaration-order objects): the collection
# serialization @derive(Json) does not emit yet (zaplang-io/zap#424). `_json_str`
# escapes+quotes via the prelude JSON writer; `_json_obj`/`_json_arr` comma-join
# pre-serialized members.
def emr_serverless_json_str(str s) -> str:
    return json.dumps(JsonValue.Str(s))

def emr_serverless_json_obj(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "{" + body + "}"

def emr_serverless_json_arr(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "[" + body + "]"

