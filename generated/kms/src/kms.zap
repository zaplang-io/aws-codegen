    # Paginator for DescribeCustomKeyStores — yields each Response page, threading the
    # NextMarker -> Marker continuation token until the output token is absent (result key: CustomKeyStores).
    def paginate_describe_custom_key_stores(self, DescribeCustomKeyStoresRequest input):
        auto host = endpoints.regional_host(kms_protocol().service, self.region)
        while True:
            auto body = input.to_json()
            auto raw = awsjson.awsjson_request_now(kms_protocol(), self.creds, self.region, "DescribeCustomKeyStores", body)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextMarker")
            if not np.has_more:
                break
            input.Marker = Optional.Some(np.token)

