# pre-serialized members.
def vpc_lattice_json_str(str s) -> str:
    return json.dumps(JsonValue.Str(s))

def vpc_lattice_json_obj(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
