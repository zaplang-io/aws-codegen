# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by vpc_lattice_error_from_code.
enum VPC_LatticeError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def vpc_lattice_error_from_code(str code) -> VPC_LatticeError:
    if code == "AccessDeniedException":
        return VPC_LatticeError.AccessDeniedException
    if code == "ConflictException":
        return VPC_LatticeError.ConflictException
    if code == "InternalServerException":
        return VPC_LatticeError.InternalServerException
    if code == "ResourceNotFoundException":
        return VPC_LatticeError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return VPC_LatticeError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return VPC_LatticeError.ThrottlingException
    if code == "ValidationException":
        return VPC_LatticeError.ValidationException
    return VPC_LatticeError.Unknown(code=code)

