# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by bedrock_error_from_code.
enum BedrockError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceInUseException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ServiceUnavailableException
    ThrottlingException
    TooManyTagsException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def bedrock_error_from_code(str code) -> BedrockError:
    if code == "AccessDeniedException":
        return BedrockError.AccessDeniedException
    if code == "ConflictException":
        return BedrockError.ConflictException
    if code == "InternalServerException":
        return BedrockError.InternalServerException
    if code == "ResourceInUseException":
        return BedrockError.ResourceInUseException
    if code == "ResourceNotFoundException":
        return BedrockError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return BedrockError.ServiceQuotaExceededException
    if code == "ServiceUnavailableException":
        return BedrockError.ServiceUnavailableException
    if code == "ThrottlingException":
        return BedrockError.ThrottlingException
    if code == "TooManyTagsException":
        return BedrockError.TooManyTagsException
    if code == "ValidationException":
        return BedrockError.ValidationException
    return BedrockError.Unknown(code=code)

