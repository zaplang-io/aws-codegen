    # Paginator for ListInvoiceSummaries — yields each Response page, threading the
    # NextToken -> NextToken continuation token until the output token is absent (result key: InvoiceSummaries).
    def paginate_list_invoice_summaries(self, ListInvoiceSummariesRequest input):
        auto host = endpoints.regional_host(invoicing_protocol().service, self.region)
        while True:
            auto body = input.to_json()
            auto raw = awsjson.awsjson_request_now(invoicing_protocol(), self.creds, self.region, "ListInvoiceSummaries", body)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

