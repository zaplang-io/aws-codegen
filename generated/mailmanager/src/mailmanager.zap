        auto body = cbor.cbor_encode(update_traffic_policy_request_to_cbor(input))
        auto host = endpoints.regional_host(mail_manager_service(), self.region)
        auto t = core.signing_time_now()
        auto req = cbor.cbor_build_request(mail_manager_service(), self.region, host, "MailManagerSvc", "UpdateTrafficPolicy", body, t.amz_date)
        return cbor.cbor_sign(self.creds, req, body, t.amz_date, t.date_stamp)

# Construct a MailManagerClient bound to credentials + region.
def mail_manager_client(core.Credentials creds, str region) -> MailManagerClient:
    return MailManagerClient(creds=creds, region=region)
