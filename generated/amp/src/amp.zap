    # Paginator for ListAnomalyDetectors — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: anomalyDetectors).
    def paginate_list_anomaly_detectors(self, ListAnomalyDetectorsRequest input):
        auto host = endpoints.regional_host(aps_service(), self.region)
        while True:
            auto raw = self.list_anomaly_detectors(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

