# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by networkmanager_error_from_code.
enum NetworkManagerError:
    AccessDeniedException
    ConflictException
    CoreNetworkPolicyException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def networkmanager_error_from_code(str code) -> NetworkManagerError:
    if code == "AccessDeniedException":
        return NetworkManagerError.AccessDeniedException
    if code == "ConflictException":
        return NetworkManagerError.ConflictException
    if code == "CoreNetworkPolicyException":
        return NetworkManagerError.CoreNetworkPolicyException
    if code == "InternalServerException":
        return NetworkManagerError.InternalServerException
    if code == "ResourceNotFoundException":
        return NetworkManagerError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return NetworkManagerError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return NetworkManagerError.ThrottlingException
    if code == "ValidationException":
        return NetworkManagerError.ValidationException
    return NetworkManagerError.Unknown(code=code)

