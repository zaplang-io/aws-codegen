# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by lookoutequipment_error_from_code.
enum LookoutEquipmentError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def lookoutequipment_error_from_code(str code) -> LookoutEquipmentError:
    if code == "AccessDeniedException":
        return LookoutEquipmentError.AccessDeniedException
    if code == "ConflictException":
        return LookoutEquipmentError.ConflictException
    if code == "InternalServerException":
        return LookoutEquipmentError.InternalServerException
    if code == "ResourceNotFoundException":
        return LookoutEquipmentError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return LookoutEquipmentError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return LookoutEquipmentError.ThrottlingException
    if code == "ValidationException":
        return LookoutEquipmentError.ValidationException
    return LookoutEquipmentError.Unknown(code=code)

