# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by mturk_requester_error_from_code.
enum MTurkError:
    RequestError
    ServiceFault
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def mturk_requester_error_from_code(str code) -> MTurkError:
    if code == "RequestError":
        return MTurkError.RequestError
    if code == "ServiceFault":
        return MTurkError.ServiceFault
    return MTurkError.Unknown(code=code)

