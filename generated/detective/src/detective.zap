# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by api_detective_error_from_code.
enum DetectiveError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    TooManyRequestsException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def api_detective_error_from_code(str code) -> DetectiveError:
    if code == "AccessDeniedException":
        return DetectiveError.AccessDeniedException
    if code == "ConflictException":
        return DetectiveError.ConflictException
    if code == "InternalServerException":
        return DetectiveError.InternalServerException
    if code == "ResourceNotFoundException":
        return DetectiveError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return DetectiveError.ServiceQuotaExceededException
    if code == "TooManyRequestsException":
        return DetectiveError.TooManyRequestsException
    if code == "ValidationException":
        return DetectiveError.ValidationException
    return DetectiveError.Unknown(code=code)

