# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by amplify_error_from_code.
enum AmplifyError:
    BadRequestException
    DependentServiceFailureException
    InternalFailureException
    LimitExceededException
    NotFoundException
    ResourceNotFoundException
    UnauthorizedException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def amplify_error_from_code(str code) -> AmplifyError:
    if code == "BadRequestException":
        return AmplifyError.BadRequestException
    if code == "DependentServiceFailureException":
        return AmplifyError.DependentServiceFailureException
    if code == "InternalFailureException":
        return AmplifyError.InternalFailureException
    if code == "LimitExceededException":
        return AmplifyError.LimitExceededException
    if code == "NotFoundException":
        return AmplifyError.NotFoundException
    if code == "ResourceNotFoundException":
        return AmplifyError.ResourceNotFoundException
    if code == "UnauthorizedException":
        return AmplifyError.UnauthorizedException
    return AmplifyError.Unknown(code=code)

