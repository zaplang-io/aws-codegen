# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by b2bi_error_from_code.
enum b2biError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def b2bi_error_from_code(str code) -> b2biError:
    if code == "AccessDeniedException":
        return b2biError.AccessDeniedException
    if code == "ConflictException":
        return b2biError.ConflictException
    if code == "InternalServerException":
        return b2biError.InternalServerException
    if code == "ResourceNotFoundException":
        return b2biError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return b2biError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return b2biError.ThrottlingException
    if code == "ValidationException":
        return b2biError.ValidationException
    return b2biError.Unknown(code=code)

