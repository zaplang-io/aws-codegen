# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by b2bi_error_from_code.
enum b2biError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def b2bi_error_from_code(str code) -> b2biError:
    if code == "AccessDeniedException":
        return b2biError.AccessDeniedException
    if code == "ConflictException":
        return b2biError.ConflictException
    if code == "InternalServerException":
        return b2biError.InternalServerException
    if code == "ResourceNotFoundException":
        return b2biError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return b2biError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return b2biError.ThrottlingException
    if code == "ValidationException":
        return b2biError.ValidationException
    return b2biError.Unknown(code=code)

# --- client ----------------------------------------------------------------

# JSON body helpers (compact, declaration-order objects): the collection
# serialization @derive(Json) does not emit yet (zaplang-io/zap#424). `_json_str`
# escapes+quotes via the prelude JSON writer; `_json_obj`/`_json_arr` comma-join
# pre-serialized members.
def b2bi_json_str(str s) -> str:
    return json.dumps(JsonValue.Str(s))

def b2bi_json_obj(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "{" + body + "}"

def b2bi_json_arr(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "[" + body + "]"

# Explicit JSON serializers for input shapes with collection/nested members
# (the @derive(Json) collection follow-up, zaplang-io/zap#424).

# Serialize AdvancedOptions to a compact JSON object (declaration order).
def advanced_options_to_json(AdvancedOptions v) -> str:
    list[str] parts = []
    if v.x12.is_some():
        auto u0 = v.x12.unwrap()
        parts.append("\"x12\":" + x12_advanced_options_to_json(u0))
    return b2bi_json_obj(parts)

