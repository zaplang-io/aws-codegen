    # SetLoadBalancerPoliciesForBackendServer
    # errors: AccessPointNotFoundException, InvalidConfigurationRequestException, PolicyNotFoundException
    def set_load_balancer_policies_for_backend_server(self, SetLoadBalancerPoliciesForBackendServerInput input) -> str:
        auto p = query.query_params("SetLoadBalancerPoliciesForBackendServer", "2012-06-01")
        p = query.query_scalar(p, "LoadBalancerName", input.LoadBalancerName)
        p = query.query_scalar(p, "InstancePort", str(input.InstancePort))
        p = query.query_list(p, "PolicyNames", "member", input.PolicyNames)
        return query.query_request(self.creds, elasticloadbalancing_service(), self.region, p)

    # SetLoadBalancerPoliciesOfListener
    # errors: AccessPointNotFoundException, InvalidConfigurationRequestException, ListenerNotFoundException, PolicyNotFoundException
    def set_load_balancer_policies_of_listener(self, SetLoadBalancerPoliciesOfListenerInput input) -> str:
        auto p = query.query_params("SetLoadBalancerPoliciesOfListener", "2012-06-01")
        p = query.query_scalar(p, "LoadBalancerName", input.LoadBalancerName)
        p = query.query_scalar(p, "LoadBalancerPort", str(input.LoadBalancerPort))
        p = query.query_list(p, "PolicyNames", "member", input.PolicyNames)
        return query.query_request(self.creds, elasticloadbalancing_service(), self.region, p)

# Construct a Elastic_Load_BalancingClient bound to credentials + region.
def elasticloadbalancing_client(core.Credentials creds, str region) -> Elastic_Load_BalancingClient:
    return Elastic_Load_BalancingClient(creds=creds, region=region)
