    # Paginator for ListIdentityPools — yields each Response page, threading the
    # NextToken -> NextToken continuation token until the output token is absent (result key: IdentityPools).
    def paginate_list_identity_pools(self, ListIdentityPoolsInput input):
        auto host = endpoints.regional_host(cognito_identity_protocol().service, self.region)
        while True:
            auto body = input.to_json()
            auto raw = awsjson.awsjson_request_now(cognito_identity_protocol(), self.creds, self.region, "ListIdentityPools", body)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

# Construct a Cognito_IdentityClient bound to credentials + region.
def cognito_identity_client(core.Credentials creds, str region) -> Cognito_IdentityClient:
    return Cognito_IdentityClient(creds=creds, region=region)
