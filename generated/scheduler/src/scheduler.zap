    # Paginator for ListScheduleGroups — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: ScheduleGroups).
    def paginate_list_schedule_groups(self, ListScheduleGroupsInput input):
        auto host = endpoints.regional_host(scheduler_service(), self.region)
        while True:
            auto raw = self.list_schedule_groups(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

    # Paginator for ListSchedules — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: Schedules).
    def paginate_list_schedules(self, ListSchedulesInput input):
        auto host = endpoints.regional_host(scheduler_service(), self.region)
        while True:
            auto raw = self.list_schedules(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

# Construct a SchedulerClient bound to credentials + region.
def scheduler_client(core.Credentials creds, str region) -> SchedulerClient:
    return SchedulerClient(creds=creds, region=region)
