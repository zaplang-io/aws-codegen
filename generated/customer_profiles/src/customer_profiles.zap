# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by profile_error_from_code.
enum Customer_ProfilesError:
    AccessDeniedException
    BadRequestException
    InternalServerException
    ResourceNotFoundException
    ThrottlingException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def profile_error_from_code(str code) -> Customer_ProfilesError:
    if code == "AccessDeniedException":
        return Customer_ProfilesError.AccessDeniedException
    if code == "BadRequestException":
        return Customer_ProfilesError.BadRequestException
    if code == "InternalServerException":
        return Customer_ProfilesError.InternalServerException
    if code == "ResourceNotFoundException":
        return Customer_ProfilesError.ResourceNotFoundException
    if code == "ThrottlingException":
        return Customer_ProfilesError.ThrottlingException
    return Customer_ProfilesError.Unknown(code=code)

