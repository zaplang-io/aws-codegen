    # Paginator for GetSimilarProfiles — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: ProfileIds).
    def paginate_get_similar_profiles(self, GetSimilarProfilesRequest input):
        auto host = endpoints.regional_host(profile_service(), self.region)
        while True:
            auto raw = self.get_similar_profiles(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

