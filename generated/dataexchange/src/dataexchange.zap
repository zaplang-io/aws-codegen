    # Paginator for ListDataGrants — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: DataGrantSummaries).
    def paginate_list_data_grants(self, ListDataGrantsRequest input):
        auto host = endpoints.regional_host(dataexchange_service(), self.region)
        while True:
            auto raw = self.list_data_grants(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

