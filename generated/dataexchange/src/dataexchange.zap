# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by dataexchange_error_from_code.
enum DataExchangeError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceLimitExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def dataexchange_error_from_code(str code) -> DataExchangeError:
    if code == "AccessDeniedException":
        return DataExchangeError.AccessDeniedException
    if code == "ConflictException":
        return DataExchangeError.ConflictException
    if code == "InternalServerException":
        return DataExchangeError.InternalServerException
    if code == "ResourceNotFoundException":
        return DataExchangeError.ResourceNotFoundException
    if code == "ServiceLimitExceededException":
        return DataExchangeError.ServiceLimitExceededException
    if code == "ThrottlingException":
        return DataExchangeError.ThrottlingException
    if code == "ValidationException":
        return DataExchangeError.ValidationException
    return DataExchangeError.Unknown(code=code)

# --- client ----------------------------------------------------------------

# Operations skipped in v0 (a member type is not yet bindable/serializable —
# a non-string/enum/int URI/query/header, a collection or non-derivable
# document member, or an unsupported httpPayload):
#   ListReceivedDataGrants (httpQuery `AcceptanceState` has unsupported type list[AcceptanceStateFilterValue])
#   SendApiAsset (httpQuery `QueryStringParameters` has unsupported type dict[str, str])

# Paginated operations (paginators-1.json) not surfaced — their operation is
# skipped above, or the continuation token is not a simple string field:
#   ListReceivedDataGrants (operation not generated)

# Per-operation JSON document bodies (the unbound "document" members of an
# operation's input, serialized with @derive(Json)).

@derive(Json)
struct RevokeRevisionDocument:
    # document members of RevokeRevision
    str RevocationComment

@derive(Json)
struct UpdateAssetDocument:
    # document members of UpdateAsset
    str Name

@derive(Json)
struct UpdateDataSetDocument:
    # document members of UpdateDataSet
    Optional[str] Description
    Optional[str] Name

@derive(Json)
struct UpdateEventActionDocument:
    # document members of UpdateEventAction
    Optional[Action] Action

@derive(Json)
struct UpdateRevisionDocument:
    # document members of UpdateRevision
    Optional[str] Comment
    Optional[bool] Finalized

# JSON body helpers (compact, declaration-order objects): the collection
# serialization @derive(Json) does not emit yet (zaplang-io/zap#424). `_json_str`
# escapes+quotes via the prelude JSON writer; `_json_obj`/`_json_arr` comma-join
# pre-serialized members.
def dataexchange_json_str(str s) -> str:
    return json.dumps(JsonValue.Str(s))

def dataexchange_json_obj(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "{" + body + "}"

def dataexchange_json_arr(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "[" + body + "]"

# A timestamp as an ISO-8601 JSON string (`@json(timestamp="iso8601")`).
def dataexchange_json_ts_iso(DateTime dt) -> str:
    return "\"" + datetime.strftime(dt, "%Y-%m-%dT%H:%M:%SZ") + "\""

