    # Paginator for ListDiscoverers — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: Discoverers).
    def paginate_list_discoverers(self, ListDiscoverersRequest input):
        auto host = endpoints.regional_host(schemas_service(), self.region)
        while True:
            auto raw = self.list_discoverers(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

