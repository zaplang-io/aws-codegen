# --- errors ----------------------------------------------------------------

# Typed service errors (#361): the per-service enum + classifier + name
# dispatcher emitted on top of `aws_core.errors` (DECISIONS.md D-0006). One
# bare variant per modeled error shape, plus an open-enum `Unknown(str code)`
# catch-all, so a caller built against this model keeps working when the
# service adds an error. The raw wire code is
# the restJson1 X-Amzn-ErrorType header or body `__type`.
# `errors.error_code` normalizes it to the bare shape name before matching;
# the base carrier, the X-Amzn-ErrorType fallback and the raise/check bridge
# are inherited from `aws_core.errors` and not re-emitted here.
enum schemasErrorKind:
    BadRequestException
    ConflictException
    ForbiddenException
    GoneException
    InternalServerErrorException
    NotFoundException
    PreconditionFailedException
    ServiceUnavailableException
    TooManyRequestsException
    UnauthorizedException
    Unknown(str code)

# Classify an AWS error code into `schemasErrorKind`,
# normalizing first (`errors.error_code` strips any namespace/suffix) then
# matching by name; an unmodeled code becomes `Unknown(name)`, carrying it.
def schemas_error_kind(str code) -> schemasErrorKind:
    auto name = errors.error_code(code)
    if name == "BadRequestException":
        return schemasErrorKind.BadRequestException
    if name == "ConflictException":
        return schemasErrorKind.ConflictException
    if name == "ForbiddenException":
        return schemasErrorKind.ForbiddenException
    if name == "GoneException":
        return schemasErrorKind.GoneException
    if name == "InternalServerErrorException":
        return schemasErrorKind.InternalServerErrorException
    if name == "NotFoundException":
        return schemasErrorKind.NotFoundException
    if name == "PreconditionFailedException":
        return schemasErrorKind.PreconditionFailedException
    if name == "ServiceUnavailableException":
        return schemasErrorKind.ServiceUnavailableException
    if name == "TooManyRequestsException":
        return schemasErrorKind.TooManyRequestsException
    if name == "UnauthorizedException":
        return schemasErrorKind.UnauthorizedException
    return schemasErrorKind.Unknown(name)

# The canonical name of a classified error. This `match` is exhaustive over
# every variant (the compiler enforces it, so a new variant forces it to be
# updated — the generator emits the enum and dispatcher together) and is
# module-local, so each pattern is a two-segment `Enum.Variant` — the portable
# form until the compiler resolves module-qualified variant patterns in a
# caller's own `match` (DECISIONS.md D-0006). `Unknown` carries its code.
def schemas_error_name(schemasErrorKind k) -> str:
    match k:
        case schemasErrorKind.BadRequestException:
            return "BadRequestException"
        case schemasErrorKind.ConflictException:
            return "ConflictException"
        case schemasErrorKind.ForbiddenException:
            return "ForbiddenException"
        case schemasErrorKind.GoneException:
            return "GoneException"
        case schemasErrorKind.InternalServerErrorException:
            return "InternalServerErrorException"
        case schemasErrorKind.NotFoundException:
            return "NotFoundException"
        case schemasErrorKind.PreconditionFailedException:
            return "PreconditionFailedException"
        case schemasErrorKind.ServiceUnavailableException:
            return "ServiceUnavailableException"
        case schemasErrorKind.TooManyRequestsException:
            return "TooManyRequestsException"
        case schemasErrorKind.UnauthorizedException:
            return "UnauthorizedException"
        case schemasErrorKind.Unknown(c):
            return "Unknown(" + c + ")"

