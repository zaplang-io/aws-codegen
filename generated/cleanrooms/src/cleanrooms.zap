# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by cleanrooms_error_from_code.
enum CleanRoomsError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def cleanrooms_error_from_code(str code) -> CleanRoomsError:
    if code == "AccessDeniedException":
        return CleanRoomsError.AccessDeniedException
    if code == "ConflictException":
        return CleanRoomsError.ConflictException
    if code == "InternalServerException":
        return CleanRoomsError.InternalServerException
    if code == "ResourceNotFoundException":
        return CleanRoomsError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return CleanRoomsError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return CleanRoomsError.ThrottlingException
    if code == "ValidationException":
        return CleanRoomsError.ValidationException
    return CleanRoomsError.Unknown(code=code)

