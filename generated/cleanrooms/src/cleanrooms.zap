@derive(Json)
struct UpdateProtectedJobDocument:
    # document members of UpdateProtectedJob
    str targetStatus

@derive(Json)
struct UpdateProtectedQueryDocument:
    # document members of UpdateProtectedQuery
    str targetStatus

