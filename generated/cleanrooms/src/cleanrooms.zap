# Per-operation JSON document bodies (the unbound "document" members of an
# operation's input, serialized with @derive(Json)).

@derive(Json)
struct DisallowIntermediateTableDocument:
    # document members of DisallowIntermediateTable
    str intermediateTableName
    Optional[bool] includeDescendants

@derive(Json)
struct PopulateIdMappingTableDocument:
    # document members of PopulateIdMappingTable
    Optional[JobType] jobType

@derive(Json)
struct PreviewPrivacyImpactDocument:
    # document members of PreviewPrivacyImpact
    PreviewPrivacyImpactParametersInput parameters

@derive(Json)
struct StartAnalysisLogExportDocument:
    # document members of StartAnalysisLogExport
    str analysisId
    str analysisType
    AnalysisLogExportResultConfiguration resultConfiguration

@derive(Json)
struct UpdateAnalysisTemplateDocument:
    # document members of UpdateAnalysisTemplate
    Optional[str] description

@derive(Json)
struct UpdateCollaborationDocument:
    # document members of UpdateCollaboration
    Optional[str] name
    Optional[str] description
