@derive(Json)
struct UpdateCollaborationChangeRequestDocument:
    # document members of UpdateCollaborationChangeRequest
    ChangeRequestAction action

@derive(Json)
struct UpdateConfiguredAudienceModelAssociationDocument:
    # document members of UpdateConfiguredAudienceModelAssociation
    Optional[str] description
    Optional[str] name

@derive(Json)
struct UpdateConfiguredTableAssociationDocument:
    # document members of UpdateConfiguredTableAssociation
    Optional[str] description
    Optional[str] roleArn

@derive(Json)
struct UpdateIdMappingTableDocument:
    # document members of UpdateIdMappingTable
    Optional[str] description
