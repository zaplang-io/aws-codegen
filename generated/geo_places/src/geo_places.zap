# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by geo_places_error_from_code.
enum Geo_PlacesError:
    AccessDeniedException
    InternalServerException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def geo_places_error_from_code(str code) -> Geo_PlacesError:
    if code == "AccessDeniedException":
        return Geo_PlacesError.AccessDeniedException
    if code == "InternalServerException":
        return Geo_PlacesError.InternalServerException
    if code == "ThrottlingException":
        return Geo_PlacesError.ThrottlingException
    if code == "ValidationException":
        return Geo_PlacesError.ValidationException
    return Geo_PlacesError.Unknown(code=code)

