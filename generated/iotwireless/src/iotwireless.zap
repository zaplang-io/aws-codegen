# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by api_iotwireless_error_from_code.
enum IoT_WirelessError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ThrottlingException
    TooManyTagsException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def api_iotwireless_error_from_code(str code) -> IoT_WirelessError:
    if code == "AccessDeniedException":
        return IoT_WirelessError.AccessDeniedException
    if code == "ConflictException":
        return IoT_WirelessError.ConflictException
    if code == "InternalServerException":
        return IoT_WirelessError.InternalServerException
    if code == "ResourceNotFoundException":
        return IoT_WirelessError.ResourceNotFoundException
    if code == "ThrottlingException":
        return IoT_WirelessError.ThrottlingException
    if code == "TooManyTagsException":
        return IoT_WirelessError.TooManyTagsException
    if code == "ValidationException":
        return IoT_WirelessError.ValidationException
    return IoT_WirelessError.Unknown(code=code)

