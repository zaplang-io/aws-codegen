    # Paginator for GetWorkUnits — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: WorkUnitRanges).
    def paginate_get_work_units(self, GetWorkUnitsRequest input):
        auto host = endpoints.regional_host(lakeformation_service(), self.region)
        while True:
            auto raw = self.get_work_units(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

