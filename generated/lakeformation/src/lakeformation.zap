    Optional[DeleteObjectInput] DeleteObject

# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by lakeformation_error_from_code.
enum LakeFormationError:
    AccessDeniedException
    AlreadyExistsException
    ConcurrentModificationException
    ConflictException
    EntityNotFoundException
    ExpiredException
    GlueEncryptionException
    InternalServiceException
    InvalidInputException
    OperationTimeoutException
    PermissionTypeMismatchException
    ResourceNotReadyException
    ResourceNumberLimitExceededException
    StatisticsNotReadyYetException
    ThrottledException
    TransactionCanceledException
    TransactionCommitInProgressException
    TransactionCommittedException
    WorkUnitsNotReadyYetException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def lakeformation_error_from_code(str code) -> LakeFormationError:
    if code == "AccessDeniedException":
        return LakeFormationError.AccessDeniedException
    if code == "AlreadyExistsException":
        return LakeFormationError.AlreadyExistsException
    if code == "ConcurrentModificationException":
        return LakeFormationError.ConcurrentModificationException
    if code == "ConflictException":
        return LakeFormationError.ConflictException
    if code == "EntityNotFoundException":
        return LakeFormationError.EntityNotFoundException
    if code == "ExpiredException":
        return LakeFormationError.ExpiredException
    if code == "GlueEncryptionException":
        return LakeFormationError.GlueEncryptionException
    if code == "InternalServiceException":
        return LakeFormationError.InternalServiceException
    if code == "InvalidInputException":
        return LakeFormationError.InvalidInputException
    if code == "OperationTimeoutException":
        return LakeFormationError.OperationTimeoutException
    if code == "PermissionTypeMismatchException":
        return LakeFormationError.PermissionTypeMismatchException
    if code == "ResourceNotReadyException":
        return LakeFormationError.ResourceNotReadyException
    if code == "ResourceNumberLimitExceededException":
        return LakeFormationError.ResourceNumberLimitExceededException
    if code == "StatisticsNotReadyYetException":
        return LakeFormationError.StatisticsNotReadyYetException
    if code == "ThrottledException":
        return LakeFormationError.ThrottledException
    if code == "TransactionCanceledException":
        return LakeFormationError.TransactionCanceledException
    if code == "TransactionCommitInProgressException":
        return LakeFormationError.TransactionCommitInProgressException
    if code == "TransactionCommittedException":
        return LakeFormationError.TransactionCommittedException
    if code == "WorkUnitsNotReadyYetException":
        return LakeFormationError.WorkUnitsNotReadyYetException
    return LakeFormationError.Unknown(code=code)

