    # Paginator for ListCentralizationRulesForOrganization — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: CentralizationRuleSummaries).
    def paginate_list_centralization_rules_for_organization(self, ListCentralizationRulesForOrganizationInput input):
        auto host = endpoints.regional_host(observabilityadmin_service(), self.region)
        while True:
            auto raw = self.list_centralization_rules_for_organization(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

