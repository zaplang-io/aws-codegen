# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by observabilityadmin_error_from_code.
enum ObservabilityAdminError:
    AccessDeniedException
    ConflictException
    InternalServerException
    InvalidStateException
    ResourceNotFoundException
    ServiceQuotaExceededException
    TooManyRequestsException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def observabilityadmin_error_from_code(str code) -> ObservabilityAdminError:
    if code == "AccessDeniedException":
        return ObservabilityAdminError.AccessDeniedException
    if code == "ConflictException":
        return ObservabilityAdminError.ConflictException
    if code == "InternalServerException":
        return ObservabilityAdminError.InternalServerException
    if code == "InvalidStateException":
        return ObservabilityAdminError.InvalidStateException
    if code == "ResourceNotFoundException":
        return ObservabilityAdminError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return ObservabilityAdminError.ServiceQuotaExceededException
    if code == "TooManyRequestsException":
        return ObservabilityAdminError.TooManyRequestsException
    if code == "ValidationException":
        return ObservabilityAdminError.ValidationException
    return ObservabilityAdminError.Unknown(code=code)

