    # Paginator for DescribeTopicPartitions — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: Partitions).
    def paginate_describe_topic_partitions(self, DescribeTopicPartitionsRequest input):
        auto host = endpoints.regional_host(kafka_service(), self.region)
        while True:
            auto raw = self.describe_topic_partitions(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

