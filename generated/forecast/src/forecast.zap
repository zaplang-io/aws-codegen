# A bound forecast client: credentials + region, threaded into every operation.
struct forecastClient:
    core.Credentials creds
    str region

    # DeleteDataset
    # errors: InvalidInputException, ResourceInUseException, ResourceNotFoundException
    def delete_dataset(self, DeleteDatasetRequest input) -> str:
        auto body = input.to_json()
        return awsjson.awsjson_request_now(forecast_protocol(), self.creds, self.region, "DeleteDataset", body)

    # DeleteDatasetGroup
    # errors: InvalidInputException, ResourceInUseException, ResourceNotFoundException
    def delete_dataset_group(self, DeleteDatasetGroupRequest input) -> str:
        auto body = input.to_json()
        return awsjson.awsjson_request_now(forecast_protocol(), self.creds, self.region, "DeleteDatasetGroup", body)

    # DeleteDatasetImportJob
    # errors: InvalidInputException, ResourceInUseException, ResourceNotFoundException
    def delete_dataset_import_job(self, DeleteDatasetImportJobRequest input) -> str:
        auto body = input.to_json()
        return awsjson.awsjson_request_now(forecast_protocol(), self.creds, self.region, "DeleteDatasetImportJob", body)

    # DeleteExplainability
    # errors: InvalidInputException, ResourceInUseException, ResourceNotFoundException
    def delete_explainability(self, DeleteExplainabilityRequest input) -> str:
        auto body = input.to_json()
        return awsjson.awsjson_request_now(forecast_protocol(), self.creds, self.region, "DeleteExplainability", body)

    # DeleteExplainabilityExport
    # errors: InvalidInputException, ResourceInUseException, ResourceNotFoundException
    def delete_explainability_export(self, DeleteExplainabilityExportRequest input) -> str:
        auto body = input.to_json()
        return awsjson.awsjson_request_now(forecast_protocol(), self.creds, self.region, "DeleteExplainabilityExport", body)

