# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by forecast_error_from_code.
enum forecastError:
    InvalidInputException
    InvalidNextTokenException
    LimitExceededException
    ResourceAlreadyExistsException
    ResourceInUseException
    ResourceNotFoundException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def forecast_error_from_code(str code) -> forecastError:
    if code == "InvalidInputException":
        return forecastError.InvalidInputException
    if code == "InvalidNextTokenException":
        return forecastError.InvalidNextTokenException
    if code == "LimitExceededException":
        return forecastError.LimitExceededException
    if code == "ResourceAlreadyExistsException":
        return forecastError.ResourceAlreadyExistsException
    if code == "ResourceInUseException":
        return forecastError.ResourceInUseException
    if code == "ResourceNotFoundException":
        return forecastError.ResourceNotFoundException
    return forecastError.Unknown(code=code)

# --- client ----------------------------------------------------------------

# JSON body helpers (compact, declaration-order objects): the collection
# serialization @derive(Json) does not emit yet (zaplang-io/zap#424). `_json_str`
# escapes+quotes via the prelude JSON writer; `_json_obj`/`_json_arr` comma-join
# pre-serialized members.
def forecast_json_str(str s) -> str:
    return json.dumps(JsonValue.Str(s))

def forecast_json_obj(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "{" + body + "}"

def forecast_json_arr(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "[" + body + "]"

# Explicit JSON serializers for input shapes with collection/nested members
# (the @derive(Json) collection follow-up, zaplang-io/zap#424).

# Serialize AdditionalDataset to a compact JSON object (declaration order).
def additional_dataset_to_json(AdditionalDataset v) -> str:
    list[str] parts = []
    parts.append("\"Name\":" + forecast_json_str(v.Name))
    if v.Configuration.is_some():
        auto u0 = v.Configuration.unwrap()
        list[str] m1 = []
        for k1 in sorted(u0.keys()):
            list[str] e2 = []
            for x2 in u0[k1]:
                e2.append(forecast_json_str(x2))
            m1.append(forecast_json_str(k1) + ":" + forecast_json_arr(e2))
        parts.append("\"Configuration\":" + forecast_json_obj(m1))
    return forecast_json_obj(parts)

