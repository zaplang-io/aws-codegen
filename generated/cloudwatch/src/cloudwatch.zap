# --- errors ----------------------------------------------------------------

# Typed service errors (#361): the per-service enum + classifier + name
# dispatcher emitted on top of `aws_core.errors` (DECISIONS.md D-0006). One
# bare variant per modeled error shape, plus an open-enum `Unknown(str code)`
# catch-all, so a caller built against this model keeps working when the
# service adds an error. The raw wire code is
# the smithy-rpc-v2-cbor body `__type`.
# `errors.error_code` normalizes it to the bare shape name before matching;
# the base carrier, the X-Amzn-ErrorType fallback and the raise/check bridge
# are inherited from `aws_core.errors` and not re-emitted here.
enum CloudWatchErrorKind:
    ConcurrentModificationException
    ConflictException
    DashboardInvalidInputError
    DashboardNotFoundError
    InternalServiceFault
    InvalidFormatFault
    InvalidNextToken
    InvalidParameterCombinationException
    InvalidParameterValueException
    KmsAccessDeniedException
    KmsKeyDisabledException
    KmsKeyNotFoundException
    LimitExceededException
    LimitExceededFault
    MissingRequiredParameterException
    ResourceConflict
    ResourceNotFound
    ResourceNotFoundException
    ValidationException
    Unknown(str code)

# Classify an AWS error code into `CloudWatchErrorKind`,
# normalizing first (`errors.error_code` strips any namespace/suffix) then
# matching by name; an unmodeled code becomes `Unknown(name)`, carrying it.
def monitoring_error_kind(str code) -> CloudWatchErrorKind:
    auto name = errors.error_code(code)
    if name == "ConcurrentModificationException":
        return CloudWatchErrorKind.ConcurrentModificationException
    if name == "ConflictException":
        return CloudWatchErrorKind.ConflictException
    if name == "DashboardInvalidInputError":
        return CloudWatchErrorKind.DashboardInvalidInputError
    if name == "DashboardNotFoundError":
        return CloudWatchErrorKind.DashboardNotFoundError
    if name == "InternalServiceFault":
        return CloudWatchErrorKind.InternalServiceFault
    if name == "InvalidFormatFault":
        return CloudWatchErrorKind.InvalidFormatFault
    if name == "InvalidNextToken":
        return CloudWatchErrorKind.InvalidNextToken
    if name == "InvalidParameterCombinationException":
        return CloudWatchErrorKind.InvalidParameterCombinationException
    if name == "InvalidParameterValueException":
        return CloudWatchErrorKind.InvalidParameterValueException
    if name == "KmsAccessDeniedException":
        return CloudWatchErrorKind.KmsAccessDeniedException
    if name == "KmsKeyDisabledException":
        return CloudWatchErrorKind.KmsKeyDisabledException
    if name == "KmsKeyNotFoundException":
        return CloudWatchErrorKind.KmsKeyNotFoundException
    if name == "LimitExceededException":
        return CloudWatchErrorKind.LimitExceededException
    if name == "LimitExceededFault":
        return CloudWatchErrorKind.LimitExceededFault
    if name == "MissingRequiredParameterException":
        return CloudWatchErrorKind.MissingRequiredParameterException
    if name == "ResourceConflict":
        return CloudWatchErrorKind.ResourceConflict
    if name == "ResourceNotFound":
        return CloudWatchErrorKind.ResourceNotFound
    if name == "ResourceNotFoundException":
        return CloudWatchErrorKind.ResourceNotFoundException
    if name == "ValidationException":
        return CloudWatchErrorKind.ValidationException
    return CloudWatchErrorKind.Unknown(name)

# The canonical name of a classified error. This `match` is exhaustive over
# every variant (the compiler enforces it, so a new variant forces it to be
# updated — the generator emits the enum and dispatcher together) and is
# module-local, so each pattern is a two-segment `Enum.Variant` — the portable
# form until the compiler resolves module-qualified variant patterns in a
# caller's own `match` (DECISIONS.md D-0006). `Unknown` carries its code.
def monitoring_error_name(CloudWatchErrorKind k) -> str:
    match k:
        case CloudWatchErrorKind.ConcurrentModificationException:
            return "ConcurrentModificationException"
        case CloudWatchErrorKind.ConflictException:
            return "ConflictException"
        case CloudWatchErrorKind.DashboardInvalidInputError:
            return "DashboardInvalidInputError"
        case CloudWatchErrorKind.DashboardNotFoundError:
            return "DashboardNotFoundError"
        case CloudWatchErrorKind.InternalServiceFault:
            return "InternalServiceFault"
        case CloudWatchErrorKind.InvalidFormatFault:
            return "InvalidFormatFault"
        case CloudWatchErrorKind.InvalidNextToken:
            return "InvalidNextToken"
        case CloudWatchErrorKind.InvalidParameterCombinationException:
            return "InvalidParameterCombinationException"
        case CloudWatchErrorKind.InvalidParameterValueException:
            return "InvalidParameterValueException"
        case CloudWatchErrorKind.KmsAccessDeniedException:
            return "KmsAccessDeniedException"
        case CloudWatchErrorKind.KmsKeyDisabledException:
            return "KmsKeyDisabledException"
        case CloudWatchErrorKind.KmsKeyNotFoundException:
            return "KmsKeyNotFoundException"
        case CloudWatchErrorKind.LimitExceededException:
            return "LimitExceededException"
        case CloudWatchErrorKind.LimitExceededFault:
            return "LimitExceededFault"
        case CloudWatchErrorKind.MissingRequiredParameterException:
            return "MissingRequiredParameterException"
        case CloudWatchErrorKind.ResourceConflict:
            return "ResourceConflict"
        case CloudWatchErrorKind.ResourceNotFound:
            return "ResourceNotFound"
        case CloudWatchErrorKind.ResourceNotFoundException:
            return "ResourceNotFoundException"
        case CloudWatchErrorKind.ValidationException:
            return "ValidationException"
        case CloudWatchErrorKind.Unknown(c):
            return "Unknown(" + c + ")"

