# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def airflow_error_from_code(str code) -> MWAAError:
    if code == "AccessDeniedException":
        return MWAAError.AccessDeniedException
    if code == "InternalServerException":
        return MWAAError.InternalServerException
    if code == "ResourceNotFoundException":
        return MWAAError.ResourceNotFoundException
    if code == "RestApiClientException":
        return MWAAError.RestApiClientException
    if code == "RestApiServerException":
        return MWAAError.RestApiServerException
    if code == "ServiceUnavailableException":
        return MWAAError.ServiceUnavailableException
    if code == "ValidationException":
        return MWAAError.ValidationException
    return MWAAError.Unknown(code=code)

