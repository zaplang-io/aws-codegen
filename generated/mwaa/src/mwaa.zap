    # Paginator for ListEnvironments — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: Environments).
    def paginate_list_environments(self, ListEnvironmentsInput input):
        auto host = endpoints.regional_host(airflow_service(), self.region)
        while True:
            auto raw = self.list_environments(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

# Construct a MWAAClient bound to credentials + region.
def airflow_client(core.Credentials creds, str region) -> MWAAClient:
    return MWAAClient(creds=creds, region=region)
