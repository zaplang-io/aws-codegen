# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by medialive_error_from_code.
enum MediaLiveError:
    BadGatewayException
    BadRequestException
    ConflictException
    ForbiddenException
    GatewayTimeoutException
    InternalServerErrorException
    NotFoundException
    TooManyRequestsException
    UnprocessableEntityException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def medialive_error_from_code(str code) -> MediaLiveError:
    if code == "BadGatewayException":
        return MediaLiveError.BadGatewayException
    if code == "BadRequestException":
        return MediaLiveError.BadRequestException
    if code == "ConflictException":
        return MediaLiveError.ConflictException
    if code == "ForbiddenException":
        return MediaLiveError.ForbiddenException
    if code == "GatewayTimeoutException":
        return MediaLiveError.GatewayTimeoutException
    if code == "InternalServerErrorException":
        return MediaLiveError.InternalServerErrorException
    if code == "NotFoundException":
        return MediaLiveError.NotFoundException
    if code == "TooManyRequestsException":
        return MediaLiveError.TooManyRequestsException
    if code == "UnprocessableEntityException":
        return MediaLiveError.UnprocessableEntityException
    return MediaLiveError.Unknown(code=code)

