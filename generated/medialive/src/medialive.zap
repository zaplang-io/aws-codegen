# Per-operation JSON document bodies (the unbound "document" members of an
# operation's input, serialized with @derive(Json)).

@derive(Json)
struct ClaimDeviceDocument:
    # document members of ClaimDevice
    Optional[str] Id

@derive(Json)
struct CreateMultiplexProgramDocument:
    # document members of CreateMultiplexProgram
    MultiplexProgramSettings MultiplexProgramSettings
    str ProgramName
    str RequestId

@derive(Json)
struct RebootInputDeviceDocument:
    # document members of RebootInputDevice
    Optional[RebootInputDeviceForce] Force

@derive(Json)
struct StartMonitorDeploymentDocument:
    # document members of StartMonitorDeployment
    Optional[bool] DryRun

@derive(Json)
struct TransferInputDeviceDocument:
    # document members of TransferInputDevice
    Optional[str] TargetCustomerId
    Optional[str] TargetRegion
    Optional[str] TransferMessage

@derive(Json)
struct UpdateAccountConfigurationDocument:
    # document members of UpdateAccountConfiguration
    Optional[AccountConfiguration] AccountConfiguration

@derive(Json)
struct UpdateCloudWatchAlarmTemplateDocument:
    # document members of UpdateCloudWatchAlarmTemplate
    Optional[CloudWatchAlarmTemplateComparisonOperator] ComparisonOperator
    Optional[int64] DatapointsToAlarm
    Optional[str] Description
    Optional[int64] EvaluationPeriods
    Optional[str] GroupIdentifier
    Optional[str] MetricName
    Optional[str] Name
    Optional[int64] Period
    Optional[CloudWatchAlarmTemplateStatistic] Statistic
    Optional[CloudWatchAlarmTemplateTargetResourceType] TargetResourceType
    Optional[float64] Threshold
    Optional[CloudWatchAlarmTemplateTreatMissingData] TreatMissingData

@derive(Json)
struct UpdateCloudWatchAlarmTemplateGroupDocument:
    # document members of UpdateCloudWatchAlarmTemplateGroup
    Optional[str] Description

@derive(Json)
struct UpdateEventBridgeRuleTemplateGroupDocument:
    # document members of UpdateEventBridgeRuleTemplateGroup
    Optional[str] Description

@derive(Json)
struct UpdateMultiplexProgramDocument:
    # document members of UpdateMultiplexProgram
    Optional[MultiplexProgramSettings] MultiplexProgramSettings

@derive(Json)
struct UpdateNodeStateDocument:
    # document members of UpdateNodeState
    Optional[UpdateNodeState] State

@derive(Json)
struct UpdateReservationDocument:
    # document members of UpdateReservation
    Optional[str] Name
    Optional[RenewalSettings] RenewalSettings

@derive(Json)
struct UpdateSdiSourceDocument:
    # document members of UpdateSdiSource
    Optional[SdiSourceMode] Mode
    Optional[str] Name
    Optional[SdiSourceType] Type

