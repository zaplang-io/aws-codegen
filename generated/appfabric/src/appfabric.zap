# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def appfabric_error_from_code(str code) -> AppFabricError:
    if code == "AccessDeniedException":
        return AppFabricError.AccessDeniedException
    if code == "ConflictException":
        return AppFabricError.ConflictException
    if code == "InternalServerException":
        return AppFabricError.InternalServerException
    if code == "ResourceNotFoundException":
        return AppFabricError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return AppFabricError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return AppFabricError.ThrottlingException
    if code == "ValidationException":
        return AppFabricError.ValidationException
    return AppFabricError.Unknown(code=code)

