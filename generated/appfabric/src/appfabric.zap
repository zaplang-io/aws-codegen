    # Paginator for ListAppAuthorizations — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: appAuthorizationSummaryList).
    def paginate_list_app_authorizations(self, ListAppAuthorizationsRequest input):
        auto host = endpoints.regional_host(appfabric_service(), self.region)
        while True:
            auto raw = self.list_app_authorizations(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

