    # Paginator for ListDatasets — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: Datasets).
    def paginate_list_datasets(self, ListDatasetsRequest input):
        auto host = endpoints.regional_host(databrew_service(), self.region)
        while True:
            auto raw = self.list_datasets(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

