# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by databrew_error_from_code.
enum DataBrewError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def databrew_error_from_code(str code) -> DataBrewError:
    if code == "AccessDeniedException":
        return DataBrewError.AccessDeniedException
    if code == "ConflictException":
        return DataBrewError.ConflictException
    if code == "InternalServerException":
        return DataBrewError.InternalServerException
    if code == "ResourceNotFoundException":
        return DataBrewError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return DataBrewError.ServiceQuotaExceededException
    if code == "ValidationException":
        return DataBrewError.ValidationException
    return DataBrewError.Unknown(code=code)

