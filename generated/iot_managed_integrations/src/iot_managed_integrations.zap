# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def api_iotmanagedintegrations_error_from_code(str code) -> IoT_Managed_IntegrationsError:
    if code == "AccessDeniedException":
        return IoT_Managed_IntegrationsError.AccessDeniedException
    if code == "ConflictException":
        return IoT_Managed_IntegrationsError.ConflictException
    if code == "InternalFailureException":
        return IoT_Managed_IntegrationsError.InternalFailureException
    if code == "InternalServerException":
        return IoT_Managed_IntegrationsError.InternalServerException
    if code == "InvalidRequestException":
        return IoT_Managed_IntegrationsError.InvalidRequestException
    if code == "LimitExceededException":
        return IoT_Managed_IntegrationsError.LimitExceededException
    if code == "ResourceNotFoundException":
        return IoT_Managed_IntegrationsError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return IoT_Managed_IntegrationsError.ServiceQuotaExceededException
    if code == "ServiceUnavailableException":
        return IoT_Managed_IntegrationsError.ServiceUnavailableException
    if code == "ThrottlingException":
        return IoT_Managed_IntegrationsError.ThrottlingException
    if code == "UnauthorizedException":
        return IoT_Managed_IntegrationsError.UnauthorizedException
    if code == "ValidationException":
        return IoT_Managed_IntegrationsError.ValidationException
    return IoT_Managed_IntegrationsError.Unknown(code=code)

