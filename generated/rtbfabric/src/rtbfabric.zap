    # Paginator for ListCertificateAssociations — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: certificateAssociations).
    def paginate_list_certificate_associations(self, ListCertificateAssociationsRequest input):
        auto host = endpoints.regional_host(rtbfabric_service(), self.region)
        while True:
            auto raw = self.list_certificate_associations(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

