# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by rtbfabric_error_from_code.
enum RTBFabricError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def rtbfabric_error_from_code(str code) -> RTBFabricError:
    if code == "AccessDeniedException":
        return RTBFabricError.AccessDeniedException
    if code == "ConflictException":
        return RTBFabricError.ConflictException
    if code == "InternalServerException":
        return RTBFabricError.InternalServerException
    if code == "ResourceNotFoundException":
        return RTBFabricError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return RTBFabricError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return RTBFabricError.ThrottlingException
    if code == "ValidationException":
        return RTBFabricError.ValidationException
    return RTBFabricError.Unknown(code=code)

