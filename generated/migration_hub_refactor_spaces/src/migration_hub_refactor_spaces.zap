    if code == "ResourceNotFoundException":
        return Migration_Hub_Refactor_SpacesError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return Migration_Hub_Refactor_SpacesError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return Migration_Hub_Refactor_SpacesError.ThrottlingException
    if code == "ValidationException":
