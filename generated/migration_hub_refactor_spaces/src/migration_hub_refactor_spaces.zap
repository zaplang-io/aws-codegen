    # Paginator for ListApplications — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: ApplicationSummaryList).
    def paginate_list_applications(self, ListApplicationsRequest input):
        auto host = endpoints.regional_host(refactor_spaces_service(), self.region)
        while True:
            auto raw = self.list_applications(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

