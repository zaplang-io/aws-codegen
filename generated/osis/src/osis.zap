    # Paginator for ListPipelineEndpointConnections — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: PipelineEndpointConnections).
    def paginate_list_pipeline_endpoint_connections(self, ListPipelineEndpointConnectionsRequest input):
        auto host = endpoints.regional_host(osis_service(), self.region)
        while True:
            auto raw = self.list_pipeline_endpoint_connections(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

    # Paginator for ListPipelineEndpoints — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: PipelineEndpoints).
    def paginate_list_pipeline_endpoints(self, ListPipelineEndpointsRequest input):
