# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by osis_error_from_code.
enum OSISError:
    AccessDeniedException
    ConflictException
    DisabledOperationException
    InternalException
    InvalidPaginationTokenException
    LimitExceededException
    ResourceAlreadyExistsException
    ResourceNotFoundException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def osis_error_from_code(str code) -> OSISError:
    if code == "AccessDeniedException":
        return OSISError.AccessDeniedException
    if code == "ConflictException":
        return OSISError.ConflictException
    if code == "DisabledOperationException":
        return OSISError.DisabledOperationException
    if code == "InternalException":
        return OSISError.InternalException
    if code == "InvalidPaginationTokenException":
        return OSISError.InvalidPaginationTokenException
    if code == "LimitExceededException":
        return OSISError.LimitExceededException
    if code == "ResourceAlreadyExistsException":
        return OSISError.ResourceAlreadyExistsException
    if code == "ResourceNotFoundException":
        return OSISError.ResourceNotFoundException
    if code == "ValidationException":
        return OSISError.ValidationException
    return OSISError.Unknown(code=code)

