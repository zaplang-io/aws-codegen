        while True:
            auto raw = self.list_support_permit_requests(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

# Construct a SupportAuthZClient bound to credentials + region.
def supportauthz_client(core.Credentials creds, str region) -> SupportAuthZClient:
    return SupportAuthZClient(creds=creds, region=region)
