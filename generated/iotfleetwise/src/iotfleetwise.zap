        parts.append("\"sensor\":" + sensor_to_json(u1))
    if v.actuator.is_some():
        auto u2 = v.actuator.unwrap()
        parts.append("\"actuator\":" + actuator_to_json(u2))
    if v.attribute.is_some():
        auto u3 = v.attribute.unwrap()
