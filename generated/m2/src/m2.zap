# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by m2_error_from_code.
enum m2Error:
    AccessDeniedException
    ConflictException
    ExecutionTimeoutException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ServiceUnavailableException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def m2_error_from_code(str code) -> m2Error:
    if code == "AccessDeniedException":
        return m2Error.AccessDeniedException
    if code == "ConflictException":
        return m2Error.ConflictException
    if code == "ExecutionTimeoutException":
        return m2Error.ExecutionTimeoutException
    if code == "InternalServerException":
        return m2Error.InternalServerException
    if code == "ResourceNotFoundException":
        return m2Error.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return m2Error.ServiceQuotaExceededException
    if code == "ServiceUnavailableException":
        return m2Error.ServiceUnavailableException
    if code == "ThrottlingException":
        return m2Error.ThrottlingException
    if code == "ValidationException":
        return m2Error.ValidationException
    return m2Error.Unknown(code=code)

