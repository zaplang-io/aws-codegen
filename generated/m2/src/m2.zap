    # Paginator for ListApplicationVersions — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: applicationVersions).
    def paginate_list_application_versions(self, ListApplicationVersionsRequest input):
        auto host = endpoints.regional_host(m2_service(), self.region)
        while True:
            auto raw = self.list_application_versions(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

