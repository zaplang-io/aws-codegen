                break
            input.nextToken = Optional.Some(np.token)

    # Paginator for ListCoreDevices — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: coreDevices).
    def paginate_list_core_devices(self, ListCoreDevicesRequest input):
        auto host = endpoints.regional_host(greengrass_service(), self.region)
        while True:
            auto raw = self.list_core_devices(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

