# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by voiceid_error_from_code.
enum Voice_IDError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def voiceid_error_from_code(str code) -> Voice_IDError:
    if code == "AccessDeniedException":
        return Voice_IDError.AccessDeniedException
    if code == "ConflictException":
        return Voice_IDError.ConflictException
    if code == "InternalServerException":
        return Voice_IDError.InternalServerException
    if code == "ResourceNotFoundException":
        return Voice_IDError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return Voice_IDError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return Voice_IDError.ThrottlingException
    if code == "ValidationException":
        return Voice_IDError.ValidationException
    return Voice_IDError.Unknown(code=code)

