    # Paginator for ListComponentOutputs — yields each Response page, threading the
    # nextToken -> nextToken continuation token until the output token is absent (result key: outputs).
    def paginate_list_component_outputs(self, ListComponentOutputsInput input):
        auto host = endpoints.regional_host(proton_protocol().service, self.region)
        while True:
            auto body = input.to_json()
            auto raw = awsjson.awsjson_request_now(proton_protocol(), self.creds, self.region, "ListComponentOutputs", body)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

