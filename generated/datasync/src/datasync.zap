# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by datasync_error_from_code.
enum DataSyncError:
    InternalException
    InvalidRequestException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def datasync_error_from_code(str code) -> DataSyncError:
    if code == "InternalException":
        return DataSyncError.InternalException
    if code == "InvalidRequestException":
        return DataSyncError.InvalidRequestException
    return DataSyncError.Unknown(code=code)

