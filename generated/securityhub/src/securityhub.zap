# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by securityhub_error_from_code.
enum SecurityHubError:
    AccessDeniedException
    ConflictException
    InternalException
    InternalServerException
    InvalidAccessException
    InvalidInputException
    LimitExceededException
    OrganizationNotFoundException
    OrganizationalUnitNotFoundException
    ResourceConflictException
    ResourceInUseException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def securityhub_error_from_code(str code) -> SecurityHubError:
    if code == "AccessDeniedException":
        return SecurityHubError.AccessDeniedException
    if code == "ConflictException":
        return SecurityHubError.ConflictException
    if code == "InternalException":
        return SecurityHubError.InternalException
    if code == "InternalServerException":
        return SecurityHubError.InternalServerException
    if code == "InvalidAccessException":
        return SecurityHubError.InvalidAccessException
    if code == "InvalidInputException":
        return SecurityHubError.InvalidInputException
    if code == "LimitExceededException":
        return SecurityHubError.LimitExceededException
    if code == "OrganizationNotFoundException":
        return SecurityHubError.OrganizationNotFoundException
    if code == "OrganizationalUnitNotFoundException":
        return SecurityHubError.OrganizationalUnitNotFoundException
    if code == "ResourceConflictException":
        return SecurityHubError.ResourceConflictException
    if code == "ResourceInUseException":
        return SecurityHubError.ResourceInUseException
    if code == "ResourceNotFoundException":
        return SecurityHubError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return SecurityHubError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return SecurityHubError.ThrottlingException
    if code == "ValidationException":
        return SecurityHubError.ValidationException
    return SecurityHubError.Unknown(code=code)

