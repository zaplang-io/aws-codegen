# Per-operation JSON document bodies (the unbound "document" members of an
# operation's input, serialized with @derive(Json)).

@derive(Json)
struct AssociateResourceDocument:
    # document members of AssociateResource
    str ResourceArn

@derive(Json)
struct DescribeRuntimeVersionsDocument:
    # document members of DescribeRuntimeVersions
    Optional[str] NextToken
    Optional[int64] MaxResults

@derive(Json)
struct DisassociateResourceDocument:
    # document members of DisassociateResource
    str ResourceArn

@derive(Json)
struct GetCanaryRunsDocument:
    # document members of GetCanaryRuns
    Optional[str] NextToken
    Optional[int64] MaxResults
    Optional[str] DryRunId
    Optional[RunType] RunType

@derive(Json)
struct ListAssociatedGroupsDocument:
    # document members of ListAssociatedGroups
    Optional[str] NextToken
    Optional[int64] MaxResults

@derive(Json)
struct ListGroupResourcesDocument:
    # document members of ListGroupResources
    Optional[str] NextToken
    Optional[int64] MaxResults

@derive(Json)
struct ListGroupsDocument:
    # document members of ListGroups
    Optional[str] NextToken
    Optional[int64] MaxResults

# JSON body helpers (compact, declaration-order objects): the collection
# serialization @derive(Json) does not emit yet (zaplang-io/zap#424). `_json_str`
# escapes+quotes via the prelude JSON writer; `_json_obj`/`_json_arr` comma-join
# pre-serialized members.
def synthetics_json_str(str s) -> str:
    return json.dumps(JsonValue.Str(s))

def synthetics_json_obj(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "{" + body + "}"

def synthetics_json_arr(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "[" + body + "]"

# Explicit JSON serializers for document bodies with collection/nested
# members (the @derive(Json) collection follow-up, zaplang-io/zap#424).

