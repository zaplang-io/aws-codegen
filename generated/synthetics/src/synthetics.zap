# Typed service errors (#361): the per-service enum + classifier + name
# dispatcher emitted on top of `aws_core.errors` (DECISIONS.md D-0006). One
# bare variant per modeled error shape, plus an open-enum `Unknown(str code)`
# catch-all, so a caller built against this model keeps working when the
# service adds an error. The raw wire code is
# the restJson1 X-Amzn-ErrorType header or body `__type`.
# `errors.error_code` normalizes it to the bare shape name before matching;
# the base carrier, the X-Amzn-ErrorType fallback and the raise/check bridge
# are inherited from `aws_core.errors` and not re-emitted here.
enum syntheticsErrorKind:
    AccessDeniedException
    BadRequestException
    ConflictException
    InternalFailureException
    InternalServerException
    NotFoundException
    RequestEntityTooLargeException
    ResourceNotFoundException
    ServiceQuotaExceededException
    TooManyRequestsException
    ValidationException
    Unknown(str code)

# Classify an AWS error code into `syntheticsErrorKind`,
# normalizing first (`errors.error_code` strips any namespace/suffix) then
# matching by name; an unmodeled code becomes `Unknown(name)`, carrying it.
def synthetics_error_kind(str code) -> syntheticsErrorKind:
    auto name = errors.error_code(code)
    if name == "AccessDeniedException":
        return syntheticsErrorKind.AccessDeniedException
    if name == "BadRequestException":
        return syntheticsErrorKind.BadRequestException
    if name == "ConflictException":
        return syntheticsErrorKind.ConflictException
    if name == "InternalFailureException":
        return syntheticsErrorKind.InternalFailureException
    if name == "InternalServerException":
        return syntheticsErrorKind.InternalServerException
    if name == "NotFoundException":
        return syntheticsErrorKind.NotFoundException
    if name == "RequestEntityTooLargeException":
        return syntheticsErrorKind.RequestEntityTooLargeException
    if name == "ResourceNotFoundException":
        return syntheticsErrorKind.ResourceNotFoundException
    if name == "ServiceQuotaExceededException":
        return syntheticsErrorKind.ServiceQuotaExceededException
    if name == "TooManyRequestsException":
        return syntheticsErrorKind.TooManyRequestsException
    if name == "ValidationException":
        return syntheticsErrorKind.ValidationException
    return syntheticsErrorKind.Unknown(name)

# The canonical name of a classified error. This `match` is exhaustive over
# every variant (the compiler enforces it, so a new variant forces it to be
# updated — the generator emits the enum and dispatcher together) and is
# module-local, so each pattern is a two-segment `Enum.Variant` — the portable
# form until the compiler resolves module-qualified variant patterns in a
# caller's own `match` (DECISIONS.md D-0006). `Unknown` carries its code.
def synthetics_error_name(syntheticsErrorKind k) -> str:
    match k:
        case syntheticsErrorKind.AccessDeniedException:
            return "AccessDeniedException"
        case syntheticsErrorKind.BadRequestException:
            return "BadRequestException"
        case syntheticsErrorKind.ConflictException:
            return "ConflictException"
        case syntheticsErrorKind.InternalFailureException:
            return "InternalFailureException"
        case syntheticsErrorKind.InternalServerException:
            return "InternalServerException"
        case syntheticsErrorKind.NotFoundException:
            return "NotFoundException"
        case syntheticsErrorKind.RequestEntityTooLargeException:
            return "RequestEntityTooLargeException"
        case syntheticsErrorKind.ResourceNotFoundException:
            return "ResourceNotFoundException"
        case syntheticsErrorKind.ServiceQuotaExceededException:
            return "ServiceQuotaExceededException"
        case syntheticsErrorKind.TooManyRequestsException:
            return "TooManyRequestsException"
        case syntheticsErrorKind.ValidationException:
            return "ValidationException"
        case syntheticsErrorKind.Unknown(c):
            return "Unknown(" + c + ")"

