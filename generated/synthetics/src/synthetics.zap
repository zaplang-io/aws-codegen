# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by synthetics_error_from_code.
enum syntheticsError:
    AccessDeniedException
    BadRequestException
    ConflictException
    InternalFailureException
    InternalServerException
    NotFoundException
    RequestEntityTooLargeException
    ResourceNotFoundException
    ServiceQuotaExceededException
    TooManyRequestsException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def synthetics_error_from_code(str code) -> syntheticsError:
    if code == "AccessDeniedException":
        return syntheticsError.AccessDeniedException
    if code == "BadRequestException":
        return syntheticsError.BadRequestException
    if code == "ConflictException":
        return syntheticsError.ConflictException
    if code == "InternalFailureException":
        return syntheticsError.InternalFailureException
    if code == "InternalServerException":
        return syntheticsError.InternalServerException
    if code == "NotFoundException":
        return syntheticsError.NotFoundException
    if code == "RequestEntityTooLargeException":
        return syntheticsError.RequestEntityTooLargeException
    if code == "ResourceNotFoundException":
        return syntheticsError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return syntheticsError.ServiceQuotaExceededException
    if code == "TooManyRequestsException":
        return syntheticsError.TooManyRequestsException
    if code == "ValidationException":
        return syntheticsError.ValidationException
    return syntheticsError.Unknown(code=code)

