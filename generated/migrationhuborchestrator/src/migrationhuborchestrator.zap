            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

    # Paginator for ListWorkflowSteps — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: workflowStepsSummary).
    def paginate_list_workflow_steps(self, ListWorkflowStepsRequest input):
        auto host = endpoints.regional_host(migrationhub_orchestrator_service(), self.region)
        while True:
            auto raw = self.list_workflow_steps(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

    # Paginator for ListWorkflows — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: migrationWorkflowSummary).
    def paginate_list_workflows(self, ListMigrationWorkflowsRequest input):
        auto host = endpoints.regional_host(migrationhub_orchestrator_service(), self.region)
        while True:
            auto raw = self.list_workflows(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

# Construct a MigrationHubOrchestratorClient bound to credentials + region.
def migrationhub_orchestrator_client(core.Credentials creds, str region) -> MigrationHubOrchestratorClient:
    return MigrationHubOrchestratorClient(creds=creds, region=region)
