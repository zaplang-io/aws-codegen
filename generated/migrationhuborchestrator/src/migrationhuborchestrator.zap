# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by migrationhub_orchestrator_error_from_code.
enum MigrationHubOrchestratorError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def migrationhub_orchestrator_error_from_code(str code) -> MigrationHubOrchestratorError:
    if code == "AccessDeniedException":
        return MigrationHubOrchestratorError.AccessDeniedException
    if code == "ConflictException":
        return MigrationHubOrchestratorError.ConflictException
    if code == "InternalServerException":
        return MigrationHubOrchestratorError.InternalServerException
    if code == "ResourceNotFoundException":
        return MigrationHubOrchestratorError.ResourceNotFoundException
    if code == "ThrottlingException":
        return MigrationHubOrchestratorError.ThrottlingException
    if code == "ValidationException":
        return MigrationHubOrchestratorError.ValidationException
    return MigrationHubOrchestratorError.Unknown(code=code)

