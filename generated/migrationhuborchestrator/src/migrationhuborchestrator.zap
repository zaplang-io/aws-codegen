    # Paginator for ListPlugins — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: plugins).
    def paginate_list_plugins(self, ListPluginsRequest input):
        auto host = endpoints.regional_host(migrationhub_orchestrator_service(), self.region)
        while True:
            auto raw = self.list_plugins(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

