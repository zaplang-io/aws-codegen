# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by email_error_from_code.
enum SESv2Error:
    AccountSuspendedException
    AlreadyExistsException
    BadRequestException
    ConcurrentModificationException
    ConflictException
    InternalServiceErrorException
    InvalidNextTokenException
    LimitExceededException
    MailFromDomainNotVerifiedException
    MessageRejected
    NotFoundException
    SendingPausedException
    TooManyRequestsException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def email_error_from_code(str code) -> SESv2Error:
    if code == "AccountSuspendedException":
        return SESv2Error.AccountSuspendedException
    if code == "AlreadyExistsException":
        return SESv2Error.AlreadyExistsException
    if code == "BadRequestException":
        return SESv2Error.BadRequestException
    if code == "ConcurrentModificationException":
        return SESv2Error.ConcurrentModificationException
    if code == "ConflictException":
        return SESv2Error.ConflictException
    if code == "InternalServiceErrorException":
        return SESv2Error.InternalServiceErrorException
    if code == "InvalidNextTokenException":
        return SESv2Error.InvalidNextTokenException
    if code == "LimitExceededException":
        return SESv2Error.LimitExceededException
    if code == "MailFromDomainNotVerifiedException":
        return SESv2Error.MailFromDomainNotVerifiedException
    if code == "MessageRejected":
        return SESv2Error.MessageRejected
    if code == "NotFoundException":
        return SESv2Error.NotFoundException
    if code == "SendingPausedException":
        return SESv2Error.SendingPausedException
    if code == "TooManyRequestsException":
        return SESv2Error.TooManyRequestsException
    return SESv2Error.Unknown(code=code)

