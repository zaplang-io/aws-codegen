    # Paginator for ListEmailIdentityCertificates — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: Certificates).
    def paginate_list_email_identity_certificates(self, ListEmailIdentityCertificatesRequest input):
        auto host = endpoints.regional_host(email_service(), self.region)
        while True:
            auto raw = self.list_email_identity_certificates(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

