            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

    # Paginator for ListSubscriptions — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: subscriptions).
    def paginate_list_subscriptions(self, ListSubscriptionsRequest input):
        auto host = endpoints.regional_host(data_ats_iot_service(), self.region)
        while True:
            auto raw = self.list_subscriptions(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

# Construct a IoT_Data_PlaneClient bound to credentials + region.
def data_ats_iot_client(core.Credentials creds, str region) -> IoT_Data_PlaneClient:
    return IoT_Data_PlaneClient(creds=creds, region=region)
