# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by greengrass_error_from_code.
enum GreengrassError:
    BadRequestException
    InternalServerErrorException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def greengrass_error_from_code(str code) -> GreengrassError:
    if code == "BadRequestException":
        return GreengrassError.BadRequestException
    if code == "InternalServerErrorException":
        return GreengrassError.InternalServerErrorException
    return GreengrassError.Unknown(code=code)

