    # Paginator for ListBulkDeploymentDetailedReports — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: Deployments).
    def paginate_list_bulk_deployment_detailed_reports(self, ListBulkDeploymentDetailedReportsRequest input):
        auto host = endpoints.regional_host(greengrass_service(), self.region)
        while True:
            auto raw = self.list_bulk_deployment_detailed_reports(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

