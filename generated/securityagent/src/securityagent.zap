    # Paginator for ListActorMessages — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: messages).
    def paginate_list_actor_messages(self, ListActorMessagesInput input):
        auto host = endpoints.regional_host(securityagent_service(), self.region)
        while True:
            auto raw = self.list_actor_messages(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

