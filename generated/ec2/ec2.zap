# --- shapes ----------------------------------------------------------------

struct AcceleratorCount:
    Optional[int64] Min
    Optional[int64] Max

struct AcceleratorCountRequest:
    Optional[int64] Min
    Optional[int64] Max

struct AcceleratorTotalMemoryMiB:
    Optional[int64] Min
    Optional[int64] Max

struct AcceleratorTotalMemoryMiBRequest:
    Optional[int64] Min
    Optional[int64] Max

struct AcceptAddressTransferRequest:
    str Address
    Optional[list[TagSpecification]] TagSpecifications
    Optional[bool] DryRun

struct AcceptAddressTransferResult:
    Optional[AddressTransfer] AddressTransfer

struct AcceptCapacityReservationBillingOwnershipRequest:
    Optional[bool] DryRun
    str CapacityReservationId

struct AcceptCapacityReservationBillingOwnershipResult:
    Optional[bool] Return

struct AcceptReservedInstancesExchangeQuoteRequest:
    Optional[bool] DryRun
    list[str] ReservedInstanceIds
    Optional[list[TargetConfigurationRequest]] TargetConfigurations

struct AcceptReservedInstancesExchangeQuoteResult:
    Optional[str] ExchangeId

struct AcceptTransitGatewayClientVpnAttachmentRequest:
    str TransitGatewayAttachmentId
    Optional[bool] DryRun

struct AcceptTransitGatewayClientVpnAttachmentResult:
    Optional[TransitGatewayClientVpnAttachment] TransitGatewayClientVpnAttachment

struct AcceptTransitGatewayMulticastDomainAssociationsRequest:
    Optional[str] TransitGatewayMulticastDomainId
    Optional[str] TransitGatewayAttachmentId
    Optional[list[str]] SubnetIds
    Optional[bool] DryRun

struct AcceptTransitGatewayMulticastDomainAssociationsResult:
    Optional[TransitGatewayMulticastDomainAssociations] Associations

struct AcceptTransitGatewayPeeringAttachmentRequest:
