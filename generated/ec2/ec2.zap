# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# ec2 `<Response><Errors><Error><Code>` element code by ec2_error_from_code.
enum EC2Error:
    Unknown(str code)

# Map a query/ec2 error code (the <Error><Code> text surfaced by the codec's
# error helpers) to a variant.
def ec2_error_from_code(str code) -> EC2Error:
    return EC2Error.Unknown(code=code)

