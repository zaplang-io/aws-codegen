# A bound EC2 client: credentials + region, threaded into every operation.
struct EC2Client:
    Credentials creds
    str region

    # AcceptVpcPeeringConnection
    def accept_vpc_peering_connection(self, AcceptVpcPeeringConnectionRequest input) -> str:
        auto p = query_params("AcceptVpcPeeringConnection", "2014-09-01")
        if input.DryRun.is_some():
            p = query_scalar(p, "DryRun", query_bool(input.DryRun.unwrap()))
        if input.VpcPeeringConnectionId.is_some():
            auto t0 = input.VpcPeeringConnectionId.unwrap()
            p = query_scalar(p, "VpcPeeringConnectionId", t0)
        return query_request(self.creds, ec2_service(), self.region, p)

    # AllocateAddress
    def allocate_address(self, AllocateAddressRequest input) -> str:
        auto p = query_params("AllocateAddress", "2014-09-01")
        if input.DryRun.is_some():
            p = query_scalar(p, "DryRun", query_bool(input.DryRun.unwrap()))
        if input.Domain.is_some():
            p = query_scalar(p, "Domain", input.Domain.unwrap())
        return query_request(self.creds, ec2_service(), self.region, p)

    # AssignPrivateIpAddresses
    def assign_private_ip_addresses(self, AssignPrivateIpAddressesRequest input) -> str:
        auto p = query_params("AssignPrivateIpAddresses", "2014-09-01")
        p = query_scalar(p, "NetworkInterfaceId", input.NetworkInterfaceId)
        auto t0 = input.PrivateIpAddresses.unwrap_or([])
        p = query_flat_list(p, "PrivateIpAddress", t0)
        if input.SecondaryPrivateIpAddressCount.is_some():
            auto t1 = str(input.SecondaryPrivateIpAddressCount.unwrap())
            p = query_scalar(p, "SecondaryPrivateIpAddressCount", t1)
        if input.AllowReassignment.is_some():
            auto t2 = query_bool(input.AllowReassignment.unwrap())
            p = query_scalar(p, "AllowReassignment", t2)
        return query_request(self.creds, ec2_service(), self.region, p)

    # AssociateAddress
    def associate_address(self, AssociateAddressRequest input) -> str:
        auto p = query_params("AssociateAddress", "2014-09-01")
        if input.DryRun.is_some():
            p = query_scalar(p, "DryRun", query_bool(input.DryRun.unwrap()))
        if input.InstanceId.is_some():
            p = query_scalar(p, "InstanceId", input.InstanceId.unwrap())
        if input.PublicIp.is_some():
            p = query_scalar(p, "PublicIp", input.PublicIp.unwrap())
        if input.AllocationId.is_some():
            p = query_scalar(p, "AllocationId", input.AllocationId.unwrap())
        if input.NetworkInterfaceId.is_some():
            p = query_scalar(p, "NetworkInterfaceId", input.NetworkInterfaceId.unwrap())
        if input.PrivateIpAddress.is_some():
            p = query_scalar(p, "PrivateIpAddress", input.PrivateIpAddress.unwrap())
        if input.AllowReassociation.is_some():
            auto t0 = query_bool(input.AllowReassociation.unwrap())
            p = query_scalar(p, "AllowReassociation", t0)
        return query_request(self.creds, ec2_service(), self.region, p)

    # AssociateDhcpOptions
    def associate_dhcp_options(self, AssociateDhcpOptionsRequest input) -> str:
        auto p = query_params("AssociateDhcpOptions", "2014-09-01")
