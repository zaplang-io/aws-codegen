            input.NextToken = Optional.Some(np.token)

    # Paginator for ListSpeechSynthesisTasks — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: SynthesisTasks).
    def paginate_list_speech_synthesis_tasks(self, ListSpeechSynthesisTasksInput input):
        auto host = endpoints.regional_host(polly_service(), self.region)
        while True:
            auto raw = self.list_speech_synthesis_tasks(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

# Construct a PollyClient bound to credentials + region.
def polly_client(core.Credentials creds, str region) -> PollyClient:
    return PollyClient(creds=creds, region=region)
