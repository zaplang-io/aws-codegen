# Per-operation JSON document bodies (the unbound "document" members of an
# operation's input, serialized with @derive(Json)).

@derive(Json)
struct CreateCaseCommentDocument:
    # document members of CreateCaseComment
    Optional[str] clientToken
    str body

@derive(Json)
struct GetCaseAttachmentUploadUrlDocument:
    # document members of GetCaseAttachmentUploadUrl
    str fileName
    int64 contentLength
    Optional[str] clientToken

@derive(Json)
struct ListCaseEditsDocument:
    # document members of ListCaseEdits
    Optional[str] nextToken
    Optional[int64] maxResults

@derive(Json)
struct ListCasesDocument:
    # document members of ListCases
    Optional[str] nextToken
    Optional[int64] maxResults

@derive(Json)
struct ListCommentsDocument:
    # document members of ListComments
    Optional[str] nextToken
    Optional[int64] maxResults

@derive(Json)
struct ListMembershipsDocument:
    # document members of ListMemberships
    Optional[str] nextToken
    Optional[int64] maxResults

@derive(Json)
struct SendFeedbackDocument:
    # document members of SendFeedback
    UsefulnessRating usefulness
    Optional[str] comment

@derive(Json)
struct UpdateCaseCommentDocument:
    # document members of UpdateCaseComment
    str body

@derive(Json)
struct UpdateCaseStatusDocument:
    # document members of UpdateCaseStatus
    SelfManagedCaseStatus caseStatus

@derive(Json)
struct UpdateResolverTypeDocument:
    # document members of UpdateResolverType
    ResolverType resolverType

# JSON body helpers (compact, declaration-order objects): the collection
# serialization @derive(Json) does not emit yet (zaplang-io/zap#424). `_json_str`
# escapes+quotes via the prelude JSON writer; `_json_obj`/`_json_arr` comma-join
# pre-serialized members.
def security_ir_json_str(str s) -> str:
    return json.dumps(JsonValue.Str(s))

def security_ir_json_obj(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "{" + body + "}"

def security_ir_json_arr(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "[" + body + "]"

# Explicit JSON serializers for document bodies with collection/nested
# members (the @derive(Json) collection follow-up, zaplang-io/zap#424).

# Serialize IncidentResponder to a compact JSON object (declaration order).
def incident_responder_to_json(IncidentResponder v) -> str:
    list[str] parts = []
    parts.append("\"name\":" + security_ir_json_str(v.name))
    parts.append("\"jobTitle\":" + security_ir_json_str(v.jobTitle))
    parts.append("\"email\":" + security_ir_json_str(v.email))
    if v.communicationPreferences.is_some():
        auto u0 = v.communicationPreferences.unwrap()
        list[str] e1 = []
        for x1 in u0:
            e1.append(x1.to_json())
        parts.append("\"communicationPreferences\":" + security_ir_json_arr(e1))
    return security_ir_json_obj(parts)

