# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by security_ir_error_from_code.
enum Security_IRError:
    AccessDeniedException
    ConflictException
    InternalServerException
    InvalidTokenException
    ResourceNotFoundException
    SecurityIncidentResponseNotActiveException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def security_ir_error_from_code(str code) -> Security_IRError:
    if code == "AccessDeniedException":
        return Security_IRError.AccessDeniedException
    if code == "ConflictException":
        return Security_IRError.ConflictException
    if code == "InternalServerException":
        return Security_IRError.InternalServerException
    if code == "InvalidTokenException":
        return Security_IRError.InvalidTokenException
    if code == "ResourceNotFoundException":
        return Security_IRError.ResourceNotFoundException
    if code == "SecurityIncidentResponseNotActiveException":
        return Security_IRError.SecurityIncidentResponseNotActiveException
    if code == "ServiceQuotaExceededException":
        return Security_IRError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return Security_IRError.ThrottlingException
    if code == "ValidationException":
        return Security_IRError.ValidationException
    return Security_IRError.Unknown(code=code)

