# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by license_manager_error_from_code.
enum License_ManagerError:
    AccessDeniedException
    AuthorizationException
    ConflictException
    EntitlementNotAllowedException
    FailedDependencyException
    FilterLimitExceededException
    InvalidParameterValueException
    InvalidResourceStateException
    LicenseUsageException
    NoEntitlementsAllowedException
    RateLimitExceededException
    RedirectException
    ResourceLimitExceededException
    ResourceNotFoundException
    ServerInternalException
    UnsupportedDigitalSignatureMethodException
    ValidationException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def license_manager_error_from_code(str code) -> License_ManagerError:
    if code == "AccessDeniedException":
        return License_ManagerError.AccessDeniedException
    if code == "AuthorizationException":
        return License_ManagerError.AuthorizationException
    if code == "ConflictException":
        return License_ManagerError.ConflictException
    if code == "EntitlementNotAllowedException":
        return License_ManagerError.EntitlementNotAllowedException
    if code == "FailedDependencyException":
        return License_ManagerError.FailedDependencyException
    if code == "FilterLimitExceededException":
        return License_ManagerError.FilterLimitExceededException
    if code == "InvalidParameterValueException":
        return License_ManagerError.InvalidParameterValueException
    if code == "InvalidResourceStateException":
        return License_ManagerError.InvalidResourceStateException
    if code == "LicenseUsageException":
        return License_ManagerError.LicenseUsageException
    if code == "NoEntitlementsAllowedException":
        return License_ManagerError.NoEntitlementsAllowedException
    if code == "RateLimitExceededException":
        return License_ManagerError.RateLimitExceededException
    if code == "RedirectException":
        return License_ManagerError.RedirectException
    if code == "ResourceLimitExceededException":
        return License_ManagerError.ResourceLimitExceededException
    if code == "ResourceNotFoundException":
        return License_ManagerError.ResourceNotFoundException
    if code == "ServerInternalException":
        return License_ManagerError.ServerInternalException
    if code == "UnsupportedDigitalSignatureMethodException":
        return License_ManagerError.UnsupportedDigitalSignatureMethodException
    if code == "ValidationException":
        return License_ManagerError.ValidationException
    return License_ManagerError.Unknown(code=code)

