# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by datazone_error_from_code.
enum DataZoneError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    UnauthorizedException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def datazone_error_from_code(str code) -> DataZoneError:
    if code == "AccessDeniedException":
        return DataZoneError.AccessDeniedException
    if code == "ConflictException":
        return DataZoneError.ConflictException
    if code == "InternalServerException":
        return DataZoneError.InternalServerException
    if code == "ResourceNotFoundException":
        return DataZoneError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return DataZoneError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return DataZoneError.ThrottlingException
    if code == "UnauthorizedException":
        return DataZoneError.UnauthorizedException
    if code == "ValidationException":
        return DataZoneError.ValidationException
    return DataZoneError.Unknown(code=code)

