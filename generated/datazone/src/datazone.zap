    # Paginator for ListAccountPools — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: items).
    def paginate_list_account_pools(self, ListAccountPoolsInput input):
        auto host = endpoints.regional_host(datazone_service(), self.region)
        while True:
            auto raw = self.list_account_pools(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

