def appconfig_json_obj(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "{" + body + "}"

def appconfig_json_arr(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
