# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by appconfig_error_from_code.
enum AppConfigError:
    BadRequestException
    ConflictException
    InternalServerException
    PayloadTooLargeException
    ResourceNotFoundException
    ServiceQuotaExceededException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def appconfig_error_from_code(str code) -> AppConfigError:
    if code == "BadRequestException":
        return AppConfigError.BadRequestException
    if code == "ConflictException":
        return AppConfigError.ConflictException
    if code == "InternalServerException":
        return AppConfigError.InternalServerException
    if code == "PayloadTooLargeException":
        return AppConfigError.PayloadTooLargeException
    if code == "ResourceNotFoundException":
        return AppConfigError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return AppConfigError.ServiceQuotaExceededException
    return AppConfigError.Unknown(code=code)

