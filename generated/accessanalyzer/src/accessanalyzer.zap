    # Paginator for GetFindingRecommendation — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: recommendedSteps).
    def paginate_get_finding_recommendation(self, GetFindingRecommendationRequest input):
        auto host = endpoints.regional_host(access_analyzer_service(), self.region)
        while True:
            auto raw = self.get_finding_recommendation(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

