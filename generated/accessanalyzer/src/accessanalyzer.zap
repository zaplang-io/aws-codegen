# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by access_analyzer_error_from_code.
enum AccessAnalyzerError:
    AccessDeniedException
    ConflictException
    InternalServerException
    InvalidParameterException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    UnprocessableEntityException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def access_analyzer_error_from_code(str code) -> AccessAnalyzerError:
    if code == "AccessDeniedException":
        return AccessAnalyzerError.AccessDeniedException
    if code == "ConflictException":
        return AccessAnalyzerError.ConflictException
    if code == "InternalServerException":
        return AccessAnalyzerError.InternalServerException
    if code == "InvalidParameterException":
        return AccessAnalyzerError.InvalidParameterException
    if code == "ResourceNotFoundException":
        return AccessAnalyzerError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return AccessAnalyzerError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return AccessAnalyzerError.ThrottlingException
    if code == "UnprocessableEntityException":
        return AccessAnalyzerError.UnprocessableEntityException
    if code == "ValidationException":
        return AccessAnalyzerError.ValidationException
    return AccessAnalyzerError.Unknown(code=code)

