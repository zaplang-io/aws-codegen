            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

# Construct a AccessAnalyzerClient bound to credentials + region.
def access_analyzer_client(core.Credentials creds, str region) -> AccessAnalyzerClient:
    return AccessAnalyzerClient(creds=creds, region=region)
