# Map an awsJson error code (the stripped __type shape name) to a variant.
def application_autoscaling_error_from_code(str code) -> Application_Auto_ScalingError:
    if code == "ConcurrentUpdateException":
        return Application_Auto_ScalingError.ConcurrentUpdateException
    if code == "FailedResourceAccessException":
        return Application_Auto_ScalingError.FailedResourceAccessException
    if code == "InternalServiceException":
        return Application_Auto_ScalingError.InternalServiceException
    if code == "InvalidNextTokenException":
        return Application_Auto_ScalingError.InvalidNextTokenException
    if code == "LimitExceededException":
        return Application_Auto_ScalingError.LimitExceededException
    if code == "ObjectNotFoundException":
        return Application_Auto_ScalingError.ObjectNotFoundException
    if code == "ResourceNotFoundException":
        return Application_Auto_ScalingError.ResourceNotFoundException
    if code == "TooManyTagsException":
        return Application_Auto_ScalingError.TooManyTagsException
    if code == "ValidationException":
        return Application_Auto_ScalingError.ValidationException
    return Application_Auto_ScalingError.Unknown(code=code)

