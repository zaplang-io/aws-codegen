        return awsjson.awsjson_request_now(application_autoscaling_protocol(), self.creds, self.region, "GetPredictiveScalingForecast", body)

    # ListTagsForResource
    # errors: ResourceNotFoundException
    def list_tags_for_resource(self, ListTagsForResourceRequest input) -> str:
        auto body = input.to_json()
