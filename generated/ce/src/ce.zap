# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by ce_error_from_code.
enum Cost_ExplorerError:
    AnalysisNotFoundException
    BackfillLimitExceededException
    BillExpirationException
    BillingViewHealthStatusException
    DataUnavailableException
    GenerationExistsException
    InvalidNextTokenException
    LimitExceededException
    RequestChangedException
    ResourceNotFoundException
    ServiceQuotaExceededException
    TooManyTagsException
    UnknownMonitorException
    UnknownSubscriptionException
    UnresolvableUsageUnitException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def ce_error_from_code(str code) -> Cost_ExplorerError:
    if code == "AnalysisNotFoundException":
        return Cost_ExplorerError.AnalysisNotFoundException
    if code == "BackfillLimitExceededException":
        return Cost_ExplorerError.BackfillLimitExceededException
    if code == "BillExpirationException":
        return Cost_ExplorerError.BillExpirationException
    if code == "BillingViewHealthStatusException":
        return Cost_ExplorerError.BillingViewHealthStatusException
    if code == "DataUnavailableException":
        return Cost_ExplorerError.DataUnavailableException
    if code == "GenerationExistsException":
        return Cost_ExplorerError.GenerationExistsException
    if code == "InvalidNextTokenException":
        return Cost_ExplorerError.InvalidNextTokenException
    if code == "LimitExceededException":
        return Cost_ExplorerError.LimitExceededException
    if code == "RequestChangedException":
        return Cost_ExplorerError.RequestChangedException
    if code == "ResourceNotFoundException":
        return Cost_ExplorerError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return Cost_ExplorerError.ServiceQuotaExceededException
    if code == "TooManyTagsException":
        return Cost_ExplorerError.TooManyTagsException
    if code == "UnknownMonitorException":
        return Cost_ExplorerError.UnknownMonitorException
    if code == "UnknownSubscriptionException":
        return Cost_ExplorerError.UnknownSubscriptionException
    if code == "UnresolvableUsageUnitException":
        return Cost_ExplorerError.UnresolvableUsageUnitException
    return Cost_ExplorerError.Unknown(code=code)

# --- client ----------------------------------------------------------------

# JSON body helpers (compact, declaration-order objects): the collection
# serialization @derive(Json) does not emit yet (zaplang-io/zap#424). `_json_str`
# escapes+quotes via the prelude JSON writer; `_json_obj`/`_json_arr` comma-join
# pre-serialized members.
def ce_json_str(str s) -> str:
    return json.dumps(JsonValue.Str(s))

def ce_json_obj(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "{" + body + "}"

def ce_json_arr(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "[" + body + "]"

# Explicit JSON serializers for input shapes with collection/nested members
# (the @derive(Json) collection follow-up, zaplang-io/zap#424).

# Serialize AnomalyMonitor to a compact JSON object (declaration order).
def anomaly_monitor_to_json(AnomalyMonitor v) -> str:
    list[str] parts = []
    if v.MonitorArn.is_some():
        auto u0 = v.MonitorArn.unwrap()
        parts.append("\"MonitorArn\":" + ce_json_str(u0))
    parts.append("\"MonitorName\":" + ce_json_str(v.MonitorName))
    if v.CreationDate.is_some():
        auto u1 = v.CreationDate.unwrap()
        parts.append("\"CreationDate\":" + ce_json_str(u1))
    if v.LastUpdatedDate.is_some():
        auto u2 = v.LastUpdatedDate.unwrap()
        parts.append("\"LastUpdatedDate\":" + ce_json_str(u2))
    if v.LastEvaluatedDate.is_some():
        auto u3 = v.LastEvaluatedDate.unwrap()
        parts.append("\"LastEvaluatedDate\":" + ce_json_str(u3))
    parts.append("\"MonitorType\":" + v.MonitorType.to_json())
    if v.MonitorDimension.is_some():
        auto u4 = v.MonitorDimension.unwrap()
        parts.append("\"MonitorDimension\":" + u4.to_json())
    if v.MonitorSpecification.is_some():
        auto u5 = v.MonitorSpecification.unwrap()
        parts.append("\"MonitorSpecification\":" + expression_to_json(u5))
    if v.DimensionalValueCount.is_some():
        auto u6 = v.DimensionalValueCount.unwrap()
        parts.append("\"DimensionalValueCount\":" + str(u6))
    return ce_json_obj(parts)

# Serialize AnomalySubscription to a compact JSON object (declaration order).
def anomaly_subscription_to_json(AnomalySubscription v) -> str:
    list[str] parts = []
    if v.SubscriptionArn.is_some():
        auto u0 = v.SubscriptionArn.unwrap()
        parts.append("\"SubscriptionArn\":" + ce_json_str(u0))
    if v.AccountId.is_some():
        auto u1 = v.AccountId.unwrap()
