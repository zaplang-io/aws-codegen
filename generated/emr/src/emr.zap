    # Paginator for ListBootstrapActions — yields each Response page, threading the
    # Marker -> Marker continuation token until the output token is absent (result key: BootstrapActions).
    def paginate_list_bootstrap_actions(self, ListBootstrapActionsInput input):
        auto host = endpoints.regional_host(elasticmapreduce_protocol().service, self.region)
        while True:
            auto body = input.to_json()
            auto raw = awsjson.awsjson_request_now(elasticmapreduce_protocol(), self.creds, self.region, "ListBootstrapActions", body)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "Marker")
            if not np.has_more:
                break
            input.Marker = Optional.Some(np.token)

