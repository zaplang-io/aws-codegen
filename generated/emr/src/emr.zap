# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by elasticmapreduce_error_from_code.
enum EMRError:
    InternalServerError
    InternalServerException
    InvalidRequestException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def elasticmapreduce_error_from_code(str code) -> EMRError:
    if code == "InternalServerError":
        return EMRError.InternalServerError
    if code == "InternalServerException":
        return EMRError.InternalServerException
    if code == "InvalidRequestException":
        return EMRError.InvalidRequestException
    return EMRError.Unknown(code=code)

