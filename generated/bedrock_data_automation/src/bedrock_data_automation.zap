# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by bedrock_data_automation_error_from_code.
enum Bedrock_Data_AutomationError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def bedrock_data_automation_error_from_code(str code) -> Bedrock_Data_AutomationError:
    if code == "AccessDeniedException":
        return Bedrock_Data_AutomationError.AccessDeniedException
    if code == "ConflictException":
        return Bedrock_Data_AutomationError.ConflictException
    if code == "InternalServerException":
        return Bedrock_Data_AutomationError.InternalServerException
    if code == "ResourceNotFoundException":
        return Bedrock_Data_AutomationError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return Bedrock_Data_AutomationError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return Bedrock_Data_AutomationError.ThrottlingException
    if code == "ValidationException":
        return Bedrock_Data_AutomationError.ValidationException
    return Bedrock_Data_AutomationError.Unknown(code=code)

