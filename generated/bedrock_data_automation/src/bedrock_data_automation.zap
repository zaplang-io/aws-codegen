    # Paginator for ListBlueprints — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: blueprints).
    def paginate_list_blueprints(self, ListBlueprintsRequest input):
        auto host = endpoints.regional_host(bedrock_data_automation_service(), self.region)
        while True:
            auto raw = self.list_blueprints(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

