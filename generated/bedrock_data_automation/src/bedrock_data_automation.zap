# Construct a Bedrock_Data_AutomationClient bound to credentials + region.
def bedrock_data_automation_client(core.Credentials creds, str region) -> Bedrock_Data_AutomationClient:
    return Bedrock_Data_AutomationClient(creds=creds, region=region)
