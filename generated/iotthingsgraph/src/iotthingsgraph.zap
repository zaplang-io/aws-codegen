    ResourceNotFoundException
    ThrottlingException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def iotthingsgraph_error_from_code(str code) -> IoTThingsGraphError:
    if code == "InternalFailureException":
        return IoTThingsGraphError.InternalFailureException
    if code == "InvalidRequestException":
        return IoTThingsGraphError.InvalidRequestException
    if code == "LimitExceededException":
        return IoTThingsGraphError.LimitExceededException
    if code == "ResourceAlreadyExistsException":
        return IoTThingsGraphError.ResourceAlreadyExistsException
    if code == "ResourceInUseException":
        return IoTThingsGraphError.ResourceInUseException
    if code == "ResourceNotFoundException":
        return IoTThingsGraphError.ResourceNotFoundException
    if code == "ThrottlingException":
        return IoTThingsGraphError.ThrottlingException
    return IoTThingsGraphError.Unknown(code=code)

