# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by messaging_chime_error_from_code.
enum Chime_SDK_MessagingError:
    BadRequestException
    ConflictException
    ForbiddenException
    NotFoundException
    ResourceLimitExceededException
    ServiceFailureException
    ServiceUnavailableException
    ThrottledClientException
    UnauthorizedClientException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def messaging_chime_error_from_code(str code) -> Chime_SDK_MessagingError:
    if code == "BadRequestException":
        return Chime_SDK_MessagingError.BadRequestException
    if code == "ConflictException":
        return Chime_SDK_MessagingError.ConflictException
    if code == "ForbiddenException":
        return Chime_SDK_MessagingError.ForbiddenException
    if code == "NotFoundException":
        return Chime_SDK_MessagingError.NotFoundException
    if code == "ResourceLimitExceededException":
        return Chime_SDK_MessagingError.ResourceLimitExceededException
    if code == "ServiceFailureException":
        return Chime_SDK_MessagingError.ServiceFailureException
    if code == "ServiceUnavailableException":
        return Chime_SDK_MessagingError.ServiceUnavailableException
    if code == "ThrottledClientException":
        return Chime_SDK_MessagingError.ThrottledClientException
    if code == "UnauthorizedClientException":
        return Chime_SDK_MessagingError.UnauthorizedClientException
    return Chime_SDK_MessagingError.Unknown(code=code)

