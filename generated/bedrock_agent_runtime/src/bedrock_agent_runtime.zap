# Construct a Bedrock_Agent_RuntimeClient bound to credentials + region.
def bedrock_agent_runtime_client(core.Credentials creds, str region) -> Bedrock_Agent_RuntimeClient:
    return Bedrock_Agent_RuntimeClient(creds=creds, region=region)
