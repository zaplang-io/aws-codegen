# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by bedrock_agent_runtime_error_from_code.
enum Bedrock_Agent_RuntimeError:
    AccessDeniedException
    BadGatewayException
    ConflictException
    DependencyFailedException
    InternalServerException
    ModelNotReadyException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def bedrock_agent_runtime_error_from_code(str code) -> Bedrock_Agent_RuntimeError:
    if code == "AccessDeniedException":
        return Bedrock_Agent_RuntimeError.AccessDeniedException
    if code == "BadGatewayException":
        return Bedrock_Agent_RuntimeError.BadGatewayException
    if code == "ConflictException":
        return Bedrock_Agent_RuntimeError.ConflictException
    if code == "DependencyFailedException":
        return Bedrock_Agent_RuntimeError.DependencyFailedException
    if code == "InternalServerException":
        return Bedrock_Agent_RuntimeError.InternalServerException
    if code == "ModelNotReadyException":
        return Bedrock_Agent_RuntimeError.ModelNotReadyException
    if code == "ResourceNotFoundException":
        return Bedrock_Agent_RuntimeError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return Bedrock_Agent_RuntimeError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return Bedrock_Agent_RuntimeError.ThrottlingException
    if code == "ValidationException":
        return Bedrock_Agent_RuntimeError.ValidationException
    return Bedrock_Agent_RuntimeError.Unknown(code=code)

