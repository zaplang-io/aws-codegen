    # Paginator for ListImportFailures — yields each Response page, threading the
    # NextToken -> NextToken continuation token until the output token is absent (result key: Failures).
    def paginate_list_import_failures(self, ListImportFailuresRequest input):
        auto host = endpoints.regional_host(cloudtrail_protocol().service, self.region)
        while True:
            auto body = input.to_json()
            auto raw = awsjson.awsjson_request_now(cloudtrail_protocol(), self.creds, self.region, "ListImportFailures", body)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

