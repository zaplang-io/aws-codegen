    # Paginator for ListConnectors — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: Connectors).
    def paginate_list_connectors(self, ListConnectorsRequest input):
        auto host = endpoints.regional_host(pca_connector_ad_service(), self.region)
        while True:
            auto raw = self.list_connectors(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

