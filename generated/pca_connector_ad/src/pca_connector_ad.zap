# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by pca_connector_ad_error_from_code.
enum Pca_Connector_AdError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def pca_connector_ad_error_from_code(str code) -> Pca_Connector_AdError:
    if code == "AccessDeniedException":
        return Pca_Connector_AdError.AccessDeniedException
    if code == "ConflictException":
        return Pca_Connector_AdError.ConflictException
    if code == "InternalServerException":
        return Pca_Connector_AdError.InternalServerException
    if code == "ResourceNotFoundException":
        return Pca_Connector_AdError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return Pca_Connector_AdError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return Pca_Connector_AdError.ThrottlingException
    if code == "ValidationException":
        return Pca_Connector_AdError.ValidationException
    return Pca_Connector_AdError.Unknown(code=code)

