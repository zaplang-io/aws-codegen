# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by aidevops_error_from_code.
enum DevOps_AgentError:
    AccessDeniedException
    ConflictException
    ContentSizeExceededException
    IdentityCenterServiceException
    InternalServerException
    InvalidParameterException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def aidevops_error_from_code(str code) -> DevOps_AgentError:
    if code == "AccessDeniedException":
        return DevOps_AgentError.AccessDeniedException
    if code == "ConflictException":
        return DevOps_AgentError.ConflictException
    if code == "ContentSizeExceededException":
        return DevOps_AgentError.ContentSizeExceededException
    if code == "IdentityCenterServiceException":
        return DevOps_AgentError.IdentityCenterServiceException
    if code == "InternalServerException":
        return DevOps_AgentError.InternalServerException
    if code == "InvalidParameterException":
        return DevOps_AgentError.InvalidParameterException
    if code == "ResourceNotFoundException":
        return DevOps_AgentError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return DevOps_AgentError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return DevOps_AgentError.ThrottlingException
    if code == "ValidationException":
        return DevOps_AgentError.ValidationException
    return DevOps_AgentError.Unknown(code=code)

