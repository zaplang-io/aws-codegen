    # Paginator for ListAgentSpaces — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: agentSpaces).
    def paginate_list_agent_spaces(self, ListAgentSpacesInput input):
        auto host = endpoints.regional_host(aidevops_service(), self.region)
        while True:
            auto raw = self.list_agent_spaces(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

