    # nextToken -> nextToken continuation token until it is absent (result key: executions).
    def paginate_list_executions(self, ListExecutionsRequest input):
        auto host = endpoints.regional_host(aidevops_service(), self.region)
        while True:
            auto raw = self.list_executions(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

