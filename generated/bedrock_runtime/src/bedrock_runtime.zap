    # InvokeModelWithResponseStream  POST /model/{modelId}/invoke-with-response-stream
    # errors: AccessDeniedException, InternalServerException, ModelErrorException, ModelNotReadyException, ModelStreamErrorException, ModelTimeoutException, ResourceNotFoundException, ServiceQuotaExceededException, ServiceUnavailableException, ThrottlingException, ValidationException
    def invoke_model_with_response_stream(self, InvokeModelWithResponseStreamRequest input) -> str:
        auto host = endpoints.regional_host(bedrock_runtime_service(), self.region)
        dict[str, str] labels = {}
        labels["modelId"] = input.modelId
        dict[str, str] headers = {}
        if input.contentType.is_some():
            headers["Content-Type"] = input.contentType.unwrap_or("")
        if input.accept.is_some():
            headers["X-Amzn-Bedrock-Accept"] = input.accept.unwrap_or("")
        if input.trace.is_some():
            headers["X-Amzn-Bedrock-Trace"] = input.trace.unwrap_or("")
        if input.guardrailIdentifier.is_some():
            headers["X-Amzn-Bedrock-GuardrailIdentifier"] = input.guardrailIdentifier.unwrap_or("")
        if input.guardrailVersion.is_some():
            headers["X-Amzn-Bedrock-GuardrailVersion"] = input.guardrailVersion.unwrap_or("")
        if input.performanceConfigLatency.is_some():
