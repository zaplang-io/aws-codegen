# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by bedrock_runtime_error_from_code.
enum Bedrock_RuntimeError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ModelErrorException
    ModelNotReadyException
    ModelStreamErrorException
    ModelTimeoutException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ServiceUnavailableException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def bedrock_runtime_error_from_code(str code) -> Bedrock_RuntimeError:
    if code == "AccessDeniedException":
        return Bedrock_RuntimeError.AccessDeniedException
    if code == "ConflictException":
        return Bedrock_RuntimeError.ConflictException
    if code == "InternalServerException":
        return Bedrock_RuntimeError.InternalServerException
    if code == "ModelErrorException":
        return Bedrock_RuntimeError.ModelErrorException
    if code == "ModelNotReadyException":
        return Bedrock_RuntimeError.ModelNotReadyException
    if code == "ModelStreamErrorException":
        return Bedrock_RuntimeError.ModelStreamErrorException
    if code == "ModelTimeoutException":
        return Bedrock_RuntimeError.ModelTimeoutException
    if code == "ResourceNotFoundException":
        return Bedrock_RuntimeError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return Bedrock_RuntimeError.ServiceQuotaExceededException
    if code == "ServiceUnavailableException":
        return Bedrock_RuntimeError.ServiceUnavailableException
    if code == "ThrottlingException":
        return Bedrock_RuntimeError.ThrottlingException
    if code == "ValidationException":
        return Bedrock_RuntimeError.ValidationException
    return Bedrock_RuntimeError.Unknown(code=code)

# --- client ----------------------------------------------------------------

# Operations skipped in v0 (a member type is not yet bindable/serializable —
# a non-string/enum/int URI/query/header, a collection or non-derivable
# document member, or an unsupported httpPayload):
#   ApplyGuardrail (document member `content: list[GuardrailContentBlock]` is not serializable by derive)
#   Converse (document member `messages: list[Message]` is not serializable by derive)
#   ConverseStream (document member `messages: list[Message]` is not serializable by derive)
#   CountTokens (document member `input: CountTokensInput` is not serializable by derive)
#   InvokeGuardrailChecks (document member `messages: list[GuardrailChecksMessage]` is not serializable by derive)
#   ListAsyncInvokes (httpQuery `submitTimeAfter` has unsupported type DateTime)
#   StartAsyncInvoke (document member `tags: list[Tag]` is not serializable by derive)

# Paginated operations (paginators-1.json) not surfaced — their operation is
# skipped above, or the continuation token is not a simple string field:
#   ListAsyncInvokes (operation not generated)

# A bound Bedrock_Runtime client: credentials + region, threaded into every operation.
struct Bedrock_RuntimeClient:
    core.Credentials creds
    str region

    # GetAsyncInvoke  GET /async-invoke/{invocationArn}
    # errors: AccessDeniedException, InternalServerException, ThrottlingException, ValidationException
    def get_async_invoke(self, GetAsyncInvokeRequest input) -> str:
        auto host = endpoints.regional_host(bedrock_runtime_service(), self.region)
        dict[str, str] labels = {}
        labels["invocationArn"] = input.invocationArn
        auto b = binding.HttpBinding(method="GET", path_template="/async-invoke/{invocationArn}", labels=labels, greedy_labels={}, query={}, headers={}, prefix_header_prefix="", prefix_headers={}, payload_kind=binding.PayloadKind.Empty, body="", content_type="")
        return restjson.rest_json_request(self.creds, b, bedrock_runtime_service(), self.region, host)

