# (zaplang-io/zap#424).
struct TokenUsage:
    int64 inputTokens
    int64 outputTokens
    int64 totalTokens
    Optional[int64] cacheReadInputTokens
    Optional[int64] cacheWriteInputTokens
    Optional[list[CacheDetail]] cacheDetails

@derive(Json)
struct Tool:
    Optional[ToolSpecification] toolSpec
    Optional[SystemTool] systemTool
    Optional[CachePointBlock] cachePoint

@derive(Json)
struct ToolAdditionBlock:
    ToolReference tool

@derive(Json)
struct ToolChoice:
    # wire name "auto" differs from field; derive rename is a #346 follow-up
    Optional[AutoToolChoice] auto_
    Optional[AnyToolChoice] any
    Optional[SpecificToolChoice] tool

# no @derive(Json): member(s) tools: list[Tool] not derivable (list/map collections);
# serialized (when used in a request) by an explicit `<shape>_to_json`
# (zaplang-io/zap#424).
struct ToolConfiguration:
    list[Tool] tools
    Optional[ToolChoice] toolChoice

@derive(Json)
struct ToolInputSchema:
    Optional[Document] json

@derive(Json)
struct ToolReference:
    Optional[str] type
    Optional[str] name
    Optional[str] serverName

@derive(Json)
struct ToolRemovalBlock:
    ToolReference tool

# no @derive(Json): member(s) content: list[ToolResultContentBlock] not derivable (list/map collections);
# serialized (when used in a request) by an explicit `<shape>_to_json`
# (zaplang-io/zap#424).
struct ToolResultBlock:
    str toolUseId
    list[ToolResultContentBlock] content
    Optional[ToolResultStatus] status
    Optional[str] type

@derive(Json)
struct ToolResultBlockDelta:
    Optional[str] text
    Optional[Document] json

@derive(Json)
struct ToolResultBlockStart:
    str toolUseId
    Optional[str] type
    Optional[ToolResultStatus] status

# no @derive(Json): member(s) document: DocumentBlock, searchResult: SearchResultBlock not derivable (list/map collections);
# serialized (when used in a request) by an explicit `<shape>_to_json`
# (zaplang-io/zap#424).
struct ToolResultContentBlock:
    Optional[Document] json
    Optional[str] text
    Optional[ImageBlock] image
    Optional[DocumentBlock] document
    Optional[VideoBlock] video
    Optional[SearchResultBlock] searchResult

@derive(Json)
struct ToolSpecification:
    str name
    Optional[str] description
    ToolInputSchema inputSchema
    Optional[bool] strict

@derive(Json)
struct ToolUseBlock:
    str toolUseId
    str name
    Document input
    Optional[str] type

@derive(Json)
struct ToolUseBlockDelta:
    str input

@derive(Json)
struct ToolUseBlockStart:
    str toolUseId
    str name
    Optional[str] type

@derive(Json)
struct ValidationException:
    Optional[str] message

@derive(Json)
struct VideoBlock:
    VideoFormat format
    VideoSource source

@derive(Json)
struct VideoSource:
    # wire name "bytes" differs from field; derive rename is a #346 follow-up
    Optional[bytes] bytes_
    Optional[S3Location] s3Location

@derive(Json)
struct WebLocation:
    Optional[str] url
    Optional[str] domain

# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by bedrock_runtime_error_from_code.
enum Bedrock_RuntimeError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ModelErrorException
    ModelNotReadyException
    ModelStreamErrorException
    ModelTimeoutException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ServiceUnavailableException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def bedrock_runtime_error_from_code(str code) -> Bedrock_RuntimeError:
    if code == "AccessDeniedException":
        return Bedrock_RuntimeError.AccessDeniedException
    if code == "ConflictException":
        return Bedrock_RuntimeError.ConflictException
    if code == "InternalServerException":
        return Bedrock_RuntimeError.InternalServerException
    if code == "ModelErrorException":
        return Bedrock_RuntimeError.ModelErrorException
    if code == "ModelNotReadyException":
        return Bedrock_RuntimeError.ModelNotReadyException
    if code == "ModelStreamErrorException":
        return Bedrock_RuntimeError.ModelStreamErrorException
    if code == "ModelTimeoutException":
        return Bedrock_RuntimeError.ModelTimeoutException
    if code == "ResourceNotFoundException":
        return Bedrock_RuntimeError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return Bedrock_RuntimeError.ServiceQuotaExceededException
    if code == "ServiceUnavailableException":
        return Bedrock_RuntimeError.ServiceUnavailableException
    if code == "ThrottlingException":
        return Bedrock_RuntimeError.ThrottlingException
    if code == "ValidationException":
        return Bedrock_RuntimeError.ValidationException
    return Bedrock_RuntimeError.Unknown(code=code)

# --- client ----------------------------------------------------------------

# JSON body helpers (compact, declaration-order objects): the collection
# serialization @derive(Json) does not emit yet (zaplang-io/zap#424). `_json_str`
# escapes+quotes via the prelude JSON writer; `_json_obj`/`_json_arr` comma-join
# pre-serialized members.
def bedrock_runtime_json_str(str s) -> str:
    return json.dumps(JsonValue.Str(s))

def bedrock_runtime_json_obj(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "{" + body + "}"

def bedrock_runtime_json_arr(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "[" + body + "]"

# Explicit JSON serializers for document bodies with collection/nested
# members (the @derive(Json) collection follow-up, zaplang-io/zap#424).

# Serialize Citation to a compact JSON object (declaration order).
def citation_to_json(Citation v) -> str:
    list[str] parts = []
    if v.title.is_some():
        auto u0 = v.title.unwrap()
        parts.append("\"title\":" + bedrock_runtime_json_str(u0))
    if v.source.is_some():
        auto u1 = v.source.unwrap()
        parts.append("\"source\":" + bedrock_runtime_json_str(u1))
    if v.sourceContent.is_some():
        auto u2 = v.sourceContent.unwrap()
        list[str] e3 = []
        for x3 in u2:
            e3.append(x3.to_json())
        parts.append("\"sourceContent\":" + bedrock_runtime_json_arr(e3))
    if v.location.is_some():
        auto u4 = v.location.unwrap()
        parts.append("\"location\":" + u4.to_json())
    return bedrock_runtime_json_obj(parts)

