# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def rum_error_from_code(str code) -> RUMError:
    if code == "AccessDeniedException":
        return RUMError.AccessDeniedException
    if code == "ConflictException":
        return RUMError.ConflictException
    if code == "InternalServerException":
        return RUMError.InternalServerException
    if code == "InvalidPolicyRevisionIdException":
        return RUMError.InvalidPolicyRevisionIdException
    if code == "MalformedPolicyDocumentException":
        return RUMError.MalformedPolicyDocumentException
    if code == "PolicyNotFoundException":
        return RUMError.PolicyNotFoundException
    if code == "PolicySizeLimitExceededException":
        return RUMError.PolicySizeLimitExceededException
    if code == "ResourceNotFoundException":
        return RUMError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return RUMError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return RUMError.ThrottlingException
    if code == "ValidationException":
        return RUMError.ValidationException
    return RUMError.Unknown(code=code)

