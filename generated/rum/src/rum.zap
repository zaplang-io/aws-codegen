# Classify an AWS error code into `RUMErrorKind`,
# normalizing first (`errors.error_code` strips any namespace/suffix) then
# matching by name; an unmodeled code becomes `Unknown(name)`, carrying it.
def rum_error_kind(str code) -> RUMErrorKind:
    auto name = errors.error_code(code)
    if name == "AccessDeniedException":
        return RUMErrorKind.AccessDeniedException
    if name == "ConflictException":
        return RUMErrorKind.ConflictException
    if name == "InternalServerException":
        return RUMErrorKind.InternalServerException
    if name == "InvalidPolicyRevisionIdException":
        return RUMErrorKind.InvalidPolicyRevisionIdException
    if name == "MalformedPolicyDocumentException":
        return RUMErrorKind.MalformedPolicyDocumentException
    if name == "PolicyNotFoundException":
        return RUMErrorKind.PolicyNotFoundException
    if name == "PolicySizeLimitExceededException":
        return RUMErrorKind.PolicySizeLimitExceededException
    if name == "ResourceNotFoundException":
        return RUMErrorKind.ResourceNotFoundException
    if name == "ServiceQuotaExceededException":
        return RUMErrorKind.ServiceQuotaExceededException
    if name == "ThrottlingException":
        return RUMErrorKind.ThrottlingException
    if name == "ValidationException":
        return RUMErrorKind.ValidationException
    return RUMErrorKind.Unknown(name)

# The canonical name of a classified error. This `match` is exhaustive over
# every variant (the compiler enforces it, so a new variant forces it to be
# updated — the generator emits the enum and dispatcher together) and is
# module-local, so each pattern is a two-segment `Enum.Variant` — the portable
# form until the compiler resolves module-qualified variant patterns in a
# caller's own `match` (DECISIONS.md D-0006). `Unknown` carries its code.
def rum_error_name(RUMErrorKind k) -> str:
    match k:
        case RUMErrorKind.AccessDeniedException:
            return "AccessDeniedException"
        case RUMErrorKind.ConflictException:
            return "ConflictException"
        case RUMErrorKind.InternalServerException:
            return "InternalServerException"
        case RUMErrorKind.InvalidPolicyRevisionIdException:
            return "InvalidPolicyRevisionIdException"
        case RUMErrorKind.MalformedPolicyDocumentException:
            return "MalformedPolicyDocumentException"
        case RUMErrorKind.PolicyNotFoundException:
            return "PolicyNotFoundException"
        case RUMErrorKind.PolicySizeLimitExceededException:
            return "PolicySizeLimitExceededException"
        case RUMErrorKind.ResourceNotFoundException:
            return "ResourceNotFoundException"
        case RUMErrorKind.ServiceQuotaExceededException:
            return "ServiceQuotaExceededException"
        case RUMErrorKind.ThrottlingException:
            return "ThrottlingException"
        case RUMErrorKind.ValidationException:
            return "ValidationException"
        case RUMErrorKind.Unknown(c):
            return "Unknown(" + c + ")"

