    # nextToken -> nextToken continuation token until it is absent (result key: taskInfos).
    def paginate_list_import_file_task(self, ListImportFileTaskRequest input):
        auto host = endpoints.regional_host(migrationhub_strategy_service(), self.region)
        while True:
            auto raw = self.list_import_file_task(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

# Construct a MigrationHubStrategyClient bound to credentials + region.
def migrationhub_strategy_client(core.Credentials creds, str region) -> MigrationHubStrategyClient:
    return MigrationHubStrategyClient(creds=creds, region=region)
