# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by migrationhub_strategy_error_from_code.
enum MigrationHubStrategyError:
    AccessDeniedException
    ConflictException
    DependencyException
    InternalServerException
    ResourceNotFoundException
    ServiceLinkedRoleLockClientException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def migrationhub_strategy_error_from_code(str code) -> MigrationHubStrategyError:
    if code == "AccessDeniedException":
        return MigrationHubStrategyError.AccessDeniedException
    if code == "ConflictException":
        return MigrationHubStrategyError.ConflictException
    if code == "DependencyException":
        return MigrationHubStrategyError.DependencyException
    if code == "InternalServerException":
        return MigrationHubStrategyError.InternalServerException
    if code == "ResourceNotFoundException":
        return MigrationHubStrategyError.ResourceNotFoundException
    if code == "ServiceLinkedRoleLockClientException":
        return MigrationHubStrategyError.ServiceLinkedRoleLockClientException
    if code == "ServiceQuotaExceededException":
        return MigrationHubStrategyError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return MigrationHubStrategyError.ThrottlingException
    if code == "ValidationException":
        return MigrationHubStrategyError.ValidationException
    return MigrationHubStrategyError.Unknown(code=code)

