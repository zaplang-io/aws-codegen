    # Paginator for GetServerDetails — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: associatedApplications).
    def paginate_get_server_details(self, GetServerDetailsRequest input):
        auto host = endpoints.regional_host(migrationhub_strategy_service(), self.region)
        while True:
            auto raw = self.get_server_details(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

