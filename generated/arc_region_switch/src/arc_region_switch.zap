# CBOR body serializers: each builds a `cbor.CborValue` map for its shape
# (member wire name -> value, model order) for `cbor.cbor_encode` (zaplang-io/
# zap#428).

# Serialize ApprovePlanExecutionStepRequest to a CBOR map (member wire name -> value, model order).
def approve_plan_execution_step_request_to_cbor(ApprovePlanExecutionStepRequest v) -> cbor.CborValue:
    list[str] keys = []
    list[cbor.CborValue] vals = []
    keys.append("planArn")
    vals.append(cbor.cbor_text(v.planArn))
    keys.append("executionId")
    vals.append(cbor.cbor_text(v.executionId))
    keys.append("stepName")
    vals.append(cbor.cbor_text(v.stepName))
