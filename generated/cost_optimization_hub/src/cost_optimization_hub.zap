    Optional[MemberAccountDiscountVisibility] memberAccountDiscountVisibility
    Optional[PreferredCommitment] preferredCommitment

@derive(Json)
struct UpdatePreferencesResponse:
    Optional[SavingsEstimationMode] savingsEstimationMode
    Optional[MemberAccountDiscountVisibility] memberAccountDiscountVisibility
    Optional[PreferredCommitment] preferredCommitment

@derive(Json)
struct Usage:
    Optional[str] usageType
    Optional[float64] usageAmount
    Optional[str] operation
    Optional[str] productCode
    Optional[str] unit

# no @derive(Json): member(s) fields: list[ValidationExceptionDetail] not yet serializable by derive
# (list/map collections — zaplang-io/zap#346 follow-up).
struct ValidationException:
    str message
    Optional[ValidationExceptionReason] reason
    Optional[list[ValidationExceptionDetail]] fields

@derive(Json)
struct ValidationExceptionDetail:
    str fieldName
    str message

# no @derive(Json): member(s) costCalculation: ResourceCostCalculation not yet serializable by derive
# (list/map collections — zaplang-io/zap#346 follow-up).
struct WorkSpaces:
    Optional[ResourceCostCalculation] costCalculation

# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by cost_optimization_hub_error_from_code.
enum Cost_Optimization_HubError:
    AccessDeniedException
    InternalServerException
    ResourceNotFoundException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def cost_optimization_hub_error_from_code(str code) -> Cost_Optimization_HubError:
    if code == "AccessDeniedException":
        return Cost_Optimization_HubError.AccessDeniedException
    if code == "InternalServerException":
        return Cost_Optimization_HubError.InternalServerException
    if code == "ResourceNotFoundException":
        return Cost_Optimization_HubError.ResourceNotFoundException
    if code == "ThrottlingException":
        return Cost_Optimization_HubError.ThrottlingException
    if code == "ValidationException":
        return Cost_Optimization_HubError.ValidationException
    return Cost_Optimization_HubError.Unknown(code=code)

