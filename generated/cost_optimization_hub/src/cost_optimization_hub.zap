#   ListRecommendations (input ListRecommendationsRequest)

# Paginated operations (paginators-1.json) not surfaced in v0 — their input
# is skipped above, or the continuation token is not a simple string field:
#   ListRecommendationSummaries (input not derivable (no generated method))
#   ListRecommendations (input not derivable (no generated method))

# A bound Cost_Optimization_Hub client: credentials + region, threaded into every operation.
struct Cost_Optimization_HubClient:
    core.Credentials creds
    str region

    # GetPreferences
    # errors: AccessDeniedException, InternalServerException, ThrottlingException, ValidationException
    def get_preferences(self) -> str:
        auto body = "{}"
        return awsjson.awsjson_request_now(cost_optimization_hub_protocol(), self.creds, self.region, "GetPreferences", body)

    # GetRecommendation
    # errors: AccessDeniedException, InternalServerException, ResourceNotFoundException, ThrottlingException, ValidationException
    def get_recommendation(self, GetRecommendationRequest input) -> str:
        auto body = input.to_json()
        return awsjson.awsjson_request_now(cost_optimization_hub_protocol(), self.creds, self.region, "GetRecommendation", body)

    # ListEfficiencyMetrics
    # errors: AccessDeniedException, InternalServerException, ThrottlingException, ValidationException
    def list_efficiency_metrics(self, ListEfficiencyMetricsRequest input) -> str:
        auto body = input.to_json()
        return awsjson.awsjson_request_now(cost_optimization_hub_protocol(), self.creds, self.region, "ListEfficiencyMetrics", body)

    # ListEnrollmentStatuses
    # errors: AccessDeniedException, InternalServerException, ThrottlingException, ValidationException
    def list_enrollment_statuses(self, ListEnrollmentStatusesRequest input) -> str:
        auto body = input.to_json()
        return awsjson.awsjson_request_now(cost_optimization_hub_protocol(), self.creds, self.region, "ListEnrollmentStatuses", body)

    # UpdateEnrollmentStatus
    # errors: AccessDeniedException, InternalServerException, ThrottlingException, ValidationException
    def update_enrollment_status(self, UpdateEnrollmentStatusRequest input) -> str:
        auto body = input.to_json()
        return awsjson.awsjson_request_now(cost_optimization_hub_protocol(), self.creds, self.region, "UpdateEnrollmentStatus", body)

    # UpdatePreferences
    # errors: AccessDeniedException, InternalServerException, ThrottlingException, ValidationException
    def update_preferences(self, UpdatePreferencesRequest input) -> str:
        auto body = input.to_json()
        return awsjson.awsjson_request_now(cost_optimization_hub_protocol(), self.creds, self.region, "UpdatePreferences", body)

    # Paginator for ListEfficiencyMetrics — yields each Response page, threading the
    # nextToken -> nextToken continuation token until the output token is absent (result key: efficiencyMetricsByGroup).
    def paginate_list_efficiency_metrics(self, ListEfficiencyMetricsRequest input):
        auto host = endpoints.regional_host(cost_optimization_hub_protocol().service, self.region)
        while True:
            auto body = input.to_json()
            auto raw = awsjson.awsjson_request_now(cost_optimization_hub_protocol(), self.creds, self.region, "ListEfficiencyMetrics", body)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

    # Paginator for ListEnrollmentStatuses — yields each Response page, threading the
    # nextToken -> nextToken continuation token until the output token is absent (result key: items).
    def paginate_list_enrollment_statuses(self, ListEnrollmentStatusesRequest input):
        auto host = endpoints.regional_host(cost_optimization_hub_protocol().service, self.region)
        while True:
            auto body = input.to_json()
            auto raw = awsjson.awsjson_request_now(cost_optimization_hub_protocol(), self.creds, self.region, "ListEnrollmentStatuses", body)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

# Construct a Cost_Optimization_HubClient bound to credentials + region.
def cost_optimization_hub_client(core.Credentials creds, str region) -> Cost_Optimization_HubClient:
    return Cost_Optimization_HubClient(creds=creds, region=region)
