            auto raw = awsjson.awsjson_request_now(bcm_pricing_calculator_protocol(), self.creds, self.region, "ListBillScenarioCommitmentModifications", body)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

# Construct a BCM_Pricing_CalculatorClient bound to credentials + region.
def bcm_pricing_calculator_client(core.Credentials creds, str region) -> BCM_Pricing_CalculatorClient:
    return BCM_Pricing_CalculatorClient(creds=creds, region=region)
