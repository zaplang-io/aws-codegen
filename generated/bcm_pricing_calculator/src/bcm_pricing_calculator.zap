# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by bcm_pricing_calculator_error_from_code.
enum BCM_Pricing_CalculatorError:
    AccessDeniedException
    ConflictException
    DataUnavailableException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def bcm_pricing_calculator_error_from_code(str code) -> BCM_Pricing_CalculatorError:
    if code == "AccessDeniedException":
        return BCM_Pricing_CalculatorError.AccessDeniedException
    if code == "ConflictException":
        return BCM_Pricing_CalculatorError.ConflictException
    if code == "DataUnavailableException":
        return BCM_Pricing_CalculatorError.DataUnavailableException
    if code == "InternalServerException":
        return BCM_Pricing_CalculatorError.InternalServerException
    if code == "ResourceNotFoundException":
        return BCM_Pricing_CalculatorError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return BCM_Pricing_CalculatorError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return BCM_Pricing_CalculatorError.ThrottlingException
    if code == "ValidationException":
        return BCM_Pricing_CalculatorError.ValidationException
    return BCM_Pricing_CalculatorError.Unknown(code=code)

