    Optional[int64] ContentLength
    Optional[str] ContentMD5
    Optional[str] ChecksumAlgorithm
    Optional[str] ChecksumCRC32
    Optional[str] ChecksumCRC32C
    Optional[str] ChecksumCRC64NVME
