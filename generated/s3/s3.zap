    Optional[str] ChecksumMD5
    Optional[str] ChecksumXXHASH64
    Optional[str] ChecksumXXHASH3
    Optional[str] ChecksumXXHASH128
    str Key
    int64 PartNumber
    str UploadId
    Optional[str] SSECustomerAlgorithm
    Optional[str] SSECustomerKey
    Optional[str] SSECustomerKeyMD5
    Optional[str] RequestPayer
    Optional[str] ExpectedBucketOwner

struct VersioningConfiguration:
    Optional[str] MFADelete
    Optional[str] Status

struct WebsiteConfiguration:
    Optional[ErrorDocument] ErrorDocument
    Optional[IndexDocument] IndexDocument
    Optional[RedirectAllRequestsTo] RedirectAllRequestsTo
    Optional[list[RoutingRule]] RoutingRules

struct WriteGetObjectResponseRequest:
