    Optional[str] VersionId
    Optional[bool] BucketKeyEnabled

# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# rest-xml `<Error><Code>` element code by s3_error_from_code.
enum S3Error:
    AccessDenied
    AnnotationLimitExceeded
    AnnotationNameTooLong
    BucketAlreadyExists
    BucketAlreadyOwnedByYou
    EncryptionTypeMismatch
    IdempotencyParameterMismatch
    InvalidAnnotationName
    InvalidObjectState
    InvalidPrefix
    InvalidRequest
    InvalidWriteOffset
    NoSuchAnnotation
    NoSuchBucket
    NoSuchKey
    NoSuchUpload
    ObjectAlreadyInActiveTierError
    ObjectNotInActiveTierError
    TooManyParts
    UnsupportedMediaType
    Unknown(str code)

# Map a rest-xml error code (the <Error><Code> text from rest_xml_error_code)
# to a variant.
def s3_error_from_code(str code) -> S3Error:
    if code == "AccessDenied":
        return S3Error.AccessDenied
    if code == "AnnotationLimitExceeded":
        return S3Error.AnnotationLimitExceeded
    if code == "AnnotationNameTooLong":
        return S3Error.AnnotationNameTooLong
    if code == "BucketAlreadyExists":
        return S3Error.BucketAlreadyExists
    if code == "BucketAlreadyOwnedByYou":
        return S3Error.BucketAlreadyOwnedByYou
    if code == "EncryptionTypeMismatch":
        return S3Error.EncryptionTypeMismatch
    if code == "IdempotencyParameterMismatch":
        return S3Error.IdempotencyParameterMismatch
    if code == "InvalidAnnotationName":
        return S3Error.InvalidAnnotationName
    if code == "InvalidObjectState":
        return S3Error.InvalidObjectState
    if code == "InvalidPrefix":
        return S3Error.InvalidPrefix
    if code == "InvalidRequest":
        return S3Error.InvalidRequest
    if code == "InvalidWriteOffset":
        return S3Error.InvalidWriteOffset
    if code == "NoSuchAnnotation":
        return S3Error.NoSuchAnnotation
    if code == "NoSuchBucket":
        return S3Error.NoSuchBucket
    if code == "NoSuchKey":
        return S3Error.NoSuchKey
    if code == "NoSuchUpload":
        return S3Error.NoSuchUpload
    if code == "ObjectAlreadyInActiveTierError":
        return S3Error.ObjectAlreadyInActiveTierError
    if code == "ObjectNotInActiveTierError":
        return S3Error.ObjectNotInActiveTierError
    if code == "TooManyParts":
        return S3Error.TooManyParts
    if code == "UnsupportedMediaType":
        return S3Error.UnsupportedMediaType
    return S3Error.Unknown(code=code)

# --- client ----------------------------------------------------------------

# Operations skipped in v0 (a body member is not yet serializable by the XML
# emitter — a bool, a map, a list/map of non-scalars, or an XML document body
# with no httpPayload):
#   AbortMultipartUpload (httpHeader `IfMatchInitiatedTime` has unsupported type DateTime)
#   CompleteMultipartUpload (httpPayload structure `MultipartUpload` is optional (v0 needs a required body))
#   CopyObject (httpHeader `CopySourceIfModifiedSince` has unsupported type DateTime)
#   CreateBucket (httpPayload structure `CreateBucketConfiguration` is optional (v0 needs a required body))
#   CreateMultipartUpload (httpHeader `BucketKeyEnabled` has unsupported type bool)
#   CreateSession (httpHeader `BucketKeyEnabled` has unsupported type bool)
#   DeleteObject (httpHeader `BypassGovernanceRetention` has unsupported type bool)
#   DeleteObjects (member `Objects` is a list of ObjectIdentifier (only string lists in v0))
#   GetObject (httpHeader `IfModifiedSince` has unsupported type DateTime)
#   GetObjectAttributes (httpHeader `ObjectAttributes` has unsupported type list[ObjectAttributes])
#   HeadObject (httpHeader `IfModifiedSince` has unsupported type DateTime)
#   ListObjectVersions (httpHeader `OptionalObjectAttributes` has unsupported type list[str])
#   ListObjects (httpHeader `OptionalObjectAttributes` has unsupported type list[str])
#   ListObjectsV2 (httpQuery `FetchOwner` has unsupported type bool)
#   PutBucketAcl (httpPayload structure `AccessControlPolicy` is optional (v0 needs a required body))
#   PutBucketAnalyticsConfiguration (member `Tags` is a list of Tag (only string lists in v0))
#   PutBucketCors (member `CORSRules` is a list of CORSRule (only string lists in v0))
#   PutBucketEncryption (member `Rules` is a list of ServerSideEncryptionRule (only string lists in v0))
#   PutBucketIntelligentTieringConfiguration (member `Tags` is a list of Tag (only string lists in v0))
#   PutBucketInventoryConfiguration (member `IsEnabled` is a bool (the codec has no xml_bool yet))
#   PutBucketLifecycle (httpPayload structure `LifecycleConfiguration` is optional (v0 needs a required body))
#   PutBucketLifecycleConfiguration (httpPayload structure `LifecycleConfiguration` is optional (v0 needs a required body))
#   PutBucketLogging (member `TargetGrants` is a list of TargetGrant (only string lists in v0))
#   PutBucketMetricsConfiguration (member `Tags` is a list of Tag (only string lists in v0))
#   PutBucketNotificationConfiguration (member `TopicConfigurations` is a list of TopicConfiguration (only string lists in v0))
#   PutBucketOwnershipControls (member `Rules` is a list of OwnershipControlsRule (only string lists in v0))
#   PutBucketPolicy (httpHeader `ConfirmRemoveSelfBucketAccess` has unsupported type bool)
#   PutBucketReplication (member `Rules` is a list of ReplicationRule (only string lists in v0))
#   PutBucketTagging (member `TagSet` is a list of Tag (only string lists in v0))
#   PutBucketWebsite (member `RoutingRules` is a list of RoutingRule (only string lists in v0))
#   PutObject (httpHeader `BucketKeyEnabled` has unsupported type bool)
#   PutObjectAcl (httpPayload structure `AccessControlPolicy` is optional (v0 needs a required body))
#   PutObjectLegalHold (httpPayload structure `LegalHold` is optional (v0 needs a required body))
#   PutObjectLockConfiguration (httpPayload structure `ObjectLockConfiguration` is optional (v0 needs a required body))
#   PutObjectRetention (httpPayload structure `Retention` is optional (v0 needs a required body))
#   PutObjectTagging (member `TagSet` is a list of Tag (only string lists in v0))
#   PutPublicAccessBlock (member `BlockPublicAcls` is a bool (the codec has no xml_bool yet))
#   RenameObject (httpHeader `DestinationIfModifiedSince` has unsupported type DateTime)
#   RestoreObject (httpPayload structure `RestoreRequest` is optional (v0 needs a required body))
#   SelectObjectContent (rest-xml document body without httpPayload (members Expression, ExpressionType, RequestProgress, InputSerialization, OutputSerialization, ScanRange) is a v0 follow-up)
#   UpdateObjectEncryption (member `BucketKeyEnabled` is a bool (the codec has no xml_bool yet))
#   UploadPartCopy (httpHeader `CopySourceIfModifiedSince` has unsupported type DateTime)
#   WriteGetObjectResponse (httpHeader `DeleteMarker` has unsupported type bool)

# Paginated operations (paginators-1.json) are not surfaced for this protocol in
# v0 — XML-response pagination (next_page_xml) is a follow-up:
#   ListBuckets
#   ListDirectoryBuckets
#   ListMultipartUploads
#   ListObjectAnnotations
#   ListObjectVersions
#   ListObjects
#   ListObjectsV2
#   ListParts

# A bound S3 client: credentials + region, threaded into every operation.
struct S3Client:
    Credentials creds
    str region

    # CreateBucketMetadataConfiguration  POST /{Bucket}?metadataConfiguration
    def create_bucket_metadata_configuration(self, CreateBucketMetadataConfigurationRequest input) -> str:
        auto host = regional_host(s3_service(), self.region)
        dict[str, str] labels = {}
        labels["Bucket"] = input.Bucket
        dict[str, str] headers = {}
        if input.ContentMD5.is_some():
            headers["Content-MD5"] = input.ContentMD5.unwrap_or("")
        if input.ChecksumAlgorithm.is_some():
            headers["x-amz-sdk-checksum-algorithm"] = input.ChecksumAlgorithm.unwrap_or("")
        if input.ExpectedBucketOwner.is_some():
            headers["x-amz-expected-bucket-owner"] = input.ExpectedBucketOwner.unwrap_or("")
        auto b = HttpBinding(method="POST", path_template="/{Bucket}?metadataConfiguration", labels=labels, greedy_labels={}, query={}, headers=headers, prefix_header_prefix="", prefix_headers={}, payload_kind=PayloadKind.Empty, body="", content_type="")
        auto root = rest_xml_root_ns("MetadataConfiguration", "http://s3.amazonaws.com/doc/2006-03-01/")
        auto n0 = rest_xml_struct(root, "JournalTableConfiguration")
        auto n1 = rest_xml_struct(n0, "RecordExpiration")
        auto t2 = input.MetadataConfiguration.JournalTableConfiguration.RecordExpiration.Expiration
        rest_xml_scalar(n1, "Expiration", t2)
        if input.MetadataConfiguration.JournalTableConfiguration.RecordExpiration.Days.is_some():
            auto t3 = str(input.MetadataConfiguration.JournalTableConfiguration.RecordExpiration.Days.unwrap())
            rest_xml_scalar(n1, "Days", t3)
        if input.MetadataConfiguration.JournalTableConfiguration.EncryptionConfiguration.is_some():
            auto n4 = rest_xml_struct(n0, "EncryptionConfiguration")
            auto t5 = input.MetadataConfiguration.JournalTableConfiguration.EncryptionConfiguration.unwrap().SseAlgorithm
            rest_xml_scalar(n4, "SseAlgorithm", t5)
            if input.MetadataConfiguration.JournalTableConfiguration.EncryptionConfiguration.unwrap().KmsKeyArn.is_some():
                auto t6 = input.MetadataConfiguration.JournalTableConfiguration.EncryptionConfiguration.unwrap().KmsKeyArn.unwrap()
                rest_xml_scalar(n4, "KmsKeyArn", t6)
        if input.MetadataConfiguration.InventoryTableConfiguration.is_some():
            auto n7 = rest_xml_struct(root, "InventoryTableConfiguration")
            auto t8 = input.MetadataConfiguration.InventoryTableConfiguration.unwrap().ConfigurationState
            rest_xml_scalar(n7, "ConfigurationState", t8)
            if input.MetadataConfiguration.InventoryTableConfiguration.unwrap().EncryptionConfiguration.is_some():
                auto n9 = rest_xml_struct(n7, "EncryptionConfiguration")
                auto t10 = input.MetadataConfiguration.InventoryTableConfiguration.unwrap().EncryptionConfiguration.unwrap().SseAlgorithm
                rest_xml_scalar(n9, "SseAlgorithm", t10)
                if input.MetadataConfiguration.InventoryTableConfiguration.unwrap().EncryptionConfiguration.unwrap().KmsKeyArn.is_some():
                    auto t11 = input.MetadataConfiguration.InventoryTableConfiguration.unwrap().EncryptionConfiguration.unwrap().KmsKeyArn.unwrap()
                    rest_xml_scalar(n9, "KmsKeyArn", t11)
        if input.MetadataConfiguration.AnnotationTableConfiguration.is_some():
            auto n12 = rest_xml_struct(root, "AnnotationTableConfiguration")
            auto t13 = input.MetadataConfiguration.AnnotationTableConfiguration.unwrap().ConfigurationState
            rest_xml_scalar(n12, "ConfigurationState", t13)
            if input.MetadataConfiguration.AnnotationTableConfiguration.unwrap().EncryptionConfiguration.is_some():
                auto n14 = rest_xml_struct(n12, "EncryptionConfiguration")
                auto t15 = input.MetadataConfiguration.AnnotationTableConfiguration.unwrap().EncryptionConfiguration.unwrap().SseAlgorithm
                rest_xml_scalar(n14, "SseAlgorithm", t15)
                if input.MetadataConfiguration.AnnotationTableConfiguration.unwrap().EncryptionConfiguration.unwrap().KmsKeyArn.is_some():
                    auto t16 = input.MetadataConfiguration.AnnotationTableConfiguration.unwrap().EncryptionConfiguration.unwrap().KmsKeyArn.unwrap()
                    rest_xml_scalar(n14, "KmsKeyArn", t16)
            if input.MetadataConfiguration.AnnotationTableConfiguration.unwrap().Role.is_some():
                auto t17 = input.MetadataConfiguration.AnnotationTableConfiguration.unwrap().Role.unwrap()
                rest_xml_scalar(n12, "Role", t17)
        auto body = rest_xml_serialize(root)
        auto bp = rest_xml_document(b, body)
        return rest_xml_request(self.creds, bp, s3_service(), self.region, host)

