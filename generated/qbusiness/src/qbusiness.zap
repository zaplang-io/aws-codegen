            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

# Construct a QBusinessClient bound to credentials + region.
def qbusiness_client(core.Credentials creds, str region) -> QBusinessClient:
    return QBusinessClient(creds=creds, region=region)
