    # Paginator for ListDataTransformationJobs — yields each Response page, threading the
    # NextToken -> NextToken continuation token until the output token is absent (result key: Items).
    def paginate_list_data_transformation_jobs(self, ListDataTransformationJobsRequest input):
        auto host = endpoints.regional_host(healthlake_protocol().service, self.region)
        while True:
            auto body = input.to_json()
            auto raw = awsjson.awsjson_request_now(healthlake_protocol(), self.creds, self.region, "ListDataTransformationJobs", body)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

