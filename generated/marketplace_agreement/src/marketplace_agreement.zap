# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# smithy-rpc-v2-cbor body `__type` (cbor.cbor_error_type) code by agreement_marketplace_error_from_code.
enum Marketplace_AgreementError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a smithy-rpc-v2-cbor error code to a variant. The code is the body's
# `__type` (cbor.cbor_error_type / cbor.cbor_error.code); it is namespaced like
# awsJson (e.g. "com.amazonaws.<svc>#<Name>"), so strip to the bare shape name
# (the text after the last '#') before dispatching.
def agreement_marketplace_error_from_code(str code) -> Marketplace_AgreementError:
    if code == "AccessDeniedException":
        return Marketplace_AgreementError.AccessDeniedException
    if code == "ConflictException":
        return Marketplace_AgreementError.ConflictException
    if code == "InternalServerException":
        return Marketplace_AgreementError.InternalServerException
    if code == "ResourceNotFoundException":
        return Marketplace_AgreementError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return Marketplace_AgreementError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return Marketplace_AgreementError.ThrottlingException
    if code == "ValidationException":
        return Marketplace_AgreementError.ValidationException
    return Marketplace_AgreementError.Unknown(code=code)

