        auto body = cbor.cbor_encode(update_purchase_orders_input_to_cbor(input))
        auto host = endpoints.regional_host(agreement_marketplace_service(), self.region)
        auto t = core.signing_time_now()
        auto req = cbor.cbor_build_request(agreement_marketplace_service(), self.region, host, "AWSMPCommerceService_v20200301", "UpdatePurchaseOrders", body, t.amz_date)
        return cbor.cbor_sign(self.creds, req, body, t.amz_date, t.date_stamp)

# Construct a Marketplace_AgreementClient bound to credentials + region.
def agreement_marketplace_client(core.Credentials creds, str region) -> Marketplace_AgreementClient:
    return Marketplace_AgreementClient(creds=creds, region=region)
