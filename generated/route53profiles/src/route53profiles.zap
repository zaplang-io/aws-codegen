    # Paginator for ListProfileAssociations — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: ProfileAssociations).
    def paginate_list_profile_associations(self, ListProfileAssociationsRequest input):
        auto host = endpoints.regional_host(route53profiles_service(), self.region)
        while True:
            auto raw = self.list_profile_associations(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
