# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by emr_containers_error_from_code.
enum EMR_containersError:
    EKSRequestThrottledException
    InternalServerException
    RequestThrottledException
    ResourceNotFoundException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def emr_containers_error_from_code(str code) -> EMR_containersError:
    if code == "EKSRequestThrottledException":
        return EMR_containersError.EKSRequestThrottledException
    if code == "InternalServerException":
        return EMR_containersError.InternalServerException
    if code == "RequestThrottledException":
        return EMR_containersError.RequestThrottledException
    if code == "ResourceNotFoundException":
        return EMR_containersError.ResourceNotFoundException
    if code == "ValidationException":
        return EMR_containersError.ValidationException
    return EMR_containersError.Unknown(code=code)

