    # document members of GetManagedEndpointSessionCredentials
    str executionRoleArn
    str credentialType
    Optional[int64] durationInSeconds
    Optional[str] logContext
    Optional[str] clientToken

@derive(Json)
struct UpdateVirtualClusterDocument:
