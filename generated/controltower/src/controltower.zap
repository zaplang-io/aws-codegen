            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

# Construct a ControlTowerClient bound to credentials + region.
def controltower_client(core.Credentials creds, str region) -> ControlTowerClient:
    return ControlTowerClient(creds=creds, region=region)
