# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by controltower_error_from_code.
enum ControlTowerError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def controltower_error_from_code(str code) -> ControlTowerError:
    if code == "AccessDeniedException":
        return ControlTowerError.AccessDeniedException
    if code == "ConflictException":
        return ControlTowerError.ConflictException
    if code == "InternalServerException":
        return ControlTowerError.InternalServerException
    if code == "ResourceNotFoundException":
        return ControlTowerError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return ControlTowerError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return ControlTowerError.ThrottlingException
    if code == "ValidationException":
        return ControlTowerError.ValidationException
    return ControlTowerError.Unknown(code=code)

