# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by codeartifact_error_from_code.
enum codeartifactError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def codeartifact_error_from_code(str code) -> codeartifactError:
    if code == "AccessDeniedException":
        return codeartifactError.AccessDeniedException
    if code == "ConflictException":
        return codeartifactError.ConflictException
    if code == "InternalServerException":
        return codeartifactError.InternalServerException
    if code == "ResourceNotFoundException":
        return codeartifactError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return codeartifactError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return codeartifactError.ThrottlingException
    if code == "ValidationException":
        return codeartifactError.ValidationException
    return codeartifactError.Unknown(code=code)

