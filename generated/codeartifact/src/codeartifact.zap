    # Paginator for ListAllowedRepositoriesForGroup — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: allowedRepositories).
    def paginate_list_allowed_repositories_for_group(self, ListAllowedRepositoriesForGroupRequest input):
        auto host = endpoints.regional_host(codeartifact_service(), self.region)
        while True:
            auto raw = self.list_allowed_repositories_for_group(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

