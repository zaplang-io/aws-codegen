    # Paginator for ListSubscribers — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: subscribers).
    def paginate_list_subscribers(self, ListSubscribersRequest input):
        auto host = endpoints.regional_host(securitylake_service(), self.region)
        while True:
            auto raw = self.list_subscribers(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

# Construct a SecurityLakeClient bound to credentials + region.
def securitylake_client(core.Credentials creds, str region) -> SecurityLakeClient:
    return SecurityLakeClient(creds=creds, region=region)
