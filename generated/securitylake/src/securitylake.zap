# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by securitylake_error_from_code.
enum SecurityLakeError:
    AccessDeniedException
    BadRequestException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ThrottlingException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def securitylake_error_from_code(str code) -> SecurityLakeError:
    if code == "AccessDeniedException":
        return SecurityLakeError.AccessDeniedException
    if code == "BadRequestException":
        return SecurityLakeError.BadRequestException
    if code == "ConflictException":
        return SecurityLakeError.ConflictException
    if code == "InternalServerException":
        return SecurityLakeError.InternalServerException
    if code == "ResourceNotFoundException":
        return SecurityLakeError.ResourceNotFoundException
    if code == "ThrottlingException":
        return SecurityLakeError.ThrottlingException
    return SecurityLakeError.Unknown(code=code)

