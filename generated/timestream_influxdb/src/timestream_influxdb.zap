# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by timestream_influxdb_error_from_code.
enum Timestream_InfluxDBError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def timestream_influxdb_error_from_code(str code) -> Timestream_InfluxDBError:
    if code == "AccessDeniedException":
        return Timestream_InfluxDBError.AccessDeniedException
    if code == "ConflictException":
        return Timestream_InfluxDBError.ConflictException
    if code == "InternalServerException":
        return Timestream_InfluxDBError.InternalServerException
    if code == "ResourceNotFoundException":
        return Timestream_InfluxDBError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return Timestream_InfluxDBError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return Timestream_InfluxDBError.ThrottlingException
    if code == "ValidationException":
        return Timestream_InfluxDBError.ValidationException
    return Timestream_InfluxDBError.Unknown(code=code)

