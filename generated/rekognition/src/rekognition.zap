    # Paginator for ListUsers — yields each Response page, threading the
    # NextToken -> NextToken continuation token until the output token is absent (result key: Users).
    def paginate_list_users(self, ListUsersRequest input):
        auto host = endpoints.regional_host(rekognition_protocol().service, self.region)
        while True:
            auto body = input.to_json()
            auto raw = awsjson.awsjson_request_now(rekognition_protocol(), self.creds, self.region, "ListUsers", body)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

# Construct a RekognitionClient bound to credentials + region.
def rekognition_client(core.Credentials creds, str region) -> RekognitionClient:
    return RekognitionClient(creds=creds, region=region)
