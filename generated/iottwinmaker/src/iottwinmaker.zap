# --- errors ----------------------------------------------------------------

# Typed service errors (#361): the per-service enum + classifier + name
# dispatcher emitted on top of `aws_core.errors` (DECISIONS.md D-0006). One
# bare variant per modeled error shape, plus an open-enum `Unknown(str code)`
# catch-all, so a caller built against this model keeps working when the
# service adds an error. The raw wire code is
# the restJson1 X-Amzn-ErrorType header or body `__type`.
# `errors.error_code` normalizes it to the bare shape name before matching;
# the base carrier, the X-Amzn-ErrorType fallback and the raise/check bridge
# are inherited from `aws_core.errors` and not re-emitted here.
enum IoTTwinMakerErrorKind:
    AccessDeniedException
    ConflictException
    ConnectorFailureException
    ConnectorTimeoutException
    InternalServerException
    QueryTimeoutException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    TooManyTagsException
    ValidationException
    Unknown(str code)

# Classify an AWS error code into `IoTTwinMakerErrorKind`,
# normalizing first (`errors.error_code` strips any namespace/suffix) then
# matching by name; an unmodeled code becomes `Unknown(name)`, carrying it.
def iottwinmaker_error_kind(str code) -> IoTTwinMakerErrorKind:
    auto name = errors.error_code(code)
    if name == "AccessDeniedException":
        return IoTTwinMakerErrorKind.AccessDeniedException
    if name == "ConflictException":
        return IoTTwinMakerErrorKind.ConflictException
    if name == "ConnectorFailureException":
        return IoTTwinMakerErrorKind.ConnectorFailureException
    if name == "ConnectorTimeoutException":
        return IoTTwinMakerErrorKind.ConnectorTimeoutException
    if name == "InternalServerException":
        return IoTTwinMakerErrorKind.InternalServerException
    if name == "QueryTimeoutException":
        return IoTTwinMakerErrorKind.QueryTimeoutException
    if name == "ResourceNotFoundException":
        return IoTTwinMakerErrorKind.ResourceNotFoundException
    if name == "ServiceQuotaExceededException":
        return IoTTwinMakerErrorKind.ServiceQuotaExceededException
    if name == "ThrottlingException":
        return IoTTwinMakerErrorKind.ThrottlingException
    if name == "TooManyTagsException":
        return IoTTwinMakerErrorKind.TooManyTagsException
    if name == "ValidationException":
        return IoTTwinMakerErrorKind.ValidationException
    return IoTTwinMakerErrorKind.Unknown(name)

# The canonical name of a classified error. This `match` is exhaustive over
# every variant (the compiler enforces it, so a new variant forces it to be
# updated — the generator emits the enum and dispatcher together) and is
# module-local, so each pattern is a two-segment `Enum.Variant` — the portable
# form until the compiler resolves module-qualified variant patterns in a
# caller's own `match` (DECISIONS.md D-0006). `Unknown` carries its code.
def iottwinmaker_error_name(IoTTwinMakerErrorKind k) -> str:
    match k:
        case IoTTwinMakerErrorKind.AccessDeniedException:
            return "AccessDeniedException"
        case IoTTwinMakerErrorKind.ConflictException:
            return "ConflictException"
        case IoTTwinMakerErrorKind.ConnectorFailureException:
            return "ConnectorFailureException"
        case IoTTwinMakerErrorKind.ConnectorTimeoutException:
            return "ConnectorTimeoutException"
        case IoTTwinMakerErrorKind.InternalServerException:
            return "InternalServerException"
        case IoTTwinMakerErrorKind.QueryTimeoutException:
            return "QueryTimeoutException"
        case IoTTwinMakerErrorKind.ResourceNotFoundException:
            return "ResourceNotFoundException"
        case IoTTwinMakerErrorKind.ServiceQuotaExceededException:
            return "ServiceQuotaExceededException"
        case IoTTwinMakerErrorKind.ThrottlingException:
            return "ThrottlingException"
        case IoTTwinMakerErrorKind.TooManyTagsException:
            return "TooManyTagsException"
        case IoTTwinMakerErrorKind.ValidationException:
            return "ValidationException"
        case IoTTwinMakerErrorKind.Unknown(c):
            return "Unknown(" + c + ")"

