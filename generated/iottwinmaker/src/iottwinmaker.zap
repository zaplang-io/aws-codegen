# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by iottwinmaker_error_from_code.
enum IoTTwinMakerError:
    AccessDeniedException
    ConflictException
    ConnectorFailureException
    ConnectorTimeoutException
    InternalServerException
    QueryTimeoutException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    TooManyTagsException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def iottwinmaker_error_from_code(str code) -> IoTTwinMakerError:
    if code == "AccessDeniedException":
        return IoTTwinMakerError.AccessDeniedException
    if code == "ConflictException":
        return IoTTwinMakerError.ConflictException
    if code == "ConnectorFailureException":
        return IoTTwinMakerError.ConnectorFailureException
    if code == "ConnectorTimeoutException":
        return IoTTwinMakerError.ConnectorTimeoutException
    if code == "InternalServerException":
        return IoTTwinMakerError.InternalServerException
    if code == "QueryTimeoutException":
        return IoTTwinMakerError.QueryTimeoutException
    if code == "ResourceNotFoundException":
        return IoTTwinMakerError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return IoTTwinMakerError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return IoTTwinMakerError.ThrottlingException
    if code == "TooManyTagsException":
        return IoTTwinMakerError.TooManyTagsException
    if code == "ValidationException":
        return IoTTwinMakerError.ValidationException
    return IoTTwinMakerError.Unknown(code=code)

