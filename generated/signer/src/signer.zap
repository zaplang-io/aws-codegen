    # Paginator for ListSigningPlatforms — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: platforms).
    def paginate_list_signing_platforms(self, ListSigningPlatformsRequest input):
        auto host = endpoints.regional_host(signer_service(), self.region)
        while True:
            auto raw = self.list_signing_platforms(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

# Construct a signerClient bound to credentials + region.
def signer_client(core.Credentials creds, str region) -> signerClient:
    return signerClient(creds=creds, region=region)
