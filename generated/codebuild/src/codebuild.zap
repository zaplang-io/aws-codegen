# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by codebuild_error_from_code.
enum CodeBuildError:
    AccountLimitExceededException
    AccountSuspendedException
    InvalidInputException
    OAuthProviderException
    ResourceAlreadyExistsException
    ResourceNotFoundException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def codebuild_error_from_code(str code) -> CodeBuildError:
    if code == "AccountLimitExceededException":
        return CodeBuildError.AccountLimitExceededException
    if code == "AccountSuspendedException":
        return CodeBuildError.AccountSuspendedException
    if code == "InvalidInputException":
        return CodeBuildError.InvalidInputException
    if code == "OAuthProviderException":
        return CodeBuildError.OAuthProviderException
    if code == "ResourceAlreadyExistsException":
        return CodeBuildError.ResourceAlreadyExistsException
    if code == "ResourceNotFoundException":
        return CodeBuildError.ResourceNotFoundException
    return CodeBuildError.Unknown(code=code)

