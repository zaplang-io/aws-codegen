# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by mediaconnect_error_from_code.
enum MediaConnectError:
    AddFlowOutputs420Exception
    BadRequestException
    ConflictException
    CreateBridge420Exception
    CreateFlow420Exception
    CreateGateway420Exception
    DestinationEndpointServiceQuotaExceededException
    ForbiddenException
    GrantFlowEntitlements420Exception
    InternalServerErrorException
    NotFoundException
    RouterInputServiceQuotaExceededException
    RouterNetworkInterfaceServiceQuotaExceededException
    RouterOutputServiceQuotaExceededException
    ServiceUnavailableException
    SourceEndpointServiceQuotaExceededException
    TooManyRequestsException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def mediaconnect_error_from_code(str code) -> MediaConnectError:
    if code == "AddFlowOutputs420Exception":
        return MediaConnectError.AddFlowOutputs420Exception
    if code == "BadRequestException":
        return MediaConnectError.BadRequestException
    if code == "ConflictException":
        return MediaConnectError.ConflictException
    if code == "CreateBridge420Exception":
        return MediaConnectError.CreateBridge420Exception
    if code == "CreateFlow420Exception":
        return MediaConnectError.CreateFlow420Exception
    if code == "CreateGateway420Exception":
        return MediaConnectError.CreateGateway420Exception
    if code == "DestinationEndpointServiceQuotaExceededException":
        return MediaConnectError.DestinationEndpointServiceQuotaExceededException
    if code == "ForbiddenException":
        return MediaConnectError.ForbiddenException
    if code == "GrantFlowEntitlements420Exception":
        return MediaConnectError.GrantFlowEntitlements420Exception
    if code == "InternalServerErrorException":
        return MediaConnectError.InternalServerErrorException
    if code == "NotFoundException":
        return MediaConnectError.NotFoundException
    if code == "RouterInputServiceQuotaExceededException":
        return MediaConnectError.RouterInputServiceQuotaExceededException
    if code == "RouterNetworkInterfaceServiceQuotaExceededException":
        return MediaConnectError.RouterNetworkInterfaceServiceQuotaExceededException
    if code == "RouterOutputServiceQuotaExceededException":
        return MediaConnectError.RouterOutputServiceQuotaExceededException
    if code == "ServiceUnavailableException":
        return MediaConnectError.ServiceUnavailableException
    if code == "SourceEndpointServiceQuotaExceededException":
        return MediaConnectError.SourceEndpointServiceQuotaExceededException
    if code == "TooManyRequestsException":
        return MediaConnectError.TooManyRequestsException
    return MediaConnectError.Unknown(code=code)

