    Optional[str] reserved

@derive(Json)
struct WorkflowSummary:
    str id
    str name
    str sourceRepositoryName
    str sourceBranchName
    WorkflowDefinitionSummary definition
    @json(timestamp="iso8601")
    DateTime createdTime
    @json(timestamp="iso8601")
    DateTime lastUpdatedTime
    WorkflowRunMode runMode
    WorkflowStatus status

# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by codecatalyst_error_from_code.
enum CodeCatalystError:
    AccessDeniedException
    ConflictException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def codecatalyst_error_from_code(str code) -> CodeCatalystError:
    if code == "AccessDeniedException":
        return CodeCatalystError.AccessDeniedException
    if code == "ConflictException":
        return CodeCatalystError.ConflictException
    if code == "ResourceNotFoundException":
        return CodeCatalystError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return CodeCatalystError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return CodeCatalystError.ThrottlingException
    if code == "ValidationException":
        return CodeCatalystError.ValidationException
    return CodeCatalystError.Unknown(code=code)

