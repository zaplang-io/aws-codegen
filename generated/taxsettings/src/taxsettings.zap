# header or body __type, stripped to the bare shape name) to a variant.
def tax_error_from_code(str code) -> TaxSettingsError:
    if code == "AccessDeniedException":
        return TaxSettingsError.AccessDeniedException
    if code == "AttachmentUploadException":
        return TaxSettingsError.AttachmentUploadException
    if code == "CaseCreationLimitExceededException":
        return TaxSettingsError.CaseCreationLimitExceededException
    if code == "ConflictException":
        return TaxSettingsError.ConflictException
    if code == "InternalServerException":
        return TaxSettingsError.InternalServerException
    if code == "ResourceNotFoundException":
        return TaxSettingsError.ResourceNotFoundException
    if code == "ValidationException":
        return TaxSettingsError.ValidationException
    return TaxSettingsError.Unknown(code=code)

# --- client ----------------------------------------------------------------

# Per-operation JSON document bodies (the unbound "document" members of an
# operation's input, serialized with @derive(Json)).

@derive(Json)
struct DeleteSupplementalTaxRegistrationDocument:
    # document members of DeleteSupplementalTaxRegistration
    str authorityId

@derive(Json)
struct DeleteTaxRegistrationDocument:
    # document members of DeleteTaxRegistration
    Optional[str] accountId

@derive(Json)
struct GetTaxRegistrationDocument:
    # document members of GetTaxRegistration
    Optional[str] accountId

@derive(Json)
struct GetTaxRegistrationDocumentDocument:
    # document members of GetTaxRegistrationDocument
    Optional[DestinationS3Location] destinationS3Location
    TaxDocumentMetadata taxDocumentMetadata

@derive(Json)
struct ListSupplementalTaxRegistrationsDocument:
    # document members of ListSupplementalTaxRegistrations
    Optional[int64] maxResults
    Optional[str] nextToken

@derive(Json)
struct ListTaxExemptionsDocument:
    # document members of ListTaxExemptions
    Optional[int64] maxResults
    Optional[str] nextToken

@derive(Json)
struct ListTaxRegistrationsDocument:
    # document members of ListTaxRegistrations
    Optional[int64] maxResults
    Optional[str] nextToken

@derive(Json)
struct PutSupplementalTaxRegistrationDocument:
    # document members of PutSupplementalTaxRegistration
    SupplementalTaxRegistrationEntry taxRegistrationEntry

@derive(Json)
struct PutTaxInheritanceDocument:
    # document members of PutTaxInheritance
    Optional[HeritageStatus] heritageStatus

# JSON body helpers (compact, declaration-order objects): the collection
# serialization @derive(Json) does not emit yet (zaplang-io/zap#424). `_json_str`
# escapes+quotes via the prelude JSON writer; `_json_obj`/`_json_arr` comma-join
# pre-serialized members.
def tax_json_str(str s) -> str:
    return json.dumps(JsonValue.Str(s))

def tax_json_obj(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "{" + body + "}"

def tax_json_arr(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "[" + body + "]"

