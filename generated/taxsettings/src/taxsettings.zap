    # Paginator for ListSupplementalTaxRegistrations — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: taxRegistrations).
    def paginate_list_supplemental_tax_registrations(self, ListSupplementalTaxRegistrationsRequest input):
        auto host = endpoints.regional_host(tax_service(), self.region)
        while True:
            auto raw = self.list_supplemental_tax_registrations(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

    # Paginator for ListTaxExemptions — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: taxExemptionDetailsMap).
    def paginate_list_tax_exemptions(self, ListTaxExemptionsRequest input):
        auto host = endpoints.regional_host(tax_service(), self.region)
        while True:
            auto raw = self.list_tax_exemptions(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

    # Paginator for ListTaxRegistrations — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: accountDetails).
    def paginate_list_tax_registrations(self, ListTaxRegistrationsRequest input):
        auto host = endpoints.regional_host(tax_service(), self.region)
        while True:
            auto raw = self.list_tax_registrations(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

# Construct a TaxSettingsClient bound to credentials + region.
def tax_client(core.Credentials creds, str region) -> TaxSettingsClient:
    return TaxSettingsClient(creds=creds, region=region)
