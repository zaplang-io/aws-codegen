# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by transcribe_error_from_code.
enum TranscribeError:
    BadRequestException
    ConflictException
    InternalFailureException
    LimitExceededException
    NotFoundException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def transcribe_error_from_code(str code) -> TranscribeError:
    if code == "BadRequestException":
        return TranscribeError.BadRequestException
    if code == "ConflictException":
        return TranscribeError.ConflictException
    if code == "InternalFailureException":
        return TranscribeError.InternalFailureException
    if code == "LimitExceededException":
        return TranscribeError.LimitExceededException
    if code == "NotFoundException":
        return TranscribeError.NotFoundException
    return TranscribeError.Unknown(code=code)

