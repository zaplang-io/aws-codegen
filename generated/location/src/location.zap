# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by geo_error_from_code.
enum LocationError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def geo_error_from_code(str code) -> LocationError:
    if code == "AccessDeniedException":
        return LocationError.AccessDeniedException
    if code == "ConflictException":
        return LocationError.ConflictException
    if code == "InternalServerException":
        return LocationError.InternalServerException
    if code == "ResourceNotFoundException":
        return LocationError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return LocationError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return LocationError.ThrottlingException
    if code == "ValidationException":
        return LocationError.ValidationException
    return LocationError.Unknown(code=code)

