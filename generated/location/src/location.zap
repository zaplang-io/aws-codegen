            input.NextToken = Optional.Some(np.token)

    # Paginator for ListRouteCalculators — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: Entries).
    def paginate_list_route_calculators(self, ListRouteCalculatorsRequest input):
        auto host = endpoints.regional_host(geo_service(), self.region)
        while True:
            auto raw = self.list_route_calculators(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

    # Paginator for ListTrackerConsumers — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: ConsumerArns).
    def paginate_list_tracker_consumers(self, ListTrackerConsumersRequest input):
        auto host = endpoints.regional_host(geo_service(), self.region)
        while True:
            auto raw = self.list_tracker_consumers(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

    # Paginator for ListTrackers — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: Entries).
    def paginate_list_trackers(self, ListTrackersRequest input):
        auto host = endpoints.regional_host(geo_service(), self.region)
        while True:
            auto raw = self.list_trackers(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

# Construct a LocationClient bound to credentials + region.
def geo_client(core.Credentials creds, str region) -> LocationClient:
    return LocationClient(creds=creds, region=region)
