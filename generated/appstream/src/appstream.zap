# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# smithy-rpc-v2-cbor body `__type` (cbor.cbor_error_type) code by appstream2_error_from_code.
enum AppStreamError:
    ConcurrentModificationException
    DryRunOperationException
    EntitlementAlreadyExistsException
    EntitlementNotFoundException
    IncompatibleImageException
    InvalidAccountStatusException
    InvalidParameterCombinationException
    InvalidRoleException
    LimitExceededException
    OperationNotPermittedException
    RequestLimitExceededException
    ResourceAlreadyExistsException
    ResourceInUseException
    ResourceNotAvailableException
    ResourceNotFoundException
    Unknown(str code)

# Map a smithy-rpc-v2-cbor error code to a variant. The code is the body's
# `__type` (cbor.cbor_error_type / cbor.cbor_error.code); it is namespaced like
# awsJson (e.g. "com.amazonaws.<svc>#<Name>"), so strip to the bare shape name
# (the text after the last '#') before dispatching.
def appstream2_error_from_code(str code) -> AppStreamError:
    if code == "ConcurrentModificationException":
        return AppStreamError.ConcurrentModificationException
    if code == "DryRunOperationException":
        return AppStreamError.DryRunOperationException
    if code == "EntitlementAlreadyExistsException":
        return AppStreamError.EntitlementAlreadyExistsException
    if code == "EntitlementNotFoundException":
        return AppStreamError.EntitlementNotFoundException
    if code == "IncompatibleImageException":
        return AppStreamError.IncompatibleImageException
    if code == "InvalidAccountStatusException":
        return AppStreamError.InvalidAccountStatusException
    if code == "InvalidParameterCombinationException":
        return AppStreamError.InvalidParameterCombinationException
    if code == "InvalidRoleException":
        return AppStreamError.InvalidRoleException
    if code == "LimitExceededException":
        return AppStreamError.LimitExceededException
    if code == "OperationNotPermittedException":
        return AppStreamError.OperationNotPermittedException
    if code == "RequestLimitExceededException":
        return AppStreamError.RequestLimitExceededException
    if code == "ResourceAlreadyExistsException":
        return AppStreamError.ResourceAlreadyExistsException
    if code == "ResourceInUseException":
        return AppStreamError.ResourceInUseException
    if code == "ResourceNotAvailableException":
        return AppStreamError.ResourceNotAvailableException
    if code == "ResourceNotFoundException":
        return AppStreamError.ResourceNotFoundException
    return AppStreamError.Unknown(code=code)

# --- client ----------------------------------------------------------------

# Paginated operations (paginators-1.json) are not surfaced for this protocol —
# CBOR-response pagination (next_page_cbor) is a runtime follow-up:
#   DescribeDirectoryConfigs
#   DescribeFleets
#   DescribeImageBuilders
#   DescribeImages
#   DescribeSessions
#   DescribeStacks
#   DescribeUserStackAssociations
#   DescribeUsers
#   ListAssociatedFleets
#   ListAssociatedStacks

# CBOR body serializers: each builds a `cbor.CborValue` map for its shape
# (member wire name -> value, model order) for `cbor.cbor_encode` (zaplang-io/
# zap#428).

# Serialize AccessEndpoint to a CBOR map (member wire name -> value, model order).
def access_endpoint_to_cbor(AccessEndpoint v) -> cbor.CborValue:
    list[str] keys = []
    list[cbor.CborValue] vals = []
    keys.append("EndpointType")
    vals.append(cbor.cbor_text(v.EndpointType))
    if v.VpceId.is_some():
        auto u0 = v.VpceId.unwrap()
        keys.append("VpceId")
        vals.append(cbor.cbor_text(u0))
    return cbor.cbor_map(keys, vals)

