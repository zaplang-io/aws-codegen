# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by es_error_from_code.
enum OpenSearchError:
    AccessDeniedException
    BaseException
    ConflictException
    DependencyFailureException
    DisabledOperationException
    InternalException
    InvalidPaginationTokenException
    InvalidTypeException
    LimitExceededException
    ResourceAlreadyExistsException
    ResourceNotFoundException
    ServiceQuotaExceededException
    SlotNotAvailableException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def es_error_from_code(str code) -> OpenSearchError:
    if code == "AccessDeniedException":
        return OpenSearchError.AccessDeniedException
    if code == "BaseException":
        return OpenSearchError.BaseException
    if code == "ConflictException":
        return OpenSearchError.ConflictException
    if code == "DependencyFailureException":
        return OpenSearchError.DependencyFailureException
    if code == "DisabledOperationException":
        return OpenSearchError.DisabledOperationException
    if code == "InternalException":
        return OpenSearchError.InternalException
    if code == "InvalidPaginationTokenException":
        return OpenSearchError.InvalidPaginationTokenException
    if code == "InvalidTypeException":
        return OpenSearchError.InvalidTypeException
    if code == "LimitExceededException":
        return OpenSearchError.LimitExceededException
    if code == "ResourceAlreadyExistsException":
        return OpenSearchError.ResourceAlreadyExistsException
    if code == "ResourceNotFoundException":
        return OpenSearchError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return OpenSearchError.ServiceQuotaExceededException
    if code == "SlotNotAvailableException":
        return OpenSearchError.SlotNotAvailableException
    if code == "ThrottlingException":
        return OpenSearchError.ThrottlingException
    if code == "ValidationException":
        return OpenSearchError.ValidationException
    return OpenSearchError.Unknown(code=code)

