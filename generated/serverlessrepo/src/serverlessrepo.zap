    # Paginator for ListApplicationDependencies — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: Dependencies).
    def paginate_list_application_dependencies(self, ListApplicationDependenciesRequest input):
        auto host = endpoints.regional_host(serverlessrepo_service(), self.region)
        while True:
            auto raw = self.list_application_dependencies(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

    # Paginator for ListApplicationVersions — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: Versions).
