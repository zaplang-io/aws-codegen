# Construct a ServerlessApplicationRepositoryClient bound to credentials + region.
def serverlessrepo_client(core.Credentials creds, str region) -> ServerlessApplicationRepositoryClient:
    return ServerlessApplicationRepositoryClient(creds=creds, region=region)
