# Classify an AWS error code into `ServerlessApplicationRepositoryErrorKind`,
# normalizing first (`errors.error_code` strips any namespace/suffix) then
# matching by name; an unmodeled code becomes `Unknown(name)`, carrying it.
def serverlessrepo_error_kind(str code) -> ServerlessApplicationRepositoryErrorKind:
    auto name = errors.error_code(code)
    if name == "BadRequestException":
        return ServerlessApplicationRepositoryErrorKind.BadRequestException
    if name == "ConflictException":
        return ServerlessApplicationRepositoryErrorKind.ConflictException
    if name == "ForbiddenException":
        return ServerlessApplicationRepositoryErrorKind.ForbiddenException
    if name == "InternalServerErrorException":
        return ServerlessApplicationRepositoryErrorKind.InternalServerErrorException
    if name == "NotFoundException":
        return ServerlessApplicationRepositoryErrorKind.NotFoundException
    if name == "TooManyRequestsException":
        return ServerlessApplicationRepositoryErrorKind.TooManyRequestsException
    return ServerlessApplicationRepositoryErrorKind.Unknown(name)

# The canonical name of a classified error. This `match` is exhaustive over
# every variant (the compiler enforces it, so a new variant forces it to be
# updated — the generator emits the enum and dispatcher together) and is
# module-local, so each pattern is a two-segment `Enum.Variant` — the portable
# form until the compiler resolves module-qualified variant patterns in a
# caller's own `match` (DECISIONS.md D-0006). `Unknown` carries its code.
def serverlessrepo_error_name(ServerlessApplicationRepositoryErrorKind k) -> str:
    match k:
        case ServerlessApplicationRepositoryErrorKind.BadRequestException:
            return "BadRequestException"
        case ServerlessApplicationRepositoryErrorKind.ConflictException:
            return "ConflictException"
        case ServerlessApplicationRepositoryErrorKind.ForbiddenException:
            return "ForbiddenException"
        case ServerlessApplicationRepositoryErrorKind.InternalServerErrorException:
            return "InternalServerErrorException"
        case ServerlessApplicationRepositoryErrorKind.NotFoundException:
            return "NotFoundException"
        case ServerlessApplicationRepositoryErrorKind.TooManyRequestsException:
            return "TooManyRequestsException"
        case ServerlessApplicationRepositoryErrorKind.Unknown(c):
            return "Unknown(" + c + ")"

