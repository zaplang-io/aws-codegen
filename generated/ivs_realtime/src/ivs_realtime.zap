    # Paginator for ListIngestConfigurations — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: ingestConfigurations).
    def paginate_list_ingest_configurations(self, ListIngestConfigurationsRequest input):
        auto host = endpoints.regional_host(ivsrealtime_service(), self.region)
        while True:
            auto raw = self.list_ingest_configurations(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

