    # Paginator for ListNamespaces — yields each Response page, threading the
    # continuationToken -> continuationToken continuation token until it is absent (result key: namespaces).
    def paginate_list_namespaces(self, ListNamespacesRequest input):
        auto host = endpoints.regional_host(s3tables_service(), self.region)
        while True:
            auto raw = self.list_namespaces(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "continuationToken")
            if not np.has_more:
                break
            input.continuationToken = Optional.Some(np.token)

    # Paginator for ListTableBuckets — yields each Response page, threading the
    # continuationToken -> continuationToken continuation token until it is absent (result key: tableBuckets).
    def paginate_list_table_buckets(self, ListTableBucketsRequest input):
