# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by s3tables_error_from_code.
enum S3TablesError:
    AccessDeniedException
    BadRequestException
    ConflictException
    ForbiddenException
    InternalServerErrorException
    MethodNotAllowedException
    NotFoundException
    TooManyRequestsException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def s3tables_error_from_code(str code) -> S3TablesError:
    if code == "AccessDeniedException":
        return S3TablesError.AccessDeniedException
    if code == "BadRequestException":
        return S3TablesError.BadRequestException
    if code == "ConflictException":
        return S3TablesError.ConflictException
    if code == "ForbiddenException":
        return S3TablesError.ForbiddenException
    if code == "InternalServerErrorException":
        return S3TablesError.InternalServerErrorException
    if code == "MethodNotAllowedException":
        return S3TablesError.MethodNotAllowedException
    if code == "NotFoundException":
        return S3TablesError.NotFoundException
    if code == "TooManyRequestsException":
        return S3TablesError.TooManyRequestsException
    return S3TablesError.Unknown(code=code)

