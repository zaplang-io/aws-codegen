            auto np = core.next_page_json(page.body, "continuationToken")
            if not np.has_more:
                break
            input.continuationToken = Optional.Some(np.token)

# Construct a S3TablesClient bound to credentials + region.
def s3tables_client(core.Credentials creds, str region) -> S3TablesClient:
    return S3TablesClient(creds=creds, region=region)
