    # Paginator for ListCustomDomainAssociations — yields each Response page, threading the
    # nextToken -> nextToken continuation token until the output token is absent (result key: associations).
    def paginate_list_custom_domain_associations(self, ListCustomDomainAssociationsRequest input):
        auto host = endpoints.regional_host(redshift_serverless_protocol().service, self.region)
        while True:
            auto body = input.to_json()
            auto raw = awsjson.awsjson_request_now(redshift_serverless_protocol(), self.creds, self.region, "ListCustomDomainAssociations", body)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

