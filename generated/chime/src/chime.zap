    # Paginator for ListAccounts — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: Accounts).
    def paginate_list_accounts(self, ListAccountsRequest input):
        auto host = endpoints.regional_host(chime_service(), self.region)
        while True:
            auto raw = self.list_accounts(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

    # Paginator for ListUsers — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: Users).
    def paginate_list_users(self, ListUsersRequest input):
        auto host = endpoints.regional_host(chime_service(), self.region)
        while True:
            auto raw = self.list_users(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

# Construct a ChimeClient bound to credentials + region.
def chime_client(core.Credentials creds, str region) -> ChimeClient:
    return ChimeClient(creds=creds, region=region)
