    # Paginator for ListCrls — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: crls).
    def paginate_list_crls(self, ListRequest input):
        auto host = endpoints.regional_host(rolesanywhere_service(), self.region)
        while True:
            auto raw = self.list_crls(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

