    # Paginator for ListAWSDefaultServiceQuotas — yields each Response page, threading the
    # NextToken -> NextToken continuation token until the output token is absent (result key: Quotas).
    def paginate_list_aws_default_service_quotas(self, ListAWSDefaultServiceQuotasRequest input):
        auto host = endpoints.regional_host(servicequotas_protocol().service, self.region)
        while True:
            auto body = input.to_json()
            auto raw = awsjson.awsjson_request_now(servicequotas_protocol(), self.creds, self.region, "ListAWSDefaultServiceQuotas", body)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

