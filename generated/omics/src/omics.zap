# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by omics_error_from_code.
enum OmicsError:
    AccessDeniedException
    ConflictException
    InternalServerException
    NotSupportedOperationException
    RangeNotSatisfiableException
    RequestTimeoutException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def omics_error_from_code(str code) -> OmicsError:
    if code == "AccessDeniedException":
        return OmicsError.AccessDeniedException
    if code == "ConflictException":
        return OmicsError.ConflictException
    if code == "InternalServerException":
        return OmicsError.InternalServerException
    if code == "NotSupportedOperationException":
        return OmicsError.NotSupportedOperationException
    if code == "RangeNotSatisfiableException":
        return OmicsError.RangeNotSatisfiableException
    if code == "RequestTimeoutException":
        return OmicsError.RequestTimeoutException
    if code == "ResourceNotFoundException":
        return OmicsError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return OmicsError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return OmicsError.ThrottlingException
    if code == "ValidationException":
        return OmicsError.ValidationException
    return OmicsError.Unknown(code=code)

