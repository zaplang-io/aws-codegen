# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by mpa_error_from_code.
enum MPAError:
    AccessDeniedException
    ConflictException
    InternalServerException
    InvalidParameterException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    TooManyTagsException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def mpa_error_from_code(str code) -> MPAError:
    if code == "AccessDeniedException":
        return MPAError.AccessDeniedException
    if code == "ConflictException":
        return MPAError.ConflictException
    if code == "InternalServerException":
        return MPAError.InternalServerException
    if code == "InvalidParameterException":
        return MPAError.InvalidParameterException
    if code == "ResourceNotFoundException":
        return MPAError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return MPAError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return MPAError.ThrottlingException
    if code == "TooManyTagsException":
        return MPAError.TooManyTagsException
    if code == "ValidationException":
        return MPAError.ValidationException
    return MPAError.Unknown(code=code)

