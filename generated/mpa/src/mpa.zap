    # Paginator for ListApprovalTeams — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: ApprovalTeams).
    def paginate_list_approval_teams(self, ListApprovalTeamsRequest input):
        auto host = endpoints.regional_host(mpa_service(), self.region)
        while True:
            auto raw = self.list_approval_teams(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

