            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

# Construct a BatchClient bound to credentials + region.
def batch_client(core.Credentials creds, str region) -> BatchClient:
    return BatchClient(creds=creds, region=region)
