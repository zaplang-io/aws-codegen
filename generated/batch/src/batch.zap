#   ListJobsByConsumableResource (document member `filters: list[KeyValuesPair]` is not serializable by derive)
#   ListServiceJobs (document member `filters: list[KeyValuesPair]` is not serializable by derive)
#   RegisterJobDefinition (document member `parameters: dict[str, str]` is not serializable by derive)
#   SubmitJob (document member `dependsOn: list[JobDependency]` is not serializable by derive)
#   SubmitServiceJob (document member `retryStrategy: ServiceJobRetryStrategy` is not serializable by derive)
#   TagResource (document member `tags: dict[str, str]` is not serializable by derive)
#   TerminateJobs (document member `jobs: list[str]` is not serializable by derive)
#   TerminateServiceJobs (document member `jobs: list[str]` is not serializable by derive)
#   UntagResource (httpQuery `tagKeys` has unsupported type list[str])
#   UpdateComputeEnvironment (document member `computeResources: ComputeResourceUpdate` is not serializable by derive)
#   UpdateJobQueue (document member `computeEnvironmentOrder: list[ComputeEnvironmentOrder]` is not serializable by derive)
#   UpdateQuotaShare (document member `capacityLimits: list[QuotaShareCapacityLimit]` is not serializable by derive)
#   UpdateSchedulingPolicy (document member `fairsharePolicy: FairsharePolicy` is not serializable by derive)
#   UpdateServiceEnvironment (document member `capacityLimits: list[CapacityLimit]` is not serializable by derive)

# Paginated operations (paginators-1.json) not surfaced — their operation is
# skipped above, or the continuation token is not a simple string field:
#   DescribeComputeEnvironments (operation not generated)
#   DescribeJobDefinitions (operation not generated)
#   DescribeJobQueues (operation not generated)
#   DescribeServiceEnvironments (operation not generated)
#   ListConsumableResources (operation not generated)
#   ListJobs (operation not generated)
#   ListJobsByConsumableResource (operation not generated)
#   ListServiceJobs (operation not generated)

# Per-operation JSON document bodies (the unbound "document" members of an
# operation's input, serialized with @derive(Json)).

@derive(Json)
struct CancelJobDocument:
    # document members of CancelJob
    str jobId
    str reason

@derive(Json)
struct DeleteComputeEnvironmentDocument:
    # document members of DeleteComputeEnvironment
    str computeEnvironment

@derive(Json)
struct DeleteConsumableResourceDocument:
    # document members of DeleteConsumableResource
    str consumableResource

@derive(Json)
struct DeleteJobQueueDocument:
    # document members of DeleteJobQueue
    str jobQueue

@derive(Json)
struct DeleteQuotaShareDocument:
    # document members of DeleteQuotaShare
    str quotaShareArn

@derive(Json)
struct DeleteSchedulingPolicyDocument:
    # document members of DeleteSchedulingPolicy
    str arn

@derive(Json)
struct DeleteServiceEnvironmentDocument:
    # document members of DeleteServiceEnvironment
    str serviceEnvironment

@derive(Json)
struct DeregisterJobDefinitionDocument:
    # document members of DeregisterJobDefinition
    str jobDefinition

@derive(Json)
struct DescribeConsumableResourceDocument:
    # document members of DescribeConsumableResource
    str consumableResource

@derive(Json)
struct DescribeQuotaShareDocument:
    # document members of DescribeQuotaShare
    str quotaShareArn

@derive(Json)
struct DescribeServiceJobDocument:
    # document members of DescribeServiceJob
    str jobId

@derive(Json)
struct GetJobQueueSnapshotDocument:
    # document members of GetJobQueueSnapshot
    str jobQueue

@derive(Json)
struct ListQuotaSharesDocument:
    # document members of ListQuotaShares
    str jobQueue
    Optional[int64] maxResults
    Optional[str] nextToken

@derive(Json)
struct ListSchedulingPoliciesDocument:
    # document members of ListSchedulingPolicies
    Optional[int64] maxResults
    Optional[str] nextToken

@derive(Json)
struct TerminateJobDocument:
    # document members of TerminateJob
    str jobId
    str reason

@derive(Json)
struct TerminateServiceJobDocument:
    # document members of TerminateServiceJob
    str jobId
    str reason

@derive(Json)
struct UpdateConsumableResourceDocument:
    # document members of UpdateConsumableResource
    str consumableResource
    Optional[str] operation
    Optional[int64] quantity
    Optional[str] clientToken

@derive(Json)
struct UpdateServiceJobDocument:
    # document members of UpdateServiceJob
    str jobId
    int64 schedulingPriority

# A bound Batch client: credentials + region, threaded into every operation.
