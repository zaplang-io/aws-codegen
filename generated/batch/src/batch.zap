    # Paginator for ListQuotaShares — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: quotaShares).
    def paginate_list_quota_shares(self, ListQuotaSharesRequest input):
        auto host = endpoints.regional_host(batch_service(), self.region)
        while True:
            auto raw = self.list_quota_shares(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

    # Paginator for ListSchedulingPolicies — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: schedulingPolicies).
    def paginate_list_scheduling_policies(self, ListSchedulingPoliciesRequest input):
        auto host = endpoints.regional_host(batch_service(), self.region)
        while True:
            auto raw = self.list_scheduling_policies(input)
