# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by batch_error_from_code.
enum BatchError:
    ClientException
    ServerException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def batch_error_from_code(str code) -> BatchError:
    if code == "ClientException":
        return BatchError.ClientException
    if code == "ServerException":
        return BatchError.ServerException
    return BatchError.Unknown(code=code)

