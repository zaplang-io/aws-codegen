    # Paginator for ListAccessPoints — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: accessPoints).
    def paginate_list_access_points(self, ListAccessPointsRequest input):
        auto host = endpoints.regional_host(s3files_service(), self.region)
        while True:
            auto raw = self.list_access_points(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

