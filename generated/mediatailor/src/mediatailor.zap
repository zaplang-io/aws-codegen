# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by api_mediatailor_error_from_code.
enum MediaTailorError:
    BadRequestException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def api_mediatailor_error_from_code(str code) -> MediaTailorError:
    if code == "BadRequestException":
        return MediaTailorError.BadRequestException
    return MediaTailorError.Unknown(code=code)

