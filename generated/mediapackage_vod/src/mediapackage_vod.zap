    # Paginator for ListAssets — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: Assets).
    def paginate_list_assets(self, ListAssetsRequest input):
        auto host = endpoints.regional_host(mediapackage_vod_service(), self.region)
        while True:
            auto raw = self.list_assets(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

