    # NextToken -> NextToken continuation token until it is absent (result key: PackagingGroups).
    def paginate_list_packaging_groups(self, ListPackagingGroupsRequest input):
        auto host = endpoints.regional_host(mediapackage_vod_service(), self.region)
        while True:
            auto raw = self.list_packaging_groups(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

# Construct a MediaPackage_VodClient bound to credentials + region.
def mediapackage_vod_client(core.Credentials creds, str region) -> MediaPackage_VodClient:
    return MediaPackage_VodClient(creds=creds, region=region)
