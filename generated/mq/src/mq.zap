    # Paginator for DescribeSharedResources — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: SharedResources).
    def paginate_describe_shared_resources(self, DescribeSharedResourcesRequest input):
        auto host = endpoints.regional_host(mq_service(), self.region)
        while True:
            auto raw = self.describe_shared_resources(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

    # Paginator for ListBrokers — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: BrokerSummaries).
    def paginate_list_brokers(self, ListBrokersRequest input):
        auto host = endpoints.regional_host(mq_service(), self.region)
        while True:
            auto raw = self.list_brokers(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

# Construct a mqClient bound to credentials + region.
def mq_client(core.Credentials creds, str region) -> mqClient:
    return mqClient(creds=creds, region=region)
