# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by mq_error_from_code.
enum mqError:
    BadRequestException
    ConflictException
    ForbiddenException
    InternalServerErrorException
    NotFoundException
    UnauthorizedException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def mq_error_from_code(str code) -> mqError:
    if code == "BadRequestException":
        return mqError.BadRequestException
    if code == "ConflictException":
        return mqError.ConflictException
    if code == "ForbiddenException":
        return mqError.ForbiddenException
    if code == "InternalServerErrorException":
        return mqError.InternalServerErrorException
    if code == "NotFoundException":
        return mqError.NotFoundException
    if code == "UnauthorizedException":
        return mqError.UnauthorizedException
    return mqError.Unknown(code=code)

