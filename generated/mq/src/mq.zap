# operation's input, serialized with @derive(Json)).

@derive(Json)
struct PromoteDocument:
    # document members of Promote
    PromoteMode Mode

@derive(Json)
struct UpdateConfigurationDocument:
    # document members of UpdateConfiguration
    str Data
    Optional[str] Description

