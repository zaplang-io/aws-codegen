# A bound Keyspaces client: credentials + region, threaded into every operation.
struct KeyspacesClient:
    core.Credentials creds
    str region

    # CreateKeyspace
    # errors: AccessDeniedException, ConflictException, InternalServerException, ServiceQuotaExceededException, ValidationException
    def create_keyspace(self, CreateKeyspaceRequest input) -> bytes:
        auto body = cbor.cbor_encode(create_keyspace_request_to_cbor(input))
        auto host = endpoints.regional_host(cassandra_service(), self.region)
        auto t = core.signing_time_now()
        auto req = cbor.cbor_build_request(cassandra_service(), self.region, host, "KeyspacesService", "CreateKeyspace", body, t.amz_date)
        return cbor.cbor_sign(self.creds, req, body, t.amz_date, t.date_stamp)

    # CreateTable
    # errors: AccessDeniedException, ConflictException, InternalServerException, ResourceNotFoundException, ServiceQuotaExceededException, ValidationException
    def create_table(self, CreateTableRequest input) -> bytes:
