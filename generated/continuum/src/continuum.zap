# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by continuum_error_from_code.
enum ContinuumError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def continuum_error_from_code(str code) -> ContinuumError:
    if code == "AccessDeniedException":
        return ContinuumError.AccessDeniedException
    if code == "ConflictException":
        return ContinuumError.ConflictException
    if code == "InternalServerException":
        return ContinuumError.InternalServerException
    if code == "ResourceNotFoundException":
        return ContinuumError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return ContinuumError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return ContinuumError.ThrottlingException
    if code == "ValidationException":
        return ContinuumError.ValidationException
    return ContinuumError.Unknown(code=code)

# --- client ----------------------------------------------------------------

