    # Paginator for ListAssociatedCollectors — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: associatedCollectors).
    def paginate_list_associated_collectors(self, ListAssociatedCollectorsInput input):
        auto host = endpoints.regional_host(continuum_service(), self.region)
        while True:
            auto raw = self.list_associated_collectors(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

