# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def launchwizard_error_from_code(str code) -> Launch_WizardError:
    if code == "InternalServerException":
        return Launch_WizardError.InternalServerException
    if code == "ResourceLimitException":
        return Launch_WizardError.ResourceLimitException
    if code == "ResourceNotFoundException":
        return Launch_WizardError.ResourceNotFoundException
    if code == "ValidationException":
        return Launch_WizardError.ValidationException
    return Launch_WizardError.Unknown(code=code)

