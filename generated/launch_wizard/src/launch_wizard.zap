            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

# Construct a Launch_WizardClient bound to credentials + region.
def launchwizard_client(core.Credentials creds, str region) -> Launch_WizardClient:
    return Launch_WizardClient(creds=creds, region=region)
