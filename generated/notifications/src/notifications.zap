    # Paginator for ListChannels — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: channels).
    def paginate_list_channels(self, ListChannelsRequest input):
        auto host = endpoints.regional_host(notifications_service(), self.region)
        while True:
            auto raw = self.list_channels(input)
