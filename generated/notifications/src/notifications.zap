# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by notifications_error_from_code.
enum NotificationsError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def notifications_error_from_code(str code) -> NotificationsError:
    if code == "AccessDeniedException":
        return NotificationsError.AccessDeniedException
    if code == "ConflictException":
        return NotificationsError.ConflictException
    if code == "InternalServerException":
        return NotificationsError.InternalServerException
    if code == "ResourceNotFoundException":
        return NotificationsError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return NotificationsError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return NotificationsError.ThrottlingException
    if code == "ValidationException":
        return NotificationsError.ValidationException
    return NotificationsError.Unknown(code=code)

