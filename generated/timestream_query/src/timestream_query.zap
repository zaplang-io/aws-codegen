    # NextToken -> NextToken continuation token until the output token is absent (result key: Rows).
    def paginate_query(self, QueryRequest input):
        auto host = endpoints.regional_host(query_timestream_protocol().service, self.region)
        while True:
            auto body = input.to_json()
            auto raw = awsjson.awsjson_request_now(query_timestream_protocol(), self.creds, self.region, "Query", body)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

# Construct a Timestream_QueryClient bound to credentials + region.
def query_timestream_client(core.Credentials creds, str region) -> Timestream_QueryClient:
    return Timestream_QueryClient(creds=creds, region=region)
