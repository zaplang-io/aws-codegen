    str OriginEndpointId
    S3Destination S3Destination
    str StartTime

@derive(Json)
struct UpdateChannelDocument:
    # document members of UpdateChannel
    Optional[str] Description

# JSON body helpers (compact, declaration-order objects): the collection
# serialization @derive(Json) does not emit yet (zaplang-io/zap#424). `_json_str`
# escapes+quotes via the prelude JSON writer; `_json_obj`/`_json_arr` comma-join
# pre-serialized members.
def mediapackage_json_str(str s) -> str:
    return json.dumps(JsonValue.Str(s))

def mediapackage_json_obj(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "{" + body + "}"

def mediapackage_json_arr(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "[" + body + "]"

