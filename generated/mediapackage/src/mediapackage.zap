# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by mediapackage_error_from_code.
enum MediaPackageError:
    ForbiddenException
    InternalServerErrorException
    NotFoundException
    ServiceUnavailableException
    TooManyRequestsException
    UnprocessableEntityException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def mediapackage_error_from_code(str code) -> MediaPackageError:
    if code == "ForbiddenException":
        return MediaPackageError.ForbiddenException
    if code == "InternalServerErrorException":
        return MediaPackageError.InternalServerErrorException
    if code == "NotFoundException":
        return MediaPackageError.NotFoundException
    if code == "ServiceUnavailableException":
        return MediaPackageError.ServiceUnavailableException
    if code == "TooManyRequestsException":
        return MediaPackageError.TooManyRequestsException
    if code == "UnprocessableEntityException":
        return MediaPackageError.UnprocessableEntityException
    return MediaPackageError.Unknown(code=code)

