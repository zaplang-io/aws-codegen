# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by evs_error_from_code.
enum evsError:
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    TagPolicyException
    ThrottlingException
    TooManyTagsException
    ValidationException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def evs_error_from_code(str code) -> evsError:
    if code == "InternalServerException":
        return evsError.InternalServerException
    if code == "ResourceNotFoundException":
        return evsError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return evsError.ServiceQuotaExceededException
    if code == "TagPolicyException":
        return evsError.TagPolicyException
    if code == "ThrottlingException":
        return evsError.ThrottlingException
    if code == "TooManyTagsException":
        return evsError.TooManyTagsException
    if code == "ValidationException":
        return evsError.ValidationException
    return evsError.Unknown(code=code)

