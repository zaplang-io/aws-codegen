    # Paginator for ListEnvironmentConnectors — yields each Response page, threading the
    # nextToken -> nextToken continuation token until the output token is absent (result key: connectors).
    def paginate_list_environment_connectors(self, ListEnvironmentConnectorsRequest input):
        auto host = endpoints.regional_host(evs_protocol().service, self.region)
        while True:
            auto body = input.to_json()
            auto raw = awsjson.awsjson_request_now(evs_protocol(), self.creds, self.region, "ListEnvironmentConnectors", body)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

