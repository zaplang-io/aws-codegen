    str KeyIdentifier
    str PrimaryAccountNumber
    CardGenerationAttributes GenerationAttributes
    Optional[int64] ValidationDataLength

@derive(Json)
struct GenerateMacDocument:
    # document members of GenerateMac
    str KeyIdentifier
    str MessageData
    MacAttributes GenerationAttributes
    Optional[int64] MacLength

@derive(Json)
struct GenerateMacEmvPinChangeDocument:
    # document members of GenerateMacEmvPinChange
    str NewPinPekIdentifier
    str NewEncryptedPinBlock
    PinBlockFormatForEmvPinChange PinBlockFormat
    str SecureMessagingIntegrityKeyIdentifier
    str SecureMessagingConfidentialityKeyIdentifier
    str MessageData
    DerivationMethodAttributes DerivationMethodAttributes

@derive(Json)
struct GeneratePinDataDocument:
