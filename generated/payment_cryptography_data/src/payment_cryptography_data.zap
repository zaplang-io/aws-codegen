# Per-operation JSON document bodies (the unbound "document" members of an
# operation's input, serialized with @derive(Json)).

@derive(Json)
struct DecryptDataDocument:
    # document members of DecryptData
    str CipherText
    EncryptionDecryptionAttributes DecryptionAttributes
    Optional[WrappedKey] WrappedKey

@derive(Json)
struct EncryptDataDocument:
    # document members of EncryptData
    str PlainText
    EncryptionDecryptionAttributes EncryptionAttributes
    Optional[WrappedKey] WrappedKey

@derive(Json)
struct GenerateAs2805KekValidationDocument:
