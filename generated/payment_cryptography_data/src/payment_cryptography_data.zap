# header or body __type, stripped to the bare shape name) to a variant.
def dataplane_payment_cryptography_error_from_code(str code) -> Payment_Cryptography_DataError:
    if code == "AccessDeniedException":
        return Payment_Cryptography_DataError.AccessDeniedException
    if code == "InternalServerException":
        return Payment_Cryptography_DataError.InternalServerException
    if code == "ResourceNotFoundException":
        return Payment_Cryptography_DataError.ResourceNotFoundException
    if code == "ThrottlingException":
        return Payment_Cryptography_DataError.ThrottlingException
    if code == "ValidationException":
        return Payment_Cryptography_DataError.ValidationException
    if code == "VerificationFailedException":
        return Payment_Cryptography_DataError.VerificationFailedException
    return Payment_Cryptography_DataError.Unknown(code=code)

