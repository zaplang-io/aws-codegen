@derive(Json)
struct ReEncryptDataDocument:
    # document members of ReEncryptData
    str OutgoingKeyIdentifier
    str CipherText
    ReEncryptionAttributes IncomingEncryptionAttributes
    ReEncryptionAttributes OutgoingEncryptionAttributes
    Optional[WrappedKey] IncomingWrappedKey
