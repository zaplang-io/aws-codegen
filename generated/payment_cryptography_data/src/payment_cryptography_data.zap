    str KeyIdentifier
    As2805KekValidationType KekValidationType
    RandomKeySendVariantMask RandomKeySendVariantMask

@derive(Json)
struct GenerateAuthRequestCryptogramDocument:
    # document members of GenerateAuthRequestCryptogram
