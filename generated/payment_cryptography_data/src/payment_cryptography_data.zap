    Optional[WrappedKey] OutgoingWrappedKey
    Optional[As2805PekDerivationAttributes] IncomingAs2805Attributes

@derive(Json)
struct VerifyAuthRequestCryptogramDocument:
    # document members of VerifyAuthRequestCryptogram
