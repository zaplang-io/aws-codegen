        if input.IncludeTags.is_some():
            auto u0 = input.IncludeTags.unwrap()
            parts.append("\"IncludeTags\":" + json.dumps(JsonValue.Bool(u0)))
        if input.LinkConfiguration.is_some():
            auto u1 = input.LinkConfiguration.unwrap()
            parts.append("\"LinkConfiguration\":" + u1.to_json())
        list[str] e2 = []
        for x2 in input.ResourceTypes:
            e2.append(x2.to_json())
        parts.append("\"ResourceTypes\":" + oam_json_arr(e2))
        auto bp = restjson.rest_json_document(b, oam_json_obj(parts))
        return restjson.rest_json_request(self.creds, bp, oam_service(), self.region, host)

    # Paginator for ListAttachedLinks — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: Items).
    def paginate_list_attached_links(self, ListAttachedLinksInput input):
        auto host = endpoints.regional_host(oam_service(), self.region)
        while True:
            auto raw = self.list_attached_links(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

    # Paginator for ListLinks — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: Items).
    def paginate_list_links(self, ListLinksInput input):
        auto host = endpoints.regional_host(oam_service(), self.region)
        while True:
            auto raw = self.list_links(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

    # Paginator for ListSinks — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: Items).
    def paginate_list_sinks(self, ListSinksInput input):
        auto host = endpoints.regional_host(oam_service(), self.region)
        while True:
            auto raw = self.list_sinks(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

# Construct a OAMClient bound to credentials + region.
def oam_client(core.Credentials creds, str region) -> OAMClient:
    return OAMClient(creds=creds, region=region)
