    # Paginator for DescribeMappedResourceConfiguration — yields each Response page, threading the
    # NextToken -> NextToken continuation token until it is absent (result key: MappedResourceConfigurationList).
    def paginate_describe_mapped_resource_configuration(self, DescribeMappedResourceConfigurationInput input):
        auto host = endpoints.regional_host(kinesisvideo_service(), self.region)
        while True:
            auto raw = self.describe_mapped_resource_configuration(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

