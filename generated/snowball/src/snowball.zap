        auto t = core.signing_time_now()
        auto req = cbor.cbor_build_request(snowball_service(), self.region, host, "AWSIESnowballJobManagementService", "UpdateCluster", body, t.amz_date)
        return cbor.cbor_sign(self.creds, req, body, t.amz_date, t.date_stamp)

    # UpdateJob
    # errors: ClusterLimitExceededException, Ec2RequestFailedException, InvalidInputCombinationException, InvalidJobStateException, InvalidResourceException, KMSRequestFailedException
    def update_job(self, UpdateJobRequest input) -> bytes:
        auto body = cbor.cbor_encode(update_job_request_to_cbor(input))
        auto host = endpoints.regional_host(snowball_service(), self.region)
