    # UpdateLongTermPricing
    # errors: InvalidResourceException
    def update_long_term_pricing(self, UpdateLongTermPricingRequest input) -> bytes:
        auto body = cbor.cbor_encode(update_long_term_pricing_request_to_cbor(input))
        auto host = endpoints.regional_host(snowball_service(), self.region)
