        return cbor.cbor_sign(self.creds, req, body, t.amz_date, t.date_stamp)

# Construct a SnowballClient bound to credentials + region.
def snowball_client(core.Credentials creds, str region) -> SnowballClient:
    return SnowballClient(creds=creds, region=region)
