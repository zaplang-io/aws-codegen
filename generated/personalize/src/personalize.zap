# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by personalize_error_from_code.
enum PersonalizeError:
    InvalidInputException
    InvalidNextTokenException
    LimitExceededException
    ResourceAlreadyExistsException
    ResourceInUseException
    ResourceNotFoundException
    TooManyTagKeysException
    TooManyTagsException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def personalize_error_from_code(str code) -> PersonalizeError:
    if code == "InvalidInputException":
        return PersonalizeError.InvalidInputException
    if code == "InvalidNextTokenException":
        return PersonalizeError.InvalidNextTokenException
    if code == "LimitExceededException":
        return PersonalizeError.LimitExceededException
    if code == "ResourceAlreadyExistsException":
        return PersonalizeError.ResourceAlreadyExistsException
    if code == "ResourceInUseException":
        return PersonalizeError.ResourceInUseException
    if code == "ResourceNotFoundException":
        return PersonalizeError.ResourceNotFoundException
    if code == "TooManyTagKeysException":
        return PersonalizeError.TooManyTagKeysException
    if code == "TooManyTagsException":
        return PersonalizeError.TooManyTagsException
    return PersonalizeError.Unknown(code=code)

