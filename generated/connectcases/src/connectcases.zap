# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by cases_error_from_code.
enum ConnectCasesError:
    AccessDeniedException
    ConflictException
    InternalServerException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def cases_error_from_code(str code) -> ConnectCasesError:
    if code == "AccessDeniedException":
        return ConnectCasesError.AccessDeniedException
    if code == "ConflictException":
        return ConnectCasesError.ConflictException
    if code == "InternalServerException":
        return ConnectCasesError.InternalServerException
    if code == "ResourceNotFoundException":
        return ConnectCasesError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return ConnectCasesError.ServiceQuotaExceededException
    if code == "ThrottlingException":
        return ConnectCasesError.ThrottlingException
    if code == "ValidationException":
        return ConnectCasesError.ValidationException
    return ConnectCasesError.Unknown(code=code)

