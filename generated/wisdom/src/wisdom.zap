    # Paginator for ListAssistantAssociations — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: assistantAssociationSummaries).
    def paginate_list_assistant_associations(self, ListAssistantAssociationsRequest input):
        auto host = endpoints.regional_host(wisdom_service(), self.region)
        while True:
            auto raw = self.list_assistant_associations(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

