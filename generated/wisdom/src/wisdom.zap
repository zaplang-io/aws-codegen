# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# restJson1 X-Amzn-ErrorType / body `__type` code by wisdom_error_from_code.
enum WisdomError:
    AccessDeniedException
    ConflictException
    PreconditionFailedException
    RequestTimeoutException
    ResourceNotFoundException
    ServiceQuotaExceededException
    TooManyTagsException
    ValidationException
    Unknown(str code)

# Map a restJson1 error code (from rest_json_error_code: the X-Amzn-ErrorType
# header or body __type, stripped to the bare shape name) to a variant.
def wisdom_error_from_code(str code) -> WisdomError:
    if code == "AccessDeniedException":
        return WisdomError.AccessDeniedException
    if code == "ConflictException":
        return WisdomError.ConflictException
    if code == "PreconditionFailedException":
        return WisdomError.PreconditionFailedException
    if code == "RequestTimeoutException":
        return WisdomError.RequestTimeoutException
    if code == "ResourceNotFoundException":
        return WisdomError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return WisdomError.ServiceQuotaExceededException
    if code == "TooManyTagsException":
        return WisdomError.TooManyTagsException
    if code == "ValidationException":
        return WisdomError.ValidationException
    return WisdomError.Unknown(code=code)

