    # Paginator for ListActs — yields each Response page, threading the
    # nextToken -> nextToken continuation token until it is absent (result key: actSummaries).
    def paginate_list_acts(self, ListActsRequest input):
        auto host = endpoints.regional_host(nova_act_service(), self.region)
        while True:
            auto raw = self.list_acts(input)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

