    ServiceQuotaExceededException
    ThrottlingException
    ValidationException
    Unknown(str code)

# Classify an AWS error code into `SSM_ContactsErrorKind`,
# normalizing first (`errors.error_code` strips any namespace/suffix) then
# matching by name; an unmodeled code becomes `Unknown(name)`, carrying it.
def ssm_contacts_error_kind(str code) -> SSM_ContactsErrorKind:
    auto name = errors.error_code(code)
    if name == "AccessDeniedException":
        return SSM_ContactsErrorKind.AccessDeniedException
    if name == "ConflictException":
        return SSM_ContactsErrorKind.ConflictException
    if name == "DataEncryptionException":
        return SSM_ContactsErrorKind.DataEncryptionException
    if name == "InternalServerException":
        return SSM_ContactsErrorKind.InternalServerException
    if name == "ResourceNotFoundException":
        return SSM_ContactsErrorKind.ResourceNotFoundException
    if name == "ServiceQuotaExceededException":
        return SSM_ContactsErrorKind.ServiceQuotaExceededException
    if name == "ThrottlingException":
        return SSM_ContactsErrorKind.ThrottlingException
    if name == "ValidationException":
        return SSM_ContactsErrorKind.ValidationException
    return SSM_ContactsErrorKind.Unknown(name)

# The canonical name of a classified error. This `match` is exhaustive over
# every variant (the compiler enforces it, so a new variant forces it to be
# updated — the generator emits the enum and dispatcher together) and is
# module-local, so each pattern is a two-segment `Enum.Variant` — the portable
# form until the compiler resolves module-qualified variant patterns in a
# caller's own `match` (DECISIONS.md D-0006). `Unknown` carries its code.
def ssm_contacts_error_name(SSM_ContactsErrorKind k) -> str:
    match k:
        case SSM_ContactsErrorKind.AccessDeniedException:
            return "AccessDeniedException"
        case SSM_ContactsErrorKind.ConflictException:
            return "ConflictException"
        case SSM_ContactsErrorKind.DataEncryptionException:
            return "DataEncryptionException"
        case SSM_ContactsErrorKind.InternalServerException:
            return "InternalServerException"
        case SSM_ContactsErrorKind.ResourceNotFoundException:
            return "ResourceNotFoundException"
        case SSM_ContactsErrorKind.ServiceQuotaExceededException:
            return "ServiceQuotaExceededException"
        case SSM_ContactsErrorKind.ThrottlingException:
            return "ThrottlingException"
        case SSM_ContactsErrorKind.ValidationException:
            return "ValidationException"
        case SSM_ContactsErrorKind.Unknown(c):
            return "Unknown(" + c + ")"

