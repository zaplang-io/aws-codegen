# pre-serialized members.
def ssm_contacts_json_str(str s) -> str:
    return json.dumps(JsonValue.Str(s))

def ssm_contacts_json_obj(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "{" + body + "}"

def ssm_contacts_json_arr(list[str] parts) -> str:
