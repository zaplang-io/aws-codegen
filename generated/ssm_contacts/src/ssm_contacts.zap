    # Paginator for ListContactChannels — yields each Response page, threading the
    # NextToken -> NextToken continuation token until the output token is absent (result key: ContactChannels).
    def paginate_list_contact_channels(self, ListContactChannelsRequest input):
        auto host = endpoints.regional_host(ssm_contacts_protocol().service, self.region)
        while True:
            auto body = input.to_json()
            auto raw = awsjson.awsjson_request_now(ssm_contacts_protocol(), self.creds, self.region, "ListContactChannels", body)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "NextToken")
            if not np.has_more:
                break
            input.NextToken = Optional.Some(np.token)

