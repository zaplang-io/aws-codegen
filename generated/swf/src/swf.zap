# --- errors ----------------------------------------------------------------

# Typed service errors (#361): the per-service enum + classifier + name
# dispatcher emitted on top of `aws_core.errors` (DECISIONS.md D-0006). One
# bare variant per modeled error shape, plus an open-enum `Unknown(str code)`
# catch-all, so a caller built against this model keeps working when the
# service adds an error. The raw wire code is
# the awsJson `__type` / X-Amzn-ErrorType shape name.
# `errors.error_code` normalizes it to the bare shape name before matching;
# the base carrier, the X-Amzn-ErrorType fallback and the raise/check bridge
# are inherited from `aws_core.errors` and not re-emitted here.
enum SWFErrorKind:
    DefaultUndefinedFault
    DomainAlreadyExistsFault
    DomainDeprecatedFault
    LimitExceededFault
    OperationNotPermittedFault
    TooManyTagsFault
    TypeAlreadyExistsFault
    TypeDeprecatedFault
    TypeNotDeprecatedFault
    UnknownResourceFault
    WorkflowExecutionAlreadyStartedFault
    Unknown(str code)

# Classify an AWS error code into `SWFErrorKind`,
# normalizing first (`errors.error_code` strips any namespace/suffix) then
# matching by name; an unmodeled code becomes `Unknown(name)`, carrying it.
def swf_error_kind(str code) -> SWFErrorKind:
    auto name = errors.error_code(code)
    if name == "DefaultUndefinedFault":
        return SWFErrorKind.DefaultUndefinedFault
    if name == "DomainAlreadyExistsFault":
        return SWFErrorKind.DomainAlreadyExistsFault
    if name == "DomainDeprecatedFault":
        return SWFErrorKind.DomainDeprecatedFault
    if name == "LimitExceededFault":
        return SWFErrorKind.LimitExceededFault
    if name == "OperationNotPermittedFault":
        return SWFErrorKind.OperationNotPermittedFault
    if name == "TooManyTagsFault":
        return SWFErrorKind.TooManyTagsFault
    if name == "TypeAlreadyExistsFault":
        return SWFErrorKind.TypeAlreadyExistsFault
    if name == "TypeDeprecatedFault":
        return SWFErrorKind.TypeDeprecatedFault
    if name == "TypeNotDeprecatedFault":
        return SWFErrorKind.TypeNotDeprecatedFault
    if name == "UnknownResourceFault":
        return SWFErrorKind.UnknownResourceFault
    if name == "WorkflowExecutionAlreadyStartedFault":
        return SWFErrorKind.WorkflowExecutionAlreadyStartedFault
    return SWFErrorKind.Unknown(name)

# The canonical name of a classified error. This `match` is exhaustive over
# every variant (the compiler enforces it, so a new variant forces it to be
# updated — the generator emits the enum and dispatcher together) and is
# module-local, so each pattern is a two-segment `Enum.Variant` — the portable
# form until the compiler resolves module-qualified variant patterns in a
# caller's own `match` (DECISIONS.md D-0006). `Unknown` carries its code.
def swf_error_name(SWFErrorKind k) -> str:
    match k:
        case SWFErrorKind.DefaultUndefinedFault:
            return "DefaultUndefinedFault"
        case SWFErrorKind.DomainAlreadyExistsFault:
            return "DomainAlreadyExistsFault"
        case SWFErrorKind.DomainDeprecatedFault:
            return "DomainDeprecatedFault"
        case SWFErrorKind.LimitExceededFault:
            return "LimitExceededFault"
        case SWFErrorKind.OperationNotPermittedFault:
            return "OperationNotPermittedFault"
        case SWFErrorKind.TooManyTagsFault:
            return "TooManyTagsFault"
        case SWFErrorKind.TypeAlreadyExistsFault:
            return "TypeAlreadyExistsFault"
        case SWFErrorKind.TypeDeprecatedFault:
            return "TypeDeprecatedFault"
        case SWFErrorKind.TypeNotDeprecatedFault:
            return "TypeNotDeprecatedFault"
        case SWFErrorKind.UnknownResourceFault:
            return "UnknownResourceFault"
        case SWFErrorKind.WorkflowExecutionAlreadyStartedFault:
            return "WorkflowExecutionAlreadyStartedFault"
        case SWFErrorKind.Unknown(c):
            return "Unknown(" + c + ")"

# --- client ----------------------------------------------------------------

# JSON body helpers (compact, declaration-order objects): the collection
# serialization @derive(Json) does not emit yet (zaplang-io/zap#424). `_json_str`
# escapes+quotes via the prelude JSON writer; `_json_obj`/`_json_arr` comma-join
# pre-serialized members.
def swf_json_str(str s) -> str:
    return json.dumps(JsonValue.Str(s))

def swf_json_obj(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "{" + body + "}"

def swf_json_arr(list[str] parts) -> str:
    auto body = ""
    auto i = 0
    for part in parts:
        if i > 0:
            body = body + ","
        body = body + part
        i = i + 1
    return "[" + body + "]"

# Explicit JSON serializers for input shapes with collection/nested members
# (the @derive(Json) collection follow-up, zaplang-io/zap#424).

