# --- errors ----------------------------------------------------------------

# Service error set (operation + service level), dispatched from the
# awsJson `__type` / X-Amzn-ErrorType code by aoss_error_from_code.
enum OpenSearchServerlessError:
    ConflictException
    InternalServerException
    OcuLimitExceededException
    ResourceNotFoundException
    ServiceQuotaExceededException
    ValidationException
    Unknown(str code)

# Map an awsJson error code (the stripped __type shape name) to a variant.
def aoss_error_from_code(str code) -> OpenSearchServerlessError:
    if code == "ConflictException":
        return OpenSearchServerlessError.ConflictException
    if code == "InternalServerException":
        return OpenSearchServerlessError.InternalServerException
    if code == "OcuLimitExceededException":
        return OpenSearchServerlessError.OcuLimitExceededException
    if code == "ResourceNotFoundException":
        return OpenSearchServerlessError.ResourceNotFoundException
    if code == "ServiceQuotaExceededException":
        return OpenSearchServerlessError.ServiceQuotaExceededException
    if code == "ValidationException":
        return OpenSearchServerlessError.ValidationException
    return OpenSearchServerlessError.Unknown(code=code)

