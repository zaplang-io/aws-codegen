    # Paginator for ListIngestionJobs — yields each Response page, threading the
    # nextToken -> nextToken continuation token until the output token is absent (result key: ingestionJobSummaries).
    def paginate_list_ingestion_jobs(self, ListIngestionJobsRequest input):
        auto host = endpoints.regional_host(aoss_protocol().service, self.region)
        while True:
            auto body = input.to_json()
            auto raw = awsjson.awsjson_request_now(aoss_protocol(), self.creds, self.region, "ListIngestionJobs", body)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

    # Paginator for ListIngestionStreams — yields each Response page, threading the
    # nextToken -> nextToken continuation token until the output token is absent (result key: ingestionStreamSummaries).
    def paginate_list_ingestion_streams(self, ListIngestionStreamsRequest input):
        auto host = endpoints.regional_host(aoss_protocol().service, self.region)
        while True:
            auto body = input.to_json()
            auto raw = awsjson.awsjson_request_now(aoss_protocol(), self.creds, self.region, "ListIngestionStreams", body)
            auto page = core.send(host, raw)
            yield page
            auto np = core.next_page_json(page.body, "nextToken")
            if not np.has_more:
                break
            input.nextToken = Optional.Some(np.token)

# Construct a OpenSearchServerlessClient bound to credentials + region.
def aoss_client(core.Credentials creds, str region) -> OpenSearchServerlessClient:
    return OpenSearchServerlessClient(creds=creds, region=region)
